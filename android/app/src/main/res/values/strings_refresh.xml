    <!-- Wie aktuell? (Sparsam / Live) -->
    <string name="update_mode_for_pros">needs more data and battery</string>
    <string name="update_mode_live">Live while open</string>
    <string name="update_mode_live_hint">Where the exchange provides a live price: instantly while the watchlist is open. Otherwise at the next fetch. Closed: no more often than every %1$s, often later.</string>
    <string name="update_mode_live_hint_ios" tools:ignore="UnusedResources">Where the exchange provides a live price: instantly while the watchlist is open. Otherwise at the next fetch. Closed: when iOS allows it, sometimes hours apart. If you swipe the app away, iOS stops these checks until you open it again.</string>
    <string name="update_mode_recommended">recommended</string>
    <string name="update_mode_sparsam">Economical</string>
    <string name="update_mode_sparsam_hint">With the app closed, no more often than every %1$s, often later (alerts, widgets). Open: each time you open it.</string>
    <string name="update_mode_sparsam_hint_ios" tools:ignore="UnusedResources">With the app closed, iOS decides when to check (alerts, widgets), sometimes hours apart. Open: each time you open it.</string>
    <string name="update_mode_title">Update frequency</string>

