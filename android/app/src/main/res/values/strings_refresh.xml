    <string name="battery_delay_hint">Android can delay checks – set battery to “Unrestricted”</string>
    <string name="battery_later">Later</string>
    <string name="battery_message">Android delays background work to save power — prices and widgets can then be hours old. Setting battery usage to unrestricted keeps them current. You can change this any time in Android settings.</string>
    <string name="battery_open_settings">Open battery settings</string>
    <string name="battery_steps">In the app info, tap Battery (or App battery usage) and choose Unrestricted.</string>
    <string name="battery_title">Keep prices up to date</string>
    <string name="ios_background_refresh_off" tools:ignore="UnusedResources">Background App Refresh is off for this app. Without it, alerts are only checked while the app is open.</string>
    <string name="ios_low_power_mode" tools:ignore="UnusedResources">Low Power Mode is on. iOS rarely checks in the background, so alerts may come late.</string>

