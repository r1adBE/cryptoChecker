<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wiederherstellen: Sicherung ohne Passwort wollte den eigenen Bitcoin-Server setzen, ersetzen oder löschen; er blieb (BackupRestorePolicy.addressServerNote KEPT) -->
    <string name="backup_restore_server_kept">Own Bitcoin server not applied – an unencrypted backup can’t change it.</string>
    <!-- Wiederherstellen: Sicherung mit Passwort ohne eigenen Bitcoin-Server hat den bisherigen entfernt (PUBLIC) -->
    <string name="backup_restore_server_public">Own Bitcoin server removed as in the backup – Bitcoin addresses are queried at public nodes again.</string>
    <!-- Wiederherstellen: Sicherung mit Passwort hat den bisherigen eigenen Bitcoin-Server ersetzt (CHANGED) -->
    <string name="backup_restore_server_changed">Own Bitcoin server replaced with the one from the backup.</string>
    <!-- Portfolio-Adresse: Anzahl Token ohne bekannten Kurs, nicht im Wert enthalten (%1$d = Anzahl) -->
    <plurals name="portfolio_address_unknown_tokens">
        <item quantity="one">+%1$d unknown token (not counted)</item>
        <item quantity="other">+%1$d unknown tokens (not counted)</item>
    </plurals>
</resources>
