    <!-- Erklärungen hinter dem ⓘ-Knopf -->
    <string name="explain_funding">Many traders bet on rising or falling prices with borrowed money. Fee between long and short positions. Strongly positive means many are betting on rising prices.</string>
    <string name="explain_open_interest">Futures are bets on the price, often with borrowed money. Value of all open futures positions. If it rises, more money is betting on the move.</string>
    <!-- Inhaltsbeschreibung des ⓘ-Knopfs, der eine Erklärung einblendet -->
    <string name="explain_show">Explanation</string>
    <string name="explain_spot_fdv">Fully diluted valuation: price × max supply (or total supply if there is no limit).</string>
    <string name="explain_spot_market_cap">Price × circulating supply. The pill shows its change over 24 hours.</string>
    <string name="explain_spot_source">Figures across all exchanges in US dollars, from CoinGecko.</string>
    <string name="explain_spot_supply">Circulating: coins on the market now. Total: all coins created minus burned ones. Max: the most that can ever exist.</string>
    <string name="explain_spot_volume">Value traded in 24 hours. Vol/Mkt cap: volume relative to market cap — high means very active trading.</string>

    <!-- Umrechnung und Sats -->
    <string name="converted_fx_stale">%1$s · rate %2$s</string>
    <string name="sats_per_unit">%1$s %2$s = %3$s sats</string>

    <!-- Kursblatt: Abstand Geld/Brief über 2 % der Mitte (BidAskSpread) -->
