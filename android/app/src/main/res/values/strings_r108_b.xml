<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Own server for addresses</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, gültiges Zertifikat nötig, kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Bitcoin only: your own Esplora- or mempool-compatible server (e.g. https://node.example/api, valid certificate required). If set, Bitcoin addresses and xpub keys are queried only there – never at public nodes, not even when your server is unreachable. Other networks keep using public nodes. Empty = public nodes.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoin server (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Test</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Testing…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Server responds – block %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">No valid answer – check the address and the certificate</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">In use: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Not set – public nodes are used</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Only https:// addresses are allowed</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">No user name or password in the address</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">No ? or # part in the address</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Not a valid server address</string>
    <!-- Portfolio › Adressen: Status einer Bitcoin-Adresse, wenn der eigene Server nicht liefert (statt «Aktualisierung fehlgeschlagen»; kein Rückfall auf öffentliche Knoten) -->
    <string name="portfolio_address_server_failed">Own server not reachable</string>
    <!-- Datenschutz-Hinweis zu xpub/Deskriptor (auch Zustimmung vor dem ersten xpub): der Betreiber des Knotens sieht alle abgefragten Adressen der Wallet und kann sie verknüpfen; %1$s = Host(s) -->
    <string name="portfolio_address_xpub_operator">Whoever runs %1$s sees all queried addresses of this wallet and can link them to each other and to your IP address.</string>
    <!-- Folgesatz zu portfolio_address_xpub_operator, nur ohne eigenen Server: Verweis auf die Einstellung (Pfad Einstellungen › Portfolio › Titel der Karte) -->
    <string name="portfolio_address_xpub_own_server_hint">To avoid this, enter your own server under Settings › Portfolio › Own server for addresses.</string>
</resources>
