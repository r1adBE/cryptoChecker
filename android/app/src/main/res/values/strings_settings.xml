    <string name="settings_depeg_alarm">Report USDT depeg</string>
    <string name="settings_depeg_alarm_hint">Notifies once when USDT drifts from 1 USD by the threshold (Kraken USDT/USD, Coinbase USDT/USD, Binance USDC/USDT).</string>
    <string name="settings_depeg_threshold">Depeg threshold</string>
    <string name="settings_fng_above">Fear &amp; Greed: notify above</string>
    <string name="settings_fng_below">Fear &amp; Greed: notify below</string>
    <string name="settings_gas_alert_hint">Notifies once when the normal fee drops below the limit. Checked during price updates, at most every 10 minutes.</string>
    <string name="settings_gas_btc_below">Bitcoin fee below (sat/vB)</string>
    <string name="settings_gas_eth_below">Ethereum gas below (gwei)</string>
    <string name="settings_ind_ath_within">Drop from all-time high at most</string>
    <string name="settings_ind_mayer_above">Mayer Multiple above</string>
    <string name="settings_ind_mayer_below">Mayer Multiple below</string>
    <string name="settings_ind_mvrv_above">MVRV above</string>
    <string name="settings_ind_mvrv_below">MVRV below</string>
    <string name="settings_indicator_alerts_hint">Bitcoin indicators, checked twice a day. You choose the limits – the app does not rate the values.</string>
    <string name="settings_macro_notifications">Economic calendar</string>
    <string name="settings_macro_notifications_hint">At 08:00 on days with important US economic data (inflation, jobs report, Fed decision). The calendar comes from the app\'s website, loaded once a day.</string>
