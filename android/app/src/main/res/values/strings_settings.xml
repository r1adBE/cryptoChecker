    <!-- Einstellungen › Merkliste (Namen, Sparkline, Aktivität) -->
    <string name="settings_activity_alerts">Notable: notify</string>
    <string name="settings_activity_alerts_hint">At most once an hour per pair: unusual price moves, volume spikes and futures extremes (data from Binance).</string>
    <string name="settings_activity_sensitivity">Sensitivity</string>
    <string name="settings_activity_sensitivity_hint">How easily a coin counts as unusual – the same for the watchlist card and market alerts. With “Less”, the card shows only the 3 strongest.</string>
    <string name="settings_watchlist_activity_card">Notable: show in the list</string>
    <string name="settings_watchlist_activity_card_hint">Shows the ⚡ chip next to the groups: tap it to see only the pairs where something is happening right now. Notifications for it are set under Market alerts.</string>
    <string name="settings_watchlist_names">Show names</string>
    <string name="settings_watchlist_names_hint">Name under the pair, e.g. Bitcoin or NVIDIA. Comes with the logo lists, loaded once for all coins.</string>
    <string name="settings_watchlist_sparkline">Mini chart in watchlist</string>
    <string name="settings_watchlist_sparkline_hint">24-hour trend next to the price</string>
    <string name="settings_watchlist_value_names">Names</string>
    <string name="settings_watchlist_value_price_only">Price only</string>
    <string name="settings_watchlist_value_sparkline">Mini chart</string>

    <!-- Einstellungen › Token & TradFi -->
    <string name="settings_asset_scope_alpha">Incl. Alpha tokens (α)</string>
    <string name="settings_asset_scope_alpha_hint">Alpha tokens: early, mostly small projects from the Binance Alpha list – often thinly traded and highly volatile.</string>
    <string name="settings_asset_scope_alpha_tradfi_hint">Belongs to Tokens. Unavailable while “TradFi only” is selected; Alpha tokens already in your watchlist stay.</string>
    <string name="settings_asset_scope_both">Tokens and TradFi</string>
    <string name="settings_asset_scope_both_hint">Everything – crypto and TradFi</string>
    <string name="settings_asset_scope_hint">Sets which pairs the selection and search show when you add pairs. Pairs already in your watchlist always stay.</string>
    <string name="settings_asset_scope_title">Tokens &amp; TradFi</string>
    <string name="settings_asset_scope_tokens">Tokens only</string>
    <string name="settings_asset_scope_tokens_hint">Crypto: spot and perpetuals</string>
    <string name="settings_asset_scope_tradfi">TradFi only</string>
    <string name="settings_asset_scope_tradfi_hint">Futures on stocks, commodities, FX – contracts, not tokens</string>
    <string name="settings_rolling_futures">Incl. quarterly &amp; other dated futures</string>
    <string name="settings_rolling_futures_hint">Off: dated futures missing from the exchange list are marked as no longer traded instead of being checked one by one. Saves time on every refresh.</string>
    <string name="settings_rolling_futures_qtly">Incl. quarterly &amp; other dated futures (QTLY)</string>
    <string name="settings_rolling_futures_tradfi_hint">Belongs to Tokens. Unavailable while “TradFi only” is selected; still applies to dated futures already in your watchlist.</string>
    <string name="settings_tradfi_futures">Stocks, commodities and FX (TradFi)</string>
    <string name="settings_tradfi_futures_hint">Also shows futures on stocks, gold and other commodities, currencies and pre-IPO companies when you pick a pair. These are contracts, not tokens.</string>

    <!-- Einstellungen › Darstellung (Theme, Akzent, Kontrast, Kursfarben, Coin-Logos, Sprache) -->
    <string name="settings_accent">Accent color</string>
    <string name="settings_accent_hint">Color for the app, widgets and app icon. Some home screens remove the icon when it changes – add it again then.</string>
    <!-- Schalter für App, Portfolio und Widgets. Kurzwert «Portfolio»/«Widgets» = portfolio_title/settings_widgets, «Aus» = option_off -->
    <string name="settings_coin_logos">Coin logos</string>
    <string name="settings_coin_logos_app">In the app</string>
    <string name="settings_coin_logos_app_hint">Watchlist, opened pair and market cards</string>
    <string name="settings_coin_logos_footer">Logos come from CoinGecko, and from Binance for coins CoinGecko doesn\'t list (e.g. gold, silver, stocks). The app loads all logos at once and keeps them on this device, so neither provider can tell which coins you follow. Coins without a logo show their initials. Favorites get a small star on the logo. Where a switch is off, neither logos nor initials appear; with all switches off, nothing is loaded.</string>
    <string name="settings_coin_logos_portfolio">In the portfolio</string>
    <string name="settings_coin_logos_portfolio_hint">Positions, coin details and insights</string>
    <string name="settings_coin_logos_value_app">App</string>
    <string name="settings_coin_logos_widgets">In widgets</string>
    <string name="settings_coin_logos_widgets_hint">Watchlist and single-coin widgets</string>
    <string name="settings_high_contrast">High contrast</string>
    <string name="settings_high_contrast_hint">Stronger price colors and darker secondary text. Also on when the system asks for more contrast.</string>
    <string name="settings_language_choose">Choose language</string>
    <string name="settings_language_system">System language</string>
    <string name="settings_price_colors">Price colors</string>
    <string name="settings_price_colors_hint">Blue / orange is easy to tell apart with every color vision deficiency (red-green and blue-yellow). The direction is always shown with + / − as well.</string>
    <string name="settings_theme_mode">Light / Dark</string>
    <string name="settings_widgets">Widgets</string>

    <!-- Einstellungen › %-Änderung -->
    <!-- Einstellungszeile und Seitentitel «%-Änderung»; %1$s ist das Prozentzeichen «%» -->
    <string name="settings_change_basis">%1$s change &amp; chart time zone</string>
    <string name="settings_change_basis_hint_1">The chosen time zone sets from when the percentage change counts (watchlist, pulse line, opened pair, widgets) and the times shown in the charts.</string>
    <string name="settings_change_basis_hint_2">“%1$s” compares with the price exactly 24 hours ago. “00:00” compares with the opening price at midnight in that time zone.</string>
    <string name="settings_change_basis_hint_3">Alerts are not affected.</string>
    <string name="settings_change_basis_hint_since_last">“%1$s” compares with the price of the previous update. With live prices it stays close to 0%%.</string>
    <!-- Zeitraum («24h», «heute», «letzter Stand») neben der Pille zeigen, ab Werk aus -->
    <string name="settings_change_period">Show period next to the change</string>
    <string name="settings_change_period_hint">Small “24h”, “today” or “last update” next to the change in the pulse line and the single-coin widget. The watchlist always shows it; screen readers always say it.</string>

    <!-- Einstellungen › Portfolio (Währung, Kostenmethode, Sperre, Systemsicherung) -->
    <string name="settings_conversion_currency">Conversion currency</string>
    <string name="settings_conversion_currency_hint">Also used for the portfolio, alerts in your currency, the crypto market card and the portfolio widget.</string>
    <string name="settings_cost_method">Cost method</string>
    <string name="settings_cost_method_average">Average cost</string>
    <string name="settings_cost_method_average_hint">Sells are valued at the moving average buy price.</string>
    <string name="settings_cost_method_fifo">FIFO (default)</string>
    <string name="settings_cost_method_fifo_hint">Oldest coins are sold first, across all exchanges and wallets.</string>
    <string name="settings_cost_method_fifo_wallet">FIFO per wallet/exchange</string>
    <string name="settings_cost_method_fifo_wallet_hint">Oldest coins first within each exchange or wallet; transfers move lots with their purchase date.</string>
    <string name="settings_portfolio_lock">Portfolio lock</string>
    <string name="settings_portfolio_lock_footer">The lock hides what’s shown on screen. Your data is stored on this device and is protected by the device encryption. You can protect backups with a password.</string>
    <string name="settings_portfolio_lock_hint">Hides only the portfolio: unlock with fingerprint, face or device PIN. Locks again after more than a minute in the background. Watchlist, alerts and other widgets stay open.</string>
    <string name="settings_portfolio_lock_no_device_lock">Without a device PIN or passcode the lock hides nothing – set up a screen lock.</string>
    <!-- «Portfolio in Systemsicherung» (eigene Portfolio-Datenbank, PortfolioBackupMirror) -->
    <string name="settings_portfolio_system_backup">Portfolio in system backup</string>
    <string name="settings_portfolio_system_backup_hint">Off: your transactions stay out of the device’s system backup and phone-to-phone transfers. To move them to a new phone, use the app’s own backup with a password.</string>
    <string name="settings_portfolio_system_backup_unavailable">Needs Android 9 or later – older versions would save the portfolio unencrypted in the Google backup.</string>
    <string name="settings_portfolio_tab">Show Portfolio tab</string>
    <string name="settings_portfolio_value_locked">On, with lock</string>
    <string name="settings_show_converted">Converted prices</string>
    <string name="settings_show_converted_hint">Shows prices in the watchlist also in %1$s</string>

