    <!-- Verschlüsselter Speicher: Schlüssel verloren (Build 59) -->
    <string name="storage_recovery_message">이 기기에 앱의 암호화된 데이터 키가 더 이상 없어 앱이 빈 상태로 시작되었습니다. 삭제된 것은 없습니다. 목록과 포트폴리오를 되찾으려면 설정의 “%1$s”에서 백업 파일을 가져오세요.</string>
    <string name="storage_recovery_title">저장된 데이터를 잠금 해제할 수 없습니다</string>
