<?xml version="1.0" encoding="utf-8"?>
<!-- Hintergrund aller Startbildschirm-Widgets: weisse Fläche mit runden Ecken als Bild einer
     ImageView unter dem Inhalt. Farbe und Deckkraft setzt der Code (setColorFilter /
     setImageAlpha, WidgetUpdater.background) — das geht in RemoteViews ab API 26, anders als
     eine Tönung des View-Hintergrunds (setBackgroundTintList erst ab API 31). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_background_radius" />
    <solid android:color="#FFFFFFFF" />
</shape>
