<?xml version="1.0" encoding="utf-8"?>
<!-- Durchsichtiger Hintergrund der Widget-Wurzel (@android:id/background): liefert nur die
     runde Umrisslinie für clipToOutline (ab Android 12) und die Startanimation des Launchers.
     Sichtbar ist die Fläche darunter (drawable/widget_background, eingefärbt im Code). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_background_radius" />
    <solid android:color="@android:color/transparent" />
</shape>
