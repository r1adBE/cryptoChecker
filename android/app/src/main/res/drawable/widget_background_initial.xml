<?xml version="1.0" encoding="utf-8"?>
<!-- Hintergrund des ersten Auftritts (android:initialLayout) aller Startbildschirm-Widgets: Farbe des Themas «System»
     (hell/dunkel über values-night), Deckkraft und Ecken wie später gezeichnet. Beim ersten Zeichnen setzt
     WidgetToolkit.background das Bild auf drawable/widget_background zurück und färbt es ein. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_background_radius" />
    <solid android:color="@color/widget_initial_background" />
</shape>
