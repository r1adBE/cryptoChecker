<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau des Listen-Widgets im Auswahlmenü (previewLayout, ab Android 12): statisch wie
     widget_list.xml / widget_list_item.xml mit drei Beispielpaaren (K4: keine angeschnittene vierte Zeile), Standard-Palette
     (dunkel, Akzent ORANGE): Veränderung als farbiger Text «↗ +2.31%», Währung klein und grau,
     neutrale Trennlinie. Nur RemoteViews-taugliche Views, keine IDs, kein Code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp">
        <!-- Kopfzeile 48 dp (Tippflächen) statt 44 dp + 4 dp Abstand: gleich hoch, Knopf-Symbol gleich gross -->

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_app_logo_orange_dark"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/tab_watchlist"
            android:textColor="@color/widget_preview_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/widget_preview_list_time_duration"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp"
            android:fontFeatureSettings="tnum" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_preview_text"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_btc_pair"
                        android:textColor="@color/widget_preview_text"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_market"
                        android:textColor="@color/widget_preview_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Kurs, Währung klein und grau daneben (wie WidgetToolkit.quoteText, 14 sp → 11 sp) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_btc_price_value"
                            android:textColor="@color/widget_preview_text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFeatureSettings="tnum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_quote_usdt"
                            android:textColor="@color/widget_preview_text_secondary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_btc_change"
                        android:textColor="@color/widget_preview_up"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_preview_divider"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_eth_pair"
                        android:textColor="@color/widget_preview_text"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_market"
                        android:textColor="@color/widget_preview_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Kurs, Währung klein und grau daneben (wie WidgetToolkit.quoteText, 14 sp → 11 sp) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_eth_price_value"
                            android:textColor="@color/widget_preview_text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFeatureSettings="tnum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_quote_usdt"
                            android:textColor="@color/widget_preview_text_secondary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_eth_change"
                        android:textColor="@color/widget_preview_up"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_preview_divider"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- UselessParent: gleicher Aufbau wie die übrigen Vorschauzeilen (Zeile plus Rahmen mit Abständen) -->
            <LinearLayout
                tools:ignore="UselessParent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_sol_pair"
                        android:textColor="@color/widget_preview_text"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_preview_market"
                        android:textColor="@color/widget_preview_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Kurs, Währung klein und grau daneben (wie WidgetToolkit.quoteText, 14 sp → 11 sp) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_sol_price_value"
                            android:textColor="@color/widget_preview_text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFeatureSettings="tnum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_quote_usdt"
                            android:textColor="@color/widget_preview_text_secondary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_sol_change"
                        android:textColor="@color/widget_preview_down"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
