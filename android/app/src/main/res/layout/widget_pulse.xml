<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Was gerade auffällt» (Crypto Pulse, Stil wie die anderen Widgets): Schlagzeile mit
     ↗/↘ in der Kursfarbe, Leitsatz (höchstens 2 Zeilen), Fear & Greed (mittel/gross), Coin-Chips
     BTC/ETH/SOL (nur so viele, wie ganz passen), Stand; gross darunter «Kurz gesagt». Inhalt setzt WidgetUpdater.updatePulse. Nur RemoteViews-taugliche Views.
     Runde Ecken: Wurzel mit @android:id/background und Umriss (ab 12 clipToOutline), darunter
     die eingefärbte Fläche. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true"
    tools:targetApi="31">

    <!-- Fläche mit runden Ecken; Farbe und Deckkraft setzt WidgetUpdater.background -->
    <ImageView
        android:id="@+id/pulse_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/pulse_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- UseCompoundDrawables: Logo als eigene 16-dp-ImageView, die der Renderer per RemoteViews setzt; als Compound-Drawable sähe es anders aus -->
        <LinearLayout
            tools:ignore="UseCompoundDrawables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <ImageView
                android:id="@+id/pulse_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_app_logo_orange_dark"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/pulse_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/pulse_now_title"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pulse_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pulse_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/pulse_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="12sp" />

            <!-- «Fear & Greed 72 · Gier» aus dem Zwischenspeicher (≤ 24 h), nur mit Platz
                 (PulseWidgetMath.sideLayout); passt es, mit der Marktbreite in derselben Zeile -->
            <TextView
                android:id="@+id/pulse_fng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <!-- «Top 30 · 24h  ↗ 22  ↘ 8» als zweite Nebenzeile, wenn nicht beides in eine Zeile passt
                 und die Höhe reicht (PulseWidgetMath.sideLayout, TWO_LINES); sonst weg -->
            <TextView
                android:id="@+id/pulse_breadth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <!-- Platzhalter: hält Chips und Stand unten (FrameLayout, da <View> in RemoteViews nicht erlaubt ist) -->
            <!-- UselessLeaf: Platzhalter mit Gewicht 1 hält den Rest unten (<View> ist in RemoteViews nicht erlaubt) -->
            <!-- NestedWeights: Widget-Layout (RemoteViews, ohne ConstraintLayout); die Aufteilung geht nur mit verschachtelten Gewichten -->
            <FrameLayout
                tools:ignore="UselessLeaf,NestedWeights"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

            <!-- «24h» klein und grau vor den Chips: Zeitraum der Veränderungen (PulseWidgetRenderer) -->
            <TextView
                android:id="@+id/pulse_coins_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Coins «BTC ↗ +2.8%» als farbiger Text ohne Pille (Kürzel in der Textfarbe, Veränderung in der
                 Kursfarbe, unverändert grau); Abstand 8 dp = PulseWidgetMath.CHIP_GAP_DP -->
            <TextView
                android:id="@+id/pulse_chip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/pulse_chip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/pulse_chip_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <TextView
                android:id="@+id/pulse_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum" />

            <!-- «Kurz gesagt» (nur gross, PulseWidgetPlain): so viele ganze Sätze, wie unter den bisherigen
                 Inhalt passen, je auf einer eigenen Zeile, darunter der Hinweis; Abstände = PulseWidgetPlain -->
            <LinearLayout
                android:id="@+id/pulse_plain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pulse_plain_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/market_plain_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_plain_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pulse_plain_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pulse_plain_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pulse_plain_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/market_plain_footnote"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ohne Marktdaten: ein ruhiger Satz statt leerer Felder -->
        <TextView
            android:id="@+id/pulse_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
