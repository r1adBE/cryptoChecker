<?xml version="1.0" encoding="utf-8"?>
<!-- Portfolio-Widget (Stil wie das Einzel-Widget). Ein Layout für alle Grössen; was sichtbar
     ist, entscheidet WidgetUpdater.updatePortfolio nach der Widget-Grösse:
     klein = Gesamtwert, ≈ USDT, Uhrzeit; mittel = dazu «heute» und Wertverlauf;
     gross = dazu die grössten Positionen. Nur RemoteViews-taugliche Views. -->
<!-- Runde Ecken auf allen Android-Versionen: Wurzel mit @android:id/background und Umriss (ab 12 clipToOutline), darunter die eingefärbte Fläche -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true"
    tools:targetApi="31">

    <!-- Fläche mit runden Ecken; Farbe und Deckkraft setzt WidgetUpdater.background -->
    <ImageView
        android:id="@+id/portfolio_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/portfolio_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <ImageView
                android:id="@+id/portfolio_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_app_logo_orange_dark"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/portfolio_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_portfolio_name"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/portfolio_values"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/portfolio_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="28sp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />

            <!-- Kompakt (klein, z. B. 2 × 1): kleinerer Gesamtwert, damit «≈ … USDT» darunter passt
                 (PortfolioWidgetMath.compactBaseHeightDp); sichtbar statt portfolio_total -->
            <TextView
                android:id="@+id/portfolio_total_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="20sp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <TextView
                android:id="@+id/portfolio_usdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/portfolio_change_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/portfolio_change_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/portfolio_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum" />
            </FrameLayout>

            <ImageView
                android:id="@+id/portfolio_chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:visibility="gone" />

            <!-- Platzhalter statt des Wertverlaufs: hält Liste und Uhrzeit unten (FrameLayout, da
                 <View> in RemoteViews nicht erlaubt ist); sichtbar, solange kein Wertverlauf da ist -->
            <FrameLayout
                android:id="@+id/portfolio_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/portfolio_positions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/portfolio_pos_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/portfolio_pos_1_symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/portfolio_pos_1_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/portfolio_pos_1_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minEms="2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="11sp"
                        android:fontFeatureSettings="tnum" />

                    <FrameLayout
                        android:id="@+id/portfolio_pos_1_change_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/portfolio_pos_1_change_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/portfolio_pos_1_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/portfolio_pos_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/portfolio_pos_2_symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/portfolio_pos_2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/portfolio_pos_2_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minEms="2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="11sp"
                        android:fontFeatureSettings="tnum" />

                    <FrameLayout
                        android:id="@+id/portfolio_pos_2_change_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/portfolio_pos_2_change_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/portfolio_pos_2_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/portfolio_pos_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/portfolio_pos_3_symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/portfolio_pos_3_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/portfolio_pos_3_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minEms="2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="11sp"
                        android:fontFeatureSettings="tnum" />

                    <FrameLayout
                        android:id="@+id/portfolio_pos_3_change_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/portfolio_pos_3_change_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/portfolio_pos_3_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/portfolio_pos_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/portfolio_pos_4_symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/portfolio_pos_4_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/portfolio_pos_4_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minEms="2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="11sp"
                        android:fontFeatureSettings="tnum" />

                    <FrameLayout
                        android:id="@+id/portfolio_pos_4_change_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/portfolio_pos_4_change_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/portfolio_pos_4_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/portfolio_pos_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/portfolio_pos_5_symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/portfolio_pos_5_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/portfolio_pos_5_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minEms="2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="11sp"
                        android:fontFeatureSettings="tnum" />

                    <FrameLayout
                        android:id="@+id/portfolio_pos_5_change_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/portfolio_pos_5_change_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/portfolio_pos_5_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/portfolio_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/portfolio_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/portfolio_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="@string/widget_portfolio_empty"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
