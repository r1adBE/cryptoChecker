<?xml version="1.0" encoding="utf-8"?>
<!-- Portfolio-Widget, mittlere Stufe (breit, z. B. 4 × 2): Kopfzeile über die ganze Breite,
     darunter links Gesamtwert, Betrag, ≈ USDT und Fusszeile, rechts der Wertverlauf.
     Gleiche Ids wie widget_portfolio.xml. Nur RemoteViews-taugliche Views. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/portfolio_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/portfolio_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <include layout="@layout/widget_portfolio_header" />

        <LinearLayout
            android:id="@+id/portfolio_values"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/widget_portfolio_value_block" />

                <FrameLayout
                    android:id="@+id/portfolio_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/portfolio_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <include
                layout="@layout/widget_portfolio_chart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
