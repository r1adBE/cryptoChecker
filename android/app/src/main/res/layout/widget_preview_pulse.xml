<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau des Widgets «Was gerade auffällt» im Auswahlmenü (previewLayout, ab Android 12):
     statisch wie widget_pulse.xml mit Beispielwerten «Breite Stärke», Standard-Palette
     (dunkel, Akzent ORANGE): Fear-&-Greed-Zahl in der Textfarbe, «24h» grau vor den Coins
     (farbiger Text ohne Pille), zwei ganze Coins wie in 3 × 2 (die Marktbreite passt dort nicht neben Fear &amp; Greed). Nur RemoteViews-taugliche Views, keine IDs, kein Code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_app_logo_orange_dark"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/pulse_now_title"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/widget_preview_pulse_glyph"
            android:textColor="@color/widget_preview_up"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/pulse_headline_up"
            android:textColor="@color/widget_preview_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/pulse_lead_btc_leads"
        android:textColor="@color/widget_preview_text"
        android:textSize="12sp" />

    <!-- «Fear & Greed 72 · Gier» wie im Widget (mittel/gross) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/factor_fear_greed"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_pulse_fng"
            android:textColor="@color/widget_preview_text"
            android:textSize="12sp"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_sep"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/fng_greed"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Zeitraum der Coins (pulse_coins_period), grau -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:text="@string/widget_range_short_24h"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp" />
        <!-- «BTC ↗ …» als farbiger Text ohne Pille: Kürzel in der Textfarbe, Veränderung in der Kursfarbe -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_pulse_btc_symbol"
                android:textColor="@color/widget_preview_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="1"
                android:text="@string/widget_preview_pulse_btc_change"
                android:textColor="@color/widget_preview_up"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <!-- «ETH ↗ …» als farbiger Text ohne Pille: Kürzel in der Textfarbe, Veränderung in der Kursfarbe -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_pulse_eth_symbol"
                android:textColor="@color/widget_preview_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="1"
                android:text="@string/widget_preview_pulse_eth_change"
                android:textColor="@color/widget_preview_up"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
