<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portfolio: ganzen Coin löschen (Wischen bzw. Screenreader «Löschen»). Titel der Rückfrage, %1$s = Coin-Kürzel -->
    <string name="portfolio_coin_delete_title">Supprimer toutes les transactions de %1$s ?</string>
    <!-- Text der Rückfrage, %d = Zahl der Transaktionen, die mit dem Coin gelöscht werden (Tausch zählt bei beiden Coins) -->
    <plurals name="portfolio_coin_delete_confirm">
        <item quantity="one">%d transaction sera supprimée. Vous pourrez l\'annuler juste après.</item>
        <item quantity="many">%d transactions seront supprimées. Vous pourrez l\'annuler juste après.</item>
        <item quantity="other">%d transactions seront supprimées. Vous pourrez l\'annuler juste après.</item>
    </plurals>
    <!-- Banner nach dem Löschen (mit «Rückgängig»), %1$s = Coin-Kürzel, %2$d = Zahl der gelöschten Transaktionen -->
    <plurals name="portfolio_coin_removed">
        <item quantity="one">%1$s retiré du portefeuille (%2$d transaction)</item>
        <item quantity="many">%1$s retiré du portefeuille (%2$d transactions)</item>
        <item quantity="other">%1$s retiré du portefeuille (%2$d transactions)</item>
    </plurals>
</resources>
