    <!-- Nur iOS: Widget selbst hinzufügen (drei Schritte) -->
    <string name="widgets_ios_intro" tools:ignore="UnusedResources">iOS არ აძლევს აპებს ვიჯეტების თავად დამატების საშუალებას. ამას მხოლოდ წამი სჭირდება:</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">ხელმისაწვდომი ვიჯეტები</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">ხანგრძლივად შეეხე მთავარი ეკრანის ცარიელ ადგილს, სანამ აპები არ აკანკალდება.</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">ზემოთ შეეხე «რედაქტირება» › «ვიჯეტის დამატება» (ან «+»-ს iOS-ის ძველ ვერსიებში).</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">მოძებნე «Crypto Checker», აირჩიე ვიჯეტი და შეეხე «ვიჯეტის დამატება»-ს.</string>

