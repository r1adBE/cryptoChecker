    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">საკუთარი სერვერი მისამართებისთვის</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">მხოლოდ Bitcoin: შენი საკუთარი Esplora- ან mempool-თავსებადი სერვერი (მაგ. https://node.example/api, საჭიროა საჯაროდ სანდო სერტიფიკატი, მაგალითად Let\'s Encrypt). თუ მითითებულია, Bitcoin მისამართები და xpub გასაღებები მხოლოდ იქ მოწმდება – არასოდეს საჯარო კვანძებში, მაშინაც კი, როცა შენი სერვერი მიუწვდომელია. სხვა ქსელები საჯარო კვანძებს იყენებს. ცარიელი = საჯარო კვანძები.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoin სერვერი (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">ტესტი</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">მოწმდება…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">სერვერი პასუხობს – ბლოკი %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">სწორი პასუხი არ არის – შეამოწმე მისამართი და სერტიფიკატი</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">გამოიყენება: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">არ არის მითითებული – გამოიყენება საჯარო კვანძები</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">დაშვებულია მხოლოდ https:// მისამართები</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">მისამართში არ უნდა იყოს მომხმარებლის სახელი ან პაროლი</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">მისამართში არ უნდა იყოს ? ან # ნაწილი</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">სერვერის სწორი მისამართი არ არის</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">გადავიდე საჯარო კვანძებზე?</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">შენი Bitcoin მისამართები და xpub გასაღებები მაშინ საჯარო კვანძებში მოწმდება: %1$s. ისინი ამ მისამართებს შენს IP მისამართთან ერთად ხედავენ.</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">საჯარო კვანძების გამოყენება</string>
