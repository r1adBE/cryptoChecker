<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">سرور خودت برای آدرس‌ها</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">فقط بیت‌کوین: سرور خودت که با Esplora یا mempool سازگار است (مثلاً https://node.example/api، گواهی مورد اعتماد عمومی مانند Let\'s Encrypt لازم است). اگر تنظیم شده باشد، آدرس‌های بیت‌کوین و xpub فقط از همان‌جا پرسیده می‌شوند – هرگز از گره‌های عمومی، حتی وقتی سرورت در دسترس نیست. شبکه‌های دیگر همچنان از گره‌های عمومی استفاده می‌کنند. خالی = گره‌های عمومی.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">سرور بیت‌کوین (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">آزمایش</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">در حال آزمایش…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">سرور پاسخ می‌دهد – بلوک %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">پاسخ معتبری نیامد – آدرس و گواهی را بررسی کن</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">در حال استفاده: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">تنظیم نشده – از گره‌های عمومی استفاده می‌شود</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">فقط آدرس‌های https:// مجازند</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">نام کاربری یا گذرواژه در آدرس نباشد</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">بخش ? یا # در آدرس نباشد</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">آدرس سرور معتبر نیست</string>
    <!-- Portfolio › Adressen: Status einer Bitcoin-Adresse, wenn der eigene Server nicht liefert (statt «Aktualisierung fehlgeschlagen»; kein Rückfall auf öffentliche Knoten) -->
    <string name="portfolio_address_server_failed">سرور خودت در دسترس نیست</string>
    <!-- Datenschutz-Hinweis zu xpub/Deskriptor (auch Zustimmung vor dem ersten xpub): der Betreiber des Knotens sieht alle abgefragten Adressen der Wallet und kann sie verknüpfen; %1$s = Host(s) -->
    <string name="portfolio_address_xpub_operator">هر کس %1$s را اداره می‌کند، همهٔ آدرس‌های پرسیده‌شدهٔ این کیف پول را می‌بیند و می‌تواند آن‌ها را به هم و به آدرس IP تو ربط دهد.</string>
    <!-- Folgesatz zu portfolio_address_xpub_operator, nur ohne eigenen Server: Verweis auf die Einstellung (Pfad Einstellungen › Portfolio › Titel der Karte) -->
    <string name="portfolio_address_xpub_own_server_hint">برای جلوگیری از این، سرور خودت را در تنظیمات › پرتفوی › سرور خودت برای آدرس‌ها وارد کن.</string>
</resources>
