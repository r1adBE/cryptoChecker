    <!-- Verschlüsselter Speicher: Schlüssel verloren -->
    <string name="storage_recovery_message">此裝置上已沒有應用程式加密資料的金鑰，因此應用程式以空白狀態啟動。沒有刪除任何內容。要找回清單和投資組合，請在設定的「%1$s」中匯入備份檔案。</string>
    <string name="storage_recovery_title">無法解鎖已儲存的資料</string>

    <!-- Sicherung mit Passwort (Argon2id, 64 MiB): zu wenig Arbeitsspeicher -->
    <string name="backup_not_enough_memory">可用記憶體不足，無法用密碼保護或開啟備份。請關閉其他應用程式後重試。</string>

    <!-- Portfolio-Speicher, Sicherung, Steuer-Export, Sperre -->
    <string name="storage_recovery_restore_action">還原備份</string>
    <string name="storage_recovery_acknowledge">知道了</string>
    <string name="storage_recovery_restored_title">已儲存的資料重新解鎖</string>
    <string name="storage_recovery_restored_message">本裝置之前的一個金鑰重新開啟了被擱置的資料，資料已還原。在此期間儲存的資料原樣保留在旁邊。</string>
    <string name="settings_reset_notice_title">設定已重設</string>
    <string name="settings_reset_notice">無法讀取設定，已還原為預設值。請檢查投資組合鎖、提醒間隔和貨幣。</string>
    <string name="backup_restore_interrupted_title">還原被中斷</string>
    <string name="backup_restore_interrupted_rolled_back">還原備份時應用程式被關閉。之前的資料已寫回；未保留備份中的任何內容。</string>
    <string name="backup_restore_interrupted_incomplete">還原備份時應用程式被關閉，之前的資料未能完全寫回。請檢查自選清單和投資組合，或在設定的「%1$s」中重新還原備份。</string>
    <string name="backup_not_verified">儲存後無法驗證備份檔案——讀回的內容不一致。請將備份儲存到新檔案。</string>

    <!-- Hinweis (nur Android): Portfolio-Kopie aus der Systemsicherung auch beim zweiten Versuch unlesbar und gelöscht -->
    <string name="system_backup_not_imported_title">未能從系統備份還原投資組合</string>
    <!-- %1$s = Name des Bereichs «Sichern &amp; Wiederherstellen» in den Einstellungen -->
    <string name="system_backup_not_imported_message">來自 Android 系統備份的投資組合副本在第二次嘗試時仍無法讀取，已被刪除。如果你有備份檔案，請在設定的「%1$s」中還原。</string>

    <!-- Verschlüsselte Datei da, Schlüssel gerade nicht lesbar: Portfolio für diesen Lauf nur im Arbeitsspeicher (EncryptingOpenHelperFactory, OpenPlan.KEEP_FILE_IN_MEMORY); Banner im Portfolio statt portfolio_storage_in_memory -->
    <string name="portfolio_storage_kept_in_memory">暫時無法讀取已儲存的資料，因此投資組合不會顯示，也無法更改。請重新啟動應用程式。</string>
    <!-- Dasselbe für die Merkliste (Hauptdatenbank): Banner in der Merkliste -->
    <string name="watchlist_storage_kept_in_memory">暫時無法讀取已儲存的資料，因此自選清單不會顯示，也無法更改。請重新啟動應用程式。</string>
    <string name="watchlist_storage_locked">無法更改自選清單：暫時無法讀取已儲存的資料。請重新啟動應用程式。</string>
    <string name="alarm_save_storage_locked">無法儲存提醒：暫時無法讀取已儲存的資料。請重新啟動應用程式。</string>
    <!-- Sichern/Einspielen abgelehnt, solange ein gespeicherter Stand nur leer im Arbeitsspeicher steht (BackupStorageKeptException) -->
    <string name="backup_storage_kept">無法備份：暫時無法讀取已儲存的資料。請重新啟動應用程式後再試。</string>
    <string name="backup_restore_storage_in_memory">目前無法匯入：應用程式暫時不儲存資料（加密尚未啟用），匯入的內容會在重新啟動後遺失。請重新啟動應用程式後再試。</string>
    <!-- Einspielen abgelehnt, bevor etwas ersetzt wird: Journal (Sicherheitskopie des bisherigen Stands) nicht geschrieben, Schlüssel gerade nicht verfügbar (BackupJournalUnavailableException, iOS Failure.journalUnavailable) -->
    <string name="backup_restore_journal_unavailable">暫時無法匯入：無法儲存你目前資料的安全副本（金鑰暫時不可用）。未做任何更改。請稍後重試或重新啟動應用程式。</string>

    <!-- Portfolio ohne Schlüssel nur im Arbeitsspeicher (EncryptingOpenHelperFactory, Decision.Refused): Banner im Portfolio -->
    <string name="portfolio_storage_in_memory">加密尚未啟用——投資組合不會被儲存，關閉應用程式後更改將遺失。應用程式會在下次啟動時重試。</string>

    <!-- Schreibweg des Nutzers abgelehnt, solange das gespeicherte Portfolio gesperrt ist (PortfolioStorageLock: Transaktion, Löschen, Adressen, Einstandsposten) -->
    <string name="portfolio_storage_locked">暫時無法讀取已儲存的資料，因此無法進行更改。請重新啟動應用程式。</string>
    <!-- Merkliste ohne Schlüssel nur im Arbeitsspeicher (Android: Decision.Refused, iOS: watchlistSavePending): Dauerhinweis in der Merkliste -->
    <string name="watchlist_storage_in_memory">此裝置暫時無法提供金鑰——自選清單不會被儲存，關閉應用程式後更改將遺失。背景提醒已暫停。應用程式會在下次啟動時重試。</string>

    <!-- Wiederherstellen: Sicherung ohne Passwort wollte den eigenen Bitcoin-Server setzen, ersetzen oder löschen; er blieb (BackupRestorePolicy.addressServerNote KEPT) -->
    <string name="backup_restore_server_kept">未還原「地址專用的自有伺服器」——未加密的備份無法更改它。</string>
    <!-- Wiederherstellen: Sicherung mit Passwort ohne eigenen Bitcoin-Server hat den bisherigen entfernt (PUBLIC) -->
    <string name="backup_restore_server_public">已按備份移除「地址專用的自有伺服器」——比特幣地址重新向公共節點查詢。</string>
    <!-- Wiederherstellen: Sicherung mit Passwort hat den bisherigen eigenen Bitcoin-Server ersetzt (CHANGED) -->
    <string name="backup_restore_server_changed">已將「地址專用的自有伺服器」替換為備份中的伺服器。</string>
</resources>
