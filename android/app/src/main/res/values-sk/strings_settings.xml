    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Vlastný server pre adresy</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Iba Bitcoin: tvoj vlastný server kompatibilný s Esplora alebo mempool (napr. https://node.example/api, potrebný verejne dôveryhodný certifikát, napríklad Let\'s Encrypt). Ak je nastavený, adresy Bitcoin a kľúče xpub sa dopytujú iba tam – nikdy na verejných uzloch, ani keď je tvoj server nedostupný. Ostatné siete naďalej používajú verejné uzly. Prázdne = verejné uzly.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Server Bitcoin (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Otestovať</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Testuje sa…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Server odpovedá – blok %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Žiadna platná odpoveď – skontroluj adresu a certifikát</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Používa sa: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Nenastavený – používajú sa verejné uzly</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Povolené sú iba adresy https://</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">V adrese nesmie byť meno používateľa ani heslo</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">V adrese nesmie byť časť ? alebo #</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Nie je platná adresa servera</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">Prepnúť na verejné uzly?</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">Tvoje adresy Bitcoin a kľúče xpub sa potom budú dopytovať na verejných uzloch: %1$s. Tie vidia tieto adresy spolu s tvojou IP adresou.</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">Použiť verejné uzly</string>
