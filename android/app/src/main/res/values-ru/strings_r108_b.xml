<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Свой сервер для адресов</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, gültiges Zertifikat nötig, kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Только Bitcoin: твой собственный сервер, совместимый с Esplora или mempool (например, https://node.example/api, нужен действительный сертификат). Если он задан, адреса Bitcoin и xpub запрашиваются только там – никогда у публичных узлов, даже если твой сервер недоступен. Другие сети по-прежнему используют публичные узлы. Пусто = публичные узлы.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Сервер Bitcoin (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Проверить</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Проверка…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Сервер отвечает – блок %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Нет корректного ответа – проверь адрес и сертификат</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Используется: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Не задан – используются публичные узлы</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Разрешены только адреса https://</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Без имени пользователя и пароля в адресе</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Без части ? или # в адресе</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Недопустимый адрес сервера</string>
    <!-- Portfolio › Adressen: Status einer Bitcoin-Adresse, wenn der eigene Server nicht liefert (statt «Aktualisierung fehlgeschlagen»; kein Rückfall auf öffentliche Knoten) -->
    <string name="portfolio_address_server_failed">Свой сервер недоступен</string>
    <!-- Datenschutz-Hinweis zu xpub/Deskriptor (auch Zustimmung vor dem ersten xpub): der Betreiber des Knotens sieht alle abgefragten Adressen der Wallet und kann sie verknüpfen; %1$s = Host(s) -->
    <string name="portfolio_address_xpub_operator">Тот, кто управляет %1$s, видит все запрошенные адреса этого кошелька и может связать их друг с другом и с твоим IP-адресом.</string>
    <!-- Folgesatz zu portfolio_address_xpub_operator, nur ohne eigenen Server: Verweis auf die Einstellung (Pfad Einstellungen › Portfolio › Titel der Karte) -->
    <string name="portfolio_address_xpub_own_server_hint">Чтобы избежать этого, укажи свой сервер в разделе Настройки › Портфель › Свой сервер для адресов.</string>
</resources>
