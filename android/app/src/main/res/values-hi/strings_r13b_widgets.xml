    <string name="widgets_manual_title">विजेट खुद जोड़ें</string>
    <string name="widgets_manual_text">आपकी होम स्क्रीन ऐप से विजेट नहीं जोड़ सकती। होम स्क्रीन पर किसी खाली जगह को दबाकर रखें, “विजेट” चुनें और “Crypto Checker” खोजें।</string>

    <string name="widgets_ios_intro" tools:ignore="UnusedResources">iOS ऐप्स को खुद विजेट जोड़ने नहीं देता। इसमें बस एक पल लगता है:</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">होम स्क्रीन पर किसी खाली जगह को तब तक दबाकर रखें जब तक ऐप्स हिलने न लगें।</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">ऊपर “संपादित करें” › “विजेट जोड़ें” पर टैप करें (पुराने iOS वर्शन में “+” पर)।</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">“Crypto Checker” खोजें, कोई विजेट चुनें और “विजेट जोड़ें” पर टैप करें।</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">उपलब्ध विजेट</string>
</resources>
