    <string name="backup_restore_over_limits">超出上限（%3$s 個交易對、每個交易對 %4$s 個提示），唔會還原：%1$s、%2$s。</string>
    <string name="backup_restored_over_limits">超出上限（%3$s 個交易對、每個交易對 %4$s 個提示），未還原：%1$s、%2$s。</string>

    <!-- Verschlüsselter Speicher: Schlüssel verloren -->
    <string name="storage_recovery_message">呢部裝置已經冇咗 App 加密資料嘅金鑰，所以 App 以空白狀態啟動。乜都冇刪除。如要取回自選清單同投資組合，請喺設定嘅「%1$s」匯入備份檔案。</string>
    <string name="storage_recovery_title">無法解鎖已儲存嘅資料</string>

    <!-- Sicherung mit Passwort (Argon2id, 64 MiB): zu wenig Arbeitsspeicher -->
    <string name="backup_not_enough_memory">冇足夠可用記憶體用密碼保護或開啟備份。請關閉其他 App 再試。</string>

    <!-- Portfolio-Speicher, Sicherung, Steuer-Export, Sperre -->
    <string name="storage_recovery_restore_action">還原備份</string>
    <string name="storage_recovery_acknowledge">明白</string>
    <string name="storage_recovery_restored_title">已重新解鎖已儲存嘅資料</string>
    <string name="storage_recovery_restored_message">呢部裝置上一條較早嘅金鑰重新開啟咗擱置嘅資料，所以資料返嚟咗。期間儲存嘅資料原封不動保留喺旁邊。</string>
    <string name="settings_reset_notice_title">設定已重設</string>
    <string name="settings_reset_notice">無法讀取你嘅設定，已重設為預設值。請檢查投資組合鎖、提示間隔同貨幣。</string>
    <string name="backup_restore_interrupted_title">還原被中斷</string>
    <string name="backup_restore_interrupted_rolled_back">還原備份期間 App 被關閉。你之前嘅資料已經放返；備份嘅內容一樣都冇保留。</string>
    <string name="backup_restore_interrupted_incomplete">還原備份期間 App 被關閉，之前嘅資料亦未能完整放返。請檢查你嘅自選清單同投資組合，或者喺設定嘅「%1$s」重新還原備份。</string>
    <string name="backup_not_verified">備份檔案儲存後無法驗證 – 讀返出嚟唔一樣。請將備份儲存去一個新檔案。</string>

    <!-- Hinweis (nur Android): Portfolio-Kopie aus der Systemsicherung auch beim zweiten Versuch unlesbar und gelöscht -->
    <string name="system_backup_not_imported_title">投資組合未有從系統備份還原</string>
    <!-- %1$s = Name des Bereichs «Sichern &amp; Wiederherstellen» in den Einstellungen -->
    <string name="system_backup_not_imported_message">Android 系統備份入面嘅投資組合副本試咗第二次都讀唔到，已經刪除。如果你有備份檔案，請喺設定嘅「%1$s」還原。</string>

    <!-- Verschlüsselte Datei da, Schlüssel gerade nicht lesbar: Portfolio für diesen Lauf nur im Arbeitsspeicher (EncryptingOpenHelperFactory, OpenPlan.KEEP_FILE_IN_MEMORY); Banner im Portfolio statt portfolio_storage_in_memory -->
    <string name="portfolio_storage_kept_in_memory">暫時讀唔到已儲存嘅資料，所以投資組合唔會顯示，亦無法更改。請重新啟動 App。</string>
    <!-- Dasselbe für die Merkliste (Hauptdatenbank): Banner in der Merkliste -->
    <string name="watchlist_storage_kept_in_memory">暫時讀唔到已儲存嘅資料，所以自選清單唔會顯示，亦無法更改。請重新啟動 App。</string>
    <string name="watchlist_storage_locked">無法更改自選清單：暫時讀唔到已儲存嘅資料。請重新啟動 App。</string>
    <string name="alarm_save_storage_locked">無法儲存提示：暫時讀唔到已儲存嘅資料。請重新啟動 App。</string>
    <!-- Sichern/Einspielen abgelehnt, solange ein gespeicherter Stand nur leer im Arbeitsspeicher steht (BackupStorageKeptException) -->
    <string name="backup_storage_kept">無法備份：暫時讀唔到已儲存嘅資料。請重新啟動 App 再試。</string>
    <string name="backup_restore_storage_in_memory">暫時無法匯入：App 而家冇儲存資料（加密未啟用），所以匯入嘅內容重新啟動後會消失。請重新啟動 App 再試。</string>
    <!-- Einspielen abgelehnt, bevor etwas ersetzt wird: Journal (Sicherheitskopie des bisherigen Stands) nicht geschrieben, Schlüssel gerade nicht verfügbar (BackupJournalUnavailableException, iOS Failure.journalUnavailable) -->
    <string name="backup_restore_journal_unavailable">暫時無法匯入：無法儲存你目前資料嘅安全副本（暫時攞唔到金鑰）。乜都冇改。請稍後再試或者重新啟動 App。</string>

    <!-- Portfolio ohne Schlüssel nur im Arbeitsspeicher (EncryptingOpenHelperFactory, Decision.Refused): Banner im Portfolio -->
    <string name="portfolio_storage_in_memory">加密未啟用 – 投資組合冇儲存，App 關閉後更改會消失。App 下次啟動時會再試。</string>

    <!-- Schreibweg des Nutzers abgelehnt, solange das gespeicherte Portfolio gesperrt ist (PortfolioStorageLock: Transaktion, Löschen, Adressen, Einstandsposten) -->
    <string name="portfolio_storage_locked">暫時讀唔到已儲存嘅資料，所以無法更改。請重新啟動 App。</string>
    <!-- Merkliste ohne Schlüssel nur im Arbeitsspeicher (Android: Decision.Refused, iOS: watchlistSavePending): Dauerhinweis in der Merkliste -->
    <string name="watchlist_storage_in_memory">呢部裝置暫時冇提供金鑰 – 自選清單冇儲存，App 關閉後更改會消失。背景提示已暫停。App 下次啟動時會再試。</string>

    <!-- Wiederherstellen: Sicherung ohne Passwort wollte den eigenen Bitcoin-Server setzen, ersetzen oder löschen; er blieb (BackupRestorePolicy.addressServerNote KEPT) -->
    <string name="backup_restore_server_kept">未有套用「地址用嘅自家伺服器」– 未加密嘅備份無法更改佢。</string>
    <!-- Wiederherstellen: Sicherung mit Passwort ohne eigenen Bitcoin-Server hat den bisherigen entfernt (PUBLIC) -->
    <string name="backup_restore_server_public">已按備份移除「地址用嘅自家伺服器」– Bitcoin 地址會重新喺公開節點查詢。</string>
    <!-- Wiederherstellen: Sicherung mit Passwort hat den bisherigen eigenen Bitcoin-Server ersetzt (CHANGED) -->
    <string name="backup_restore_server_changed">「地址用嘅自家伺服器」已換成備份入面嗰個。</string>
</resources>
