<?xml version="1.0" encoding="utf-8"?>
<!-- tools:targetApi: targetCellWidth/-Height, previewLayout und widgetFeatures wirken erst ab Android 12 bzw. 9;
     ältere Versionen übergehen sie bewusst (dort gelten minWidth/minHeight und previewImage). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_list"
    android:configure="com.cryptochecker.app.widget.WidgetConfigureActivity"
    android:previewImage="@drawable/widget_preview_list_img"
    android:previewLayout="@layout/widget_preview_list"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
