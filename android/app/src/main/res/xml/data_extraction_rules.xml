<?xml version="1.0" encoding="utf-8"?>
<!-- Ab Android 12 (android:dataExtractionRules). Gleicher Umfang wie backup_rules.xml
     (bis Android 11) — bei Änderungen beide anpassen. -->
<data-extraction-rules>
    <!-- Ohne Ende-zu-Ende-Verschlüsselung (keine Bildschirmsperre) keine Cloud-Sicherung:
         Merkliste, Portfolio-Kopie und Einstellungen nicht unverschlüsselt in die Cloud. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Merkliste, Alarme, Gruppen, Notizen: unverschlüsselte Kopie der Hauptdatenbank, die es nur während
             einer Sicherung gibt (SystemBackupAgent.EXPORT_NAME, eine Datei ohne WAL). Die Datenbank selbst
             (cryptochecker.db, seit Build 59 verschlüsselt) steht bewusst NICHT hier: Ihr Schlüssel liegt im
             Keystore dieses Geräts und ginge nicht mit. Ebenso nie: Schlüsseldateien (noBackupFilesDir/db_keys),
             beiseitegelegte *.unreadable, MarketDatabase.db (Altbestand). -->
        <include domain="database" path="cryptochecker_system_backup.db" />
        <!-- Nur für die Wiederherstellung alter Sicherungen (bis Build 58: cryptochecker.db-wal), die der Agent
             hierhin umleitet (SystemBackupAgent.onRestoreFile); beim Sichern gibt es die Datei nie. -->
        <include domain="database" path="cryptochecker_system_backup.db-wal" />
        <!-- Einstellungen (DataStore «settings», SettingsRepository) -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- Portfolio: Die eigene Datenbank (PortfolioDatabase.DB_NAME, cryptochecker_portfolio.db)
             steht bewusst NICHT hier. Nur mit dem Schalter «Portfolio in Systemsicherung» gibt es
             diese Kopie (PortfolioBackupMirror.FILE_NAME); aus = Datei gelöscht = nicht gesichert. -->
        <include domain="file" path="portfolio_system_backup.json" />
        <!-- SharedPreferences mit Nutzerdaten: App-Sprache, Favoriten, Portfolio (Übernahme-Marke,
             damit der alte Bestand nach einer Wiederherstellung nicht doppelt übernommen wird) -->
        <include domain="sharedpref" path="app_language.xml" />
        <include domain="sharedpref" path="favorites.xml" />
        <include domain="sharedpref" path="portfolio.xml" />
        <!-- Nicht gesichert (nur ausdrücklich Eingeschlossenes wird gesichert):
             Zwischenspeicher und flüchtiger Zustand — activity, refresh_stats, starter_coins,
             market_zone, macro_notify, gas_alerts; Widget-Zuordnung und -Momentaufnahme
             (widgets, portfolio_widget: Widget-Ids gelten nur auf diesem Gerät); Zyklus-/Makro-
             Zwischenspeicher liegen in cacheDir. Die App-Sperre speichert kein Geheimnis
             (Biometrie/Geräte-Sperre des Systems), nur den Schalter in den Einstellungen. -->
    </cloud-backup>
    <device-transfer>
        <!-- Merkliste, Alarme, Gruppen, Notizen: unverschlüsselte Kopie der Hauptdatenbank, die es nur während
             einer Sicherung gibt (SystemBackupAgent.EXPORT_NAME, eine Datei ohne WAL). Die Datenbank selbst
             (cryptochecker.db, seit Build 59 verschlüsselt) steht bewusst NICHT hier: Ihr Schlüssel liegt im
             Keystore dieses Geräts und ginge nicht mit. Ebenso nie: Schlüsseldateien (noBackupFilesDir/db_keys),
             beiseitegelegte *.unreadable, MarketDatabase.db (Altbestand). -->
        <include domain="database" path="cryptochecker_system_backup.db" />
        <!-- Nur für die Wiederherstellung alter Sicherungen (bis Build 58: cryptochecker.db-wal), die der Agent
             hierhin umleitet (SystemBackupAgent.onRestoreFile); beim Sichern gibt es die Datei nie. -->
        <include domain="database" path="cryptochecker_system_backup.db-wal" />
        <!-- Einstellungen (DataStore «settings», SettingsRepository) -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- Portfolio: Die eigene Datenbank (PortfolioDatabase.DB_NAME, cryptochecker_portfolio.db)
             steht bewusst NICHT hier. Nur mit dem Schalter «Portfolio in Systemsicherung» gibt es
             diese Kopie (PortfolioBackupMirror.FILE_NAME); aus = Datei gelöscht = nicht gesichert. -->
        <include domain="file" path="portfolio_system_backup.json" />
        <!-- SharedPreferences mit Nutzerdaten: App-Sprache, Favoriten, Portfolio (Übernahme-Marke,
             damit der alte Bestand nach einer Wiederherstellung nicht doppelt übernommen wird) -->
        <include domain="sharedpref" path="app_language.xml" />
        <include domain="sharedpref" path="favorites.xml" />
        <include domain="sharedpref" path="portfolio.xml" />
        <!-- Nicht gesichert (nur ausdrücklich Eingeschlossenes wird gesichert):
             Zwischenspeicher und flüchtiger Zustand — activity, refresh_stats, starter_coins,
             market_zone, macro_notify, gas_alerts; Widget-Zuordnung und -Momentaufnahme
             (widgets, portfolio_widget: Widget-Ids gelten nur auf diesem Gerät); Zyklus-/Makro-
             Zwischenspeicher liegen in cacheDir. Die App-Sperre speichert kein Geheimnis
             (Biometrie/Geräte-Sperre des Systems), nur den Schalter in den Einstellungen. -->
    </device-transfer>
</data-extraction-rules>
