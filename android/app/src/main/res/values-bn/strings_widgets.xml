    <!-- Nur iOS: Widget selbst hinzufügen (drei Schritte) -->
    <string name="widgets_ios_intro" tools:ignore="UnusedResources">iOS অ্যাপকে নিজে উইজেট যোগ করতে দেয় না। এক মুহূর্তের কাজ:</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">উপলব্ধ উইজেট</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">হোম স্ক্রিনের একটি খালি জায়গায় চেপে ধরুন যতক্ষণ না অ্যাপগুলো নড়তে থাকে।</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">উপরে “সম্পাদনা” › “উইজেট যোগ করুন”-এ ট্যাপ করুন (বা পুরোনো iOS সংস্করণে “+”)।</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">“Crypto Checker” খুঁজুন, একটি উইজেট বেছে নিন এবং “উইজেট যোগ করুন”-এ ট্যাপ করুন।</string>

