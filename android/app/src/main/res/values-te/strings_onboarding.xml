<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Begrüssung beim ersten Start -->
    <string name="welcome_alert">అలర్ట్‌లను సెట్ చేయండి – ధర, శాతం, వాల్యూమ్, అసాధారణ కదలికలు</string>
    <string name="welcome_alert_q">ఎప్పుడు అలర్ట్ చేయాలి?</string>
    <string name="welcome_text">మీ ధరలు. మీ అలర్ట్‌లు. మీ అవలోకనం.\nఖాతా అవసరం లేదు. ప్రకటనలు లేవు. ట్రాకింగ్ లేదు.</string>
    <string name="welcome_understand">అర్థం చేసుకోండి – ప్రస్తుతం ఒక ధరతో పాటు ఏది కదులుతోంది</string>
    <string name="welcome_understand_q">దానితో పాటు ఏది కదులుతోంది?</string>
    <string name="welcome_watch">గమనించండి – మీ కాయిన్‌లు, ధరలు, ధర చరిత్ర</string>
    <string name="welcome_watch_q">ఏం జరుగుతోంది?</string>

    <!-- Start-Coins (Vorschlagsliste nach der Begrüssung) -->
    <string name="starter_add_selected">వాచ్‌లిస్ట్‌కు జోడించు (%1$d)</string>
    <string name="starter_loading_prices">ధరలు లోడ్ అవుతున్నాయి…</string>
    <string name="starter_search_coin">మరో కాయిన్ కోసం వెతకండి</string>
    <string name="starter_select_all">అన్నీ ఎంచుకో</string>
    <string name="starter_select_none">ఏదీ ఎంచుకోవద్దు</string>
    <string name="starter_title">ఈ కాయిన్‌లతో ప్రారంభించండి</string>
    <string name="starter_watch_alarm_hint">ధరను గమనించండి, అలర్ట్‌ను సెట్ చేయండి</string>

    <!-- Start-Auswahl: Börse und Quote der Startpaare (Binance, bei Standort-Sperre Binance.US), z. B. «Kurse von Binance in USDT. …» -->
    <string name="starter_source_text">%1$s నుండి %2$sలో ధరలు. మీకు వద్దనుకున్నవాటి ఎంపికను తీసివేసి, మిగిలినవాటిని ఒకేసారి జోడించండి. ప్రతి కాయిన్‌కు ఎక్స్ఛేంజ్‌ను, జతను మార్చవచ్చు.</string>
</resources>
