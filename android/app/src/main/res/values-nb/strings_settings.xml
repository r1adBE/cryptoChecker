    <!-- Einstellungen › %-Änderung -->
    <!-- Einstellungszeile und Seitentitel «%-Änderung»; %1$s ist das Prozentzeichen «%» -->
    <string name="settings_change_basis">Endring i %1$s og graf-tidssone</string>
    <string name="settings_change_basis_hint_1">Den valgte tidssonen bestemmer fra når den prosentvise endringen regnes (overvåkingsliste, pulslinje, åpnet par, widgeter), og hvilke klokkeslett grafene viser.</string>
    <string name="settings_change_basis_hint_2">«%1$s» sammenligner med kursen for nøyaktig 24 timer siden. «00:00» sammenligner med åpningskursen ved midnatt i denne tidssonen.</string>
    <string name="settings_change_basis_hint_3">Alarmer påvirkes ikke.</string>
    <string name="settings_change_basis_hint_since_last">«%1$s» sammenligner med kursen fra forrige oppdatering. Med livekurser holder den seg nær 0 %%.</string>
    <!-- Zeitraum («24h», «heute», «letzter Stand») neben der Pille zeigen, ab Werk aus -->
    <string name="settings_change_period">Vis periode ved endringen</string>
    <string name="settings_change_period_hint">Liten «24h», «i dag» eller «siste oppdatering» ved endringen i overvåkingslisten og i widgeten med én mynt. Skjermleseren sier den alltid.</string>

