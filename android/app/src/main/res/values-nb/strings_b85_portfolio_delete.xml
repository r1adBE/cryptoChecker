<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portfolio: ganzen Coin löschen (Wischen bzw. Screenreader «Löschen»). Titel der Rückfrage, %1$s = Coin-Kürzel -->
    <string name="portfolio_coin_delete_title">Slette alle transaksjoner for %1$s?</string>
    <!-- Text der Rückfrage, %d = Zahl der Transaktionen, die mit dem Coin gelöscht werden (Tausch zählt bei beiden Coins) -->
    <plurals name="portfolio_coin_delete_confirm">
        <item quantity="one">%d transaksjon blir fjernet. Du kan angre det rett etterpå.</item>
        <item quantity="other">%d transaksjoner blir fjernet. Du kan angre det rett etterpå.</item>
    </plurals>
    <!-- Banner nach dem Löschen (mit «Rückgängig»), %1$s = Coin-Kürzel, %2$d = Zahl der gelöschten Transaktionen -->
    <plurals name="portfolio_coin_removed">
        <item quantity="one">%1$s fjernet fra porteføljen (%2$d transaksjon)</item>
        <item quantity="other">%1$s fjernet fra porteføljen (%2$d transaksjoner)</item>
    </plurals>
</resources>
