<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portfolio: ganzen Coin löschen (Wischen bzw. Screenreader «Löschen»). Titel der Rückfrage, %1$s = Coin-Kürzel -->
    <string name="portfolio_coin_delete_title">Poistetaanko kaikki kohteen %1$s tapahtumat?</string>
    <!-- Text der Rückfrage, %d = Zahl der Transaktionen, die mit dem Coin gelöscht werden (Tausch zählt bei beiden Coins) -->
    <plurals name="portfolio_coin_delete_confirm">
        <item quantity="one">%d tapahtuma poistetaan. Voit perua sen heti perään.</item>
        <item quantity="other">%d tapahtumaa poistetaan. Voit perua sen heti perään.</item>
    </plurals>
    <!-- Banner nach dem Löschen (mit «Rückgängig»), %1$s = Coin-Kürzel, %2$d = Zahl der gelöschten Transaktionen -->
    <plurals name="portfolio_coin_removed">
        <item quantity="one">%1$s poistettu salkusta (%2$d tapahtuma)</item>
        <item quantity="other">%1$s poistettu salkusta (%2$d tapahtumaa)</item>
    </plurals>
</resources>
