    <!-- Verschlüsselter Speicher: Schlüssel verloren (Build 59) -->
    <string name="storage_recovery_message">此设备上已没有应用加密数据的密钥，因此应用以空白状态启动。没有删除任何内容。要找回列表和投资组合，请在设置的「%1$s」中导入备份文件。</string>
    <string name="storage_recovery_title">无法解锁已保存的数据</string>

    <!-- Sicherung mit Passwort (Argon2id, 64 MiB): zu wenig Arbeitsspeicher -->
    <string name="backup_not_enough_memory">可用内存不足，无法用密码保护或打开备份。请关闭其他应用后重试。</string>

    <!-- Build 76: Portfolio-Speicher, Sicherung, Steuer-Export, Sperre -->
    <string name="storage_recovery_restore_action">恢复备份</string>
    <string name="storage_recovery_acknowledge">知道了</string>
    <string name="storage_recovery_restored_title">已保存的数据重新解锁</string>
    <string name="storage_recovery_restored_message">本设备之前的一个密钥重新打开了被搁置的数据，数据已恢复。在此期间保存的数据原样保留在旁边。</string>
    <string name="settings_reset_notice_title">设置已重置</string>
    <string name="settings_reset_notice">无法读取设置，已恢复为默认值。请检查投资组合锁、提醒间隔和货币。</string>
    <string name="backup_restore_interrupted_title">恢复被中断</string>
    <string name="backup_restore_interrupted_rolled_back">恢复备份时应用被关闭。之前的数据已写回；未保留备份中的任何内容。</string>
    <string name="backup_restore_interrupted_incomplete">恢复备份时应用被关闭，之前的数据未能完全写回。请检查自选列表和投资组合，或在设置的“%1$s”中重新恢复备份。</string>
    <string name="backup_not_verified">保存后无法验证备份文件——读回的内容不一致。请将备份保存到新文件。</string>

    <!-- Hinweis (nur Android): Portfolio-Kopie aus der Systemsicherung auch beim zweiten Versuch unlesbar und gelöscht -->
    <string name="system_backup_not_imported_title">未能从系统备份恢复投资组合</string>
    <!-- %1$s = Name des Bereichs «Sichern &amp; Wiederherstellen» in den Einstellungen -->
    <string name="system_backup_not_imported_message">来自 Android 系统备份的投资组合副本在第二次尝试时仍无法读取，已被删除。如果你有备份文件，请在设置的“%1$s”中恢复。</string>

    <!-- Verschlüsselte Datei da, Schlüssel gerade nicht lesbar: Portfolio für diesen Lauf nur im Arbeitsspeicher (EncryptingOpenHelperFactory, OpenPlan.KEEP_FILE_IN_MEMORY); Banner im Portfolio statt portfolio_storage_in_memory -->
    <string name="portfolio_storage_kept_in_memory">暂时无法读取已保存的数据，因此投资组合不会显示，也无法更改。请重启应用。</string>
    <!-- Dasselbe für die Merkliste (Hauptdatenbank): Banner in der Merkliste -->
    <string name="watchlist_storage_kept_in_memory">暂时无法读取已保存的数据，因此自选列表不会显示，也无法更改。请重启应用。</string>
    <string name="watchlist_storage_locked">无法更改自选列表：暂时无法读取已保存的数据。请重启应用。</string>
    <string name="alarm_save_storage_locked">无法保存提醒：暂时无法读取已保存的数据。请重启应用。</string>
    <!-- Sichern/Einspielen abgelehnt, solange ein gespeicherter Stand nur leer im Arbeitsspeicher steht (BackupStorageKeptException) -->
    <string name="backup_storage_kept">无法备份：暂时无法读取已保存的数据。请重启应用后再试。</string>
    <string name="backup_restore_storage_in_memory">目前无法导入：应用暂时不保存数据（加密尚未启用），导入的内容会在重启后丢失。请重新启动应用后再试。</string>
    <!-- Einspielen abgelehnt, bevor etwas ersetzt wird: Journal (Sicherheitskopie des bisherigen Stands) nicht geschrieben, Schlüssel gerade nicht verfügbar (BackupJournalUnavailableException, iOS Failure.journalUnavailable); seit Build 102 -->
    <string name="backup_restore_journal_unavailable">暂时无法导入：无法保存你当前数据的安全副本（密钥暂时不可用）。未做任何更改。请稍后重试或重新启动应用。</string>

    <!-- Portfolio ohne Schlüssel nur im Arbeitsspeicher (EncryptingOpenHelperFactory, Decision.Refused): Banner im Portfolio -->
    <string name="portfolio_storage_in_memory">加密尚未启用——投资组合不会被保存，关闭应用后更改将丢失。应用会在下次启动时重试。</string>

    <!-- Schreibweg des Nutzers abgelehnt, solange das gespeicherte Portfolio gesperrt ist (PortfolioStorageLock: Transaktion, Löschen, Adressen, Einstandsposten) -->
    <string name="portfolio_storage_locked">暂时无法读取已保存的数据，因此无法进行更改。请重启应用。</string>
    <!-- Merkliste ohne Schlüssel nur im Arbeitsspeicher (Android: Decision.Refused, iOS: watchlistSavePending): Dauerhinweis in der Merkliste -->
    <string name="watchlist_storage_in_memory">此设备暂时无法提供密钥——自选列表不会被保存，关闭应用后更改将丢失。后台提醒已暂停。应用会在下次启动时重试。</string>
</resources>
