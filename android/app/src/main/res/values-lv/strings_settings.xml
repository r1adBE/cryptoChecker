    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Savs serveris adresēm</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Tikai Bitcoin: tavs savs Esplora vai mempool saderīgs serveris (piem., https://node.example/api, nepieciešams publiski uzticams sertifikāts, piemēram, Let\'s Encrypt). Ja iestatīts, Bitcoin adreses un xpub atslēgas tiek pieprasītas tikai tur – nekad publiskajos mezglos, pat ja tavs serveris nav sasniedzams. Citi tīkli turpina izmantot publiskos mezglus. Tukšs = publiskie mezgli.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoin serveris (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Pārbaudīt</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Pārbauda…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Serveris atbild – bloks %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Nav derīgas atbildes – pārbaudi adresi un sertifikātu</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Lietošanā: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Nav iestatīts – tiek izmantoti publiskie mezgli</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Atļautas tikai https:// adreses</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Adresē nedrīkst būt lietotājvārds vai parole</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Adresē nedrīkst būt ? vai # daļa</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Nav derīga servera adrese</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">Pārslēgties uz publiskajiem mezgliem?</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">Tavas Bitcoin adreses un xpub atslēgas tad tiks pieprasītas publiskajos mezglos: %1$s. Tie redz šīs adreses kopā ar tavu IP adresi.</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">Izmantot publiskos mezglus</string>
