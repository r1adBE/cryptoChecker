<resources>
    <!-- Begrüssung beim ersten Start -->
    <string name="welcome_alert">അലേർട്ടുകൾ സജ്ജമാക്കുക – വില, ശതമാനം, വോളിയം, അസാധാരണ നീക്കങ്ങൾ</string>
    <string name="welcome_alert_q">എപ്പോൾ അറിയിക്കണം?</string>
    <string name="welcome_text">നിങ്ങളുടെ വിലകൾ. നിങ്ങളുടെ അലേർട്ടുകൾ. നിങ്ങളുടെ അവലോകനം.\nഅക്കൗണ്ടില്ല. പരസ്യങ്ങളില്ല. ട്രാക്കിംഗില്ല.</string>
    <string name="welcome_understand">മനസ്സിലാക്കുക – ഇപ്പോൾ ഒരു വിലയ്‌ക്കൊപ്പം എന്തെല്ലാം നീങ്ങുന്നു</string>
    <string name="welcome_understand_q">ഒപ്പം എന്താണ് നീങ്ങുന്നത്?</string>
    <string name="welcome_watch">നിരീക്ഷിക്കുക – നിങ്ങളുടെ കോയിനുകൾ, വിലകൾ, വില ചരിത്രം</string>
    <string name="welcome_watch_q">എന്താണ് സംഭവിക്കുന്നത്?</string>

    <!-- Start-Coins (Vorschlagsliste nach der Begrüssung) -->
    <string name="starter_add_selected">വാച്ച്‌ലിസ്റ്റിലേക്ക് ചേർക്കുക (%1$d)</string>
    <string name="starter_loading_prices">വിലകൾ ലോഡ് ചെയ്യുന്നു…</string>
    <string name="starter_search_coin">മറ്റൊരു കോയിൻ തിരയുക</string>
    <string name="starter_select_all">എല്ലാം തിരഞ്ഞെടുക്കുക</string>
    <string name="starter_select_none">ഒന്നും തിരഞ്ഞെടുക്കാതിരിക്കുക</string>
    <string name="starter_title">ഈ കോയിനുകളിൽ നിന്ന് തുടങ്ങുക</string>
    <string name="starter_watch_alarm_hint">വില നിരീക്ഷിക്കുക, അലേർട്ട് സജ്ജമാക്കുക</string>

    <!-- Start-Auswahl: Börse und Quote der Startpaare (Binance, bei Standort-Sperre Binance.US), z. B. «Kurse von Binance in USDT. …» -->
    <string name="starter_source_text">%1$s-ൽ നിന്നുള്ള വിലകൾ, %2$s-ൽ. വേണ്ടാത്തവ ഒഴിവാക്കി ബാക്കിയുള്ളവ ഒറ്റയടിക്ക് ചേർക്കുക. ഓരോ കോയിനിന്റെയും എക്സ്ചേഞ്ചും ജോഡിയും നിങ്ങൾക്ക് മാറ്റാം.</string>
