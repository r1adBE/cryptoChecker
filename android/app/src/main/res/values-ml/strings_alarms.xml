    <!-- Futures- und Volumen-Alarme (Funding pro 8 Stunden, Open Interest, Volumen-Spike) -->
    <!-- Funding-Schwelle gilt pro 8 Stunden; stündliches Funding wird umgerechnet -->
    <string name="alarm_funding_hint_8h">8 മണിക്കൂറിനുള്ള ഫണ്ടിംഗ് നിരക്ക്. മറ്റൊരു ഇടവേളയുള്ള കോൺട്രാക്റ്റുകൾ പരിവർത്തനം ചെയ്യുന്നു (1 മ. × 8, 4 മ. × 2); ഫ്യൂച്ചേഴ്സ് കാർഡ് പരിവർത്തനം ചെയ്ത മൂല്യം കാണിക്കുന്നു. ഇടവേള അജ്ഞാതമെങ്കിൽ, അലേർട്ട് പരിശോധിക്കില്ല. നെഗറ്റീവ് എങ്കിൽ ഷോർട്ടുകൾ ലോംഗുകൾക്ക് നൽകുന്നു. ± ചിഹ്നം മാറ്റുന്നു.</string>
    <string name="alarm_funding_sign_a11y">ചിഹ്നം മാറ്റുക</string>
