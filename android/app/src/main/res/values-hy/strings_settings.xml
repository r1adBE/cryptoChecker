    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Սեփական սերվեր հասցեների համար</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Միայն Bitcoin՝ քո սեփական Esplora- կամ mempool-համատեղելի սերվերը (օր.՝ https://node.example/api, պահանջվում է հանրորեն վստահելի վկայագիր, օրինակ՝ Let\'s Encrypt)։ Եթե սահմանված է, Bitcoin հասցեներն ու xpub բանալիները հարցվում են միայն այնտեղ – երբեք հանրային հանգույցներում, նույնիսկ երբ քո սերվերը հասանելի չէ։ Այլ ցանցերը շարունակում են օգտագործել հանրային հանգույցներ։ Դատարկ = հանրային հանգույցներ։</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoin սերվեր (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Փորձել</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Փորձարկվում է…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Սերվերը պատասխանում է – բլոկ %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Վավեր պատասխան չկա – ստուգիր հասցեն և վկայագիրը</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Օգտագործվում է՝ %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Սահմանված չէ – օգտագործվում են հանրային հանգույցներ</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Թույլատրված են միայն https:// հասցեներ</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Հասցեում օգտանուն կամ գաղտնաբառ չպետք է լինի</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Հասցեում ? կամ # մաս չպետք է լինի</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Վավեր սերվերի հասցե չէ</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">Անցնե՞լ հանրային հանգույցներին</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">Քո Bitcoin հասցեներն ու xpub բանալիներն այդ դեպքում կհարցվեն հանրային հանգույցներում՝ %1$s։ Նրանք տեսնում են այդ հասցեները քո IP հասցեի հետ միասին։</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">Օգտագործել հանրային հանգույցներ</string>
