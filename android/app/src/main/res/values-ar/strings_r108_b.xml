<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">خادم خاص للعناوين</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">بيتكوين فقط: خادمك الخاص المتوافق مع Esplora أو mempool (مثل https://node.example/api، ويلزم شهادة موثوقة علنًا مثل Let\'s Encrypt). عند ضبطه تُستعلم عناوين بيتكوين وxpub منه فقط – ولا تُرسل أبدًا إلى عُقد عامة، حتى إن تعذّر الوصول إلى خادمك. تستخدم الشبكات الأخرى العُقد العامة كما في السابق. فارغ = عُقد عامة.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">خادم بيتكوين (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">اختبار</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">جارٍ الاختبار…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">الخادم يستجيب – الكتلة %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">لا توجد استجابة صالحة – تحقّق من العنوان والشهادة</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">قيد الاستخدام: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">غير مضبوط – تُستخدم العُقد العامة</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">يُسمح بعناوين https:// فقط</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">بدون اسم مستخدم أو كلمة مرور في العنوان</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">بدون جزء ? أو # في العنوان</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">عنوان الخادم غير صالح</string>
    <!-- Portfolio › Adressen: Status einer Bitcoin-Adresse, wenn der eigene Server nicht liefert (statt «Aktualisierung fehlgeschlagen»; kein Rückfall auf öffentliche Knoten) -->
    <string name="portfolio_address_server_failed">تعذّر الوصول إلى الخادم الخاص</string>
    <!-- Datenschutz-Hinweis zu xpub/Deskriptor (auch Zustimmung vor dem ersten xpub): der Betreiber des Knotens sieht alle abgefragten Adressen der Wallet und kann sie verknüpfen; %1$s = Host(s) -->
    <string name="portfolio_address_xpub_operator">من يشغّل %1$s يرى كل العناوين المستعلَم عنها من هذه المحفظة ويمكنه ربطها ببعضها وبعنوان IP الخاص بك.</string>
    <!-- Folgesatz zu portfolio_address_xpub_operator, nur ohne eigenen Server: Verweis auf die Einstellung (Pfad Einstellungen › Portfolio › Titel der Karte) -->
    <string name="portfolio_address_xpub_own_server_hint">لتجنّب ذلك أدخل خادمك الخاص من الإعدادات › المحفظة › خادم خاص للعناوين.</string>
</resources>
