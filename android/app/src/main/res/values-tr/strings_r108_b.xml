<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Adresler için kendi sunucun</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, gültiges Zertifikat nötig, kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Yalnızca Bitcoin: kendi Esplora veya mempool uyumlu sunucun (ör. https://node.example/api, geçerli sertifika gerekir). Ayarlıysa Bitcoin adresleri ve xpub’lar yalnızca orada sorgulanır – sunucuna ulaşılamasa bile asla herkese açık düğümlerde değil. Diğer ağlar herkese açık düğümleri kullanmaya devam eder. Boş = herkese açık düğümler.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoin sunucusu (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Test et</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Test ediliyor…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Sunucu yanıt veriyor – blok %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Geçerli yanıt yok – adresi ve sertifikayı kontrol et</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Kullanımda: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Ayarlanmadı – herkese açık düğümler kullanılıyor</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Yalnızca https:// adreslerine izin verilir</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Adreste kullanıcı adı veya parola olmasın</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Adreste ? veya # kısmı olmasın</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Geçerli bir sunucu adresi değil</string>
    <!-- Portfolio › Adressen: Status einer Bitcoin-Adresse, wenn der eigene Server nicht liefert (statt «Aktualisierung fehlgeschlagen»; kein Rückfall auf öffentliche Knoten) -->
    <string name="portfolio_address_server_failed">Kendi sunucuna ulaşılamıyor</string>
    <!-- Datenschutz-Hinweis zu xpub/Deskriptor (auch Zustimmung vor dem ersten xpub): der Betreiber des Knotens sieht alle abgefragten Adressen der Wallet und kann sie verknüpfen; %1$s = Host(s) -->
    <string name="portfolio_address_xpub_operator">%1$s hizmetini işleten, bu cüzdanın sorgulanan tüm adreslerini görür ve bunları birbirine ve IP adresine bağlayabilir.</string>
    <!-- Folgesatz zu portfolio_address_xpub_operator, nur ohne eigenen Server: Verweis auf die Einstellung (Pfad Einstellungen › Portfolio › Titel der Karte) -->
    <string name="portfolio_address_xpub_own_server_hint">Bunu önlemek için kendi sunucunu Ayarlar › Portföy › Adresler için kendi sunucun bölümüne gir.</string>
</resources>
