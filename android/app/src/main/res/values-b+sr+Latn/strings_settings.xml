    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Sopstveni server za adrese</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Samo Bitkoin: tvoj sopstveni server kompatibilan s Esplora-om ili mempool-om (npr. https://node.example/api, potreban je javno pouzdan sertifikat, poput Let\'s Encrypt-a). Ako je postavljen, Bitkoin adrese i xpub ključevi preuzimaju se samo tamo – nikada s javnih čvorova, čak ni kada tvoj server nije dostupan. Ostale mreže i dalje koriste javne čvorove. Prazno = javni čvorovi.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitkoin server (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Testiraj</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Testiranje…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Server odgovara – blok %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Nema važećeg odgovora – proveri adresu i sertifikat</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">U upotrebi: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Nije postavljeno – koriste se javni čvorovi</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Dozvoljene su samo https:// adrese</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Bez korisničkog imena i lozinke u adresi</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Bez dela ? ili # u adresi</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Nije važeća adresa servera</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">Preći na javne čvorove?</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">Tvoje Bitkoin adrese i xpub ključevi tada će se preuzimati s javnih čvorova: %1$s. Oni vide te adrese zajedno s tvojom IP adresom.</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">Koristi javne čvorove</string>
