    <string name="widgets_manual_title">הוסיפו את הווידג׳ט בעצמכם</string>
    <string name="widgets_manual_text">מסך הבית שלכם לא יכול להוסיף ווידג׳טים מתוך האפליקציה. לחצו לחיצה ארוכה על מקום ריק במסך הבית, בחרו ״ווידג׳טים״ וחפשו ״Crypto Checker״.</string>

    <string name="widgets_ios_intro" tools:ignore="UnusedResources">ב־iOS אפליקציות לא יכולות להוסיף ווידג׳טים בעצמן. זה לוקח רק רגע:</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">לחצו לחיצה ארוכה על מקום ריק במסך הבית עד שהאפליקציות מתחילות לרעוד.</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">הקישו למעלה על ״עריכה״ › ״הוספת וידג׳ט״ (או על ״+״ בגרסאות iOS ישנות יותר).</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">חפשו ״Crypto Checker״, בחרו ווידג׳ט והקישו על ״הוספת וידג׳ט״.</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">ווידג׳טים זמינים</string>
</resources>
