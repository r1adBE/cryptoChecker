    <string name="market_info_a11y">מידע: %1$s</string>
    <string name="market_info_alt_season_source">מחירים יומיים: Binance · מחושב מחדש בערך כל 3 שעות</string>
    <string name="market_info_alt_season_what">סופר כמה מתוך כ־20 אלטקוינים גדולים (למשל Ethereum,‏ Solana,‏ XRP) הציגו ביצועים טובים יותר מ־Bitcoin ב־90 הימים האחרונים. הערך הוא חלקם בין 0 ל־100.</string>
    <string name="market_info_coin_source">מחירים: Binance או Bybit · נטען מחדש בערך כל 15 דקות</string>
    <string name="market_info_dominance_how">כשהדומיננטיות עולה, Bitcoin מתפקד טוב יותר משאר השוק; כשהיא יורדת, מטבעות אחרים צוברים משקל. גם מטבעות יציבים נספרים: אם שוויים גדל, חלקו של Bitcoin יורד גם כשמחיר Bitcoin לא משתנה.</string>
    <string name="market_info_dominance_source">מקור: CoinGecko · נטען מחדש בערך כל 30 דקות</string>
    <string name="market_info_dominance_what">החלק של Bitcoin בשווי הכולל של כל המטבעות הקריפטוגרפיים (שווי שוק). מתחתיו מוצג החלק של Ethereum.</string>
    <string name="market_info_fear_greed_how">מתחת ל־25 פירושו פחד קיצוני, מעל 75 תאוות בצע קיצונית, סביב 50 ניטרלי. בכרטיס הפתוח מופיעים הערכים של אתמול, לפני שבוע ולפני חודש. זה לא אות קנייה או מכירה.</string>
    <string name="market_info_fear_greed_source">מקור: alternative.me · ערך חדש פעם ביום</string>
    <string name="market_info_fear_greed_what">מדד סנטימנט לשוק הקריפטו בין 0 ל־100. alternative.me מחשב אותו מכמה נתונים, בהם תנודות מחירים, נפח מסחר, רשתות חברתיות והדומיננטיות של Bitcoin.</string>
    <string name="market_info_gas_how">ערכים גבוהים יותר פירושם שהרשת עמוסה וההעברות יקרות יותר. איטי, רגיל ומהיר הם עמלות לאישור מאוחר יותר או מהיר יותר. בכרטיס הפתוח מוצגת העלות המשוערת של העברה פשוטה.</string>
    <string name="market_info_gas_source">צמתי RPC ציבוריים, mempool.space · נטען מחדש כל דקה</string>
    <string name="market_info_gas_what">כמה עולה כרגע עסקה בכל רשת. ב־Ethereum וברשתות דומות ב־gwei (חלק המיליארד של ETH ליחידת gas), ב־Bitcoin ב־sat/vB (סאטושי לבייט וירטואלי של העסקה).</string>
    <string name="market_info_halving_source">תאריך: לפי גובה הבלוק וזמן בלוק ממוצע (mempool.space), אחרת לפי לוח השנה · היסטוריית שער: Coin Metrics,‏ Binance, נטען מחדש כל 12 שעות</string>
    <string name="market_info_halving_what">בהלבינג התגמול שהכורים מקבלים על בלוק Bitcoin חדש יורד בחצי. זה קורה כל 210,000 בלוקים, כלומר בערך כל ארבע שנים. לאחר מכן נוצרים מדי יום רק חצי ממספר הביטקוינים החדשים.</string>
    <string name="market_info_how">איך לקרוא את זה</string>
    <string name="market_info_macro_how">ההודעה מופיעה רק כשמועד כזה חל היום או מחר. סביב הפרסום המחירים נוטים לתנודות חזקות מהרגיל. האפליקציה מציגה רק את המועד, לא את הנתונים עצמם.</string>
    <string name="market_info_macro_source">לוח מועדים מאתר האפליקציה · נטען פעם ביום</string>
    <string name="market_info_macro_what">מועדי נתונים כלכליים חשובים מארה״ב: אינפלציה (CPI,‏ PCE), מחירי יצרן (PPI), דוח התעסוקה והחלטות הריבית של הפדרל ריזרב. נתונים כאלה מזיזים לעיתים קרובות גם את מחירי המטבעות הקריפטוגרפיים.</string>
    <string name="market_info_no_advice">אין ייעוץ השקעות.</string>
    <string name="market_info_phase_source">Binance,‏ Coin Metrics · מחירים כל שעה, נתוני on-chain נטענים מחדש כל 12 שעות</string>
    <string name="market_info_pulse_how">הכותרת מציינת את הכיוון; בכרטיס הפתוח מופיעים הפרטים. תנועה רחבה פירושה שרוב המטבעות הגדולים נעים לאותו כיוון. אווירת מינוף אופטימית פירושה שרבים מהמרים על עליית מחירים במינוף, לפי שיעור המימון בחוזים העתידיים על Bitcoin. תמונת מצב, לא תחזית.</string>
    <string name="market_info_pulse_source">Binance,‏ CoinGecko · נטען מחדש בערך כל 5 דקות</string>
    <string name="market_info_pulse_what">סיכום קצר של השוק ב־24 השעות האחרונות: איך נעים Bitcoin,‏ Ethereum ו־Solana, כמה מהמטבעות הגדולים ביותר עולים או יורדים, כמה Bitcoin נסחר עכשיו ומהי אווירת המינוף (לפי שיעור המימון בחוזים העתידיים על Bitcoin).</string>
    <string name="market_info_totals_how">לצד הערך מוצג השינוי בשווי הכולל ב־24 שעות. נפח גבוה פירושו שנסחר הרבה, אך הוא אינו מציין את הכיוון. מוצג במטבע להמרה כשאפשר, אחרת בדולר אמריקאי.</string>
    <string name="market_info_totals_source">כל המטבעות · CoinGecko · נטען מחדש בערך כל 30 דקות</string>
    <string name="market_info_totals_what">השווי הכולל של כל המטבעות הקריפטוגרפיים (שווי שוק: מחיר כפול הכמות במחזור, מסוכם לכל המטבעות) ונפח המסחר ב־24 השעות האחרונות.</string>
    <string name="market_info_unusual_how">לכל מטבע מוצגת התצפית הבולטת ביותר, ולצידה השינוי ב־24 שעות. נפח של 2× פירושו פי שניים ממחזור המסחר הרגיל. חריג אינו אומר טוב או רע.</string>
    <string name="market_info_unusual_source">Binance,‏ CoinGecko · נטען מחדש בערך כל 10 דקות</string>
    <string name="market_info_unusual_what">עד חמישה מטבעות מתוך כ־30 הגדולים (ללא מטבעות יציבים) שמתנהגים היום באופן חריג: חזקים או חלשים בבירור מ־Bitcoin, נגד כיוון השוק, עם נפח מסחר גבוה במיוחד או עם שיעור מימון בולט.</string>
