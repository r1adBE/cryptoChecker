    <string name="settings_price_colors_inverted_hint">E kuqe për rritje, e gjelbër për rënie, siç është zakon në Kinë, Japoni, Kore dhe Tajvan. Parazgjedhja varet nga rajoni i pajisjes.</string>

    <!-- Hoher Kontrast -->
