    <string name="settings_price_colors">Ngjyrat e çmimeve</string>
    <string name="price_colors_green_red">E gjelbër / e kuqe</string>
    <string name="price_colors_blue_orange">Blu / portokalli</string>
    <string name="settings_price_colors_hint">Bluja / portokallia dallohen lehtë me çdo lloj mangësie të shikimit të ngjyrave (e kuqe-e gjelbër dhe blu-e verdhë). Drejtimi tregohet gjithmonë edhe me + / −.</string>
    <string name="settings_watchlist_sparkline">Grafik i vogël në listën e ndjekjes</string>
