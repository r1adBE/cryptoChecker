<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wiederherstellen: Sicherung ohne Passwort wollte den eigenen Bitcoin-Server setzen, ersetzen oder löschen; er blieb (BackupRestorePolicy.addressServerNote KEPT) -->
    <string name="backup_restore_server_kept">Eigener Bitcoin-Server nicht übernommen – eine unverschlüsselte Sicherung kann ihn nicht ändern.</string>
    <!-- Wiederherstellen: Sicherung mit Passwort ohne eigenen Bitcoin-Server hat den bisherigen entfernt (PUBLIC) -->
    <string name="backup_restore_server_public">Eigener Bitcoin-Server entfernt wie in der Sicherung – Bitcoin-Adressen werden wieder bei öffentlichen Knoten abgefragt.</string>
    <!-- Wiederherstellen: Sicherung mit Passwort hat den bisherigen eigenen Bitcoin-Server ersetzt (CHANGED) -->
    <string name="backup_restore_server_changed">Eigener Bitcoin-Server durch den aus der Sicherung ersetzt.</string>
    <!-- Portfolio-Adresse: Anzahl Token ohne bekannten Kurs, nicht im Wert enthalten (%1$d = Anzahl) -->
    <plurals name="portfolio_address_unknown_tokens">
        <item quantity="one">+%1$d unbekannter Token (nicht gezählt)</item>
        <item quantity="other">+%1$d unbekannte Token (nicht gezählt)</item>
    </plurals>
</resources>
