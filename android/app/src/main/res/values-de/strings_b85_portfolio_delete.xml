<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portfolio: ganzen Coin löschen (Wischen bzw. Screenreader «Löschen»). Titel der Rückfrage, %1$s = Coin-Kürzel -->
    <string name="portfolio_coin_delete_title">Alle Transaktionen von %1$s löschen?</string>
    <!-- Text der Rückfrage, %d = Zahl der Transaktionen, die mit dem Coin gelöscht werden (Tausch zählt bei beiden Coins) -->
    <plurals name="portfolio_coin_delete_confirm">
        <item quantity="one">%d Transaktion wird entfernt. Du kannst es direkt danach rückgängig machen.</item>
        <item quantity="other">%d Transaktionen werden entfernt. Du kannst es direkt danach rückgängig machen.</item>
    </plurals>
    <!-- Banner nach dem Löschen (mit «Rückgängig»), %1$s = Coin-Kürzel, %2$d = Zahl der gelöschten Transaktionen -->
    <plurals name="portfolio_coin_removed">
        <item quantity="one">%1$s aus dem Portfolio entfernt (%2$d Transaktion)</item>
        <item quantity="other">%1$s aus dem Portfolio entfernt (%2$d Transaktionen)</item>
    </plurals>
</resources>
