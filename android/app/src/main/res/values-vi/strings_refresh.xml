    <string name="battery_delay_hint">Android có thể trì hoãn việc kiểm tra – đặt pin thành «Không hạn chế»</string>
    <string name="battery_later">Để sau</string>
    <string name="battery_message">Android trì hoãn tác vụ nền để tiết kiệm pin — khi đó giá và tiện ích có thể cũ đến vài giờ. Đặt mức sử dụng pin thành không hạn chế giúp chúng luôn cập nhật. Bạn có thể thay đổi bất cứ lúc nào trong cài đặt Android.</string>
    <string name="battery_open_settings">Mở cài đặt pin</string>
    <string name="battery_steps">Trong thông tin ứng dụng, nhấn Pin (hoặc Mức sử dụng pin của ứng dụng) và chọn Không hạn chế.</string>
    <string name="battery_title">Giữ giá luôn cập nhật</string>
    <string name="ios_background_refresh_off">Làm mới ứng dụng trong nền đang tắt cho ứng dụng này. Khi tắt, cảnh báo chỉ được kiểm tra lúc ứng dụng mở.</string>
    <string name="ios_low_power_mode">Chế độ nguồn điện thấp đang bật. iOS hiếm khi kiểm tra trong nền nên cảnh báo có thể đến muộn.</string>
