    <string name="update_mode_for_pros">tốn nhiều dữ liệu và pin hơn</string>
    <string name="update_mode_live">Trực tiếp khi đang mở</string>
    <string name="update_mode_live_hint">Nếu sàn cung cấp giá trực tiếp: tức thì khi danh sách đang mở. Nếu không, ở lần tải tiếp theo. Đóng: không thường xuyên hơn mỗi %1$s, thường muộn hơn.</string>
    <string name="update_mode_live_hint_ios">Nếu sàn cung cấp giá trực tiếp: tức thì khi danh sách đang mở. Nếu không, ở lần tải tiếp theo. Đóng: khi iOS cho phép, đôi khi cách nhau hàng giờ. Nếu bạn vuốt tắt ứng dụng, iOS sẽ dừng các lần kiểm tra này cho đến khi bạn mở lại.</string>
    <string name="update_mode_recommended">khuyên dùng</string>
    <string name="update_mode_sparsam">Tiết kiệm</string>
    <string name="update_mode_sparsam_hint">Khi đóng ứng dụng, không thường xuyên hơn mỗi %1$s, thường muộn hơn (cảnh báo, widget). Khi mở: mỗi lần mở.</string>
    <string name="update_mode_sparsam_hint_ios">Khi ứng dụng đóng, iOS quyết định lúc kiểm tra (cảnh báo, tiện ích), đôi khi cách nhau hàng giờ. Mở: mỗi lần bạn mở.</string>
