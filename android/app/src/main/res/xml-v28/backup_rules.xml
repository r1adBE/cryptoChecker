<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup Android 9 bis 11 (android:fullBackupContent, xml-v28). Gleicher Umfang wie
     data_extraction_rules.xml (ab Android 12); Android 8/8.1: xml/backup_rules.xml ohne
     Portfolio-Kopie, ohne Kopie der Hauptdatenbank und ohne Einstellungen — bei Änderungen alle drei
     anpassen. -->
<full-backup-content>
    <!-- requireFlags (ab Android 9, wie disableIfNoEncryptionCapabilities ab 12): jede Datei nur
         bei Ende-zu-Ende-verschlüsselter Cloud-Sicherung (Bildschirmsperre) ODER bei der Übertragung
         Gerät zu Gerät — darum je zwei Zeilen. Android 8 kennt das Attribut nicht: dafür xml/backup_rules.xml. -->
    <!-- Merkliste, Alarme, Gruppen, Notizen: unverschlüsselte Kopie der Hauptdatenbank, die es nur während
         einer Sicherung gibt (SystemBackupAgent.EXPORT_NAME, eine Datei ohne WAL). Die Datenbank selbst
         (cryptochecker.db, verschlüsselt) steht bewusst NICHT hier: Ihr Schlüssel liegt im
         Keystore dieses Geräts und ginge nicht mit. Ebenso nie: Schlüsseldateien (noBackupFilesDir/db_keys),
         beiseitegelegte *.unreadable. -->
    <include domain="database" path="cryptochecker_system_backup.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="cryptochecker_system_backup.db" requireFlags="deviceToDeviceTransfer" />
    <!-- Einstellungen (DataStore «settings», SettingsRepository) -->
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="deviceToDeviceTransfer" />
    <!-- Portfolio: Die eigene Datenbank (PortfolioDatabase.DB_NAME, cryptochecker_portfolio.db)
         steht bewusst NICHT hier. Nur mit dem Schalter «Portfolio in Systemsicherung» gibt es
         diese Kopie (PortfolioBackupMirror.FILE_NAME); aus = Datei gelöscht = nicht gesichert. -->
    <include domain="file" path="portfolio_system_backup.json" requireFlags="clientSideEncryption" />
    <include domain="file" path="portfolio_system_backup.json" requireFlags="deviceToDeviceTransfer" />
    <!-- SharedPreferences mit Nutzerdaten: App-Sprache, Favoriten, Portfolio
         (Zwischenspeicher der Coin-Listen) -->
    <include domain="sharedpref" path="app_language.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="app_language.xml" requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="favorites.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="favorites.xml" requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="portfolio.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="portfolio.xml" requireFlags="deviceToDeviceTransfer" />
    <!-- Nicht gesichert (nur ausdrücklich Eingeschlossenes wird gesichert):
         Zwischenspeicher und flüchtiger Zustand — activity, refresh_stats, starter_coins,
         market_zone, macro_notify, gas_alerts; Widget-Zuordnung und -Momentaufnahme
         (widgets, portfolio_widget: Widget-Ids gelten nur auf diesem Gerät); Zyklus-/Makro-
         Zwischenspeicher liegen in cacheDir. Die App-Sperre speichert kein Geheimnis
         (Biometrie/Geräte-Sperre des Systems), nur den Schalter in den Einstellungen. -->
</full-backup-content>
