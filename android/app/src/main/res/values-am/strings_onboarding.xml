<resources>
    <!-- Begrüssung beim ersten Start -->
    <string name="welcome_alert">ማንቂያዎችን ያዘጋጁ – ዋጋ፣ መቶኛ፣ መጠን እና ያልተለመዱ እንቅስቃሴዎች</string>
    <string name="welcome_alert_q">መቼ ይንቃ?</string>
    <string name="welcome_text">የእርስዎ ዋጋዎች። የእርስዎ ማንቂያዎች። የእርስዎ አጠቃላይ እይታ።\nመለያ የለም። ማስታወቂያ የለም። ክትትል የለም።</string>
    <string name="welcome_understand">ይረዱ – አሁን ከአንድ ዋጋ ጋር አብሮ ምን እየተንቀሳቀሰ እንደሆነ</string>
    <string name="welcome_understand_q">አብሮ ምን እየተንቀሳቀሰ ነው?</string>
    <string name="welcome_watch">ይከታተሉ – ሳንቲሞችዎን፣ ዋጋዎችንና የዋጋ ታሪክን</string>
    <string name="welcome_watch_q">ምን እየሆነ ነው?</string>

    <!-- Start-Coins (Vorschlagsliste nach der Begrüssung) -->
