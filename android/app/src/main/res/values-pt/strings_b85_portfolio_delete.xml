<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portfolio: ganzen Coin löschen (Wischen bzw. Screenreader «Löschen»). Titel der Rückfrage, %1$s = Coin-Kürzel -->
    <string name="portfolio_coin_delete_title">Eliminar todas as transações de %1$s?</string>
    <!-- Text der Rückfrage, %d = Zahl der Transaktionen, die mit dem Coin gelöscht werden (Tausch zählt bei beiden Coins) -->
    <plurals name="portfolio_coin_delete_confirm">
        <item quantity="one">Será removida %d transação. Pode anular logo a seguir.</item>
        <item quantity="many">Serão removidas %d transações. Pode anular logo a seguir.</item>
        <item quantity="other">Serão removidas %d transações. Pode anular logo a seguir.</item>
    </plurals>
    <!-- Banner nach dem Löschen (mit «Rückgängig»), %1$s = Coin-Kürzel, %2$d = Zahl der gelöschten Transaktionen -->
    <plurals name="portfolio_coin_removed">
        <item quantity="one">%1$s removido do portfólio (%2$d transação)</item>
        <item quantity="many">%1$s removido do portfólio (%2$d transações)</item>
        <item quantity="other">%1$s removido do portfólio (%2$d transações)</item>
    </plurals>
</resources>
