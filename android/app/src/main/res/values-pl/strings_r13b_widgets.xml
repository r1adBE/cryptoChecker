    <string name="widgets_manual_text">Twój ekran główny nie może dodawać widżetów z aplikacji. Przytrzymaj puste miejsce na ekranie głównym, wybierz „Widżety” i znajdź „Crypto Checker”.</string>

    <string name="widgets_ios_intro" tools:ignore="UnusedResources">iOS nie pozwala aplikacjom samodzielnie dodawać widżetów. To zajmie tylko chwilę:</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">Przytrzymaj puste miejsce na ekranie początkowym, aż aplikacje zaczną drgać.</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">Stuknij u góry „Edycja” › „Dodaj widżet” (lub „+” w starszych wersjach iOS).</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">Wyszukaj „Crypto Checker”, wybierz widżet i stuknij „Dodaj widżet”.</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">Dostępne widżety</string>
