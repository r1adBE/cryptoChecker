    <string name="update_mode_live">Na żywo, gdy otwarta</string>
    <string name="update_mode_live_hint">Gdy giełda podaje kurs na żywo: od razu, dopóki lista jest otwarta. W przeciwnym razie przy następnym pobraniu. Zamknięta: nie częściej niż co %1$s, często później.</string>
