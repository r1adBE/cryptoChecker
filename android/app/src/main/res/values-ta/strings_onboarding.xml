<resources>
    <!-- Begrüssung beim ersten Start -->
    <string name="welcome_alert">விழிப்பூட்டல்களை அமைக்கவும் – விலை, சதவீதம், வால்யூம் மற்றும் அசாதாரண நகர்வுகள்</string>
    <string name="welcome_alert_q">எப்போது விழிப்பூட்ட வேண்டும்?</string>
    <string name="welcome_text">உங்கள் விலைகள். உங்கள் விழிப்பூட்டல்கள். உங்கள் மேலோட்டம்.\nகணக்கு இல்லை. விளம்பரங்கள் இல்லை. கண்காணிப்பு இல்லை.</string>
    <string name="welcome_understand">புரிந்துகொள்ளுங்கள் – இப்போது ஒரு விலையுடன் சேர்ந்து எது நகர்கிறது</string>
    <string name="welcome_understand_q">கூடவே எது நகர்கிறது?</string>
    <string name="welcome_watch">கவனியுங்கள் – உங்கள் காயின்கள், விலைகள் மற்றும் விலை வரலாறு</string>
    <string name="welcome_watch_q">என்ன நடக்கிறது?</string>

    <!-- Start-Coins (Vorschlagsliste nach der Begrüssung) -->
    <string name="starter_add_selected">கண்காணிப்புப் பட்டியலில் சேர் (%1$d)</string>
    <string name="starter_loading_prices">விலைகளை ஏற்றுகிறது…</string>
    <string name="starter_search_coin">வேறு காயினைத் தேடு</string>
    <string name="starter_select_all">அனைத்தையும் தேர்ந்தெடு</string>
    <string name="starter_select_none">எதையும் தேர்ந்தெடுக்காதே</string>
    <string name="starter_title">இந்தக் காயின்களுடன் தொடங்குங்கள்</string>
    <string name="starter_watch_alarm_hint">விலையைக் கவனியுங்கள், விழிப்பூட்டலை அமைக்கவும்</string>

    <!-- Start-Auswahl: Börse und Quote der Startpaare (Binance, bei Standort-Sperre Binance.US), z. B. «Kurse von Binance in USDT. …» -->
    <string name="starter_source_text">%1$s இலிருந்து %2$s இல் விலைகள். வேண்டாதவற்றின் தேர்வை நீக்கி, மீதமுள்ளவற்றை ஒரே முறையில் சேர்க்கவும். ஒவ்வொரு காயினுக்கும் எக்ஸ்சேஞ்சையும் ஜோடியையும் மாற்றலாம்.</string>
</resources>
