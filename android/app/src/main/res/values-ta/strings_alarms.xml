    <!-- Funding-Schwelle gilt pro 8 Stunden; stündliches Funding wird umgerechnet -->
    <string name="alarm_funding_hint_8h">8 மணிநேரத்துக்கான ஃபண்டிங் விகிதம். வேறு இடைவெளி உள்ள ஒப்பந்தங்கள் மாற்றப்படும் (1 ம.நே. × 8, 4 ம.நே. × 2); ஃபியூச்சர்ஸ் அட்டை மாற்றப்பட்ட மதிப்பைக் காட்டும். இடைவெளி தெரியவில்லையெனில், விழிப்பூட்டல் சரிபார்க்காது. எதிர்மறை என்றால் ஷார்ட்டுகள் லாங்குகளுக்குச் செலுத்துகின்றன. ± குறியை மாற்றும்.</string>
    <string name="alarm_funding_sign_a11y">குறியை மாற்று</string>
    <string name="alarm_oi_hint">ஓப்பன் இன்ட்ரஸ்டை அத்தனை மணிநேரத்துக்கு முன் சேமிக்கப்பட்ட மதிப்புடன் ஒப்பிடுகிறது. ஆப் அவ்வளவு நேரம் தரவைச் சேகரித்த பிறகே புதிய விழிப்பூட்டல் தெரிவிக்கும்; அதிகபட்சம் 5 நிமிடங்களுக்கு ஒருமுறை சரிபார்க்கப்படும்.</string>
    <string name="alarm_volume_factor_label">கடந்த ஒரு மணிநேர வால்யூம் vs. வழக்கமானது</string>
