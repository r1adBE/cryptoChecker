    <!-- Nur iOS: Widget selbst hinzufügen (drei Schritte) -->
    <string name="widgets_ios_intro" tools:ignore="UnusedResources">ஆப்ஸ் தாமாக விட்ஜெட்களைச் சேர்க்க iOS அனுமதிக்காது. இதற்குச் சில நொடிகளே ஆகும்:</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">கிடைக்கும் விட்ஜெட்கள்</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">ஆப்ஸ் அசையும் வரை முகப்புத் திரையில் ஒரு வெற்று இடத்தைத் தொட்டுப் பிடிக்கவும்.</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">மேலே “திருத்து” › “விட்ஜெட்டைச் சேர்” என்பதைத் தட்டவும் (பழைய iOS பதிப்புகளில் “+”).</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">“Crypto Checker” ஐத் தேடி, ஒரு விட்ஜெட்டைத் தேர்ந்தெடுத்து “விட்ஜெட்டைச் சேர்” என்பதைத் தட்டவும்.</string>

