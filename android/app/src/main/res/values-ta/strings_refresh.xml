    <!-- Einschränkungen im Hintergrund (Akku, iOS-Hintergrundaktualisierung, Stromsparmodus) -->
    <string name="battery_delay_hint">Android சரிபார்ப்புகளைத் தாமதப்படுத்தலாம் – பேட்டரியை “கட்டுப்பாடற்றது” என அமைக்கவும்</string>
    <string name="battery_later">பிறகு</string>
    <string name="battery_message">மின்சக்தியைச் சேமிக்க Android பின்னணி வேலைகளைத் தாமதப்படுத்துகிறது — அப்போது விலைகளும் விட்ஜெட்களும் மணிநேரம் பழையதாக இருக்கலாம். பேட்டரிப் பயன்பாட்டைக் கட்டுப்பாடற்றதாக அமைத்தால் அவை புதுப்பித்த நிலையில் இருக்கும். இதை Android அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.</string>
    <string name="battery_open_settings">பேட்டரி அமைப்புகளைத் திற</string>
    <string name="battery_steps">ஆப் தகவலில், பேட்டரி (அல்லது ஆப் பேட்டரிப் பயன்பாடு) என்பதைத் தட்டி கட்டுப்பாடற்றது என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="battery_title">விலைகளைப் புதுப்பித்த நிலையில் வைத்திருங்கள்</string>
    <string name="ios_background_refresh_off">இந்த ஆப்புக்குப் பின்னணி ஆப் புதுப்பிப்பு ஆஃப் செய்யப்பட்டுள்ளது. அது இல்லாமல், ஆப் திறந்திருக்கும்போது மட்டுமே விழிப்பூட்டல்கள் சரிபார்க்கப்படும்.</string>
    <string name="ios_low_power_mode">குறைந்த மின் பயன்முறை ஆன் செய்யப்பட்டுள்ளது. iOS பின்னணியில் அரிதாகவே சரிபார்க்கும், எனவே விழிப்பூட்டல்கள் தாமதமாக வரலாம்.</string>

