    <string name="why_summary_calm">குறிப்பிடத்தக்க நகர்வு இல்லை: சந்தையும் காயினும் அமைதியாக உள்ளன.</string>
    <string name="why_summary_coin">இந்தக் காயின் மட்டுமே நகர்கிறது – இந்தக் காயினை மட்டும் பாதிக்கும் ஏதாவது இருக்கலாம்.</string>
    <string name="why_summary_coin_volume">இந்தக் காயின் மட்டுமே அதிக வால்யூமுடன் நகர்கிறது – இந்தக் காயினை மட்டும் பாதிக்கும் ஏதாவது இருக்கலாம்.</string>
    <string name="why_summary_longs">ஃபியூச்சர்ஸ்: லீவரேஜுடன் பல லாங் நிலைகள்.</string>
    <string name="why_summary_market">இந்த நகர்வு நேரத்தில் ஒட்டுமொத்தச் சந்தையுடன் ஒத்துப்போகிறது.</string>
    <string name="why_summary_market_volume">இந்த நகர்வு அதிக வர்த்தக வால்யூமுடனும் பரவலாக நகரும் சந்தையுடனும் ஒரே நேரத்தில் நிகழ்கிறது.</string>
    <string name="why_summary_peg_near">விலை அதன் 1:1 பெக்குக்கு அருகில் உள்ளது.</string>
    <string name="why_summary_peg_off">விலை அதன் 1:1 பெக்கிலிருந்து குறிப்பிடத்தக்க அளவு விலகுகிறது.</string>
    <string name="why_summary_shorts">ஃபியூச்சர்ஸ்: பல ஷார்ட் நிலைகள்.</string>
    <string name="why_summary_thin">இந்த நகர்வு பலவீனமானது: பின்னால் குறைந்த வால்யூம்.</string>

