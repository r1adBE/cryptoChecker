    <!-- «Warum?»: ausführliche Sätze je Beobachtung -->
    <string name="why_against_market_text">24 ம.நே. இல் இந்தக் காயின் %1$s, BTC %2$s — குறிப்பிடத்தக்க சுயாதீன நகர்வு.</string>
    <string name="why_against_ref_text">24 ம.நே. இல் இந்தக் காயின் %1$s, %2$s %3$s — குறிப்பிடத்தக்க சுயாதீன நகர்வு.</string>
    <string name="why_btc_independent">%1$s தற்போது Bitcoin ஐச் சாராமல் நகர்கிறது.</string>
    <string name="why_btc_tight">%1$s தற்போது Bitcoin உடன் நெருக்கமாக நகர்கிறது.</string>
    <string name="why_change_1h">1 ம.நே.</string>
    <string name="why_change_24h">24 ம.நே.</string>
    <string name="why_coin_only_text">சந்தை அமைதியாக இருக்கும்போது 24 ம.நே. இல் %1$s – இந்தக் காயினை மட்டும் பாதிக்கும் ஏதாவது இருக்கலாம்.</string>
    <string name="why_leverage_balanced_text">ஃபியூச்சர்ஸ் சந்தையில் லாங் அல்லது ஷார்ட் நிலைகளின் குவிப்பு இல்லை.</string>
    <string name="why_leverage_longs_text">பலர் கடன் வாங்கிய பணத்துடன் விலை ஏறும் என்று பந்தயம் கட்டுகின்றனர். லாங்குகள் ஷார்ட்டுகளுக்குச் செலுத்துகின்றன — விலை இறங்கினால் லிக்விடேஷன் அபாயம் அதிகம்.</string>
    <string name="why_leverage_shorts_text">பலர் கடன் வாங்கிய பணத்துடன் விலை இறங்கும் என்று பந்தயம் கட்டுகின்றனர். ஷார்ட்டுகள் லாங்குகளுக்குச் செலுத்துகின்றன – விலை ஏறினால் ஷார்ட் ஸ்க்வீஸ் சாத்தியம்.</string>
    <string name="why_market_calm_text">இந்தக் காயின்: 24 ம.நே. இல் %1$s. சந்தையோ காயினோ அதிகம் நகரவில்லை.</string>
    <string name="why_market_leader_text">மிகப்பெரிய காயினாக, BTC பொதுவாக மற்ற சந்தையுடன் இணைந்து நகரும். ETH: 24 ம.நே. இல் %1$s.</string>
    <string name="why_market_leader_text_no_eth">மிகப்பெரிய காயினாக, BTC பொதுவாக மற்ற சந்தையுடன் இணைந்து நகரும்.</string>
    <string name="why_market_similar_text">இந்தக் காயின்: 24 ம.நே. இல் %1$s – அதே நேரத்தில், சந்தையும் அதே திசையில் நகர்கிறது, ஆனால் குறைவான தெளிவுடன்.</string>
    <string name="why_market_wide_text">இந்தக் காயின்: 24 ம.நே. இல் %1$s – அதே நேரத்தில், ஒட்டுமொத்தச் சந்தை தெளிவாக நகர்கிறது.</string>
    <string name="why_open_interest_change">கடைசிச் சரிபார்ப்பிலிருந்து ஓப்பன் இன்ட்ரஸ்ட் %1$s.</string>
    <string name="why_peg_text">ஸ்டேபிள்காயின்: மேற்கோள் நாணயத்துடனான 1:1 பெக்குடன் ஒப்பிடும்போது விலகல் %1$s.</string>
    <string name="why_sentiment_text">முழுக் கிரிப்டோ சந்தையின் Fear &amp; Greed குறியீடு, நேற்றுடன் ஒப்பிடும்போது %1$s.</string>
