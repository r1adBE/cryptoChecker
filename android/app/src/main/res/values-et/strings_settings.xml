    <!-- Einstellungen › Portfolio: Titel der Karte «Eigener Server für Adressen» (nur Bitcoin; Adressabfragen dann nur dorthin); auch im Pfad von portfolio_address_xpub_own_server_hint -->
    <string name="settings_address_server_title">Oma server aadresside jaoks</string>
    <!-- Erklärung unter dem Titel: nur Bitcoin, Esplora-/mempool-kompatibel, öffentlich vertrauenswürdiges Zertifikat nötig (z. B. Let's Encrypt), kein Rückfall auf öffentliche Knoten, andere Netze weiter öffentlich, leer = öffentliche Knoten -->
    <string name="settings_address_server_hint">Ainult Bitcoin: sinu enda Esplora- või mempool-ühilduv server (nt https://node.example/api, vajalik on avalikult usaldatav sertifikaat, näiteks Let\'s Encrypt). Kui see on seatud, päritakse Bitcoini aadresse ja xpub-võtmeid ainult sealt – mitte kunagi avalikest sõlmedest, isegi mitte siis, kui sinu server pole kättesaadav. Muud võrgud kasutavad edasi avalikke sõlmi. Tühi = avalikud sõlmed.</string>
    <!-- Beschriftung des Eingabefelds (Basis-URL des eigenen Bitcoin-Servers, nur https://) -->
    <string name="settings_address_server_field">Bitcoini server (https://)</string>
    <!-- Knopf: eigenen Server testen (fragt nur die aktuelle Blockhöhe ab, nennt keine Adresse) -->
    <string name="settings_address_server_test">Testi</string>
    <!-- Hinweis während des Tests -->
    <string name="settings_address_server_testing">Testimine…</string>
    <!-- Test erfolgreich; %1$s = aktuelle Blockhöhe (Zahl) -->
    <string name="settings_address_server_test_ok">Server vastab – plokk %1$s</string>
    <!-- Test fehlgeschlagen (keine oder keine passende Antwort, z. B. falsche Adresse oder ungültiges Zertifikat) -->
    <string name="settings_address_server_test_failed">Kehtiv vastus puudub – kontrolli aadressi ja sertifikaati</string>
    <!-- Stand unter dem Feld: eigener Server gespeichert; %1$s = Host des Servers -->
    <string name="settings_address_server_active">Kasutusel: %1$s</string>
    <!-- Stand unter dem Feld: kein eigener Server – öffentliche Knoten wie bisher -->
    <string name="settings_address_server_none">Pole seatud – kasutatakse avalikke sõlmi</string>
    <!-- Eingabefehler: Adresse beginnt nicht mit https:// -->
    <string name="settings_address_server_error_https">Lubatud on ainult https://-aadressid</string>
    <!-- Eingabefehler: Benutzername oder Passwort in der Adresse (user:pass@) -->
    <string name="settings_address_server_error_userinfo">Aadressis ei tohi olla kasutajanime ega parooli</string>
    <!-- Eingabefehler: Abfrage (?) oder Fragment (#) in der Adresse -->
    <string name="settings_address_server_error_query">Aadressis ei tohi olla ?- ega #-osa</string>
    <!-- Eingabefehler: sonst ungültig (Host, Port oder Zeichen) -->
    <string name="settings_address_server_error_invalid">Pole kehtiv serveri aadress</string>

    <!-- Einstellungen › Portfolio › Eigener Server: Titel der Rückfrage beim Wechsel vom eigenen Server auf öffentliche Knoten (Feld geleert + Speichern, Bitcoin-Adressen oder xpub vorhanden) -->
    <string name="settings_address_server_public_title">Kas lülituda avalikele sõlmedele?</string>
    <!-- Text der Rückfrage: Bitcoin-Adressen und xpub gehen dann an die öffentlichen Knoten; %1$s = deren Hosts, kommagetrennt (z. B. mempool.space, blockstream.info) -->
    <string name="settings_address_server_public_text">Sinu Bitcoini aadresse ja xpub-võtmeid päritakse siis avalikest sõlmedest: %1$s. Need näevad neid aadresse koos sinu IP-aadressiga.</string>
    <!-- Bestätigen-Knopf der Rückfrage (öffentliche Knoten verwenden; «Abbrechen» behält den eigenen Server) -->
    <string name="settings_address_server_public_confirm">Kasuta avalikke sõlmi</string>
