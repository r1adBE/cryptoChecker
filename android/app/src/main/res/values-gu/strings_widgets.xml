    <!-- Nur iOS: Widget selbst hinzufügen (drei Schritte) -->
    <string name="widgets_ios_intro" tools:ignore="UnusedResources">iOS ઍપને જાતે વિજેટ ઉમેરવા દેતું નથી. તેમાં ફક્ત એક ક્ષણ લાગે છે:</string>
    <string name="widgets_ios_kinds" tools:ignore="UnusedResources">ઉપલબ્ધ વિજેટ</string>
    <string name="widgets_ios_step1" tools:ignore="UnusedResources">ઍપ હલવા લાગે ત્યાં સુધી હોમ સ્ક્રીન પર ખાલી જગ્યાને દબાવી રાખો.</string>
    <string name="widgets_ios_step2" tools:ignore="UnusedResources">ઉપર “ફેરફાર કરો” › “વિજેટ ઉમેરો” પર ટૅપ કરો (જૂના iOS વર્ઝન પર “+”).</string>
    <string name="widgets_ios_step3" tools:ignore="UnusedResources">“Crypto Checker” શોધો, વિજેટ પસંદ કરો અને “વિજેટ ઉમેરો” પર ટૅપ કરો.</string>

