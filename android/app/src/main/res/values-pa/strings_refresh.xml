    <!-- Einschränkungen im Hintergrund (Akku, iOS-Hintergrundaktualisierung, Stromsparmodus) -->
    <string name="battery_delay_hint">Android ਜਾਂਚਾਂ ਵਿੱਚ ਦੇਰੀ ਕਰ ਸਕਦਾ ਹੈ – ਬੈਟਰੀ ਨੂੰ “ਬਿਨਾਂ ਪਾਬੰਦੀ” ’ਤੇ ਸੈੱਟ ਕਰੋ</string>
    <string name="battery_later">ਬਾਅਦ ਵਿੱਚ</string>
    <string name="battery_message">Android ਬਿਜਲੀ ਬਚਾਉਣ ਲਈ ਪਿਛੋਕੜ ਦੇ ਕੰਮ ਵਿੱਚ ਦੇਰੀ ਕਰਦਾ ਹੈ — ਫਿਰ ਕੀਮਤਾਂ ਅਤੇ ਵਿਜੇਟ ਘੰਟਿਆਂ ਪੁਰਾਣੇ ਹੋ ਸਕਦੇ ਹਨ। ਬੈਟਰੀ ਵਰਤੋਂ ਬਿਨਾਂ ਪਾਬੰਦੀ ਕਰਨ ਨਾਲ ਇਹ ਤਾਜ਼ਾ ਰਹਿੰਦੇ ਹਨ। ਇਹ Android ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਬਦਲਿਆ ਜਾ ਸਕਦਾ ਹੈ।</string>
    <string name="battery_open_settings">ਬੈਟਰੀ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ</string>
    <string name="battery_steps">ਐਪ ਜਾਣਕਾਰੀ ਵਿੱਚ ਬੈਟਰੀ (ਜਾਂ ਐਪ ਬੈਟਰੀ ਵਰਤੋਂ) ’ਤੇ ਟੈਪ ਕਰੋ ਅਤੇ ਬਿਨਾਂ ਪਾਬੰਦੀ ਚੁਣੋ।</string>
    <string name="battery_title">ਕੀਮਤਾਂ ਤਾਜ਼ਾ ਰੱਖੋ</string>
    <string name="ios_background_refresh_off">ਇਸ ਐਪ ਲਈ ਪਿਛੋਕੜ ਐਪ ਤਾਜ਼ਗੀ ਬੰਦ ਹੈ। ਇਸ ਤੋਂ ਬਿਨਾਂ ਅਲਰਟ ਸਿਰਫ਼ ਐਪ ਖੁੱਲ੍ਹੀ ਹੋਣ ’ਤੇ ਜਾਂਚੇ ਜਾਂਦੇ ਹਨ।</string>
