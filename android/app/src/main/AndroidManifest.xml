<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bewusst behalten: Die bevorzugte (expedited) Kursaktualisierung läuft bis Android 11
         (API < 31) kurz als Vordergrunddienst ohne Typ (PriceUpdateWorker.getForegroundInfo,
         PriceUpdateScheduler.setExpedited). WorkManager trägt die Berechtigung über sein eigenes
         Manifest ohnehin ein; ab Android 12 wird sie nicht genutzt. Kein eigener
         Vordergrunddienst, kein dataSync – vor dem Play-Upload das zusammengeführte Manifest prüfen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- «Pünktlich prüfen» (Schalter, Standard aus): exakter Wecker alle 15 Min.
         (ExactCheckScheduler). SCHEDULE_EXACT_ALARM — vom Nutzer erteilt und widerrufbar; bewusst
         NICHT USE_EXACT_ALARM (nur für Wecker-/Kalender-Apps) und NICHT
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Keine Play-Console-Erklärung nötig: Die Pflicht-
         Erklärung gilt nur für USE_EXACT_ALARM; SCHEDULE_EXACT_ALARM ist ab Android 14 standardmässig
         verweigert und wird in der App erfragt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Preis-Overlay (Schalter, Standard aus): die Paare der dauerhaften Kurs-Mitteilung als schwebende
         Pille über anderen Apps (`overlay/PriceOverlay`, TYPE_APPLICATION_OVERLAY, kein Dienst). Vom Nutzer in den
         Android-Einstellungen erteilt und widerrufbar. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Ab Android 11 muss die Sprachausgabe ausdrücklich sichtbar gemacht werden. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Systemsicherung: Auto Backup nach den XML-Regeln (fullBackupOnly); der eigene Agent legt nur für die
         Dauer einer Sicherung eine unverschlüsselte Kopie der (verschlüsselten) Hauptdatenbank dazu und macht
         sie nach einer Wiederherstellung wieder zur Datenbank (SystemBackupAgent). -->
    <!-- largeHeap: Sicherungen mit Passwort leiten den Schlüssel mit Argon2id ab, das 64 MiB am Stück im ART-Heap
         braucht (Argon2id.kt, m = 65 536 KiB). Ohne largeHeap liegt die Heap-Grenze auf Geräten mit 2 GB RAM oft
         bei 128–192 MiB; zusammen mit der laufenden App reicht das nicht, und die Sicherung liesse sich dort nie
         einspielen. Die Parameter bleiben fest (sonst passten bestehende Sicherungen nicht mehr); reicht der
         Speicher trotzdem nicht, meldet BackupCrypto «zu wenig Arbeitsspeicher» statt abzustürzen. -->
    <!-- tools:targetApi 33: localeConfig (App-Sprache in den Systemeinstellungen) gibt es erst ab Android 13;
         ältere Versionen übergehen das Attribut bewusst, die Sprachwahl in der App gilt dort weiter. -->
    <application
        android:name=".CryptoCheckerApp"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher_orange_dark"
        android:roundIcon="@mipmap/ic_launcher_orange_dark_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CryptoChecker"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="true"
        android:backupAgent=".data.local.SystemBackupAgent"
        android:fullBackupOnly="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <!-- Startpunkt ohne eigenes Launcher-Icon: Die Einträge im Launcher
             kommen von den activity-alias unten, je einer pro Akzentfarbe.
             Aktiv ist immer genau einer (siehe AppearanceApplier). -->
        <!-- adjustResize (K-5): mit randloser Darstellung verschiebt Android das Fenster nicht mehr
             (sonst sprang die Tableiste über die Tastatur); den Abstand zur Tastatur setzt AppNavHost. -->
        <!-- singleTop: Tipp auf Mitteilung oder Widget (NEW_TASK|CLEAR_TOP) erreicht die laufende
             Activity über onNewIntent, statt sie neu aufzubauen. -->
        <!-- Startbildschirm: Theme.CryptoChecker.Starting (installSplashScreen in MainActivity). -->
        <!-- taskAffinity="": keine fremde App kann sich per gleicher Affinität in unseren
             Task schieben (Task-Hijacking); die activity-alias übernehmen die Affinität ihres Ziels. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CryptoChecker.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LauncherOrange"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange_dark"
            android:roundIcon="@mipmap/ic_launcher_orange_dark_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>


        <activity-alias
            android:name=".LauncherRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red_dark"
            android:roundIcon="@mipmap/ic_launcher_red_dark_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>


        <activity-alias
            android:name=".LauncherBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue_dark"
            android:roundIcon="@mipmap/ic_launcher_blue_dark_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>


        <activity-alias
            android:name=".LauncherGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green_dark"
            android:roundIcon="@mipmap/ic_launcher_green_dark_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>


        <activity-alias
            android:name=".LauncherMarrsGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_marrs_green_dark"
            android:roundIcon="@mipmap/ic_launcher_marrs_green_dark_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Einrichten-Activities der Widgets: exportiert, weil Startbildschirme sie direkt öffnen (beim Ablegen und
             «Widget neu einrichten» ab Android 12, widgetFeatures="reconfigurable"). Jede arbeitet nur mit der Id eines
             eigenen Widgets ihres Anbieters (WidgetConfigureGuard), sonst schliesst sie sich ohne Ergebnis;
             taskAffinity="" wie MainActivity (kein Task-Hijacking). -->
        <!-- Auswahl des Paares beim Ablegen eines Widgets -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CryptoChecker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Kurs-Widget -->
        <receiver
            android:name=".widget.PriceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cryptochecker.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/price_widget_info" />
        </receiver>

        <!-- Einzel-Widget: ein Coin gross -->
        <activity
            android:name=".widget.SingleWidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CryptoChecker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SingleWidgetProvider"
            android:exported="false"
            android:label="@string/single_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_widget_info" />
        </receiver>

        <!-- Portfolio-Widget: Einrichten (Anzeige ≈ USDT, Hintergrund, Deckkraft); optional ab Android 12 -->
        <activity
            android:name=".widget.PortfolioWidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CryptoChecker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Portfolio-Widget: Gesamtwert, heute, Wertverlauf und grösste Positionen je nach Grösse -->
        <receiver
            android:name=".widget.PortfolioWidgetProvider"
            android:exported="false"
            android:label="@string/widget_portfolio_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/portfolio_widget_info" />
        </receiver>

        <!-- Widget «Was gerade auffällt» (Crypto Pulse): Einrichten optional (Hintergrund, Deckkraft) -->
        <activity
            android:name=".widget.PulseWidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CryptoChecker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.PulseWidgetProvider"
            android:exported="false"
            android:label="@string/pulse_now_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulse_widget_info" />
        </receiver>

        <!-- Widget aus der App hinzugefügt (requestPinAppWidget): Rückmeldung mit der neuen Widget-Id -->
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- Wiederherstellung nach Neustart. Nur geschützte System-Aktionen (kann keine andere App
             senden); kein QUICKBOOT_POWERON (ungeschützte Hersteller-Aktion, von jeder App auslösbar). -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- «Wecker und Erinnerungen» erlaubt (Android 12+, geschützt): Wecker neu stellen -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- Zeitzone bzw. Uhr geändert (geschützt, für Manifest-Empfänger erlaubt): Wirtschaftstermine neu planen -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Wecker «Pünktlich prüfen»: nur über den eigenen PendingIntent erreichbar -->
        <receiver
            android:name=".work.ExactCheckReceiver"
            android:exported="false" />

        <!-- Knopf «1 h später» der Alarm-Meldung: nur über den eigenen PendingIntent erreichbar -->
        <receiver
            android:name=".notification.AlarmActionReceiver"
            android:exported="false" />

        <!-- Liefert die Zeilen der Widget-Liste -->
        <!-- Uhr-App: Wahl und eigene Liste der Uhr über die Wear-Daten-Schicht (nur Coin-Kürzel) -->
        <service
            android:name=".wearable.PhoneWatchListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/cc/watch"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.PriceWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- «Diagnose teilen»: Textdatei aus cache/diagnostics nur zum Lesen an die gewählte App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>

        <!-- WorkManager wird über Hilt konfiguriert, daher kein Auto-Start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
