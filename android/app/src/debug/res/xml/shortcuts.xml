<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-Kopie von src/main/res/xml/shortcuts.xml mit dem Paket der Debug-App (applicationIdSuffix .debug):
     statische Verknüpfungen kennen keine Manifest-Platzhalter. Bis auf targetPackage gleich (ShortcutsXmlTest). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cryptochecker.app.debug"
            android:targetClass="com.cryptochecker.app.ui.MainActivity">
            <extra android:name="open" android:value="add" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="alarms"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_alarms"
        android:shortcutShortLabel="@string/shortcut_alarms"
        android:shortcutLongLabel="@string/shortcut_alarms_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cryptochecker.app.debug"
            android:targetClass="com.cryptochecker.app.ui.MainActivity">
            <extra android:name="open" android:value="alarms" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="cycle"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_cycle"
        android:shortcutShortLabel="@string/shortcut_cycle"
        android:shortcutLongLabel="@string/shortcut_cycle_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cryptochecker.app.debug"
            android:targetClass="com.cryptochecker.app.ui.MainActivity">
            <extra android:name="open" android:value="cycle" />
        </intent>
    </shortcut>
</shortcuts>
