<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse-Widget, Ansicht «Gewinner und Verlierer 24 h» (PulseWidgetMovers): links Gewinner, rechts Verlierer, je
     bis zu drei Coins mit 24-h-Veränderung in der Kursfarbe (Stand in der Kopfzeile). Teil von widget_pulse.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pulse_movers"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pulse_gain_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/pulse_gain_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_gain_sym_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_gain_chg_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pulse_gain_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_gain_sym_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_gain_chg_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pulse_gain_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_gain_sym_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_gain_chg_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>

        <!-- Abstand zwischen den Spalten (FrameLayout, da <Space> in RemoteViews nicht erlaubt ist) -->
        <FrameLayout
            tools:ignore="UselessLeaf"
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pulse_loss_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/pulse_loss_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_loss_sym_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_loss_chg_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pulse_loss_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_loss_sym_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_loss_chg_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pulse_loss_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/pulse_loss_sym_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pulse_loss_chg_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
