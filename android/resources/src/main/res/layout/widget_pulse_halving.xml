<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse-Widget, Ansicht «Bitcoin-Halving» (PulseWidgetHalving): voraussichtlicher Monat gross, verbleibende Tage,
     letztes Halving und «Nach Kalender geschätzt». Ohne Netz, keine Prognose. Teil von widget_pulse.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pulse_halving"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/pulse_halving_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pulse_halving_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp" />

    <!-- Platzhalter mit Gewicht 1 hält den Stand unten (FrameLayout, da <Space>/<View> in RemoteViews nicht erlaubt sind) -->
    <FrameLayout
        tools:ignore="UselessLeaf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/pulse_halving_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/pulse_halving_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp" />
</LinearLayout>
