    {"name": "offline, frisch", "online": false, "outdated": false, "time": 1700000000000, "expected": "offline"},
    {"name": "offline schlägt veraltet", "online": false, "outdated": true, "time": 1700000000000, "expected": "offline"},
    {"name": "offline, nie aktualisiert", "online": false, "outdated": false, "time": 0, "expected": "offlineNoTime"},
    {"name": "offline, veraltet, ohne Zeit", "online": false, "outdated": true, "time": 0, "expected": "offlineNoTime"},
    {"name": "online, nie aktualisiert", "online": true, "outdated": false, "time": 0, "expected": "time"},
