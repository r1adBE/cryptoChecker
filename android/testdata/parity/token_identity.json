      "symbol": "CAT",
      "own": "Catcoin",
      "host": "data-api.binance.vision",
      "binance": "Simon's Cat",
      "providerName": null,
      "expected": false
    },
    {
      "name": "coinbase host, binance name contradicts: whole chain skipped (action sheet, volume)",
      "symbol": "CAT",
      "own": "Catcoin",
