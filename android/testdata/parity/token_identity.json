      "expected": true
    },
    {
      "name": "coinbase host, binance name unknown",
      "symbol": "CAT",
      "own": "Simon's Cat",
      "host": "api.exchange.coinbase.com",
      "binance": null,
      "providerName": null,
      "expected": true
    }
  ]
}
