      "binance": "Simon's Cat",
      "providerName": null,
      "expected": false
    },
    {
      "name": "binance.us host, binance name contradicts",
      "symbol": "TON",
      "own": "Tokamak Network",
      "host": "api.binance.us",
      "binance": "Toncoin",
      "providerName": null,
      "expected": false
    },
    {
      "name": "own name unknown: symbol + band",
      "symbol": "CAT",
      "own": null,
      "host": "api.exchange.coinbase.com",
      "binance": "Simon's Cat",
      "providerName": null,
      "expected": true
    },
    {
      "name": "coinbase name contradicts own name",
      "symbol": "CAT",
      "own": "Simon's Cat",
      "host": "api.exchange.coinbase.com",
      "binance": "Simons Cat",
      "providerName": "Catcoin",
      "expected": false
    },
    {
      "name": "futures host, same token",
      "symbol": "TON",
      "own": "Toncoin",
