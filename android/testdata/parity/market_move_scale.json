 "description": "Headline of the market pulse and the shared 'slight'/'clear' scale (Android MarketMove.kt + CryptoPulse.kt / iOS MarketMove.swift + CryptoPulse.swift). input: 24-h changes in % of BTC, ETH, SOL; marketChange24h = change of the total market cap in % (null = unknown; tests pass it with a positive market cap); breadth = rising/falling/total of the top list (null = unknown; tests build topChanges as up x +1.0, down x -1.0, rest 0.0); btcVolumeRatio optional (null). expected: direction/level = MarketMoveScale.decide (level null unless UP/DOWN), summary = PulseSummary, lead = PulseLeadKind of the lead sentence, plainDirection = MarketPlainSummary.directionKind(marketChange24h) (null without market change).",
 "cases": [
  {
   "name": "device example: 26 of 30 falling, market -3.1 %, BTC/ETH/SOL all negative -> clearly down, never mixed",
   "input": {
    "btc24h": -2.0,
    "eth24h": -2.6,
    "sol24h": -1.2,
    "marketChange24h": -3.1,
    "breadth": {
     "up": 4,
     "down": 26,
     "total": 30
    }
   },
   "expected": {
    "direction": "DOWN",
    "level": "CLEAR",
    "summary": "BROAD_DOWN",
    "lead": "BROAD_DOWN",
    "plainDirection": "DOWN_CLEAR"
   }
  },
