      "pair": {
        "base": "BTC",
        "quote": "KRW",
        "id": "KRW-BTC",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"market\":\"KRW-BTC\",\"trade_date\":\"20241010\",\"trade_time\":\"060000\",\"trade_date_kst\":\"20241010\",\"trade_time_kst\":\"150000\", \"trade_timestamp\":1728540000000,\"opening_price\":85000000,\"high_price\":86500000,\"low_price\":84000000,\"trade_price\":86000000, \"prev_closing_price\":84500000,\"change\":\"RISE\",\"change_price\":1500000,\"change_rate\":0.0177514793,\"signed_change_price\":1500000, \"signed_change_rate\":0.0177514793,\"trade_volume\":0.001,\"acc_trade_price\":123456789012.5,\"acc_trade_price_24h\":234567890123.4, \"acc_trade_volume\":1450.12,\"acc_trade_volume_24h\":2750.34,\"highest_52_week_price\":105000000,\"highest_52_week_date\":\"2024-03-14\", \"lowest_52_week_price\":40000000,\"lowest_52_week_date\":\"2023-10-12\",\"timestamp\":1728540000123}]",
      "expect": {
