{
  "exchange": "Phemex / Phemex Futures",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.phemex.com/md/spot/ticker/24hr?symbol=sBTCUSDT | /md/v2/ticker/24hr?symbol=BTCUSDT",
    "bulk": "GET https://api.phemex.com/md/spot/ticker/24hr/all | /md/v2/ticker/24hr/all",
    "pairs": "GET https://api.phemex.com/public/products (also first bulk request while no scales are known)"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "products perpProductsV2: perpProductSubType «TradFi» = TradFi, other or missing = crypto",
      "market": "PhemexFutures",
      "requestId": 0,
      "body": "{\"code\":0,\"msg\":\"\",\"data\":{\"currencies\":[],\"products\":[],\"perpProductsV2\":[{\"symbol\":\"BTCUSDT\",\"type\":\"PerpetualV2\",\"status\":\"Listed\",\"baseCurrency\":\"BTC\",\"quoteCurrency\":\"USDT\",\"perpProductSubType\":\"Crypto\"},{\"symbol\":\"NVDAUSDT\",\"type\":\"PerpetualV2\",\"status\":\"Listed\",\"baseCurrency\":\"NVDA\",\"quoteCurrency\":\"USDT\",\"perpProductSubType\":\"TradFi\"},{\"symbol\":\"ETHUSDT\",\"type\":\"PerpetualV2\",\"status\":\"Listed\",\"baseCurrency\":\"ETH\",\"quoteCurrency\":\"USDT\"},{\"symbol\":\"OLDUSDT\",\"type\":\"PerpetualV2\",\"status\":\"Delisted\",\"baseCurrency\":\"OLD\",\"quoteCurrency\":\"USDT\",\"perpProductSubType\":\"TradFi\"}]}}",
      "expect": {
        "count": 3,
        "absent": [
          "OLDUSDT"
        ],
        "pairs": {
          "BTCUSDT": {
            "base": "BTC",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          },
          "NVDAUSDT": {
            "base": "NVDA",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": true
          },
          "ETHUSDT": {
            "base": "ETH",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          }
        }
      }
    },
    {
      "kind": "pairs",
      "name": "products: spot pairs and scales (Ep/Ev) — loaded before any spot price is parsed (no guessed factor)",
      "market": "Phemex",
      "requestId": 0,
      "note": "Runs first: without a loaded product list (memory or stored copy) Phemex spot prices are not parsed at all.",
      "body": "{\"code\":0,\"msg\":\"\",\"data\":{\"currencies\":[{\"currency\":\"BTC\",\"valueScale\":8},{\"currency\":\"ETH\",\"valueScale\":8},{\"currency\":\"USDT\",\"valueScale\":8},{\"currency\":\"SHIB\",\"valueScale\":2}],\"products\":[{\"symbol\":\"sBTCUSDT\",\"type\":\"Spot\",\"status\":\"Listed\",\"baseCurrency\":\"BTC\",\"quoteCurrency\":\"USDT\",\"priceScale\":8},{\"symbol\":\"sETHUSDT\",\"type\":\"Spot\",\"status\":\"Listed\",\"baseCurrency\":\"ETH\",\"quoteCurrency\":\"USDT\",\"priceScale\":8},{\"symbol\":\"sSHIBUSDT\",\"type\":\"Spot\",\"status\":\"Listed\",\"baseCurrency\":\"SHIB\",\"quoteCurrency\":\"USDT\",\"priceScale\":8},{\"symbol\":\"BTCUSD\",\"type\":\"Perpetual\",\"status\":\"Listed\",\"baseCurrency\":\"BTC\",\"quoteCurrency\":\"USD\",\"priceScale\":4}],\"perpProductsV2\":[]}}",
      "expect": {
        "count": 3,
        "absent": [
          "BTCUSD"
        ],
        "pairs": {
          "sBTCUSDT": {
            "base": "BTC",
            "quote": "USDT"
          },
          "sSHIBUSDT": {
            "base": "SHIB",
            "quote": "USDT"
          }
        }
      }
    },
    {
      "kind": "single",
      "name": "spot 24hr: scaled integers (Ep/Ev = 1e8), timestamp in ns",
      "market": "Phemex",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "sBTCUSDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":{\"askEp\":6200020000000,\"bidEp\":6200010000000,\"highEp\":6250000000000,\"indexEp\":6201010000000,\"lastEp\":6200010000000, \"lowEp\":6000000000000,\"openEp\":6050000000000,\"symbol\":\"sBTCUSDT\",\"timestamp\":1728540000123456789, \"turnoverEv\":74446012345678900,\"volumeEv\":1210050000000}}",
      "expect": {
        "last": 62000.1,
        "bid": 62000.1,
        "ask": 62000.2,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.5,
        "volQuote": 744460123.456789,
        "change24hPercent": 2.4795041322314026,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "futures v2 24hr: decimal strings (Rp/Rq/Rv), no bid/ask",
      "market": "PhemexFutures",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTCUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":{\"closeRp\":\"62000.1\",\"fundingRateRr\":\"0.0001\",\"highRp\":\"62500\",\"indexPriceRp\":\"62010.1\",\"lowRp\":\"60000\", \"markPriceRp\":\"62005.5\",\"openInterestRv\":\"1234.5\",\"openRp\":\"60500\",\"predFundingRateRr\":\"0.0001\",\"symbol\":\"BTCUSDT\", \"timestamp\":1728540000123456789,\"turnoverRv\":\"744460123.45\",\"volumeRq\":\"12100.5\"}}",
      "expect": {
        "last": 62000.1,
        "bid": -1.0,
        "ask": -1.0,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.5,
        "volQuote": 744460123.45,
        "change24hPercent": 2.4795041322314026,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "error object",
      "market": "Phemex",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "sFOOUSDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"error\":{\"code\":6001,\"message\":\"invalid argument\"},\"id\":0,\"result\":null}",
      "expect": {
        "error": true,
        "message": "invalid argument"
      }
    },
    {
      "kind": "single",
      "name": "code/msg error",
      "market": "PhemexFutures",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOOUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"code\":6001,\"msg\":\"invalid argument\",\"data\":null}",
      "expect": {
        "error": true,
        "message": "invalid argument"
      }
    },
    {
      "kind": "bulk",
      "name": "bulk spot /all",
      "market": "Phemex",
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":[{\"askEp\":6200020000000,\"bidEp\":6200010000000,\"highEp\":6250000000000,\"indexEp\":6201010000000,\"lastEp\":6200010000000, \"lowEp\":6000000000000,\"openEp\":6050000000000,\"symbol\":\"sBTCUSDT\",\"timestamp\":1728540000123456789, \"turnoverEv\":74446012345678900,\"volumeEv\":1210050000000},{\"askEp\":6200020000000,\"bidEp\":6200010000000,\"highEp\":6250000000000,\"indexEp\":6201010000000,\"lastEp\":245012000000, \"lowEp\":6000000000000,\"openEp\":246246000000,\"symbol\":\"sETHUSDT\",\"timestamp\":1728540000123456789, \"turnoverEv\":74446012345678900,\"volumeEv\":1210050000000}]}",
      "expect": {
        "count": 2,
        "tickers": {
          "sBTCUSDT": {
            "last": 62000.1,
            "exchangeTime": null
          },
          "sETHUSDT": {
            "last": 2450.12,
            "change24hPercent": -0.5011248913687997
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk futures v2 /all",
      "market": "PhemexFutures",
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":[{\"closeRp\":\"62000.1\",\"fundingRateRr\":\"0.0001\",\"highRp\":\"62500\",\"indexPriceRp\":\"62010.1\",\"lowRp\":\"60000\", \"markPriceRp\":\"62005.5\",\"openInterestRv\":\"1234.5\",\"openRp\":\"60500\",\"predFundingRateRr\":\"0.0001\",\"symbol\":\"BTCUSDT\", \"timestamp\":1728540000123456789,\"turnoverRv\":\"744460123.45\",\"volumeRq\":\"12100.5\"}]}",
      "expect": {
        "count": 1,
        "tickers": {
          "BTCUSDT": {
            "last": 62000.1,
            "volQuote": 744460123.45,
            "exchangeTime": null
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk with code/msg error instead of result: request fails",
      "market": "Phemex",
      "requestId": 0,
      "body": "{\"code\":6001,\"msg\":\"invalid argument\",\"data\":null}",
      "expect": {
        "error": true
      },
      "note": "both platforms throw with the exchange text instead of returning an empty batch"
    },
    {
      "kind": "bulk",
      "name": "bulk with error object and result null: request fails",
      "market": "PhemexFutures",
      "requestId": 0,
      "body": "{\"error\":{\"code\":6001,\"message\":\"invalid argument\"},\"id\":0,\"result\":null}",
      "expect": {
        "error": true
      }
    },
    {
      "kind": "single",
      "name": "code/msg error with msg null: no error text (not \"null\")",
      "market": "PhemexFutures",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOOUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"code\":6001,\"msg\":null,\"data\":null}",
      "expect": {
        "error": true,
        "message": null
      }
    },
    {
      "kind": "single",
      "name": "timestamp \"NaN\" / huge: no crash",
      "market": "PhemexFutures",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTCUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":{\"closeRp\":\"62000.1\",\"fundingRateRr\":\"0.0001\",\"highRp\":\"62500\",\"indexPriceRp\":\"62010.1\",\"lowRp\":\"60000\", \"markPriceRp\":\"62005.5\",\"openInterestRv\":\"1234.5\",\"openRp\":\"60500\",\"predFundingRateRr\":\"0.0001\",\"symbol\":\"BTCUSDT\", \"timestamp\":\"1e40\",\"turnoverRv\":\"744460123.45\",\"volumeRq\":\"12100.5\"}}",
      "expect": {
        "last": 62000.1,
        "exchangeTime": null
      },
      "note": "timestamp is a snapshot time, not a trade time: ignored (no exchange time), so odd values cannot crash"
    },
    {
      "kind": "bulk",
      "name": "bulk spot /all: SHIB volume with its value scale 2 (Public-Spot-API currencies table), price Ep 1e8",
      "market": "Phemex",
      "requestId": 0,
      "body": "{\"error\":null,\"id\":0,\"result\":[{\"askEp\":1235,\"bidEp\":1234,\"highEp\":1300,\"lastEp\":1234,\"lowEp\":1200,\"openEp\":1250,\"symbol\":\"sSHIBUSDT\",\"timestamp\":1728540000123456789,\"turnoverEv\":1523456789000,\"volumeEv\":123456789012},{\"askEp\":6200020000000,\"bidEp\":6200010000000,\"highEp\":6250000000000,\"lastEp\":6200010000000,\"lowEp\":6000000000000,\"openEp\":6050000000000,\"symbol\":\"sBTCUSDT\",\"timestamp\":1728540000123456789,\"turnoverEv\":74446012345678900,\"volumeEv\":1210050000000}]}",
      "expect": {
        "count": 2,
        "tickers": {
          "sSHIBUSDT": {
            "last": 1.234e-05,
            "vol": 1234567890.12,
            "volQuote": 15234.56789
          },
          "sBTCUSDT": {
            "last": 62000.1,
            "vol": 12100.5,
            "volQuote": 744460123.456789
          }
        }
      }
    }
  ]
}
