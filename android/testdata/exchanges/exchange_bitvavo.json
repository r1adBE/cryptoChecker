{
  "exchange": "Bitvavo",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.bitvavo.com/v2/ticker/24h?market=BTC-EUR",
    "bulk": "GET https://api.bitvavo.com/v2/ticker/24h"
  },
  "cases": [
    {
      "kind": "single",
      "name": "ticker/24h BTC-EUR (open = start of rolling window)",
      "market": "Bitvavo",
      "pair": {
        "base": "BTC",
        "quote": "EUR",
        "id": "BTC-EUR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"market\":\"BTC-EUR\",\"startTimestamp\":1728453600123,\"timestamp\":1728540000123,\"open\":\"56500\",\"openTimestamp\":1728453600500, \"high\":\"58500\",\"low\":\"56000\",\"last\":\"58000.1\",\"closeTimestamp\":1728539999000,\"bid\":\"58000\",\"bidSize\":\"0.5\", \"ask\":\"58000.2\",\"askSize\":\"0.8\",\"volume\":\"1234.5\",\"volumeQuote\":\"71234567.8\"}",
      "expect": {
        "last": 58000.1,
        "bid": 58000.0,
        "ask": 58000.2,
        "high": 58500.0,
        "low": 56000.0,
        "vol": 1234.5,
        "volQuote": 71234567.8,
        "change24hPercent": 2.655044247787608,
        "timestamp": 1728540000123
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "market": "Bitvavo",
      "pair": {
        "base": "FOO",
        "quote": "EUR",
        "id": "FOO-EUR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"errorCode\":205,\"error\":\"market parameter is invalid.\"}",
      "expect": {
        "error": true,
        "message": "market parameter is invalid."
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: inactive market with null last skipped",
      "market": "Bitvavo",
      "requestId": 0,
      "body": "[{\"market\":\"BTC-EUR\",\"startTimestamp\":1728453600123,\"timestamp\":1728540000123,\"open\":\"56500\",\"openTimestamp\":1728453600500, \"high\":\"58500\",\"low\":\"56000\",\"last\":\"58000.1\",\"closeTimestamp\":1728539999000,\"bid\":\"58000\",\"bidSize\":\"0.5\", \"ask\":\"58000.2\",\"askSize\":\"0.8\",\"volume\":\"1234.5\",\"volumeQuote\":\"71234567.8\"},{\"market\":\"OLD-EUR\",\"startTimestamp\":null,\"timestamp\":1728540000123,\"open\":null,\"high\":null,\"low\":null,\"last\":null,\"bid\":null,\"ask\":null,\"volume\":\"0\",\"volumeQuote\":\"0\"}]",
      "expect": {
        "count": 1,
        "absent": [
          "OLD-EUR"
        ],
        "tickers": {
          "BTC-EUR": {
            "last": 58000.1
          }
        }
      }
    }
  ]
}
