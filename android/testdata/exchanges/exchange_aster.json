{
  "exchange": "Aster",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://fapi.asterdex.com/fapi/v1/ticker/24hr?symbol=BTCUSDT",
    "bulk": "GET https://fapi.asterdex.com/fapi/v1/ticker/24hr",
    "pairs": "GET https://fapi.asterdex.com/fapi/v1/exchangeInfo"
  },
  "note": "needs recorded verification: written from the public (Binance-futures-compatible) API documentation without a live capture",
  "cases": [
    {
      "kind": "single",
      "name": "24hr BTCUSDT (Binance-compatible): last trade price, priceChangePercent already percent",
      "market": "Aster",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTCUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"symbol\":\"BTCUSDT\",\"priceChange\":\"1499.60\",\"priceChangePercent\":\"2.479\",\"weightedAvgPrice\":\"61250.3\",\"lastPrice\":\"62000.10\",\"lastQty\":\"0.010\",\"openPrice\":\"60500.50\",\"highPrice\":\"62500.00\",\"lowPrice\":\"60000.00\",\"volume\":\"12100.523\",\"quoteVolume\":\"741160123.45\",\"openTime\":1728453600000,\"closeTime\":1728540000000,\"firstId\":1,\"lastId\":2,\"count\":2}",
      "expect": {
        "last": 62000.1,
        "bid": -1.0,
        "ask": -1.0,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.523,
        "volQuote": 741160123.45,
        "change24hPercent": 2.479,
        "exchangeTime": null,
        "markFallback": false
      }
    },
    {
      "kind": "single",
      "name": "error payload: invalid symbol, msg is the error text",
      "market": "Aster",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOOUSDT",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"code\":-1121,\"msg\":\"Invalid symbol.\"}",
      "expect": {
        "error": true,
        "message": "Invalid symbol."
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: all contracts; lastPrice 0 (inactive) skipped, non-object entry ignored",
      "market": "Aster",
      "requestId": 0,
      "body": "[{\"symbol\":\"BTCUSDT\",\"priceChange\":\"1499.60\",\"priceChangePercent\":\"2.479\",\"weightedAvgPrice\":\"61250.3\",\"lastPrice\":\"62000.10\",\"lastQty\":\"0.010\",\"openPrice\":\"60500.50\",\"highPrice\":\"62500.00\",\"lowPrice\":\"60000.00\",\"volume\":\"12100.523\",\"quoteVolume\":\"741160123.45\",\"openTime\":1728453600000,\"closeTime\":1728540000000,\"firstId\":1,\"lastId\":2,\"count\":2},{\"symbol\":\"NEWUSDT\",\"priceChange\":\"0\",\"priceChangePercent\":\"0\",\"lastPrice\":\"0\",\"openPrice\":\"0\",\"highPrice\":\"0\",\"lowPrice\":\"0\",\"volume\":\"0\",\"quoteVolume\":\"0\"},null,{\"symbol\":\"ASTERUSDT\",\"priceChange\":\"-0.0412\",\"priceChangePercent\":\"-2.150\",\"lastPrice\":\"1.8750\",\"openPrice\":\"1.9162\",\"highPrice\":\"1.9500\",\"lowPrice\":\"1.8500\",\"volume\":\"98765432.0\",\"quoteVolume\":\"185000000.5\",\"openTime\":1728453600000,\"closeTime\":1728540000000}]",
      "expect": {
        "count": 2,
        "absent": [
          "NEWUSDT"
        ],
        "tickers": {
          "BTCUSDT": {
            "last": 62000.1,
            "change24hPercent": 2.479,
            "exchangeTime": null
          },
          "ASTERUSDT": {
            "last": 1.875,
            "vol": 98765432.0,
            "change24hPercent": -2.15
          }
        }
      }
    },
    {
      "kind": "pairs",
      "name": "exchangeInfo: only TRADING PERPETUAL contracts",
      "market": "Aster",
      "requestId": 0,
      "body": "{\"timezone\":\"UTC\",\"serverTime\":1728540000000,\"rateLimits\":[],\"assets\":[],\"symbols\":[{\"symbol\":\"BTCUSDT\",\"pair\":\"BTCUSDT\",\"contractType\":\"PERPETUAL\",\"deliveryDate\":4133404800000,\"onboardDate\":1569398400000,\"status\":\"TRADING\",\"baseAsset\":\"BTC\",\"quoteAsset\":\"USDT\",\"marginAsset\":\"USDT\",\"pricePrecision\":1,\"quantityPrecision\":3,\"underlyingType\":\"COIN\"},{\"symbol\":\"ASTERUSDT\",\"pair\":\"ASTERUSDT\",\"contractType\":\"PERPETUAL\",\"status\":\"TRADING\",\"baseAsset\":\"ASTER\",\"quoteAsset\":\"USDT\",\"marginAsset\":\"USDT\"},{\"symbol\":\"OLDUSDT\",\"pair\":\"OLDUSDT\",\"contractType\":\"PERPETUAL\",\"status\":\"SETTLING\",\"baseAsset\":\"OLD\",\"quoteAsset\":\"USDT\",\"marginAsset\":\"USDT\"},{\"symbol\":\"BTCUSDT_251226\",\"pair\":\"BTCUSDT\",\"contractType\":\"CURRENT_QUARTER\",\"status\":\"TRADING\",\"baseAsset\":\"BTC\",\"quoteAsset\":\"USDT\",\"marginAsset\":\"USDT\"}]}",
      "expect": {
        "count": 2,
        "absent": [
          "OLDUSDT",
          "BTCUSDT_251226"
        ],
        "pairs": {
          "BTCUSDT": {
            "base": "BTC",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          },
          "ASTERUSDT": {
            "base": "ASTER",
            "quote": "USDT",
            "contract": "PERPETUAL"
          }
        }
      }
    }
  ]
}
