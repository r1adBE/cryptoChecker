{
  "exchange": "CoinDCX",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Checked against recorded live responses on 19 October 2026 (workflow «Record exchange fixtures» with ExchangeContractTest); re-record with tools/record_exchange_fixtures.py. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS). Needs recorded verification (tools/record_exchange_fixtures.py) before release.",
  "endpoints": {
    "pairs": "GET https://api.coindcx.com/exchange/v1/markets_details",
    "single": "GET https://api.coindcx.com/exchange/ticker (whole list, row by market)",
    "bulk": "GET https://api.coindcx.com/exchange/ticker"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "markets_details: target = coin, base = quote currency; inactive dropped; duplicate id once",
      "market": "CoinDcx",
      "requestId": 0,
      "body": "[{\"coindcx_name\":\"BTCINR\",\"base_currency_short_name\":\"INR\",\"target_currency_short_name\":\"BTC\",\"target_currency_name\":\"Bitcoin\",\"base_currency_name\":\"Indian Rupee\",\"min_quantity\":1e-05,\"symbol\":\"BTCINR\",\"ecode\":\"I\",\"pair\":\"I-BTC_INR\",\"status\":\"active\"},{\"coindcx_name\":\"BTCUSDT\",\"base_currency_short_name\":\"USDT\",\"target_currency_short_name\":\"BTC\",\"symbol\":\"BTCUSDT\",\"ecode\":\"B\",\"pair\":\"B-BTC_USDT\",\"status\":\"active\"},{\"coindcx_name\":\"BTCUSDT\",\"base_currency_short_name\":\"USDT\",\"target_currency_short_name\":\"BTC\",\"symbol\":\"BTCUSDT\",\"ecode\":\"HB\",\"pair\":\"HB-BTC_USDT\",\"status\":\"active\"},{\"coindcx_name\":\"OLDINR\",\"base_currency_short_name\":\"INR\",\"target_currency_short_name\":\"OLD\",\"symbol\":\"OLDINR\",\"ecode\":\"I\",\"pair\":\"I-OLD_INR\",\"status\":\"inactive\"}]",
      "expect": {
        "count": 2,
        "absent": [
          "OLDINR"
        ],
        "pairs": {
          "BTCINR": {
            "base": "BTC",
            "quote": "INR"
          },
          "BTCUSDT": {
            "base": "BTC",
            "quote": "USDT"
          }
        }
      }
    },
    {
      "kind": "single",
      "name": "ticker BTCINR from the whole list (volume in quote currency, change_24_hour in percent, timestamp = snapshot)",
      "market": "CoinDcx",
      "pair": {
        "base": "BTC",
        "quote": "INR",
        "id": "BTCINR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"market\":\"BTCUSDT\",\"change_24_hour\":\"2.5\",\"high\":\"63500\",\"low\":\"61000\",\"volume\":\"1234567.89\",\"last_price\":\"62900.5\",\"bid\":\"62900\",\"ask\":\"62901\",\"timestamp\":1728540000},{\"market\":\"BTCINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"5560000.0\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000}]",
      "expect": {
        "last": 5560000.0,
        "bid": 5559000.0,
        "ask": 5561000.0,
        "high": 5650000.0,
        "low": 5480000.0,
        "vol": -1.0,
        "volQuote": 182345678.5,
        "change24hPercent": -1.621,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "pair missing from the list -> no data",
      "market": "CoinDcx",
      "pair": {
        "base": "FOO",
        "quote": "INR",
        "id": "FOOINR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"market\":\"BTCUSDT\",\"change_24_hour\":\"2.5\",\"high\":\"63500\",\"low\":\"61000\",\"volume\":\"1234567.89\",\"last_price\":\"62900.5\",\"bid\":\"62900\",\"ask\":\"62901\",\"timestamp\":1728540000},{\"market\":\"BTCINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"5560000.0\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000}]",
      "expect": {
        "error": true,
        "thrown": "No data"
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "market": "CoinDcx",
      "pair": {
        "base": "BTC",
        "quote": "INR",
        "id": "BTCINR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"code\":500,\"message\":\"Internal Server Error\",\"status\":\"error\"}",
      "expect": {
        "error": true,
        "message": "Internal Server Error"
      }
    },
    {
      "kind": "single",
      "name": "zero last_price -> no price",
      "market": "CoinDcx",
      "pair": {
        "base": "BTC",
        "quote": "INR",
        "id": "BTCINR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"market\":\"BTCINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"0\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000}]",
      "expect": {
        "error": true
      }
    },
    {
      "kind": "single",
      "name": "rate limit payload (HTTP 429) -> exchange text",
      "market": "CoinDcx",
      "pair": {
        "base": "BTC",
        "quote": "INR",
        "id": "BTCINR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"code\":429,\"message\":\"Too many requests\",\"status\":\"error\"}",
      "expect": {
        "error": true,
        "message": "Too many requests"
      }
    },
    {
      "kind": "bulk",
      "name": "ticker: all markets",
      "market": "CoinDcx",
      "requestId": 0,
      "body": "[{\"market\":\"BTCINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"5560000.0\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000},{\"market\":\"BTCUSDT\",\"change_24_hour\":\"2.5\",\"high\":\"63500\",\"low\":\"61000\",\"volume\":\"1234567.89\",\"last_price\":\"62900.5\",\"bid\":\"62900\",\"ask\":\"62901\",\"timestamp\":1728540000}]",
      "expect": {
        "count": 2,
        "tickers": {
          "BTCINR": {
            "last": 5560000.0,
            "change24hPercent": -1.621
          },
          "BTCUSDT": {
            "last": 62900.5,
            "volQuote": 1234567.89
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: renamed field «last_price» in one row — that pair is reported as unreadable, the rest stays; row with empty «last_price» (inactive) is skipped, not failed",
      "market": "CoinDcx",
      "requestId": 0,
      "body": "[{\"market\":\"BTCINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"5560000.0\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000},{\"market\":\"BTCUSDT\",\"change_24_hour\":\"2.5\",\"high\":\"63500\",\"low\":\"61000\",\"volume\":\"1234567.89\",\"bid\":\"62900\",\"ask\":\"62901\",\"timestamp\":1728540000,\"last_price_renamed\":\"62900.5\"},{\"market\":\"OLDINR\",\"change_24_hour\":\"-1.621\",\"high\":\"5650000\",\"low\":\"5480000\",\"volume\":\"182345678.5\",\"last_price\":\"\",\"bid\":\"5559000.0\",\"ask\":\"5561000.0\",\"timestamp\":1728540000}]",
      "expect": {
        "count": 1,
        "absent": [
          "BTCUSDT",
          "OLDINR"
        ],
        "failed": [
          "BTCUSDT"
        ],
        "tickers": {
          "BTCINR": {
            "last": 5560000.0
          }
        }
      }
    }
  ]
}
