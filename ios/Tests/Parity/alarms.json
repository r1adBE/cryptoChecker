    { "name": "move window expired", "alarm": { "condition": "MOVE_PERCENT_WINDOW", "threshold": 5, "referencePrice": 100, "windowHours": 1, "referenceAt": 1699992800000 }, "price": 120, "previousPrice": 100, "cooldownMinutes": 0, "expected": false },
