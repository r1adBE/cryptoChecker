{
  "description": "Basis of the % change (Android ChangeBasis.kt / iOS ChangeBasis.swift). Times are ISO-8601 UTC strings (or epoch ms numbers), zones are IANA ids. dayStart: start of the current day for basis/zone (null = rolling). choose: final value from the ticker value and the candle value. isCurrent: do stored values (stamp) still apply. fromName: stored name -> basis. Fixed zones are stored as UTC_DAY+8 / UTC_DAY-5 (UTC-12 … UTC+14). zoneLabel: offset in seconds -> label.",
  "dayStart": [
    {"name": "utc day ignores the zone", "basis": "UTC_DAY", "now": "2026-10-07T23:59:00Z", "zone": "Europe/Zurich", "expected": "2026-10-07T00:00:00Z"},
    {"name": "utc day at midnight", "basis": "UTC_DAY", "now": "2026-10-08T00:00:00Z", "zone": "Europe/Zurich", "expected": "2026-10-08T00:00:00Z"},
    {"name": "rolling has no day start", "basis": "ROLLING_24H", "now": "2026-10-07T23:59:00Z", "zone": "Europe/Zurich", "expected": null},
    {"name": "local day in summer time (UTC+2)", "basis": "LOCAL_DAY", "now": "2026-10-07T23:30:00Z", "zone": "Europe/Zurich", "expected": "2026-10-07T22:00:00Z"},
    {"name": "local day in UTC", "basis": "LOCAL_DAY", "now": "2026-10-07T23:30:00Z", "zone": "UTC", "expected": "2026-10-07T00:00:00Z"},
    {"name": "spring forward day starts in winter time", "basis": "LOCAL_DAY", "now": "2026-03-29T21:00:00Z", "zone": "Europe/Zurich", "expected": "2026-03-28T23:00:00Z"},
    {"name": "day after spring forward", "basis": "LOCAL_DAY", "now": "2026-03-29T22:30:00Z", "zone": "Europe/Zurich", "expected": "2026-03-29T22:00:00Z"},
    {"name": "fall back day starts in summer time", "basis": "LOCAL_DAY", "now": "2026-10-25T22:30:00Z", "zone": "Europe/Zurich", "expected": "2026-10-24T22:00:00Z"},
    {"name": "day after fall back (25 h later)", "basis": "LOCAL_DAY", "now": "2026-10-25T23:00:00Z", "zone": "Europe/Zurich", "expected": "2026-10-25T23:00:00Z"},
    {"name": "half hour zone", "basis": "LOCAL_DAY", "now": "2026-10-07T10:00:00Z", "zone": "Asia/Kolkata", "expected": "2026-10-06T18:30:00Z"},
    {"name": "new york spring forward", "basis": "LOCAL_DAY", "now": "2026-03-08T12:00:00Z", "zone": "America/New_York", "expected": "2026-03-08T05:00:00Z"},
    {"name": "santiago normal day", "basis": "LOCAL_DAY", "now": "2026-09-10T15:00:00Z", "zone": "America/Santiago", "expected": "2026-09-10T03:00:00Z"},
    {"name": "santiago: midnight does not exist, first valid time", "basis": "LOCAL_DAY", "now": "2026-09-06T15:00:00Z", "zone": "America/Santiago", "expected": "2026-09-06T04:00:00Z"},
    {"name": "utc+8 day already began in asia", "basis": "UTC_DAY+8", "now": "2026-10-07T23:59:00Z", "zone": "Europe/Zurich", "expected": "2026-10-07T16:00:00Z"},
    {"name": "utc-5 still the previous day", "basis": "UTC_DAY-5", "now": "2026-10-07T03:00:00Z", "zone": "Europe/Zurich", "expected": "2026-10-06T05:00:00Z"},
    {"name": "utc+14 at its midnight", "basis": "UTC_DAY+14", "now": "2026-10-07T10:00:00Z", "zone": "Europe/Zurich", "expected": "2026-10-07T10:00:00Z"},
    {"name": "utc-12 one minute before its midnight", "basis": "UTC_DAY-12", "now": "2026-10-07T11:59:00Z", "zone": "Europe/Zurich", "expected": "2026-10-06T12:00:00Z"}
  ],
