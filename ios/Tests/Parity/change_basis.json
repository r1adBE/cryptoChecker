    {"name": "next day", "stamp": {"basis": "UTC_DAY", "dayStart": "2026-10-07T00:00:00Z"}, "basis": "UTC_DAY", "now": "2026-10-08T00:00:01Z", "zone": "UTC", "expected": false},
    {"name": "other basis (local)", "stamp": {"basis": "UTC_DAY", "dayStart": "2026-10-07T00:00:00Z"}, "basis": "LOCAL_DAY", "now": "2026-10-07T12:00:00Z", "zone": "Europe/Zurich", "expected": false},
    {"name": "other basis (rolling)", "stamp": {"basis": "UTC_DAY", "dayStart": "2026-10-07T00:00:00Z"}, "basis": "ROLLING_24H", "now": "2026-10-07T12:00:00Z", "zone": "UTC", "expected": false},
    {"name": "rolling stays current", "stamp": {"basis": "ROLLING_24H", "dayStart": 0}, "basis": "ROLLING_24H", "now": "2026-10-10T12:00:00Z", "zone": "UTC", "expected": true},
    {"name": "local day in zurich", "stamp": {"basis": "LOCAL_DAY", "dayStart": "2026-10-06T22:00:00Z"}, "basis": "LOCAL_DAY", "now": "2026-10-07T12:00:00Z", "zone": "Europe/Zurich", "expected": true},
    {"name": "local day, other zone", "stamp": {"basis": "LOCAL_DAY", "dayStart": "2026-10-06T22:00:00Z"}, "basis": "LOCAL_DAY", "now": "2026-10-07T12:00:00Z", "zone": "UTC", "expected": false},
    {"name": "same day start but other zone", "stamp": {"basis": "UTC_DAY+8", "dayStart": "2026-10-06T16:00:00Z"}, "basis": "UTC_DAY+9", "now": "2026-10-07T12:00:00Z", "zone": "UTC", "expected": false},
    {"name": "fixed zone, same day", "stamp": {"basis": "UTC_DAY+8", "dayStart": "2026-10-06T16:00:00Z"}, "basis": "UTC_DAY+8", "now": "2026-10-07T15:59:00Z", "zone": "UTC", "expected": true},
    {"name": "fixed zone, next day began", "stamp": {"basis": "UTC_DAY+8", "dayStart": "2026-10-06T16:00:00Z"}, "basis": "UTC_DAY+8", "now": "2026-10-07T16:00:00Z", "zone": "UTC", "expected": false}
  ],
