{
  "description": "Ergebnis von Sichern/Wiederherstellen als Dialog statt Toast (Android BackupResultPresentation.kt, iOS BackupResultPresentation.swift): Dialog, wenn Paare/Alarme über den Grenzen weggelassen (droppedPairs/droppedAlarms > 0), die Sperre an blieb (appLockKept), ein Hinweis zum eigenen Bitcoin-Server da ist (addressServerNote KEPT/PUBLIC/CHANGED), der Haupttext (key) in longKeys steht oder die Anzeigebreite des Gesamttexts grösser ist als toastMaxChars / max(1, fontScale); sonst Toast. Anzeigebreite: je Unicode-Codepunkt 1, in wideRanges (East Asian Wide/Fullwidth, Grenzen hexadezimal, einschliesslich) 2. fontScale = Schriftgrösse des Systems (Android Configuration.fontScale, iOS UIFontMetrics.default.scaledValue(for: 1)); fehlt er, gilt 1. «expected»: toast | dialog.",
  "toastMaxChars": 80,
  "wideRanges": [
    [
      "1100",
      "115F"
    ],
    [
      "2E80",
      "A4CF"
    ],
    [
      "AC00",
      "D7A3"
    ],
    [
      "F900",
      "FAFF"
    ],
    [
      "FE30",
      "FE4F"
    ],
    [
      "FF00",
      "FF60"
    ],
    [
      "FFE0",
      "FFE6"
    ],
    [
      "20000",
      "3FFFD"
    ]
  ],
  "longKeys": [
    "backup_not_enough_memory",
    "backup_storage_kept",
    "backup_restore_storage_in_memory",
    "backup_restore_journal_unavailable",
    "backup_not_verified",
    "backup_restore_newer_version"
  ],
  "cases": [
    {
      "description": "Gesichert: kurz → Toast",
      "key": "backup_exported",
      "text": "Backup saved.",
      "droppedPairs": 0,
      "droppedAlarms": 0,
      "appLockKept": false,
      "addressServerNote": null,
      "expected": "toast"
    },
    {
      "description": "Fehlgeschlagen (englisch, 49 Zeichen) → Toast",
      "key": "backup_failed",
      "text": "That didn't work. Is it a Crypto Checker backup?",
      "droppedPairs": 0,
      "droppedAlarms": 0,
      "appLockKept": false,
      "addressServerNote": null,
      "expected": "toast"
    },
    {
      "description": "Zu wenig Arbeitsspeicher: Schlüssel immer Dialog, auch bei kurzem Text",
      "key": "backup_not_enough_memory",
      "text": "Kurz.",
      "droppedPairs": 0,
      "droppedAlarms": 0,
      "appLockKept": false,
      "addressServerNote": null,
      "expected": "dialog"
    },
    {
      "description": "Gespeicherter Stand nicht lesbar: immer Dialog",
      "key": "backup_storage_kept",
