{
  "description": "PercentText (Android PercentText.kt / iOS PercentText.swift): value with exactly 'decimals' decimal places (half up), digits and percent sign of 'locale' (CLDR pattern: space before % in de/fr/cs/da/es/fi/nb/ro/ru/sv except de_CH, de_LI, fr_CH, es_MX; also en_AT/en_DE/en_DK/en_FI/en_SE (full locale per CLDR, not only the language); tr prefix; ar/fa U+066A). 'signed' = sign before everything (U+2212 minus, none when rounded to 0); 'unsigned' = absolute value. Without bidi isolation.",
  "cases": [
    {
      "locale": "en_US",
      "kind": "signed",
      "value": 2.4,
      "decimals": 1,
      "expected": "+2.4%"
    },
    {
      "locale": "en_US",
      "kind": "signed",
      "value": -1.36,
      "decimals": 1,
      "expected": "\u22121.4%"
    },
    {
      "locale": "en_US",
      "kind": "signed",
      "value": 0.004,
      "decimals": 2,
      "expected": "0.00%"
    },
    {
      "locale": "en_US",
      "kind": "unsigned",
      "value": -2.5,
      "decimals": 2,
      "expected": "2.50%"
    },
    {
      "locale": "en_US",
      "kind": "signed",
      "value": 1.005,
      "decimals": 2,
      "expected": "+1.01%"
    },
    {
      "locale": "de_DE",
      "kind": "signed",
      "value": 2.4,
      "decimals": 2,
      "expected": "+2,40\u00a0%"
    },
    {
      "locale": "de_DE",
      "kind": "unsigned",
      "value": 58.44,
      "decimals": 1,
      "expected": "58,4\u00a0%"
    },
    {
      "locale": "de_CH",
      "kind": "signed",
      "value": 2.4,
      "decimals": 2,
      "expected": "+2.40%"
    },
    {
      "locale": "de_AT",
      "kind": "signed",
      "value": -0.05,
      "decimals": 1,
      "expected": "\u22120,1\u00a0%"
    },
    {
      "locale": "fr_FR",
      "kind": "signed",
      "value": -2.4,
      "decimals": 1,
      "expected": "\u22122,4\u00a0%"
    },
    {
      "locale": "fr_CH",
      "kind": "signed",
      "value": 2.4,
      "decimals": 0,
      "expected": "+2%"
    },
    {
      "locale": "es_ES",
      "kind": "signed",
      "value": 12.345,
      "decimals": 2,
      "expected": "+12,35\u00a0%"
    },
    {
      "locale": "it_IT",
      "kind": "signed",
      "value": 2.4,
      "decimals": 1,
      "expected": "+2,4%"
    },
    {
      "locale": "tr_TR",
      "kind": "signed",
      "value": 2.4,
      "decimals": 1,
      "expected": "+%2,4"
    },
    {
      "locale": "tr_TR",
      "kind": "unsigned",
      "value": 0.0,
      "decimals": 2,
      "expected": "%0,00"
    },
    {
      "locale": "ar_EG",
      "kind": "signed",
      "value": 2.4,
      "decimals": 1,
      "expected": "+\u0662\u066b\u0664\u066a"
    },
    {
      "locale": "fa_IR",
      "kind": "signed",
      "value": -2.4,
      "decimals": 1,
      "expected": "\u2212\u06f2\u066b\u06f4\u066a"
    },
    {
      "locale": "ja_JP",
      "kind": "signed",
      "value": 2.4,
      "decimals": 1,
      "expected": "+2.4%"
    },
    {
      "locale": "es_MX",
      "kind": "signed",
      "value": -2.4,
      "decimals": 0,
      "expected": "\u22122%"
    },
    {
      "locale": "es_US",
      "kind": "unsigned",
      "value": 2.4,
      "decimals": 0,
      "expected": "2\u00a0%"
    },
    {
      "locale": "en_DE",
      "kind": "unsigned",
      "value": 2.4,
      "decimals": 0,
      "expected": "2\u00a0%"
    },
    {
      "locale": "en_AT",
      "kind": "signed",
      "value": -2.4,
      "decimals": 0,
      "expected": "\u22122\u00a0%"
    },
    {
      "locale": "en_CH",
      "kind": "signed",
      "value": 2.4,
      "decimals": 0,
      "expected": "+2%"
    },
    {
      "locale": "en_US",
      "kind": "unsigned",
      "value": 2.4,
      "decimals": 1,
      "expected": "2.4%"
    },
    {
      "locale": "de_CH",
      "kind": "unsigned",
      "value": 58.44,
      "decimals": 1,
      "expected": "58.4%"
    }
  ],
  "watch_change": {
    "description": "Change on the watch (Android wear WatchFormat.change / iOS WatchPercent.change): like PercentText.signed with 2 decimals in the locale's notation, value null -> '\u2014'; in RTL languages (ar, fa, he ...) wrapped as LTR isolate (U+2066 ... U+2069) like BidiText.ltr on the phone.",
    "cases": [
      {
        "locale": "en_US",
        "value": 1.234,
        "expected": "+1.23%"
      },
      {
        "locale": "en_US",
        "value": -0.5,
        "expected": "\u22120.50%"
      },
      {
        "locale": "en_US",
        "value": 0.004,
        "expected": "0.00%"
      },
      {
        "locale": "en_US",
        "value": -0.005,
        "expected": "\u22120.01%"
      },
      {
        "locale": "en_US",
        "value": null,
        "expected": "\u2014"
      },
      {
        "locale": "de_DE",
        "value": 2.4,
        "expected": "+2,40\u00a0%"
      },
      {
        "locale": "de_CH",
        "value": 2.4,
        "expected": "+2.40%"
      },
      {
        "locale": "fr_FR",
        "value": -12.345,
        "expected": "\u221212,35\u00a0%"
      },
      {
        "locale": "tr_TR",
        "value": 2.4,
        "expected": "+%2,40"
      },
      {
        "locale": "ar_EG",
        "value": 2.4,
        "expected": "\u2066+\u0662\u066b\u0664\u0660\u066a\u2069"
      },
      {
        "locale": "he_IL",
        "value": -1.5,
        "expected": "\u2066\u22121.50%\u2069"
      }
    ]
  }
}
