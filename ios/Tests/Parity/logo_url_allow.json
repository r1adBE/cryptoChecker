    },
    {
      "url": "https:///x.png",
      "expected": false,
      "_why": "ohne Host"
    },
    {
      "url": "https://coin-images.coingecko.com.evil.example/x.png",
      "expected": false,
      "_why": "fremder Host"
    },
    {
