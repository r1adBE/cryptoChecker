      "expected": false,
      "_why": "Freigabe-Name nur im Pfad"
    },
    {
      "url": "https://coin-images.coingecko.com/coins/images/missing_large.png",
      "expected": false,
      "_why": "Platzhalter ohne Logo"
    },
