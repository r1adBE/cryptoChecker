{
  "description": "Shared cases for the futures alarms (Android DerivativesAlarm.kt / iOS DerivativesAlarm.swift): «Funding above/below x %» and «Open interest rises/falls by x % in N hours». Times: 'now' in epoch ms; history entries are [minutesAgo, units] relative to 'now' (negative = in the future). Sequences step 5 minutes; an alarm re-arms (referenceAt 0) on 'rearm' and on 'fire' records lastTriggeredAt/referenceAt and switches off unless repeating. Numbers JSON cannot hold are strings (\"NaN\").",
  "now": 1700000000000,
  "stepMillis": 300000,
  "decide": [
    {"name": "funding above fires at the threshold", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.05, "armed": true, "expected": "fire", "cooldownMinutes": 0},
    {"name": "funding above stays quiet just below", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.0499, "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "funding below with a negative threshold", "condition": "FUNDING_BELOW", "threshold": -0.01, "value": -0.01, "armed": true, "expected": "fire", "cooldownMinutes": 0},
    {"name": "funding below zero fires when funding turns negative", "condition": "FUNDING_BELOW", "threshold": 0, "value": -0.0001, "armed": true, "expected": "fire", "cooldownMinutes": 0},
    {"name": "funding below stays quiet above", "condition": "FUNDING_BELOW", "threshold": -0.01, "value": -0.0099, "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "reported funding inside the hysteresis stays reported", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.046, "armed": false, "expected": "none", "cooldownMinutes": 0},
    {"name": "reported funding beyond the hysteresis re-arms", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.044, "armed": false, "expected": "rearm", "cooldownMinutes": 0},
    {"name": "reported funding below re-arms above", "condition": "FUNDING_BELOW", "threshold": -0.01, "value": -0.004, "armed": false, "expected": "rearm", "cooldownMinutes": 0},
    {"name": "reported funding below inside the hysteresis", "condition": "FUNDING_BELOW", "threshold": -0.01, "value": -0.006, "armed": false, "expected": "none", "cooldownMinutes": 0},
    {"name": "disabled alarm never fires", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 1, "armed": true, "enabled": false, "expected": "none", "cooldownMinutes": 0},
    {"name": "missing value does nothing", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": null, "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "NaN value does nothing", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": "NaN", "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "cooldown suppresses", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.06, "armed": true, "lastTriggeredAt": 1699999400000, "cooldownMinutes": 30, "expected": "none"},
    {"name": "cooldown over", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.06, "armed": true, "lastTriggeredAt": 1699998200000, "cooldownMinutes": 30, "expected": "fire"},
    {"name": "no cooldown", "condition": "FUNDING_ABOVE", "threshold": 0.05, "value": 0.06, "armed": true, "lastTriggeredAt": 1699999940000, "cooldownMinutes": 0, "expected": "fire"},
    {"name": "open interest up fires at the threshold", "condition": "OI_UP", "threshold": 10, "value": 10, "armed": true, "expected": "fire", "cooldownMinutes": 0},
    {"name": "open interest up stays quiet below", "condition": "OI_UP", "threshold": 10, "value": 9.99, "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "open interest down fires at minus the threshold", "condition": "OI_DOWN", "threshold": 5, "value": -5, "armed": true, "expected": "fire", "cooldownMinutes": 0},
    {"name": "open interest down ignores a rise", "condition": "OI_DOWN", "threshold": 5, "value": 5, "armed": true, "expected": "none", "cooldownMinutes": 0},
    {"name": "reported open interest up re-arms one point below", "condition": "OI_UP", "threshold": 10, "value": 8.9, "armed": false, "expected": "rearm", "cooldownMinutes": 0},
    {"name": "reported open interest up inside the hysteresis", "condition": "OI_UP", "threshold": 10, "value": 9.1, "armed": false, "expected": "none", "cooldownMinutes": 0},
    {"name": "reported open interest down re-arms", "condition": "OI_DOWN", "threshold": 5, "value": -3.9, "armed": false, "expected": "rearm", "cooldownMinutes": 0},
    {"name": "reported open interest down inside the hysteresis", "condition": "OI_DOWN", "threshold": 5, "value": -4.1, "armed": false, "expected": "none", "cooldownMinutes": 0},
    {"name": "price condition is not a derivatives alarm", "condition": "PRICE_ABOVE", "threshold": 0.05, "value": 1, "armed": true, "expected": "none", "cooldownMinutes": 0}
  ],
  "sequences": [
    {"name": "funding above: fires, waits for the hysteresis, fires again", "condition": "FUNDING_ABOVE", "threshold": 0.05, "repeating": true, "cooldownMinutes": 0, "values": [0.01, 0.05, 0.06, 0.047, 0.05, 0.044, 0.051], "expectedFires": 2},
    {"name": "funding below a negative level", "condition": "FUNDING_BELOW", "threshold": -0.01, "repeating": true, "cooldownMinutes": 0, "values": [0.01, -0.012, -0.004, -0.0049, 0.0, -0.02], "expectedFires": 2},
    {"name": "open interest up", "condition": "OI_UP", "threshold": 10, "repeating": true, "cooldownMinutes": 0, "values": [2, 10.5, 9.5, 8.9, 12], "expectedFires": 2},
    {"name": "open interest down", "condition": "OI_DOWN", "threshold": 5, "repeating": true, "cooldownMinutes": 0, "values": [-3, -5, -4.5, -3.9, -6], "expectedFires": 2},
    {"name": "one-shot fires once", "condition": "FUNDING_ABOVE", "threshold": 0.05, "repeating": false, "cooldownMinutes": 0, "values": [0.06, 0.01, 0.07], "expectedFires": 1},
    {"name": "cooldown delays the second report", "condition": "FUNDING_ABOVE", "threshold": 0.05, "repeating": true, "cooldownMinutes": 30, "values": [0.06, 0.01, 0.06, 0.06, 0.06, 0.06, 0.06], "expectedFires": 2},
    {"name": "missing values change nothing", "condition": "FUNDING_ABOVE", "threshold": 0.05, "repeating": true, "cooldownMinutes": 0, "values": [0.06, null, 0.01, null, 0.06], "expectedFires": 2},
    {"name": "open interest without an old enough sample never fires", "condition": "OI_UP", "threshold": 10, "repeating": true, "cooldownMinutes": 0, "values": [null, null, null], "expectedFires": 0}
  ],
  "oiChange": [
    {"name": "one hour: sample exactly one hour old", "history": [[60, 100]], "current": 110, "hours": 1, "expected": 10.0},
    {"name": "one hour: sample too young", "history": [[59, 100]], "current": 110, "hours": 1, "expected": null},
    {"name": "one hour: sample too old", "history": [[91, 100]], "current": 110, "hours": 1, "expected": null},
    {"name": "one hour: oldest allowed age", "history": [[90, 100]], "current": 110, "hours": 1, "expected": 10.0},
    {"name": "one hour: newest sample at least an hour old wins", "history": [[80, 100], [65, 105], [30, 200]], "current": 110, "hours": 1, "expected": 4.761904761904773},
    {"name": "no current value", "history": [[60, 100]], "current": null, "hours": 1, "expected": null},
    {"name": "zero current value", "history": [[60, 100]], "current": 0, "hours": 1, "expected": null},
    {"name": "zero sample ignored", "history": [[70, 0]], "current": 110, "hours": 1, "expected": null},
    {"name": "four hours: fall", "history": [[250, 200]], "current": 150, "hours": 4, "expected": -25.0},
    {"name": "four hours: too old", "history": [[301, 200]], "current": 150, "hours": 4, "expected": null},
    {"name": "24 hours", "history": [[1500, 50]], "current": 55, "hours": 24, "expected": 10.000000000000014},
    {"name": "24 hours: too old", "history": [[1801, 50]], "current": 55, "hours": 24, "expected": null},
    {"name": "empty history", "history": [], "current": 55, "hours": 4, "expected": null}
  ],
  "prune": [
    {"name": "drops samples older than 26 hours", "history": [[1600, 10], [1500, 10], [10, 10]], "expected": [1500, 10]},
    {"name": "drops samples from the future", "history": [[-2, 10], [0, 10]], "expected": [0]},
    {"name": "keeps 4-minute spacing in the last two hours", "history": [[5, 10], [20, 10], [1, 10], [17, 10], [15, 10], [10, 10]], "expected": [20, 15, 10, 5, 1]},
    {"name": "thins older samples to 25 minutes", "history": [[290, 1], [300, 1], [280, 1], [270, 1], [260, 1], [250, 1], [240, 1], [200, 1], [130, 1], [125, 1]], "expected": [300, 270, 240, 200, 130]},
    {"name": "drops invalid samples", "history": [[30, 0], [20, "NaN"], [10, 5]], "expected": [10]}
  ],
  "append": [
    {"name": "first sample", "history": [], "point": [0, 100], "expected": [0]},
    {"name": "too soon after the last sample", "history": [[3, 100]], "point": [0, 100], "expected": [3]},
    {"name": "four minutes later", "history": [[4, 100]], "point": [0, 101], "expected": [4, 0]},
    {"name": "invalid sample not added", "history": [[10, 100]], "point": [0, 0], "expected": [10]}
  ],
  "parseFunding": [
    {"text": "0,05", "decimalSeparator": ",", "expected": 0.05},
    {"text": "-0,01", "decimalSeparator": ",", "expected": -0.01},
    {"text": "−0.01", "decimalSeparator": ".", "expected": -0.01},
    {"text": "+0.02", "decimalSeparator": ".", "expected": 0.02},
    {"text": "0", "decimalSeparator": ".", "expected": 0},
    {"text": "-0", "decimalSeparator": ".", "expected": 0},
    {"text": "0,000", "decimalSeparator": ",", "expected": 0},
    {"text": "10", "decimalSeparator": ".", "expected": 10},
    {"text": "10.5", "decimalSeparator": ".", "expected": null},
    {"text": "-", "decimalSeparator": ".", "expected": null},
    {"text": "", "decimalSeparator": ".", "expected": null},
    {"text": "abc", "decimalSeparator": ".", "expected": null},
    {"text": "- 0.03", "decimalSeparator": ".", "expected": -0.03},
    {"text": "0.0125", "decimalSeparator": ".", "expected": 0.0125},
    {"text": "-10", "decimalSeparator": ".", "expected": -10},
    {"text": "1,5", "decimalSeparator": ",", "expected": 1.5}
  ],
  "supports": [
    {"marketKey": "BinanceFutures", "perpetual": true, "expected": true},
    {"marketKey": "BinanceFutures", "perpetual": false, "expected": false},
    {"marketKey": "BybitFutures", "perpetual": true, "expected": true},
    {"marketKey": "OkexFutures", "perpetual": true, "expected": true},
    {"marketKey": "KrakenFutures", "perpetual": true, "expected": false},
    {"marketKey": "Binance", "perpetual": true, "expected": false}
  ],
  "oiWindow": [
    {"hours": 0, "expected": 1},
    {"hours": 1, "expected": 1},
    {"hours": 2, "expected": 4},
    {"hours": 4, "expected": 4},
    {"hours": 12, "expected": 24},
    {"hours": 24, "expected": 24},
    {"hours": 48, "expected": 24}
  ]
}
