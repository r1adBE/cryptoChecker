        "body": "{\"success\":true,\"data\":{\"rows\":[{\"symbol\":\"PERP_MAGIC_USDT\",\"indexPrice\":\"0.1201\",\"markPrice\":\"0.12\",\"estFundingRate\":\"0.00005\",\"lastFundingRate\":\"0.0001\",\"nextFundingTime\":1728547200000,\"openInterest\":\"1500000\",\"24hOpen\":\"0.118\",\"24hClose\":\"0.1201\",\"24hHigh\":\"0.125\",\"24hLow\":\"0.115\",\"24hVolume\":\"12000000\",\"24hAmount\":\"1440000\"}]},\"timestamp\":1728540000123}"
      },
      "expected": {
        "fundingRatePercent": 0.005,
        "nextFundingTime": 1728547200000,
        "openInterestUsd": 180000.0,
        "source": "WOO X Futures"
      }
    },
