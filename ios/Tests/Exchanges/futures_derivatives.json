{
  "exchange": "Futures funding / open interest (FuturesParsers)",
  "description": "Hand-written in the documented response formats (no live capture possible in the build environment); field names are exactly the ones FuturesParsers reads. Bodies are raw response text (null = optional request failed); expectations are the parsed FuturesInfo (fundingRatePercent = rate x 100, openInterestUsd null = must be absent). 'notes' = FuturesSources.note (null = data of the observed exchange). Shared by FuturesParsersTest.kt (Android) and FuturesParsersTests.swift (iOS). Not an exchange_*.json file: ExchangeContractTest only reads ticker fixtures.",
  "endpoints": {
    "woo": "GET https://api.woox.io/v3/public/futures?symbol=PERP_BTC_USDT",
    "bitget": "GET https://api.bitget.com/api/v2/mix/market/ticker?symbol=BTCUSDT&productType=USDT-FUTURES | /api/v2/mix/market/funding-time?symbol=BTCUSDT&productType=USDT-FUTURES",
    "mexc": "GET https://contract.mexc.com/api/v1/contract/ticker?symbol=BTC_USDT | /api/v1/contract/detail?symbol=BTC_USDT | /api/v1/contract/funding_rate/BTC_USDT",
    "htx": "GET https://api.hbdm.com/linear-swap-api/v1/swap_funding_rate?contract_code=BTC-USDT | /linear-swap-api/v1/swap_open_interest?contract_code=BTC-USDT&business_type=swap",
    "hyperliquid": "POST https://api.hyperliquid.xyz/info {\"type\":\"metaAndAssetCtxs\"}",
    "deribit": "GET https://www.deribit.com/api/v2/public/ticker?instrument_name=BTC-PERPETUAL",
    "binanceCoinM": "GET https://dapi.binance.com/dapi/v1/premiumIndex?symbol=BTCUSD_PERP | /dapi/v1/openInterest?symbol=BTCUSD_PERP"
  },
  "cases": [
    {
