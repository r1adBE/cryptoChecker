{
  "exchange": "Foxbit",
  "description": "Built from live responses of 3 November 2026 (shortened to a few rows; prices as answered then); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS); full recorded responses in recorded/recorded_foxbit.json (tools/record_exchange_fixtures.py).",
  "endpoints": {
    "pairs": "GET https://api.foxbit.com.br/rest/v3/markets",
    "single": "GET https://api.foxbit.com.br/rest/v3/markets/btcbrl/ticker/24hr",
    "bulk": "GET https://api.foxbit.com.br/rest/v3/markets/ticker/24hr"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "markets: base/quote symbols in upper case, id stays lower case",
      "exchangeKey": "Foxbit",
      "requestId": 0,
      "body": "{\"data\":[{\"base\":{\"name\":\"Bitcoin\",\"precision\":8,\"symbol\":\"btc\",\"type\":\"CRYPTO\"},\"quote\":{\"name\":\"Real\",\"precision\":2,\"symbol\":\"brl\",\"type\":\"FIAT\"},\"symbol\":\"btcbrl\",\"quantity_min\":\"0.00000103\",\"quantity_increment\":\"0.00000001\",\"quantity_precision\":8,\"price_min\":\"0.0001\",\"price_increment\":\"1.0\",\"price_precision\":0,\"default_fees\":{\"maker\":\"0.0025\",\"taker\":\"0.005\"},\"order_type\":[\"MARKET\",\"LIMIT\",\"INSTANT\",\"STOP_MARKET\",\"STOP_LIMIT\",\"TRAILING_STOP_MARKET\",\"TRAILING_STOP_LIMIT\",\"OCO\"]},{\"base\":{\"name\":\"Ethereum\",\"precision\":8,\"symbol\":\"eth\",\"type\":\"CRYPTO\"},\"quote\":{\"name\":\"Real\",\"precision\":2,\"symbol\":\"brl\",\"type\":\"FIAT\"},\"symbol\":\"ethbrl\",\"quantity_min\":\"0.00003601\",\"quantity_increment\":\"0.00000001\",\"quantity_precision\":8,\"price_min\":\"0.0001\",\"price_increment\":\"0.1\",\"price_precision\":1,\"default_fees\":{\"maker\":\"0.0025\",\"taker\":\"0.005\"},\"order_type\":[\"MARKET\",\"LIMIT\",\"INSTANT\",\"STOP_MARKET\",\"STOP_LIMIT\",\"TRAILING_STOP_MARKET\",\"TRAILING_STOP_LIMIT\",\"OCO\"]},{\"base\":{\"name\":\"Tether\",\"precision\":8,\"symbol\":\"usdt\",\"type\":\"CRYPTO\"},\"quote\":{\"name\":\"Real\",\"precision\":2,\"symbol\":\"brl\",\"type\":\"FIAT\"},\"symbol\":\"usdtbrl\",\"quantity_min\":\"0.08261125\",\"quantity_increment\":\"0.00001\",\"quantity_precision\":5,\"price_min\":\"0.0001\",\"price_increment\":\"0.0001\",\"price_precision\":4,\"default_fees\":{\"maker\":\"0.0025\",\"taker\":\"0.005\"},\"order_type\":[\"MARKET\",\"LIMIT\",\"INSTANT\",\"STOP_MARKET\",\"STOP_LIMIT\",\"OCO\"]}]}",
      "expect": {
        "count": 3,
        "pairs": {
          "btcbrl": {
            "base": "BTC",
            "quote": "BRL"
          },
          "ethbrl": {
            "base": "ETH",
            "quote": "BRL"
          },
          "usdtbrl": {
            "base": "USDT",
            "quote": "BRL"
          }
        }
