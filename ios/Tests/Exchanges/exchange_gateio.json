{
  "exchange": "Gate.io",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.gateio.ws/api/v4/spot/tickers?currency_pair=BTC_USDT",
    "bulk": "GET https://api.gateio.ws/api/v4/spot/tickers"
  },
  "cases": [
    {
      "kind": "single",
      "name": "spot ticker: change_percentage used, change_utc0/utc8 ignored",
      "market": "GateIo",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTC_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"}]",
      "expect": {
        "last": 62000.1,
        "bid": 62000.1,
        "ask": 62000.2,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.52,
        "volQuote": 744460123.45,
        "change24hPercent": 2.48,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "error payload: invalid currency pair",
      "market": "GateIo",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"label\":\"INVALID_CURRENCY_PAIR\",\"message\":\"Invalid currency pair FOO_USDT\"}",
      "expect": {
        "error": true,
        "message": "Invalid currency pair FOO_USDT"
      }
    },
    {
      "kind": "single",
      "name": "empty array",
      "market": "GateIo",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[]",
      "expect": {
        "error": true,
        "message": null,
        "thrown": "No data"
      }
    },
    {
      "kind": "bulk",
      "name": "bulk tickers",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"ETH_BTC\",\"last\":\"0.0396\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"}]",
      "expect": {
        "count": 2,
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1,
            "change24hPercent": 2.48,
            "exchangeTime": null
          },
          "ETH_BTC": {
            "last": 0.0396,
            "exchangeTime": null
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: one pair without order book (empty highest_bid) should not drop the rest",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"NEW_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"}]",
      "expect": {
        "count": 2,
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1,
            "exchangeTime": null
          },
          "NEW_USDT": {
            "last": 62000.1,
            "bid": -1.0,
            "ask": 62000.2,
            "exchangeTime": null
          }
        }
      },
      "note": "Gate sends \"\" for highest_bid/lowest_ask without an order book: no bid/ask, ticker stays"
    },
    {
      "kind": "single",
      "name": "single ticker with empty highest_bid/lowest_ask",
      "market": "GateIo",
      "pair": {
        "base": "NEW",
        "quote": "USDT",
        "id": "NEW_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "[{\"currency_pair\":\"NEW_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"}]",
      "expect": {
        "last": 62000.1,
        "bid": -1.0,
        "ask": -1.0,
        "change24hPercent": 2.48
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: one unreadable entry (last not a number) is reported, the rest stays",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"OLD_USDT\",\"last\":\"n/a\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"}]",
      "expect": {
        "count": 1,
        "absent": [
          "OLD_USDT"
        ],
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1,
            "exchangeTime": null
          }
        },
        "failed": [
          "OLD_USDT"
        ]
      }
    },
    {
      "kind": "single",
      "name": "error payload with message null: no error text (not \"null\")",
      "market": "GateIo",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"label\":\"INVALID_CURRENCY_PAIR\",\"message\":null}",
      "expect": {
        "error": true,
        "message": null
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: renamed field «last» in one row — that pair is reported as unreadable, the rest stays",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\",\"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\",\"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\",\"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"ETH_BTC\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\",\"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\",\"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\",\"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\",\"last_renamed\":\"0.0396\"}]",
      "expect": {
        "count": 1,
        "absent": [
          "ETH_BTC"
        ],
        "failed": [
          "ETH_BTC"
        ]
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: renamed field «last» in every row — format error of the whole response",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\",\"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\",\"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\",\"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\",\"last_renamed\":\"62000.1\"},{\"currency_pair\":\"ETH_BTC\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\",\"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\",\"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\",\"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\",\"last_renamed\":\"0.0396\"}]",
      "expect": {
        "error": true
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: entries with empty or zero last (inactive) are skipped, not reported as unreadable",
      "market": "GateIo",
      "requestId": 0,
      "body": "[{\"currency_pair\":\"BTC_USDT\",\"last\":\"62000.1\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"ETH_BTC\",\"last\":\"0.0396\",\"lowest_ask\":\"62000.2\",\"lowest_size\":\"0.5123\", \"highest_bid\":\"62000.1\",\"highest_size\":\"1.2\",\"change_percentage\":\"2.48\",\"change_utc0\":\"1.64\",\"change_utc8\":\"1.97\", \"base_volume\":\"12100.52\",\"quote_volume\":\"744460123.45\",\"high_24h\":\"62500\",\"low_24h\":\"60000\",\"etf_net_value\":\"\", \"etf_pre_net_value\":\"\",\"etf_pre_timestamp\":0,\"etf_leverage\":\"\"},{\"currency_pair\":\"OLD_USDT\",\"last\":\"\",\"lowest_ask\":\"\",\"lowest_size\":\"\",\"highest_bid\":\"\",\"highest_size\":\"\",\"change_percentage\":\"\",\"base_volume\":\"0\",\"quote_volume\":\"0\",\"high_24h\":\"0\",\"low_24h\":\"0\"},{\"currency_pair\":\"ZERO_USDT\",\"last\":\"0\",\"lowest_ask\":\"\",\"highest_bid\":\"\",\"change_percentage\":\"0\",\"base_volume\":\"0\",\"quote_volume\":\"0\",\"high_24h\":\"0\",\"low_24h\":\"0\"}]",
      "expect": {
        "count": 2,
        "absent": [
          "OLD_USDT",
          "ZERO_USDT"
        ],
        "failed": []
      }
    }
  ]
}
