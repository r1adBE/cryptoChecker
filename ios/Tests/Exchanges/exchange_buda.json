    },
    {
      "kind": "single",
      "name": "unknown market (HTTP 404) -> exchange text",
      "exchangeKey": "Buda",
      "pair": {
        "base": "FOO",
        "quote": "CLP",
        "id": "FOO-CLP",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"message\":\"Not found\",\"code\":\"not_found\"}",
      "expect": {
        "error": true,
        "message": "Not found"
      }
    },
    {
      "kind": "single",
      "name": "price 0 -> no price",
      "exchangeKey": "Buda",
      "pair": {
        "base": "BTC",
        "quote": "CLP",
        "id": "BTC-CLP",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"ticker\":{\"market_id\":\"BTC-CLP\",\"last_price\":[\"0.0\",\"CLP\"],\"min_ask\":[\"75198000.0\",\"CLP\"],\"max_bid\":[\"75078601.0\",\"CLP\"],\"volume\":[\"4.86242737\",\"BTC\"],\"quote_volume\":[\"368807211.17\",\"CLP\"],\"price_variation_24h\":\"-0.037\",\"price_variation_7d\":\"-0.048\"}}",
      "expect": {
        "error": true
      }
    },
    {
      "kind": "bulk",
      "name": "tickers: price and 24 h change only",
      "exchangeKey": "Buda",
      "requestId": 0,
      "body": "{\"tickers\":[{\"market_id\":\"BTC-CLP\",\"price_variation_24h\":\"-0.037\",\"price_variation_7d\":\"-0.048\",\"last_price\":[\"75293694.0\",\"CLP\"]},{\"market_id\":\"ETH-CLP\",\"price_variation_24h\":\"-0.032\",\"price_variation_7d\":\"-0.039\",\"last_price\":[\"2213091.0\",\"CLP\"]}]}",
      "expect": {
        "count": 2,
        "tickers": {
          "BTC-CLP": {
            "last": 75293694.0,
            "bid": -1.0,
            "change24hPercent": -3.6999999999999997
          },
          "ETH-CLP": {
            "last": 2213091.0
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk: renamed «last_price» in one row reported as unreadable; price 0 skipped silently",
      "exchangeKey": "Buda",
      "requestId": 0,
      "body": "{\"tickers\":[{\"market_id\":\"BTC-CLP\",\"price_variation_24h\":\"-0.037\",\"price_variation_7d\":\"-0.048\",\"last_price\":[\"75293694.0\",\"CLP\"]},{\"market_id\":\"ETH-CLP\",\"price_variation_24h\":\"-0.032\",\"price_variation_7d\":\"-0.039\",\"price\":[\"2213091.0\",\"CLP\"]},{\"market_id\":\"NEW-CLP\",\"price_variation_24h\":\"-0.037\",\"price_variation_7d\":\"-0.048\",\"last_price\":[\"0.0\",\"CLP\"]}]}",
      "expect": {
        "count": 1,
        "absent": [
          "ETH-CLP",
          "NEW-CLP"
        ],
        "failed": [
          "ETH-CLP"
        ],
        "tickers": {
          "BTC-CLP": {
            "last": 75293694.0
          }
        }
      }
    }
  ]
