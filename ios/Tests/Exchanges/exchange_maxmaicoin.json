      "expect": {
        "last": 2508653.2,
        "bid": 2508000.0,
        "ask": 2508533.8,
        "high": 2577551.0,
        "low": 2505882.3,
        "vol": 15.8211,
        "volQuote": 39544462.79887654,
        "change24hPercent": -2.1967563352826436,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "pair without stored id: market built from base and quote in lower case",
      "exchangeKey": "MaxMaicoin",
      "pair": {
        "base": "BTC",
        "quote": "TWD",
        "id": null,
        "contract": "NONE"
      },
      "requestId": 0,
