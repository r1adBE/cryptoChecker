{
  "exchange": "MaxMaicoin",
  "description": "Built from live responses of 3 November 2026 (shortened to a few rows; prices as answered then); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS); full recorded responses in recorded/recorded_maxmaicoin.json (tools/record_exchange_fixtures.py).",
  "endpoints": {
    "pairs": "GET https://max-api.maicoin.com/api/v3/markets",
    "single": "GET https://max-api.maicoin.com/api/v3/ticker?market=btctwd",
    "bulk": "GET https://max-api.maicoin.com/api/v3/tickers?markets%5B%5D=btctwd&markets%5B%5D=ethtwd"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "markets v3: status active only; units shown in upper case, id stays lower case",
      "exchangeKey": "MaxMaicoin",
      "requestId": 0,
      "body": "[{\"id\":\"btctwd\",\"status\":\"active\",\"base_unit\":\"btc\",\"base_unit_precision\":8,\"min_base_amount\":0.0001,\"quote_unit\":\"twd\",\"quote_unit_precision\":1,\"min_quote_amount\":250.0,\"m_wallet_supported\":true},{\"id\":\"usdttwd\",\"status\":\"active\",\"base_unit\":\"usdt\",\"base_unit_precision\":2,\"min_base_amount\":8.0,\"quote_unit\":\"twd\",\"quote_unit_precision\":3,\"min_quote_amount\":250.0,\"m_wallet_supported\":true},{\"id\":\"ethusdt\",\"status\":\"active\",\"base_unit\":\"eth\",\"base_unit_precision\":5,\"min_base_amount\":0.003,\"quote_unit\":\"usdt\",\"quote_unit_precision\":2,\"min_quote_amount\":8.0,\"m_wallet_supported\":true},{\"id\":\"oldtwd\",\"status\":\"suspended\",\"base_unit\":\"old\",\"base_unit_precision\":8,\"min_base_amount\":0.0001,\"quote_unit\":\"twd\",\"quote_unit_precision\":1,\"min_quote_amount\":250.0,\"m_wallet_supported\":true}]",
      "expect": {
        "count": 3,
        "absent": [
          "oldtwd"
        ],
        "pairs": {
          "btctwd": {
            "base": "BTC",
            "quote": "TWD"
          },
          "usdttwd": {
            "base": "USDT",
            "quote": "TWD"
          },
          "ethusdt": {
            "base": "ETH",
            "quote": "USDT"
          }
        }
      }
    },
