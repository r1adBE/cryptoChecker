      "exchangeKey": "MaxMaicoin",
      "requestId": 0,
      "body": "[{\"market\":\"btctwd\",\"at\":1793664349,\"buy\":\"2508000.0\",\"buy_vol\":\"0.00119617\",\"sell\":\"2508533.8\",\"sell_vol\":\"0.03626888\",\"open\":\"2565000.0\",\"low\":\"2505882.3\",\"high\":\"2577551.0\",\"last\":\"2508653.2\",\"vol\":\"15.8211\",\"vol_in_btc\":\"15.8211\",\"vol_in_quote\":\"39544462.798876538244\"},{\"market\":\"ethtwd\",\"at\":1793664350,\"buy\":\"73534.3\",\"buy_vol\":\"3.552958\",\"sell\":\"73572.6\",\"sell_vol\":\"0.280548\",\"open\":\"74551.8\",\"low\":\"73080.0\",\"high\":\"75730.0\",\"price\":\"73572.6\",\"vol\":\"601.5988\",\"vol_in_btc\":\"17.64136002016814839644\",\"vol_in_quote\":\"44094159.384564135792\"},{\"market\":\"usdttwd\",\"at\":1793664349,\"buy\":\"2508000.0\",\"buy_vol\":\"0.00119617\",\"sell\":\"2508533.8\",\"sell_vol\":\"0.03626888\",\"open\":\"2565000.0\",\"low\":\"2505882.3\",\"high\":\"2577551.0\",\"last\":\"2508653.2\",\"vol\":\"15.8211\",\"vol_in_btc\":\"15.8211\",\"vol_in_quote\":\"39544462.798876538244\"}]",
