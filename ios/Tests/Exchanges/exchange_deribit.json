{
  "exchange": "Deribit",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://www.deribit.com/api/v2/public/ticker?instrument_name=BTC-PERPETUAL",
    "bulk": "GET https://www.deribit.com/api/v2/public/get_book_summary_by_currency?currency=BTC&kind=future"
  },
  "cases": [
    {
      "kind": "single",
      "name": "ticker BTC-PERPETUAL (stats.price_change in %)",
      "market": "Deribit",
      "pair": {
        "base": "BTC",
        "quote": "USD",
        "id": "BTC-PERPETUAL",
        "contract": "INVERSE_PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"jsonrpc\":\"2.0\",\"result\":{\"timestamp\":1728540000123,\"stats\":{\"volume_usd\":1234567890.0,\"volume\":20000.5, \"price_change\":2.4794,\"low\":60000.0,\"high\":62500.0},\"state\":\"open\",\"settlement_price\":61000.12,\"open_interest\":1234567890, \"min_price\":61000.0,\"max_price\":63000.0,\"mark_price\":62005.5,\"last_price\":62000.0,\"interest_value\":0.1234, \"instrument_name\":\"BTC-PERPETUAL\",\"index_price\":62010.1,\"funding_8h\":0.0001,\"estimated_delivery_price\":62010.1, \"current_funding\":0.0,\"best_bid_price\":61999.5,\"best_bid_amount\":10000.0,\"best_ask_price\":62000.5,\"best_ask_amount\":20000.0}, \"usIn\":1728540000123456,\"usOut\":1728540000123789,\"usDiff\":333,\"testnet\":false}",
      "expect": {
        "last": 62000.0,
        "bid": 61999.5,
        "ask": 62000.5,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 20000.5,
        "volQuote": 1234567890.0,
        "change24hPercent": 2.4794,
        "timestamp": 1728540000123
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "market": "Deribit",
      "pair": {
        "base": "FOO",
        "quote": "USD",
        "id": "FOO-PERPETUAL",
        "contract": "PERPETUAL"
      },
      "requestId": 0,
      "body": "{\"jsonrpc\":\"2.0\",\"error\":{\"message\":\"Invalid params\",\"data\":{\"reason\":\"instrument not found\",\"param\":\"instrument_name\"},\"code\":-32602}, \"usIn\":1728540000123456,\"usOut\":1728540000123789,\"usDiff\":333,\"testnet\":false}",
      "expect": {
        "error": true,
        "message": "Invalid params"
      }
    },
    {
      "kind": "bulk",
      "name": "book summary: only perpetuals with a last price; USDC uses volume_notional",
      "market": "Deribit",
      "requestId": 0,
      "body": "{\"jsonrpc\":\"2.0\",\"result\":[ {\"volume_usd\":1234567890.0,\"volume\":20000.5,\"quote_currency\":\"USD\",\"price_change\":2.4794,\"open_interest\":1234567890,\"mid_price\":62000.0,\"mark_price\":62005.5,\"low\":60000.0,\"last\":62000.0,\"instrument_name\":\"BTC-PERPETUAL\",\"high\":62500.0,\"funding_8h\":0.0001,\"estimated_delivery_price\":62010.1,\"current_funding\":0.0,\"creation_timestamp\":1728540000123,\"bid_price\":61999.5,\"base_currency\":\"BTC\",\"ask_price\":62000.5}, {\"volume_usd\":12345.0,\"volume\":0.2,\"quote_currency\":\"USD\",\"price_change\":1.0,\"low\":61000.0,\"last\":62500.0,\"instrument_name\":\"BTC-27DEC24\",\"high\":63000.0,\"creation_timestamp\":1728540000123,\"bid_price\":62400.0,\"base_currency\":\"BTC\",\"ask_price\":62600.0}, {\"volume_usd\":0.0,\"volume\":0.0,\"quote_currency\":\"USD\",\"price_change\":null,\"low\":null,\"last\":null,\"instrument_name\":\"ETH-PERPETUAL\",\"high\":null,\"creation_timestamp\":1728540000123,\"bid_price\":null,\"base_currency\":\"ETH\",\"ask_price\":null}, {\"volume_notional\":4567890.12,\"volume\":30000.0,\"quote_currency\":\"USDC\",\"price_change\":-1.5,\"low\":140.0,\"last\":145.5,\"instrument_name\":\"SOL_USDC-PERPETUAL\",\"high\":150.0,\"creation_timestamp\":1728540000456,\"bid_price\":145.4,\"base_currency\":\"SOL\",\"ask_price\":145.6} ],\"usIn\":1,\"usOut\":2,\"usDiff\":1,\"testnet\":false}",
      "expect": {
        "count": 2,
        "absent": [
          "BTC-27DEC24",
          "ETH-PERPETUAL"
        ],
        "tickers": {
          "BTC-PERPETUAL": {
            "last": 62000.0,
            "bid": 61999.5,
            "ask": 62000.5,
            "volQuote": 1234567890.0,
            "change24hPercent": 2.4794,
            "timestamp": 1728540000123
          },
          "SOL_USDC-PERPETUAL": {
            "last": 145.5,
            "volQuote": 4567890.12,
            "change24hPercent": -1.5,
            "timestamp": 1728540000456
          }
        }
      }
    }
  ]
}
