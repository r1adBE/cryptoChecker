{
  "exchange": "NonKYC",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.nonkyc.io/api/v2/ticker/BTC_USDT",
    "bulk": "GET https://api.nonkyc.io/api/v2/tickers"
  },
  "cases": [
    {
      "kind": "single",
      "name": "ticker BTC_USDT (no rolling change read)",
      "market": "NonKyc",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTC_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"ticker_id\":\"BTC_USDT\",\"type\":\"spot\",\"base_currency\":\"BTC\",\"target_currency\":\"USDT\",\"last_price\":\"62000.1\", \"base_volume\":\"1.2345\",\"target_volume\":\"76543.21\",\"bid\":\"61990\",\"ask\":\"62010\",\"high\":\"62500\",\"low\":\"60000\",\"change_percent\":\"2.48\", \"usd_volume_est\":\"76543.21\"}",
      "expect": {
        "last": 62000.1,
        "bid": 61990.0,
        "ask": 62010.0,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 1.2345,
        "volQuote": 76543.21,
        "change24hPercent": null
      }
    },
    {
      "kind": "single",
      "name": "error object",
      "market": "NonKyc",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"error\":{\"code\":404,\"message\":\"Market not found\"}}",
      "expect": {
        "error": true,
        "message": "Market not found"
      }
    },
    {
      "kind": "bulk",
      "name": "bulk tickers: id from ticker_id or base/target",
      "market": "NonKyc",
      "requestId": 0,
      "body": "[{\"ticker_id\":\"BTC_USDT\",\"type\":\"spot\",\"base_currency\":\"BTC\",\"target_currency\":\"USDT\",\"last_price\":\"62000.1\", \"base_volume\":\"1.2345\",\"target_volume\":\"76543.21\",\"bid\":\"61990\",\"ask\":\"62010\",\"high\":\"62500\",\"low\":\"60000\",\"change_percent\":\"2.48\", \"usd_volume_est\":\"76543.21\"},{\"type\":\"spot\",\"base_currency\":\"ETH\",\"target_currency\":\"USDT\",\"last_price\":\"2450.12\", \"base_volume\":\"1.2345\",\"target_volume\":\"76543.21\",\"bid\":\"61990\",\"ask\":\"62010\",\"high\":\"62500\",\"low\":\"60000\",\"change_percent\":\"2.48\", \"usd_volume_est\":\"76543.21\"}]",
      "expect": {
        "count": 2,
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1
          },
          "ETH_USDT": {
            "last": 2450.12
          }
        }
      }
    }
  ]
}
