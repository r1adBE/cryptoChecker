        "base": "BTC",
        "quote": "INR",
        "id": null,
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"symbol\":\"btcinr\",\"baseAsset\":\"btc\",\"quoteAsset\":\"inr\",\"openPrice\":\"7849000\",\"lowPrice\":\"7667478.0\",\"highPrice\":\"7861525.0\",\"lastPrice\":\"7755013.0\",\"volume\":\"0.15299\",\"bidPrice\":\"7755012.0\",\"askPrice\":\"7755013.0\",\"at\":1793677166000}",
