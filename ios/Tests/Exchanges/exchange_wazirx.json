      "expect": {
        "error": true
      }
    },
    {
      "kind": "bulk",
      "name": "tickers/24hr: all listed rows",
      "exchangeKey": "WazirX",
      "requestId": 0,
      "body": "[{\"symbol\":\"btcinr\",\"baseAsset\":\"btc\",\"quoteAsset\":\"inr\",\"openPrice\":\"7849000\",\"lowPrice\":\"7667478.0\",\"highPrice\":\"7861525.0\",\"lastPrice\":\"7755013.0\",\"volume\":\"0.15299\",\"bidPrice\":\"7755012.0\",\"askPrice\":\"7755013.0\",\"at\":1793677166000},{\"symbol\":\"ethinr\",\"baseAsset\":\"eth\",\"quoteAsset\":\"inr\",\"openPrice\":\"229900\",\"lowPrice\":\"224800.0\",\"highPrice\":\"231992.4\",\"lastPrice\":\"224800.1\",\"volume\":\"7.962800000000001\",\"bidPrice\":\"224800.0\",\"askPrice\":\"224800.1\",\"at\":1793677166000}]",
      "expect": {
