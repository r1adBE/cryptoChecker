{
  "exchange": "WazirX",
  "description": "Built from live responses of 3 November 2026 (shortened to a few rows; prices as answered then); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS); full recorded responses in recorded/recorded_wazirx.json (tools/record_exchange_fixtures.py).",
  "endpoints": {
    "pairs": "GET https://api.wazirx.com/sapi/v1/exchangeInfo",
    "single": "GET https://api.wazirx.com/sapi/v1/ticker/24hr?symbol=btcinr",
    "bulk": "GET https://api.wazirx.com/sapi/v1/tickers/24hr"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "exchangeInfo: status «trading» only; assets in upper case, id stays lower case",
      "exchangeKey": "WazirX",
      "requestId": 0,
      "body": "{\"timeZone\":\"UTC\",\"serverTime\":1793677172,\"symbols\":[{\"symbol\":\"btcinr\",\"status\":\"trading\",\"baseAsset\":\"btc\",\"quoteAsset\":\"inr\",\"baseAssetPrecision\":5,\"quoteAssetPrecision\":0,\"orderTypes\":[\"limit\",\"stop_limit\",\"limit_maker\"],\"isSpotTradingAllowed\":true,\"filters\":[{\"filterType\":\"PRICE_FILTER\",\"minPrice\":\"1.000000\",\"tickSize\":\"1.000000\"}]},{\"symbol\":\"ethinr\",\"status\":\"trading\",\"baseAsset\":\"eth\",\"quoteAsset\":\"inr\",\"baseAssetPrecision\":4,\"quoteAssetPrecision\":1,\"orderTypes\":[\"limit\",\"stop_limit\",\"limit_maker\"],\"isSpotTradingAllowed\":true,\"filters\":[{\"filterType\":\"PRICE_FILTER\",\"minPrice\":\"0.100000\",\"tickSize\":\"0.100000\"}]},{\"symbol\":\"btcusdt\",\"status\":\"trading\",\"baseAsset\":\"btc\",\"quoteAsset\":\"usdt\",\"baseAssetPrecision\":5,\"quoteAssetPrecision\":0,\"orderTypes\":[\"limit\",\"stop_limit\",\"limit_maker\"],\"isSpotTradingAllowed\":true,\"filters\":[{\"filterType\":\"PRICE_FILTER\",\"minPrice\":\"1.000000\",\"tickSize\":\"1.000000\"}]},{\"symbol\":\"oldinr\",\"status\":\"halt\",\"baseAsset\":\"old\",\"quoteAsset\":\"inr\",\"baseAssetPrecision\":5,\"quoteAssetPrecision\":0,\"orderTypes\":[\"limit\",\"stop_limit\",\"limit_maker\"],\"isSpotTradingAllowed\":true,\"filters\":[{\"filterType\":\"PRICE_FILTER\",\"minPrice\":\"1.000000\",\"tickSize\":\"1.000000\"}]}]}",
      "expect": {
        "count": 3,
        "absent": [
          "oldinr"
        ],
        "pairs": {
          "btcinr": {
            "base": "BTC",
            "quote": "INR"
          },
          "ethinr": {
            "base": "ETH",
            "quote": "INR"
          },
          "btcusdt": {
            "base": "BTC",
            "quote": "USDT"
          }
        }
      }
    },
    {
