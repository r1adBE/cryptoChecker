{
  "exchange": "HTX / HTX Futures",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.huobi.pro/market/detail/merged?symbol=btcusdt | https://api.hbdm.com/linear-swap-ex/market/detail/merged?contract_code=BTC-USDT",
    "bulk": "GET https://api.huobi.pro/market/tickers | https://api.hbdm.com/linear-swap-ex/market/detail/batch_merged?business_type=swap"
  },
  "cases": [
    {
      "kind": "pairs",
      "name": "swap_contract_info: non-empty tradfi_labels (text or list) = TradFi; empty, [] or null = crypto",
      "market": "HtxFutures",
      "requestId": 0,
      "note": "tradfi_labels format not confirmed by a live capture: text and list are both accepted; any non-blank label marks the contract as TradFi (stock, commodity ...).",
      "body": "{\"status\":\"ok\",\"data\":[{\"symbol\":\"BTC\",\"contract_code\":\"BTC-USDT\",\"contract_size\":0.001,\"price_tick\":0.1,\"contract_status\":1,\"business_type\":\"swap\",\"pair\":\"BTC-USDT\",\"tradfi_labels\":\"\"},{\"symbol\":\"NVDA\",\"contract_code\":\"NVDA-USDT\",\"contract_size\":0.01,\"price_tick\":0.01,\"contract_status\":1,\"business_type\":\"swap\",\"pair\":\"NVDA-USDT\",\"tradfi_labels\":\"stock\"},{\"symbol\":\"XAU\",\"contract_code\":\"XAU-USDT\",\"contract_size\":0.001,\"price_tick\":0.01,\"contract_status\":1,\"business_type\":\"swap\",\"pair\":\"XAU-USDT\",\"tradfi_labels\":[\"commodity\"]},{\"symbol\":\"ETH\",\"contract_code\":\"ETH-USDT\",\"contract_size\":0.01,\"price_tick\":0.01,\"contract_status\":1,\"business_type\":\"swap\",\"pair\":\"ETH-USDT\",\"tradfi_labels\":[]},{\"symbol\":\"SOL\",\"contract_code\":\"SOL-USDT\",\"contract_size\":1,\"price_tick\":0.001,\"contract_status\":1,\"business_type\":\"swap\",\"pair\":\"SOL-USDT\",\"tradfi_labels\":null},{\"symbol\":\"OLD\",\"contract_code\":\"OLD-USDT\",\"contract_size\":1,\"price_tick\":0.001,\"contract_status\":5,\"business_type\":\"swap\",\"pair\":\"OLD-USDT\",\"tradfi_labels\":\"stock\"}],\"ts\":1728540000123}",
      "expect": {
        "count": 5,
        "absent": [
          "OLD-USDT"
        ],
        "pairs": {
          "BTC-USDT": {
            "base": "BTC",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          },
          "NVDA-USDT": {
            "base": "NVDA",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": true
          },
          "XAU-USDT": {
            "base": "XAU",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": true
          },
          "ETH-USDT": {
            "base": "ETH",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          },
          "SOL-USDT": {
            "base": "SOL",
            "quote": "USDT",
            "contract": "PERPETUAL",
            "tradFi": false
          }
        }
      }
    },
    {
      "kind": "single",
      "name": "spot detail/merged: 'open' (calendar day) not used",
      "market": "Htx",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "btcusdt",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"ch\":\"market.btcusdt.detail.merged\",\"status\":\"ok\",\"ts\":1728540000123,\"tick\":{\"id\":352345678901, \"version\":352345678901,\"open\":60500.0,\"close\":62000.1,\"low\":60000.0,\"high\":62500.0,\"amount\":12100.523456, \"vol\":744460123.4567,\"count\":1234567,\"bid\":[62000.0,0.5123],\"ask\":[62000.2,0.8012]}}",
