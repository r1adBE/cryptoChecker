    {
      "kind": "bulk",
      "name": "bulk: renamed field «close» in one row — that pair is reported as unreadable, the rest stays; row with null «close» (inactive) is skipped, not failed",
      "market": "Htx",
      "requestId": 0,
      "body": "{\"status\":\"ok\",\"ts\":1728540000999,\"data\":[{\"symbol\":\"btcusdt\",\"open\":60500.0,\"high\":62500.0,\"low\":60000.0,\"close\":62000.1,\"amount\":12100.523456,\"vol\":744460123.4567,\"count\":1234567,\"bid\":62000.0,\"bidSize\":0.5123,\"ask\":62000.2,\"askSize\":0.8012},{\"symbol\":\"shibusdt\",\"open\":1.79e-05,\"high\":1.812e-05,\"low\":1.755e-05,\"close\":1.768e-05,\"amount\":98765432101.2,\"vol\":1746172.5,\"count\":4567,\"bid\":1.767e-05,\"bidSize\":1000000,\"ask\":1.769e-05,\"askSize\":2000000},{\"symbol\":\"ethusdt\",\"open\":60500.0,\"high\":62500.0,\"low\":60000.0,\"amount\":12100.523456,\"vol\":744460123.4567,\"count\":1234567,\"bid\":62000.0,\"bidSize\":0.5123,\"ask\":62000.2,\"askSize\":0.8012,\"close_renamed\":62000.1},{\"symbol\":\"oldusdt\",\"open\":60500.0,\"high\":62500.0,\"low\":60000.0,\"close\":null,\"amount\":12100.523456,\"vol\":744460123.4567,\"count\":1234567,\"bid\":62000.0,\"bidSize\":0.5123,\"ask\":62000.2,\"askSize\":0.8012}]}",
