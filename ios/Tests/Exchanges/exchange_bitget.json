        "bid": 61990.2,
        "ask": 61990.3,
        "high": 62480.0,
        "low": 59980.1,
        "vol": 215432.12,
        "volQuote": 13248901234.56,
        "change24hPercent": -0.56,
        "timestamp": 1728540000456
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "market": "Bitget",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOOUSDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"code\":\"40034\",\"msg\":\"Parameter does not exist\",\"requestTime\":1728540000200,\"data\":null}",
      "expect": {
        "error": true,
        "message": "Parameter does not exist"
      }
    },
    {
      "kind": "bulk",
      "name": "bulk spot: entry without lastPr skipped",
      "market": "Bitget",
      "requestId": 0,
      "body": "{\"code\":\"00000\",\"msg\":\"success\",\"requestTime\":1728540000200,\"data\":[{\"symbol\":\"BTCUSDT\",\"high24h\":\"62500\",\"open\":\"60500\",\"lastPr\":\"62000.1\",\"low24h\":\"60000\", \"quoteVolume\":\"744460123.45\",\"baseVolume\":\"12100.52\",\"usdtVolume\":\"744460123.45\",\"bidPr\":\"62000\",\"askPr\":\"62000.2\", \"bidSz\":\"0.5123\",\"askSz\":\"0.8012\",\"openUtc\":\"61000\",\"ts\":\"1728540000123\",\"changeUtc24h\":\"0.01641\",\"change24h\":\"0.02481\"},{\"symbol\":\"NEWUSDT\",\"high24h\":\"62500\",\"open\":\"60500\",\"low24h\":\"60000\", \"quoteVolume\":\"744460123.45\",\"baseVolume\":\"12100.52\",\"usdtVolume\":\"744460123.45\",\"bidPr\":\"62000\",\"askPr\":\"62000.2\", \"bidSz\":\"0.5123\",\"askSz\":\"0.8012\",\"openUtc\":\"61000\",\"ts\":\"1728540000123\",\"changeUtc24h\":\"0.01641\",\"change24h\":\"0.02481\"}]}",
      "expect": {
        "count": 1,
        "absent": [
          "NEWUSDT"
        ],
        "tickers": {
          "BTCUSDT": {
            "last": 62000.1,
            "change24hPercent": 2.481
          }
        }
