{
  "exchange": "Coinbase",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.exchange.coinbase.com/products/BTC-USD/stats",
    "pairs": "GET https://api.exchange.coinbase.com/products",
    "ws": "wss://ws-feed.exchange.coinbase.com  channel ticker"
  },
  "cases": [
    {
      "kind": "single",
      "name": "stats BTC-USD (open = price 24 h ago)",
      "exchangeKey": "Coinbase",
      "pair": {
        "base": "BTC",
        "quote": "USD",
        "id": "BTC-USD",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"open\":\"60500.00\",\"high\":\"62500.00\",\"low\":\"60000.00\",\"last\":\"62000.10\",\"volume\":\"12345.67890123\", \"volume_30day\":\"350000.12345678\",\"rfq_volume_24hour\":\"12.345\",\"conversions_volume_24hour\":\"0\"}",
      "expect": {
        "last": 62000.1,
        "bid": -1.0,
        "ask": -1.0,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12345.67890123,
        "change24hPercent": 2.4795041322314026,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "very small price (SHIB-USD)",
      "exchangeKey": "Coinbase",
      "pair": {
        "base": "SHIB",
        "quote": "USD",
        "id": "SHIB-USD",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"open\":\"0.00001790\",\"high\":\"0.00001812\",\"low\":\"0.00001755\",\"last\":\"0.00001768\",\"volume\":\"987654321012.5\",\"volume_30day\":\"1\"}",
      "expect": {
        "last": 1.768e-05,
        "high": 1.812e-05,
        "low": 1.755e-05,
        "vol": 987654321012.5,
        "change24hPercent": -1.2290502793296159
      }
    },
    {
      "kind": "single",
      "name": "unknown product: {message}",
      "exchangeKey": "Coinbase",
      "pair": {
        "base": "FOO",
        "quote": "USD",
        "id": "FOO-USD",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"message\":\"NotFound\"}",
      "expect": {
        "error": true,
        "message": "NotFound",
        "thrown": "NotFound"
      }
    },
    {
      "kind": "single",
      "name": "volume 0 is valid: last price is kept",
      "exchangeKey": "Coinbase",
      "pair": {
        "base": "OLD",
        "quote": "USD",
        "id": "OLD-USD",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"open\":\"1.00\",\"high\":\"1.00\",\"low\":\"1.00\",\"last\":\"1.00\",\"volume\":\"0\",\"volume_30day\":\"0\"}",
      "expect": {
        "last": 1.0,
        "high": 1.0,
        "low": 1.0,
        "vol": 0.0,
        "change24hPercent": 0.0
      }
    },
    {
      "kind": "single",
      "name": "open missing -> no change",
      "exchangeKey": "Coinbase",
      "pair": {
        "base": "BTC",
        "quote": "USD",
        "id": "BTC-USD",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"high\":\"62500.00\",\"low\":\"60000.00\",\"last\":\"62000.10\",\"volume\":\"12345.67890123\", \"volume_30day\":\"350000.12345678\",\"rfq_volume_24hour\":\"12.345\",\"conversions_volume_24hour\":\"0\"}",
      "expect": {
        "last": 62000.1,
        "change24hPercent": null
      }
    },
    {
      "kind": "pairs",
      "name": "products: only status online without trading_disabled (delisted, offline, internal and trading_disabled are dropped)",
      "exchangeKey": "Coinbase",
      "requestId": 0,
      "body": "[{\"id\":\"BTC-USD\",\"base_currency\":\"BTC\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"BTC/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"online\",\"status_message\":\"\",\"trading_disabled\":false,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"ETH-EUR\",\"base_currency\":\"ETH\",\"quote_currency\":\"EUR\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"ETH/EUR\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"online\",\"status_message\":\"\",\"trading_disabled\":false,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"OLD-USD\",\"base_currency\":\"OLD\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"OLD/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"delisted\",\"status_message\":\"\",\"trading_disabled\":true,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"MNT-USD\",\"base_currency\":\"MNT\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"MNT/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"offline\",\"status_message\":\"\",\"trading_disabled\":false,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"HALT-USD\",\"base_currency\":\"HALT\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"HALT/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"online\",\"status_message\":\"\",\"trading_disabled\":true,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"INT-USD\",\"base_currency\":\"INT\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"INT/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"internal\",\"status_message\":\"\",\"trading_disabled\":false,\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"NEW-USD\",\"base_currency\":\"NEW\",\"quote_currency\":\"USD\",\"quote_increment\":\"0.01\",\"base_increment\":\"0.00000001\",\"display_name\":\"NEW/USD\",\"min_market_funds\":\"1\",\"margin_enabled\":false,\"post_only\":false,\"limit_only\":false,\"cancel_only\":false,\"status\":\"online\",\"status_message\":\"\",\"fx_stablecoin\":false,\"max_slippage_percentage\":\"0.02000000\",\"auction_mode\":false},{\"id\":\"RAW-USD\",\"base_currency\":\"RAW\",\"quote_currency\":\"USD\"}]",
      "expect": {
        "count": 4,
        "absent": [
          "OLD-USD",
          "MNT-USD",
          "HALT-USD",
          "INT-USD"
        ],
        "pairs": {
          "BTC-USD": {
            "base": "BTC",
            "quote": "USD",
            "contract": "NONE"
          },
          "ETH-EUR": {
            "base": "ETH",
            "quote": "EUR"
          },
          "NEW-USD": {
            "base": "NEW",
            "quote": "USD"
          },
          "RAW-USD": {
            "base": "RAW",
            "quote": "USD"
          }
        }
      },
      "note": "trading_disabled missing counts as not disabled. A product without any status stays (format change: better offer it than lose the whole list)."
    },
    {
      "kind": "live",
      "name": "ws ticker",
      "exchange": "COINBASE",
      "message": "{\"type\":\"ticker\",\"sequence\":90763402417,\"product_id\":\"BTC-USD\",\"price\":\"62000.10\",\"open_24h\":\"60500.00\", \"volume_24h\":\"12345.67890123\",\"low_24h\":\"60000.00\",\"high_24h\":\"62500.00\",\"volume_30d\":\"350000.12345678\", \"best_bid\":\"62000.09\",\"best_bid_size\":\"0.10000000\",\"best_ask\":\"62000.10\",\"best_ask_size\":\"0.04000000\",\"side\":\"buy\", \"time\":\"2024-10-10T06:00:00.123456Z\",\"trade_id\":712345678,\"last_size\":\"0.00123\"}",
