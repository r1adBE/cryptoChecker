      "name": "tickers: one object per product id (sparklines not read)",
      "exchangeKey": "CoinJar",
      "requestId": 0,
      "body": "{\"BTCAUD\":{\"last\":\"110000.00000000\",\"ask\":\"110100.00000000\",\"bid\":\"110000.00000000\",\"change_24h\":-0.0152,\"mark_price\":\"110000.00000000\",\"sparklines_24h\":[\"111500.00000000\",\"111600.00000000\",\"111400.00000000\",\"111100.00000000\",\"111300.00000000\",\"111200.00000000\",\"111300.00000000\",\"110900.00000000\",\"110700.00000000\",\"111300.00000000\",\"110900.00000000\",\"110500.00000000\",\"109900.00000000\",\"109900.00000000\",\"109800.00000000\",\"109600.00000000\",\"109500.00000000\",\"109700.00000000\",\"109600.00000000\",\"109700.00000000\",\"110100.00000000\",\"110000.00000000\",\"109600.00000000\",\"109900.00000000\",\"109800.00000000\"],\"volume_24h\":\"2.43469234\"},\"BTC-USDC\":{\"last\":\"76910.00000000\",\"ask\":\"76930.00000000\",\"bid\":\"76860.00000000\",\"change_24h\":-0.0205,\"mark_price\":\"76910.00000000\",\"volume_24h\":\"0.57843428\"}}",
      "expect": {
