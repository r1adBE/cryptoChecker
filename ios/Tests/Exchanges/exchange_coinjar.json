    {
      "kind": "bulk",
      "name": "bulk: renamed «last» in one row reported as unreadable; last 0 or false (never traded) skipped",
      "exchangeKey": "CoinJar",
      "requestId": 0,
      "body": "{\"BTCAUD\":{\"last\":\"110000.00000000\",\"ask\":\"110100.00000000\",\"bid\":\"110000.00000000\",\"change_24h\":-0.0152,\"mark_price\":\"110000.00000000\",\"volume_24h\":\"2.43469234\"},\"BTC-USDC\":{\"price\":\"76910.00000000\",\"ask\":\"76930.00000000\",\"bid\":\"76860.00000000\",\"change_24h\":-0.0205,\"mark_price\":\"76910.00000000\",\"volume_24h\":\"0.57843428\"},\"NEWAUD\":{\"last\":\"0.00000000\",\"ask\":\"110100.00000000\",\"bid\":\"110000.00000000\",\"change_24h\":-0.0152,\"mark_price\":\"110000.00000000\",\"volume_24h\":\"2.43469234\"},\"JUPAUD\":{\"last\":false,\"ask\":\"110100.00000000\",\"bid\":\"110000.00000000\",\"change_24h\":null,\"mark_price\":\"110000.00000000\",\"volume_24h\":\"2.43469234\"}}",
      "expect": {
        "count": 1,
        "absent": [
          "BTC-USDC",
          "NEWAUD",
          "JUPAUD"
        ],
        "failed": [
          "BTC-USDC"
        ],
        "tickers": {
          "BTCAUD": {
            "last": 110000.0
          }
        }
      }
    }
  ]
}
