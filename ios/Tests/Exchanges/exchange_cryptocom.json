{
  "exchange": "Crypto.com",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.crypto.com/exchange/v1/public/get-tickers?instrument_name=BTC_USDT",
    "bulk": "GET https://api.crypto.com/exchange/v1/public/get-tickers"
  },
  "cases": [
    {
      "kind": "single",
      "name": "get-tickers BTC_USDT (single letters; c = fraction)",
      "exchangeKey": "CryptoCom",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTC_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"BTC_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"62000.10\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\", \"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123}]}}",
      "expect": {
        "last": 62000.1,
        "bid": 62000.0,
        "ask": 62000.2,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.5234,
        "volQuote": 744460123.45,
        "change24hPercent": 2.48,
        "exchangeTime": null
      }
    },
    {
      "kind": "single",
      "name": "no trades: c = null -> no change",
      "exchangeKey": "CryptoCom",
      "pair": {
        "base": "NEW",
        "quote": "USDT",
        "id": "NEW_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"NEW_USDT\",\"h\":null,\"l\":null,\"a\":\"0.5\", \"v\":\"0\",\"vv\":\"0\",\"c\":null,\"b\":\"0.49\",\"k\":\"0.51\",\"oi\":\"0\",\"t\":1728540000123}]}}",
      "expect": {
        "last": 0.5,
        "high": -1.0,
        "low": -1.0,
        "vol": 0.0,
        "change24hPercent": null
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "exchangeKey": "CryptoCom",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":40004,\"message\":\"Invalid instrument_name\"}",
      "expect": {
        "error": true,
        "message": "Invalid instrument_name"
      }
    },
    {
      "kind": "single",
      "name": "empty data list",
      "exchangeKey": "CryptoCom",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[]}}",
      "expect": {
        "error": true,
        "message": null
      }
    },
    {
      "kind": "bulk",
      "name": "bulk get-tickers (row without «a» is reported as unreadable, bulkRow)",
      "exchangeKey": "CryptoCom",
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"BTC_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"62000.10\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\", \"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"ETH_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"2450.12\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\", \"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"BAD_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\", \"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123}]}}",
      "expect": {
        "count": 2,
        "absent": [
          "BAD_USDT"
        ],
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1
          },
          "ETH_USDT": {
            "last": 2450.12
          }
        },
        "failed": [
          "BAD_USDT"
        ]
      }
    },
    {
      "kind": "single",
      "name": "get-tickers BTC_EUR: vv is USD, not EUR -> no quote volume",
      "exchangeKey": "CryptoCom",
      "pair": {
        "base": "BTC",
        "quote": "EUR",
        "id": "BTC_EUR",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"BTC_EUR\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"57000.5\",\"v\":\"12100.5234\",\"vv\":\"690000000.0\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123}]}}",
      "expect": {
        "last": 57000.5,
        "vol": 12100.5234,
        "volQuote": -1.0
      }
    },
    {
      "kind": "bulk",
      "name": "bulk get-tickers: quote volume only for USD quotes; row without «a» is reported as unreadable",
      "exchangeKey": "CryptoCom",
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"BTC_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"62000.10\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"ETH_USDC\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"2400.5\",\"v\":\"12100.5234\",\"vv\":\"1234567.5\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"ETH_BTC\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"0.0387\",\"v\":\"12100.5234\",\"vv\":\"5555555.5\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"BTC_EUR\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"57000.5\",\"v\":\"12100.5234\",\"vv\":\"690000000.0\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"XRP_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123,\"last_renamed\":\"0.5\"}]}}",
      "expect": {
        "count": 4,
        "failed": [
          "XRP_USDT"
        ],
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1,
            "volQuote": 744460123.45
          },
          "ETH_USDC": {
            "last": 2400.5,
            "volQuote": 1234567.5
          },
          "ETH_BTC": {
            "last": 0.0387,
            "volQuote": -1.0
          },
          "BTC_EUR": {
            "last": 57000.5,
            "volQuote": -1.0
          }
        }
      }
    },
    {
      "kind": "bulk",
      "name": "bulk get-tickers: inactive instrument with a = \"0\" is skipped, not reported as unreadable",
      "exchangeKey": "CryptoCom",
      "requestId": 0,
      "body": "{\"id\":-1,\"method\":\"public/get-tickers\",\"code\":0,\"result\":{\"data\":[{\"i\":\"BTC_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"62000.10\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123},{\"i\":\"OLD_USDT\",\"h\":\"62500.00\",\"l\":\"60000.00\",\"a\":\"0\",\"v\":\"12100.5234\",\"vv\":\"744460123.45\",\"c\":\"0.0248\",\"b\":\"62000.00\",\"k\":\"62000.20\",\"oi\":\"0\",\"t\":1728540000123}]}}",
      "expect": {
        "count": 1,
        "absent": [
          "OLD_USDT"
        ],
        "failed": [],
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1
          }
        }
      }
    }
  ]
}
