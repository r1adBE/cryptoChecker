{
  "exchange": "Poloniex",
  "description": "Hand-written in the documented response format (no live capture possible in the build environment); field names are exactly the ones the adapters read. Bodies are raw response text, expectations are the parsed Ticker (-1 = Ticker.NO_DATA, change24hPercent null = must not be set). Shared by ExchangeContractTest.kt (Android) and ExchangeContractTests.swift (iOS).",
  "endpoints": {
    "single": "GET https://api.poloniex.com/markets/BTC_USDT/ticker24h",
    "bulk": "GET https://api.poloniex.com/markets/ticker24h"
  },
  "cases": [
    {
      "kind": "single",
      "name": "ticker24h object",
      "market": "Poloniex",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTC_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"symbol\":\"BTC_USDT\",\"open\":\"60500\",\"low\":\"60000\",\"high\":\"62500\",\"close\":\"62000.1\",\"quantity\":\"12100.5\", \"amount\":\"744460123.45\",\"tradeCount\":123456,\"startTime\":1728453600000,\"closeTime\":1728540000000,\"displayName\":\"BTC/USDT\", \"dailyChange\":\"0.0248\",\"bid\":\"62000\",\"bidQuantity\":\"0.5\",\"ask\":\"62000.2\",\"askQuantity\":\"0.8\",\"ts\":1728540000123,\"markPrice\":\"62005\"}",
      "expect": {
        "last": 62000.1,
        "bid": 62000.0,
        "ask": 62000.2,
        "high": 62500.0,
        "low": 60000.0,
        "vol": 12100.5,
        "volQuote": 744460123.45,
        "change24hPercent": 2.4795041322314026,
        "timestamp": 1728540000123
      }
    },
    {
      "kind": "single",
      "name": "ticker24h wrapped in an array, open missing -> dailyChange fraction",
      "market": "Poloniex",
      "pair": {
        "base": "BTC",
        "quote": "USDT",
        "id": "BTC_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "  [{\"symbol\":\"BTC_USDT\",\"low\":\"60000\",\"high\":\"62500\",\"close\":\"62000.1\",\"quantity\":\"12100.5\", \"amount\":\"744460123.45\",\"tradeCount\":123456,\"startTime\":1728453600000,\"closeTime\":1728540000000,\"displayName\":\"BTC/USDT\", \"dailyChange\":\"0.0248\",\"bid\":\"62000\",\"bidQuantity\":\"0.5\",\"ask\":\"62000.2\",\"askQuantity\":\"0.8\",\"ts\":1728540000123,\"markPrice\":\"62005\"}]",
      "expect": {
        "last": 62000.1,
        "change24hPercent": 2.48
      }
    },
    {
      "kind": "single",
      "name": "error payload",
      "market": "Poloniex",
      "pair": {
        "base": "FOO",
        "quote": "USDT",
        "id": "FOO_USDT",
        "contract": "NONE"
      },
      "requestId": 0,
      "body": "{\"code\":21607,\"message\":\"Invalid symbol!\"}",
      "expect": {
        "error": true,
        "message": "Invalid symbol!"
      }
    },
    {
      "kind": "bulk",
      "name": "bulk ticker24h",
      "market": "Poloniex",
      "requestId": 0,
      "body": "[{\"symbol\":\"BTC_USDT\",\"open\":\"60500\",\"low\":\"60000\",\"high\":\"62500\",\"close\":\"62000.1\",\"quantity\":\"12100.5\", \"amount\":\"744460123.45\",\"tradeCount\":123456,\"startTime\":1728453600000,\"closeTime\":1728540000000,\"displayName\":\"BTC/USDT\", \"dailyChange\":\"0.0248\",\"bid\":\"62000\",\"bidQuantity\":\"0.5\",\"ask\":\"62000.2\",\"askQuantity\":\"0.8\",\"ts\":1728540000123,\"markPrice\":\"62005\"}]",
      "expect": {
        "count": 1,
        "tickers": {
          "BTC_USDT": {
            "last": 62000.1
          }
        }
      }
    }
  ]
}
