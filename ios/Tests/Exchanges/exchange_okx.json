    "single": "GET https://www.okx.com/api/v5/market/ticker?instId=BTC-USDT",
    "bulk": "GET https://www.okx.com/api/v5/market/tickers?instType=SPOT|SWAP",
    "ws": "wss://ws.okx.com:8443/ws/v5/public  channel tickers"
  },
