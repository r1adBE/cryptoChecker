      "requestId": 0,
      "body": "{\"code\":\"0\",\"msg\":\"\",\"data\":[{\"instType\":\"SPOT\",\"instId\":\"NEW-USDT\",\"last\":\"0.0123\",\"lastSz\":\"100\",\"askPx\":\"\", \"askSz\":\"\",\"bidPx\":\"\",\"bidSz\":\"\",\"open24h\":\"0.0120\",\"high24h\":\"0.0125\",\"low24h\":\"0.0119\",\"volCcy24h\":\"1234.5\", \"vol24h\":\"100370.7\",\"ts\":\"1728540000123\",\"sodUtc0\":\"0.0121\",\"sodUtc8\":\"0.0122\"}]}",
