        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato burza nemá pro vybraný typ kontraktu žádné %1$@ páry. Nejprve burzu synchronizujte, nebo zkuste jiný typ kontraktu."
