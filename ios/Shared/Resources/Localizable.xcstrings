    "portfolio_csv_import_stable_swaps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُسجَّل عمليات الشراء والبيع مقابل العملات المستقرة (USDT وUSDC …) كمبادلات – وتظهر العملة المستقرة في رصيدك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy a prodeje za stablecoiny (USDT, USDC …) se účtují jako směna – stablecoin se objeví v tvé držbě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb og salg mod stablecoins (USDT, USDC …) bogføres som bytte – stablecoinen vises i din beholdning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe und Verkäufe gegen Stablecoins (USDT, USDC …) werden als Tausch gebucht – der Stablecoin erscheint im Bestand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αγορές και πωλήσεις έναντι stablecoins (USDT, USDC …) καταχωρούνται ως ανταλλαγές – το stablecoin εμφανίζεται στην κατοχή σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trades against stablecoins (USDT, USDC …) are booked as swaps – the stablecoin appears in your holdings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras y ventas a cambio de stablecoins (USDT, USDC …) se registran como intercambios – la stablecoin aparece en tu tenencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خرید و فروش در برابر استیبل‌کوین‌ها (USDT، USDC …) به‌صورت تبادل ثبت می‌شود – استیبل‌کوین در دارایی تو نمایش داده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostot ja myynnit stablecoineja (USDT, USDC …) vastaan kirjataan vaihdoiksi – stablecoin näkyy omistuksessasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats et ventes contre des stablecoins (USDT, USDC …) sont enregistrés comme échanges – le stablecoin apparaît dans tes avoirs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קניות ומכירות תמורת מטבעות יציבים (USDT, USDC …) נרשמות כהחלפות – המטבע היציב מופיע באחזקות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टेबलकॉइन (USDT, USDC …) के बदले ख़रीद और बिक्री स्वैप के रूप में दर्ज होती है – स्टेबलकॉइन तुम्हारी होल्डिंग में दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stablecoinok (USDT, USDC …) elleni vételek és eladások cserének számítanak – a stablecoin megjelenik az állományodban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian dan penjualan dengan stablecoin (USDT, USDC …) dicatat sebagai tukar – stablecoin muncul di kepemilikanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquisti e vendite contro stablecoin (USDT, USDC …) vengono registrati come scambi – lo stablecoin compare nel saldo."
