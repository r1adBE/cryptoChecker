    "explain_spot_fdv" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقييم المخفف بالكامل: السعر × الحد الأقصى للمعروض (أو الإجمالي إذا لم يكن هناك حد)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plně zředěná hodnota: cena × max. zásoba (nebo celková zásoba, pokud limit neexistuje)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuldt udvandet værdi: kurs × maks. mængde (eller samlet mængde, hvis der ikke er nogen grænse)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voll verwässerte Bewertung: Kurs × Höchstmenge (oder Gesamtmenge, wenn es keine Grenze gibt)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρως αραιωμένη αποτίμηση: τιμή × μέγ. προσφορά (ή συνολική, αν δεν υπάρχει όριο)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fully diluted valuation: price × max supply (or total supply if there is no limit)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoración totalmente diluida: precio × suministro máximo (o total si no hay límite)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارزش‌گذاری کاملاً رقیق‌شده: قیمت × حداکثر عرضه (یا عرضه کل اگر سقفی نباشد)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin laimennettu arvo: hinta × enimmäismäärä (tai kokonaismäärä, jos rajaa ei ole)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorisation entièrement diluée : prix × offre maximale (ou offre totale s'il n'y a pas de limite)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שווי בדילול מלא: מחיר × היצע מרבי (או כולל אם אין מגבלה)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
