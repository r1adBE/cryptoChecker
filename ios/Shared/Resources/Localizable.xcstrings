    "portfolio_tx_third_fee_incomplete" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون سعر لا تُحتسب الرسوم في تكلفة الشراء ولا في العائد؛ ويُعلِّم التصدير الضريبي هذه المبيعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez ceny se poplatek nezapočítá do pořizovací ceny ani výnosu; daňový export takové prodeje označí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden pris indgår gebyret ikke i anskaffelsespris eller provenu; skatteeksporten markerer sådanne salg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Preis zählt die Gebühr nicht zum Einstand bzw. Erlös; Verkäufe damit markiert der Steuer-Export."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς τιμή η χρέωση δεν μετρά στο κόστος κτήσης ούτε στο έσοδο· η φορολογική εξαγωγή επισημαίνει τέτοιες πωλήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a price the fee is left out of cost basis and proceeds; the tax export flags such sales."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin precio, la comisión no se incluye en el coste de adquisición ni en el importe de venta; la exportación fiscal marca esas ventas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون قیمت، کارمزد در بهای تمام‌شده و درآمد فروش حساب نمی‌شود؛ خروجی مالیاتی این فروش‌ها را علامت می‌زند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman hintaa kulua ei lasketa hankintahintaan eikä myyntituottoon; verovienti merkitsee tällaiset myynnit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans prix, les frais ne sont inclus ni dans le coût de revient ni dans le produit de cession ; l’export fiscal signale ces ventes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי מחיר העמלה לא נכללת בעלות הרכישה ובתמורה; הייצוא למס מסמן מכירות כאלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाव के बिना शुल्क लागत और बिक्री आय में नहीं गिना जाता; टैक्स एक्सपोर्ट ऐसी बिक्री को चिह्नित करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ár nélkül a díj nem számít bele a bekerülési értékbe és a bevételbe; az adó-export megjelöli az ilyen eladásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa harga, biaya tidak dihitung dalam biaya perolehan maupun hasil penjualan; ekspor pajak menandai penjualan tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza prezzo la commissione non rientra nel costo di carico né nel ricavo; l’esportazione fiscale segnala queste vendite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格がないと手数料は取得原価にも売却額にも含まれません。税務用エクスポートではこうした売却に印が付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격이 없으면 수수료는 매입 원가와 매도 금액에 포함되지 않으며, 세금 내보내기에서 해당 매도가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten pris inngår gebyret ikke i inngangsverdi eller salgssum; skatteeksporten markerer slike salg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder prijs tellen de kosten niet mee in kostprijs of opbrengst; de belastingexport markeert zulke verkopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez ceny opłata nie wchodzi do kosztu nabycia ani przychodu; eksport podatkowy oznacza takie sprzedaże."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem preço, a comissão fica fora do custo de aquisição e da receita; a exportação fiscal assinala essas vendas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem preço, a taxa fica fora do custo de aquisição e do valor recebido; a exportação fiscal marca essas vendas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără preț, comisionul nu intră în costul de achiziție sau în încasare; exportul fiscal marchează astfel de vânzări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без цены комиссия не учитывается в стоимости покупки и выручке; налоговый экспорт помечает такие продажи."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa çmim, tarifa nuk llogaritet as në koston e blerjes as në të ardhurat; eksporti tatimor i shënon këto shitje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan pris räknas avgiften inte in i anskaffningsvärde eller likvid; skatteexporten markerar sådana försäljningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีราคา ค่าธรรมเนียมจะไม่รวมในต้นทุนและรายรับ การส่งออกข้อมูลภาษีจะทำเครื่องหมายการขายเหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyat olmadan ücret maliyete ve satış gelirine dahil edilmez; vergi dışa aktarımı bu satışları işaretler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без ціни комісія не враховується у вартості купівлі та виручці; податковий експорт позначає такі продажі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có giá thì phí không được tính vào giá vốn và số tiền thu; dữ liệu thuế xuất ra sẽ đánh dấu các lệnh bán đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有价格时，手续费不计入成本和卖出所得；税务导出会标记此类卖出。"
          }
        }
      }
    },
