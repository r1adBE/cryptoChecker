        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostokulu USDT:nä tai käteisenä ei ole tappio: käteiskulu ei ole vähennyskelpoinen, USDT-kulu on luovutus nimellisarvoon ilman voittoa – se näytetään vain tiedoksi (%1$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des frais de retrait en USDT ou en espèces ne sont pas une perte : des frais en espèces ne sont pas déductibles, des frais en USDT sont une cession au pair sans plus-value – ils figurent à titre d’information (%1$@)."
