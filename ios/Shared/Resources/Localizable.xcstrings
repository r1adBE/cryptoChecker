    "alarm_save_storage_locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حفظ التنبيهات: تعذّرت قراءة البيانات المحفوظة الآن. أعد تشغيل التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmy nelze uložit: uložená data teď nelze přečíst. Restartuj aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmer kan ikke gemmes: Gemte data kan ikke læses lige nu. Genstart appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarme lassen sich nicht speichern: Gespeicherte Daten gerade nicht lesbar. Starte die App neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συναγερμοί δεν μπορούν να αποθηκευτούν: τα αποθηκευμένα δεδομένα δεν μπορούν να διαβαστούν αυτή τη στιγμή. Επανεκκίνησε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts can't be saved: saved data can't be read right now. Restart the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden guardar alarmas: ahora no se pueden leer los datos guardados. Reinicia la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هشدارها ذخیره نمی‌شوند: داده‌های ذخیره‌شده الان خوانده نمی‌شوند. برنامه را دوباره راه‌اندازی کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälytyksiä ei voi tallentaa: tallennettuja tietoja ei voi juuri nyt lukea. Käynnistä sovellus uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer des alertes : les données enregistrées sont illisibles pour l'instant. Redémarre l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשמור התראות: לא ניתן לקרוא כרגע את הנתונים השמורים. הפעילו מחדש את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म सहेजे नहीं जा सकते: सहेजा गया डेटा अभी पढ़ा नहीं जा सकता। ऐप दोबारा शुरू करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riasztásokat nem lehet menteni: a mentett adatok most nem olvashatók. Indítsd újra az alkalmazást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
