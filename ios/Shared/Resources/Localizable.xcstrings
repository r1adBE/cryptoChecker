    "market_info_gas_what" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم تكلف المعاملة الآن على كل شبكة. على Ethereum والشبكات المشابهة بوحدة gwei (جزء من مليار من ETH لكل وحدة غاز)، وعلى Bitcoin بوحدة sat/vB (ساتوشي لكل بايت افتراضي من المعاملة)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik právě stojí transakce v jednotlivých sítích. U Etherea a podobných sítí v gwei (miliardtina ETH za jednotku gasu), u Bitcoinu v sat/vB (satoshi za virtuální bajt transakce)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad en transaktion koster på hvert netværk lige nu. På Ethereum og lignende netværk i gwei (en milliardtedel ETH pr. gasenhed), på Bitcoin i sat/vB (satoshi pr. virtuel byte i transaktionen)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was eine Transaktion im jeweiligen Netz gerade kostet. Bei Ethereum und ähnlichen Netzen in gwei (ein Milliardstel ETH je Gas-Einheit), bei Bitcoin in sat/vB (Satoshi je virtuellem Byte der Transaktion)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο κοστίζει τώρα μια συναλλαγή σε κάθε δίκτυο. Στο Ethereum και σε παρόμοια δίκτυα σε gwei (ένα δισεκατομμυριοστό του ETH ανά μονάδα gas), στο Bitcoin σε sat/vB (satoshi ανά εικονικό byte της συναλλαγής)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a transaction currently costs on each network. On Ethereum and similar networks in gwei (one billionth of an ETH per unit of gas), on Bitcoin in sat/vB (satoshis per virtual byte of the transaction)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cuesta ahora una transacción en cada red. En Ethereum y redes similares en gwei (una milmillonésima de ETH por unidad de gas), en Bitcoin en sat/vB (satoshis por byte virtual de la transacción)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه فعلی یک تراکنش در هر شبکه. در Ethereum و شبکه‌های مشابه به gwei (یک‌میلیاردم ETH برای هر واحد گس)، در Bitcoin به sat/vB (ساتوشی برای هر بایت مجازی تراکنش)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä transaktio maksaa kussakin verkossa juuri nyt. Ethereumissa ja vastaavissa verkoissa gweinä (miljardisosa ETH:ta kaasuyksikköä kohden), Bitcoinissa sat/vB-yksikkönä (satoshia transaktion virtuaalitavua kohden)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que coûte actuellement une transaction sur chaque réseau. Sur Ethereum et les réseaux similaires en gwei (un milliardième d'ETH par unité de gas), sur Bitcoin en sat/vB (satoshis par octet virtuel de la transaction)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה עולה כרגע עסקה בכל רשת. ב־Ethereum וברשתות דומות ב־gwei (חלק המיליארד של ETH ליחידת gas), ב־Bitcoin ב־sat/vB (סאטושי לבייט וירטואלי של העסקה)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर नेटवर्क पर अभी एक ट्रांज़ैक्शन की लागत। Ethereum और मिलते-जुलते नेटवर्क पर gwei में (प्रति गैस यूनिट ETH का एक अरबवाँ हिस्सा), Bitcoin पर sat/vB में (ट्रांज़ैक्शन के प्रति वर्चुअल बाइट satoshi)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyibe kerül éppen egy tranzakció az egyes hálózatokon. Az Ethereumon és hasonló hálózatokon gweiben (egy ETH milliárdod része gázegységenként), a Bitcoinon sat/vB-ben (satoshi a tranzakció virtuális bájtjára)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya satu transaksi di tiap jaringan saat ini. Di Ethereum dan jaringan serupa dalam gwei (sepermiliar ETH per unit gas), di Bitcoin dalam sat/vB (satoshi per byte virtual transaksi)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto costa ora una transazione su ciascuna rete. Su Ethereum e reti simili in gwei (un miliardesimo di ETH per unità di gas), su Bitcoin in sat/vB (satoshi per byte virtuale della transazione)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ネットワークで、いま1件の取引にかかる手数料です。Ethereum など同様のネットワークでは gwei（ガス1単位あたり ETH の10億分の1）、Bitcoin では sat/vB（取引の仮想バイトあたりの satoshi）で表します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 네트워크에서 지금 거래 한 건에 드는 비용입니다. Ethereum과 비슷한 네트워크는 gwei(가스 1단위당 ETH의 10억분의 1), Bitcoin은 sat/vB(거래의 가상 바이트당 satoshi)로 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva en transaksjon koster på hvert nettverk akkurat nå. På Ethereum og lignende nettverk i gwei (en milliardtedel ETH per gassenhet), på Bitcoin i sat/vB (satoshi per virtuell byte i transaksjonen)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat een transactie op elk netwerk op dit moment kost. Bij Ethereum en vergelijkbare netwerken in gwei (een miljardste ETH per eenheid gas), bij Bitcoin in sat/vB (satoshi per virtuele byte van de transactie)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile teraz kosztuje transakcja w danej sieci. W Ethereum i podobnych sieciach w gwei (jedna miliardowa ETH za jednostkę gazu), w Bitcoinie w sat/vB (satoshi za wirtualny bajt transakcji)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto custa agora uma transação em cada rede. Na Ethereum e em redes semelhantes em gwei (a mil-milionésima parte de um ETH por unidade de gas), na Bitcoin em sat/vB (satoshis por byte virtual da transação)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto custa agora uma transação em cada rede. No Ethereum e em redes parecidas em gwei (um bilionésimo de ETH por unidade de gas), no Bitcoin em sat/vB (satoshis por byte virtual da transação)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât costă acum o tranzacție în fiecare rețea. Pe Ethereum și rețele similare în gwei (o miliardime de ETH pe unitate de gas), pe Bitcoin în sat/vB (satoshi pe byte virtual al tranzacției)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько сейчас стоит транзакция в каждой сети. В Ethereum и похожих сетях в gwei (миллиардная доля ETH за единицу газа), в Bitcoin в sat/vB (сатоши за виртуальный байт транзакции)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa kushton tani një transaksion në secilin rrjet. Në Ethereum dhe rrjete të ngjashme në gwei (një e miliarta e ETH për njësi gas), në Bitcoin në sat/vB (satoshi për bajt virtual të transaksionit)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad en transaktion kostar i varje nätverk just nu. På Ethereum och liknande nätverk i gwei (en miljarddels ETH per gasenhet), på Bitcoin i sat/vB (satoshi per virtuell byte i transaktionen)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าใช้จ่ายของธุรกรรมหนึ่งรายการในแต่ละเครือข่ายตอนนี้ บน Ethereum และเครือข่ายที่คล้ายกันเป็น gwei (หนึ่งในพันล้านของ ETH ต่อหน่วย gas) บน Bitcoin เป็น sat/vB (satoshi ต่อไบต์เสมือนของธุรกรรม)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ağda bir işlemin şu anda ne kadara mal olduğu. Ethereum ve benzeri ağlarda gwei cinsinden (gas birimi başına ETH’nin milyarda biri), Bitcoin’de sat/vB cinsinden (işlemin sanal baytı başına satoshi)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки зараз коштує транзакція в кожній мережі. В Ethereum і подібних мережах у gwei (мільярдна частка ETH за одиницю газу), у Bitcoin у sat/vB (сатоші за віртуальний байт транзакції)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi phí hiện tại của một giao dịch trên từng mạng. Trên Ethereum và các mạng tương tự tính bằng gwei (một phần tỷ ETH cho mỗi đơn vị gas), trên Bitcoin tính bằng sat/vB (satoshi trên mỗi byte ảo của giao dịch)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前在各网络上一笔交易的费用。Ethereum 及类似网络以 gwei 计（每单位 gas 为十亿分之一 ETH），Bitcoin 以 sat/vB 计（交易每虚拟字节的 satoshi 数）。"
          }
        }
      }
    },
