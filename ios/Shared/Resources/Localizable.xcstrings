        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena jako násobek ceny v den halvingu (log. měřítko). Minulé cykly jsou vzorec, ne předpověď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurs som multiplum af kursen på halveringsdagen (log-skala). Tidligere cyklusser er et mønster, ikke en prognose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurs als Vielfaches des Kurses am Halving-Tag (logarithmisch). Frühere Zyklen sind ein Muster, keine Prognose."
