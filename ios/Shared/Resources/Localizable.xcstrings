    "about_license" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الأسعار مباشرة من المنصات؛ بلا حساب وبلا تتبّع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny přicházejí přímo z burz; žádný účet a žádné sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurserne kommer direkte fra børserne; ingen konto og ingen sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kurse kommen direkt von den Börsen, ohne Konto und ohne Nachverfolgung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές έρχονται απευθείας από τα ανταλλακτήρια· χωρίς λογαριασμό και χωρίς παρακολούθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices come straight from the exchanges; no account and no tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los precios vienen directamente de los exchanges; sin cuenta y sin rastreo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌ها مستقیماً از صرافی‌ها می‌آیند؛ بدون حساب کاربری و بدون ردیابی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnat tulevat suoraan pörsseistä; ei tiliä eikä seurantaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prix viennent directement des plateformes ; aucun compte, aucun pistage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחירים מגיעים ישירות מהבורסות; ללא חשבון וללא מעקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमतें सीधे एक्सचेंजों से आती हैं; कोई अकाउंट नहीं और कोई ट्रैकिंग नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az árak közvetlenül a tőzsdékről érkeznek; nincs fiók és nincs követés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga langsung dari bursa; tanpa akun dan tanpa pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prezzi arrivano direttamente dagli exchange; nessun account e nessun tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格は取引所から直接取得します。アカウント不要、トラッキングなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격은 거래소에서 직접 가져오며, 계정도 추적도 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursene kommer rett fra børsene; ingen konto og ingen sporing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koersen komen rechtstreeks van de exchanges; geen account en geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny pochodzą bezpośrednio z giełd; bez konta i bez śledzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os preços vêm diretamente das exchanges; sem conta e sem rastreio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os preços vêm diretamente das exchanges; sem conta e sem rastreamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețurile vin direct de la burse; fără cont și fără urmărire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цены поступают напрямую с бирж; без аккаунта и без отслеживания."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çmimet vijnë drejtpërdrejt nga bursat; pa llogari dhe pa gjurmim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurserna kommer direkt från börserna; inget konto och ingen spårning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคามาจากกระดานเทรดโดยตรง ไม่ต้องมีบัญชีและไม่มีการติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatlar doğrudan borsalardan gelir; hesap yok, izleme yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ціни надходять безпосередньо з бірж; без облікового запису й без стеження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá lấy trực tiếp từ các sàn; không cần tài khoản và không theo dõi người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格直接来自交易所；无需账户，无跟踪。"
          }
        }
      }
