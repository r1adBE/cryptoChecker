            "state" : "translated",
            "value" : "Cambia la lingua dell'app nell'app Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの言語は iOS の「設定」アプリで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 언어는 iOS 설정 앱에서 변경하세요."
          }
        },
