    "alarm_near_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّه أيضًا عند تسجيل أعلى أو أدنى مستوى جديد. يعتمد على الشموع اليومية، ويُحدَّث كل 6 ساعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní také při novém maximu nebo minimu. Na základě denních svíček, obnovuje se každých 6 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver også besked ved en ny top eller bund. Baseret på daglige candlesticks, opdateret hver 6. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet sich auch bei einem neuen Hoch oder Tief. Grundlage sind Tageskerzen, alle 6 Stunden aufgefrischt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποιεί επίσης όταν σημειώνεται νέο υψηλό ή χαμηλό. Με βάση ημερήσια κεριά, ανανεώνεται κάθε 6 ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also notifies when a new high or low is set. Based on daily candles, refreshed every 6 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También avisa cuando se marca un nuevo máximo o mínimo. Basado en velas diarias, actualizado cada 6 horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام ثبت سقف یا کف جدید هم خبر می‌دهد. بر اساس کندل‌های روزانه، هر ۶ ساعت به‌روز می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoittaa myös, kun syntyy uusi huippu tai pohja. Perustuu päiväkynttilöihin, päivittyy 6 tunnin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévient aussi quand un nouveau plus haut ou plus bas est atteint. Basé sur les bougies journalières, actualisé toutes les 6 heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתריע גם כשנקבע שיא או שפל חדש. מבוסס על נרות יומיים, מתעדכן כל 6 שעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया उच्च या निम्न स्तर बनने पर भी सूचना देता है। दैनिक कैंडल पर आधारित, हर 6 घंटे में अपडेट।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új csúcsnál vagy mélypontnál is értesít. Napi gyertyák alapján, 6 óránként frissítve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga memberi tahu saat titik tertinggi atau terendah baru tercapai. Berdasarkan candle harian, diperbarui setiap 6 jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa anche quando si segna un nuovo massimo o minimo. Basato sulle candele giornaliere, aggiornato ogni 6 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい高値・安値を付けたときにも通知します。日足に基づき、6時間ごとに更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 고점이나 저점이 나와도 알려 줍니다. 일봉 기준이며 6시간마다 갱신됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler også ved en ny topp eller bunn. Basert på daglige candlesticks, oppdatert hver 6. time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt zich ook bij een nieuwe top of bodem. Gebaseerd op dagcandles, elke 6 uur vernieuwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia też o nowym maksimum lub minimum. Na podstawie świec dziennych, odświeżane co 6 godzin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também avisa quando é atingido um novo máximo ou mínimo. Com base em velas diárias, atualizado a cada 6 horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também avisa quando um novo máximo ou mínimo é atingido. Com base em velas diárias, atualizado a cada 6 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anunță și când se atinge un nou maxim sau minim. Pe baza lumânărilor zilnice, actualizat la fiecare 6 ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также сообщает о новом максимуме или минимуме. По дневным свечам, обновляется каждые 6 часов."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njofton edhe kur arrihet një maksimum ose minimum i ri. Bazuar në qirinjtë ditorë, rifreskohet çdo 6 orë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelar också vid en ny topp eller botten. Baserat på dagliga candlesticks, uppdateras var 6:e timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งด้วยเมื่อทำจุดสูงสุดหรือต่ำสุดใหม่ อิงแท่งเทียนรายวัน อัปเดตทุก 6 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir zirve veya dip oluştuğunda da bildirir. Günlük mumlara dayanır, 6 saatte bir yenilenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також повідомляє про новий максимум або мінімум. За денними свічками, оновлюється кожні 6 годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng báo khi lập đỉnh hoặc đáy mới. Dựa trên nến ngày, cập nhật mỗi 6 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创出新高点或新低点时也会提醒。基于日 K 线，每 6 小时更新一次。"
          }
        }
      }
    },
