    "backup_export_too_large" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتجاوز النسخة الاحتياطية 64 ميغابايت ولن يمكن استعادتها، لذلك لم تُحفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záloha by byla větší než 64 MB a nešla by obnovit, proto nebyla uložena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopien ville være større end 64 MB og kunne ikke gendannes, så den blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherung wäre grösser als 64 MB und liesse sich nicht mehr einspielen – sie wurde nicht gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αντίγραφο θα ήταν μεγαλύτερο από 64 MB και δεν θα μπορούσε να επαναφερθεί, γι' αυτό δεν αποθηκεύτηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup would be larger than 64 MB and could not be restored, so it wasn't saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia superaría los 64 MB y no se podría restaurar, por eso no se ha guardado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ پشتیبان بزرگ‌تر از ۶۴ مگابایت می‌شد و قابل بازیابی نبود، برای همین ذخیره نشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopio olisi yli 64 Mt eikä sitä voisi palauttaa, joten sitä ei tallennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde dépasserait 64 Mo et ne pourrait pas être restaurée ; elle n'a donc pas été enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגיבוי היה גדול מ־64 MB ולא ניתן היה לשחזר אותו, ולכן הוא לא נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
