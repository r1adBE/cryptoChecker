    "backup_device_bound" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل تغيير الجهاز أنشئ ملف نسخة احتياطية – لا يمكن فتح البيانات المشفّرة إلا على هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před výměnou zařízení si vytvoř soubor zálohy – šifrovaná data lze otevřít jen na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en sikkerhedskopi-fil, før du skifter enhed – de krypterede data kan kun åbnes på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor einem Gerätewechsel eine Sicherungsdatei erstellen – die verschlüsselten Daten lassen sich nur auf diesem Gerät öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν αλλάξεις συσκευή, δημιούργησε αρχείο αντιγράφου ασφαλείας – τα κρυπτογραφημένα δεδομένα ανοίγουν μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before switching devices, create a backup file – the encrypted data can only be opened on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cambiar de dispositivo, crea un archivo de copia de seguridad: los datos cifrados solo se pueden abrir en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از تعویض دستگاه یک فایل پشتیبان بساز – داده‌های رمزگذاری‌شده فقط روی همین دستگاه باز می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo varmuuskopiotiedosto ennen laitteen vaihtoa – salattuja tietoja voi avata vain tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de changer d’appareil, crée un fichier de sauvegarde – les données chiffrées ne s’ouvrent que sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפני החלפת מכשיר צרו קובץ גיבוי – את הנתונים המוצפנים אפשר לפתוח רק במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस बदलने से पहले बैकअप फ़ाइल बनाओ – एन्क्रिप्ट किया गया डेटा केवल इसी डिवाइस पर खुलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eszközcsere előtt készíts biztonsági mentést – a titkosított adatok csak ezen az eszközön nyithatók meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum ganti perangkat, buat file cadangan – data terenkripsi hanya bisa dibuka di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di cambiare dispositivo, crea un file di backup: i dati crittografati si possono aprire solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機種変更の前にバックアップファイルを作成してください。暗号化されたデータはこの端末でしか開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기를 바꾸기 전에 백업 파일을 만드세요. 암호화된 데이터는 이 기기에서만 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag en sikkerhetskopifil før du bytter enhet – de krypterte dataene kan bare åpnes på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak vóór een apparaatwissel een back-upbestand – de versleutelde gegevens zijn alleen op dit apparaat te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed zmianą urządzenia utwórz plik kopii zapasowej – zaszyfrowane dane można otworzyć tylko na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de mudar de dispositivo, cria um ficheiro de cópia de segurança – os dados encriptados só abrem neste dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de trocar de aparelho, crie um arquivo de backup – os dados criptografados só podem ser abertos neste aparelho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte de a schimba dispozitivul, creează un fișier de backup – datele criptate se pot deschide doar pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сменой устройства создай файл резервной копии – зашифрованные данные открываются только на этом устройстве."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para se të ndërrosh pajisjen, krijo një skedar kopjeje rezervë – të dhënat e enkriptuara hapen vetëm në këtë pajisje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en säkerhetskopia innan du byter enhet – krypterade data kan bara öppnas på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนเปลี่ยนอุปกรณ์ ให้สร้างไฟล์สำรองข้อมูล – ข้อมูลที่เข้ารหัสเปิดได้เฉพาะบนอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz değiştirmeden önce bir yedek dosyası oluştur – şifreli veriler yalnızca bu cihazda açılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед зміною пристрою створи файл резервної копії – зашифровані дані відкриваються лише на цьому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi đổi thiết bị, hãy tạo tệp sao lưu – dữ liệu đã mã hóa chỉ mở được trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更换设备前请先创建备份文件——加密数据只能在本设备上打开。"
          }
        }
      }
    },
    "backup_encryption_pending" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التشفير غير مفعّل بعد – سيحاول التطبيق مجددًا عند التشغيل التالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrování ještě není aktivní – aplikace to zkusí znovu při příštím spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryptering er endnu ikke aktiv – appen prøver igen ved næste start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselung noch nicht aktiv – die App versucht es beim nächsten Start erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κρυπτογράφηση δεν είναι ακόμη ενεργή – η εφαρμογή θα δοκιμάσει ξανά στην επόμενη εκκίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encryption not active yet – the app will try again at the next start."
          }
        },
        "es" : {
          "stringUnit" : {
