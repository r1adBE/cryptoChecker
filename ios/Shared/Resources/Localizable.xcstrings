    "portfolio_avg_price_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط سعر الشراء: متوسط جميع عمليات الشراء مرجحًا بالكمية. تُقيَّم عمليات البيع بهذا المتوسط."
