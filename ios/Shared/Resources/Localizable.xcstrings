            "value" : "Να αφαιρεθούν όλα τα ζεύγη από τη λίστα παρακολούθησης; Θα διαγραφούν και οι ειδοποιήσεις τιμής τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove all pairs from the watchlist? Their alarms go with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar todos los pares de la lista de seguimiento? Sus alarmas también se eliminarán."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه جفت‌ها از واچ‌لیست حذف شوند؟ هشدارهایشان نیز حذف می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko kaikki parit seurantalistalta? Myös niiden hälytykset poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer toutes les paires de la liste de suivi ? Leurs alertes seront aussi supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסיר את כל הצמדים מרשימת המעקב? גם ההתראות שלהם יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉचलिस्ट से सभी पेयर हटाएँ? उनके अलार्म भी हट जाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja az összes párt a figyelőlistáról? A riasztásaik is törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua pasangan dari daftar pantau? Alarmnya juga akan ikut terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere tutte le coppie dalla lista di osservazione? Verranno eliminati anche i loro allarmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリストからすべてのペアを削除しますか？各ペアのアラームも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 목록에서 모든 거래쌍을 삭제할까요? 해당 경보도 함께 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerne alle par fra overvåkingslisten? Alarmene deres forsvinner også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle paren uit de volglijst verwijderen? Hun alarmen worden ook verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć wszystkie pary z listy obserwowanych? Ich alarmy również zostaną usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover todos os pares da lista de acompanhamento? Os respetivos alarmes também serão removidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover todos os pares da lista de acompanhamento? Os alarmes deles também serão removidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminați toate perechile din lista de urmărire? Alarmele lor vor fi șterse și ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить все пары из избранного? Их оповещения тоже будут удалены."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të hiqen të gjitha çiftet nga lista e ndjekjes? Bashkë me to hiqen edhe alarmet e tyre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort alla par från bevakningslistan? Deras larm tas också bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบคู่ทั้งหมดออกจากรายการติดตามไหม? สัญญาณเตือนของคู่เหล่านั้นจะถูกลบด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm çiftler izleme listesinden kaldırılsın mı? Alarmları da silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити всі пари зі списку? Їхні сигнали також буде видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tất cả cặp khỏi danh sách theo dõi? Các cảnh báo của chúng cũng sẽ bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要从自选中移除所有交易对吗？其提醒也将一并删除。"
          }
        }
      }
    },
    "watchlist_empty_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اختر منصة وزوجًا من «إضافة». يمكن لكل زوج أن يحصل على إشعار وتحديث صوتي وتنبيهات سعرية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo vyberte burzu a pár na kartě „Přidat“. Každý pár může mít oznámení, hlasové hlášení ceny a cenové alarmy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller vælg en børs og et par under ”Tilføj”. Hvert par kan få en notifikation, en oplæsning og kursalarmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder unter «Hinzufügen» eine Börse und ein Paar wählen. Jedes Paar kann eine Benachrichtigung, eine Sprachansage und Alarme bekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ή επιλέξτε ανταλλακτήριο και ζεύγος στην «Προσθήκη». Κάθε ζεύγος μπορεί να έχει ειδοποίηση, φωνητική ενημέρωση και ειδοποιήσεις τιμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or pick an exchange and a pair under Add. Every pair can have a notification, a spoken update and price alarms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O elige un exchange y un par en «Añadir». Cada par puede tener una notificación, un aviso hablado y alarmas de precio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا در «افزودن» یک صرافی و یک جفت انتخاب کنید. هر جفت می‌تواند اعلان، خواندن صوتی قیمت و هشدار قیمت داشته باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai valitse pörssi ja pari välilehdellä ”Lisää”. Jokaiselle parille voi asettaa ilmoituksen, puhutun hinnan ja hintahälytyksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou choisissez une plateforme et une paire sous « Ajouter ». Chaque paire peut avoir une notification, une annonce vocale et des alertes de prix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "או בחרו בורסה וצמד בלשונית \"הוספה\". לכל צמד אפשר להגדיר התראה, הקראת מחיר והתראות מחיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या “जोड़ें” में एक एक्सचेंज और पेयर चुनें। हर पेयर के लिए नोटिफ़िकेशन, बोलकर अपडेट और प्राइस अलार्म सेट किए जा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy válasszon tőzsdét és párt a „Hozzáadás” lapon. Minden párhoz beállítható értesítés, felolvasott ár és árriasztás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau pilih bursa dan pasangan di “Tambah”. Setiap pasangan bisa memiliki notifikasi, pembaruan suara, dan alarm harga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure scegli un exchange e una coppia in «Aggiungi». Ogni coppia può avere una notifica, un annuncio vocale e allarmi di prezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または「追加」で取引所とペアを選んでください。各ペアに通知、読み上げ、価格アラームを設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 ‘추가’ 탭에서 거래소와 거래쌍을 고르세요. 거래쌍마다 알림, 음성 안내, 가격 경보를 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller velg en børs og et par under «Legg til». Hvert par kan få et varsel, en opplesning og kursalarmer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of kies onder ‘Toevoegen’ een exchange en een paar. Elk paar kan een melding, een gesproken update en koersalarmen hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albo wybierz giełdę i parę w zakładce „Dodaj”. Każda para może mieć powiadomienie, komunikat głosowy i alarmy cenowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou escolha uma exchange e um par em «Adicionar». Cada par pode ter uma notificação, um aviso falado e alarmes de preço."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou escolha uma exchange e um par em “Adicionar”. Cada par pode ter uma notificação, um aviso falado e alarmes de preço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau alegeți o bursă și o pereche în „Adaugă”. Fiecare pereche poate avea o notificare, anunțarea vocală a prețului și alarme de preț."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или выберите биржу и пару в разделе «Добавить». Для каждой пары можно включить уведомление, озвучивание и ценовые оповещения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ose zgjidh një bursë dhe një çift te «Shto». Çdo çift mund të ketë njoftim, lexim zanor të çmimit dhe alarme çmimi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller välj en börs och ett par under ”Lägg till”. Varje par kan få en avisering, en uppläsning och kurslarm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือเลือกกระดานเทรดและคู่เหรียญในแท็บ “เพิ่ม” แต่ละคู่ตั้งการแจ้งเตือน การอ่านราคาด้วยเสียง และสัญญาณเตือนราคาได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da “Ekle” bölümünde bir borsa ve çift seçin. Her çift için bildirim, sesli güncelleme ve fiyat alarmları ayarlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або виберіть біржу й пару в розділі «Додати». Для кожної пари можна ввімкнути сповіщення, озвучення та цінові сигнали."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc chọn sàn và cặp tiền trong “Thêm”. Mỗi cặp có thể có thông báo, đọc giá bằng giọng nói và cảnh báo giá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或在“添加”中选择交易所和交易对。每个交易对都可以设置通知、语音播报和价格提醒。"
          }
        }
      }
    },
