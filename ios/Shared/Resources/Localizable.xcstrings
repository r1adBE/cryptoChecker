    "settings_price_colors_inverted_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأحمر للارتفاع والأخضر للانخفاض، كما هو معتاد في الصين واليابان وكوريا وتايوان. الإعداد الافتراضي حسب منطقة الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Červená pro růst, zelená pro pokles, jak je zvykem v Číně, Japonsku, Koreji a na Tchaj-wanu. Výchozí nastavení závisí na regionu zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rød for stigning, grøn for fald, som det er almindeligt i Kina, Japan, Korea og Taiwan. Standard afhænger af enhedens region."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rot für steigend, Grün für fallend – wie in China, Japan, Korea und Taiwan üblich. Standard nach Region des Geräts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κόκκινο για άνοδο, πράσινο για πτώση, όπως συνηθίζεται σε Κίνα, Ιαπωνία, Κορέα και Ταϊβάν. Η προεπιλογή εξαρτάται από την περιοχή της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red for rising, green for falling, as usual in China, Japan, Korea and Taiwan. Default depends on the device region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rojo para subidas y verde para bajadas, como es habitual en China, Japón, Corea y Taiwán. El valor predeterminado depende de la región del dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرمز برای افزایش و سبز برای کاهش، همان‌طور که در چین، ژاپن، کره و تایوان مرسوم است. پیش‌فرض بر اساس منطقه دستگاه است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punainen nousulle, vihreä laskulle, kuten Kiinassa, Japanissa, Koreassa ja Taiwanissa on tapana. Oletus riippuu laitteen alueesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rouge pour la hausse, vert pour la baisse, comme en Chine, au Japon, en Corée et à Taïwan. Par défaut selon la région de l'appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אדום לעלייה, ירוק לירידה, כמקובל בסין, ביפן, בקוריאה ובטייוואן. ברירת המחדל תלויה באזור של המכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बढ़त के लिए लाल, गिरावट के लिए हरा, जैसा चीन, जापान, कोरिया और ताइवान में आम है। डिफ़ॉल्ट डिवाइस के क्षेत्र पर निर्भर करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piros az emelkedésnél, zöld az esésnél, ahogy Kínában, Japánban, Koreában és Tajvanon szokás. Az alapértelmezés az eszköz régiójától függ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merah untuk naik, hijau untuk turun, seperti lazim di Tiongkok, Jepang, Korea, dan Taiwan. Default mengikuti wilayah perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosso per il rialzo, verde per il ribasso, come d'uso in Cina, Giappone, Corea e Taiwan. Il valore predefinito dipende dalla regione del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国、日本、韓国、台湾で一般的なように、上昇を赤、下落を緑で表示します。既定値は端末の地域によって決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중국, 일본, 한국, 대만에서처럼 상승은 빨강, 하락은 초록으로 표시합니다. 기본값은 기기 지역에 따라 다릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rødt for stigning, grønt for fall, slik det er vanlig i Kina, Japan, Korea og Taiwan. Standard avhenger av enhetens region."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rood voor stijging, groen voor daling, zoals gebruikelijk in China, Japan, Korea en Taiwan. Standaard afhankelijk van de regio van het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czerwony dla wzrostu, zielony dla spadku, jak przyjęto w Chinach, Japonii, Korei i na Tajwanie. Domyślnie zależnie od regionu urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermelho para alta, verde para queda, como é comum na China, no Japão, na Coreia e em Taiwan. O padrão depende da região do dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermelho para alta, verde para queda, como é comum na China, no Japão, na Coreia e em Taiwan. O padrão depende da região do dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roșu pentru creștere, verde pentru scădere, cum se obișnuiește în China, Japonia, Coreea și Taiwan. Implicit în funcție de regiunea dispozitivului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красный для роста, зелёный для падения, как принято в Китае, Японии, Корее и на Тайване. По умолчанию зависит от региона устройства."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E kuqe për rritje, e gjelbër për rënie, siç është zakon në Kinë, Japoni, Kore dhe Tajvan. Parazgjedhja varet nga rajoni i pajisjes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rött för uppgång, grönt för nedgång, som är vanligt i Kina, Japan, Korea och Taiwan. Standard beror på enhetens region."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีแดงเมื่อขึ้น สีเขียวเมื่อลง ตามที่นิยมในจีน ญี่ปุ่น เกาหลี และไต้หวัน ค่าเริ่มต้นขึ้นอยู่กับภูมิภาคของอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çin, Japonya, Kore ve Tayvan'da alışıldığı gibi yükseliş için kırmızı, düşüş için yeşil. Varsayılan, cihazın bölgesine göre belirlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Червоний для зростання, зелений для падіння, як заведено в Китаї, Японії, Кореї та на Тайвані. Типово залежить від регіону пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đỏ cho tăng, xanh lá cho giảm, như thông lệ ở Trung Quốc, Nhật Bản, Hàn Quốc và Đài Loan. Mặc định tùy theo khu vực của thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红色表示上涨，绿色表示下跌，与中国、日本、韩国和台湾地区的习惯一致。默认值取决于设备所在地区。"
          }
        }
      }
    },
