    "settings_quiet_hours_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بين %1$@ و %2$@ تنتظر التنبيهات حتى نهاية ساعات الصمت ثم تنطلق بالصوت. تصل الإشعارات الأخرى بصمت ودون نطق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezi %1$@ a %2$@ alarmy počkají do konce nočního klidu a pak se ozvou se zvukem. Ostatní upozornění přicházejí potichu, bez hlasového hlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellem %1$@ og %2$@ venter alarmer, til nattero slutter, og lyder derefter med lyd. Andre meddelelser kommer lydløst uden oplæsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen %1$@ und %2$@ warten Alarme bis zum Ende der Nachtruhe und melden sich dann mit Ton. Andere Mitteilungen kommen lautlos, ohne Sprachausgabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταξύ %1$@ και %2$@ οι συναγερμοί περιμένουν μέχρι το τέλος των ωρών ησυχίας και μετά ηχούν κανονικά. Οι υπόλοιπες ειδοποιήσεις έρχονται αθόρυβα, χωρίς εκφώνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Between %1$@ and %2$@, alerts wait until quiet hours end and then go off with sound. Other notifications arrive silently, without speech."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ y %2$@, las alarmas esperan hasta que terminan las horas de silencio y luego suenan. Los demás avisos llegan en silencio, sin voz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بین %1$@ و %2$@ هشدارها تا پایان ساعات بی‌صدا صبر می‌کنند و سپس با صدا اعلام می‌شوند. اعلان‌های دیگر بی‌صدا و بدون گفتار می‌رسند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikavälillä %1$@–%2$@ hälytykset odottavat hiljaisten tuntien loppuun ja hälyttävät sitten äänellä. Muut ilmoitukset tulevat äänettömästi, ilman puhetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ et %2$@, les alertes attendent la fin des heures calmes, puis sonnent normalement. Les autres notifications arrivent en silence, sans voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בין %1$@ ל־%2$@ התראות ממתינות עד סוף שעות הדממה ואז מתריעות עם צליל. הודעות אחרות מגיעות בשקט, בלי הקראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से %2$@ के बीच अलार्म मौन घंटे खत्म होने तक रुकते हैं और फिर आवाज़ के साथ बजते हैं। बाकी सूचनाएँ चुपचाप आती हैं, बिना बोलकर सूचना के।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ és %2$@ között a riasztások megvárják a csendes órák végét, és utána hanggal szólalnak meg. A többi értesítés némán, felolvasás nélkül érkezik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antara %1$@ dan %2$@, alarm menunggu sampai jam tenang berakhir lalu berbunyi dengan suara. Pemberitahuan lain datang tanpa suara dan tanpa ucapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra %1$@ e %2$@ gli allarmi aspettano la fine delle ore di silenzio e poi suonano. Gli altri avvisi arrivano in silenzio, senza voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@～%2$@ はアラームがおやすみ時間の終わりまで待機し、その後サウンド付きで通知します。その他の通知は無音で、読み上げなしで届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@~%2$@에는 경보가 조용한 시간이 끝날 때까지 기다렸다가 소리와 함께 울립니다. 다른 알림은 음성 안내 없이 소리 없이 도착합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellom %1$@ og %2$@ venter alarmer til nattroen er over, og varsler deretter med lyd. Andre varsler kommer lydløst, uten opplesning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tussen %1$@ en %2$@ wachten alarmen tot de stille uren voorbij zijn en gaan dan af met geluid. Andere meldingen komen geluidloos binnen, zonder spraak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Między %1$@ a %2$@ alarmy czekają do końca godzin ciszy, a potem odzywają się z dźwiękiem. Inne powiadomienia przychodzą bez dźwięku i komunikatów głosowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ e %2$@, os alarmes esperam até ao fim das horas de silêncio e depois tocam com som. Os outros avisos chegam em silêncio, sem voz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ e %2$@, os alarmes esperam até o fim do horário de silêncio e depois tocam com som. Os outros avisos chegam em silêncio, sem voz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Între %1$@ și %2$@, alarmele așteaptă până la sfârșitul orelor de liniște și apoi sună. Celelalte notificări sosesc în liniște, fără voce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С %1$@ до %2$@ оповещения ждут окончания тихих часов и затем срабатывают со звуком. Остальные уведомления приходят беззвучно, без озвучивания."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midis %1$@ dhe %2$@ alarmet presin deri në fund të orëve të heshtjes dhe pastaj bien me tingull. Njoftimet e tjera vijnë në heshtje, pa zë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellan %1$@ och %2$@ väntar larm tills de tysta timmarna är slut och hörs sedan med ljud. Andra aviseringar kommer ljudlöst, utan uppläsning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่าง %1$@ ถึง %2$@ สัญญาณเตือนจะรอจนหมดช่วงเวลาเงียบ แล้วจึงดังพร้อมเสียง การแจ้งเตือนอื่นจะมาแบบเงียบ ไม่อ่านออกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ile %2$@ arasında alarmlar sessiz saatlerin bitmesini bekler, sonra sesli çalar. Diğer bildirimler sessiz ve sesli okuma olmadan gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З %1$@ до %2$@ сигнали чекають до кінця тихих годин, а потім спрацьовують зі звуком. Інші сповіщення надходять беззвучно, без озвучення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ %1$@ đến %2$@, cảnh báo sẽ chờ đến khi hết giờ yên lặng rồi mới kêu có âm thanh. Các thông báo khác đến trong im lặng, không có giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 至 %2$@ 之间，提醒会等到静音时段结束后再响铃提示。其他通知将静音送达，不进行语音播报。"
          }
        }
      }
    },
