            "value" : "70 से ऊपर मतलब पिछले हफ़्तों में तेज़ बढ़त, 30 से नीचे मतलब तेज़ गिरावट।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "70 felett erős emelkedést jelent az elmúlt hetekben, 30 alatt erős esést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di atas 70 berarti kenaikan kuat dalam beberapa minggu terakhir, di bawah 30 berarti penurunan kuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopra 70 significa forti rialzi nelle ultime settimane, sotto 30 forti ribassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "70超はここ数週間の大きな上昇、30未満は大きな下落を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "70 이상이면 최근 몇 주 동안 크게 올랐고, 30 미만이면 크게 내렸다는 뜻입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over 70 betyr kraftige oppganger de siste ukene, under 30 kraftige fall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boven 70 betekent sterke stijgingen in de afgelopen weken, onder 30 sterke dalingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powyżej 70 oznacza silne wzrosty w ostatnich tygodniach, poniżej 30 – silne spadki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima de 70 significa fortes subidas nas últimas semanas; abaixo de 30, fortes quedas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima de 70 significa fortes altas nas últimas semanas; abaixo de 30, fortes quedas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peste 70 înseamnă creșteri puternice în ultimele săptămâni, sub 30 scăderi puternice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выше 70 — сильный рост за последние недели, ниже 30 — сильное падение."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbi 70 do të thotë rritje të forta në javët e fundit, nën 30 rënie të forta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Över 70 betyder kraftiga uppgångar de senaste veckorna, under 30 kraftiga nedgångar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกิน 70 หมายถึงขึ้นแรงในช่วงหลายสัปดาห์ที่ผ่านมา ต่ำกว่า 30 หมายถึงลงแรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "70’in üzeri son haftalarda güçlü yükseliş, 30’un altı güçlü düşüş demektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понад 70 — сильне зростання за останні тижні, нижче 30 — сильне падіння."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên 70 nghĩa là tăng mạnh trong những tuần gần đây, dưới 30 nghĩa là giảm mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高于 70 表示近几周涨幅较大，低于 30 表示跌幅较大。"
          }
        }
      }
    },
    "ind_read_sma50_vs_200" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموجب يعني أن المتوسط القصير فوق الطويل، والسالب يعني أنه تحته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kladná znamená, že krátký průměr je nad dlouhým, záporná pod ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiv betyder, at det korte gennemsnit ligger over det lange, negativ under."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiv heisst, der kurze Schnitt liegt über dem langen, negativ heisst darunter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θετικό σημαίνει ότι ο σύντομος μέσος όρος είναι πάνω από τον μακρύ, αρνητικό κάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive means the short-term average is above the long-term one, negative means below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positivo significa que la media corta está por encima de la larga; negativo, por debajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبت یعنی میانگین کوتاه بالای میانگین بلند است، منفی یعنی زیر آن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiivinen tarkoittaa, että lyhyt keskiarvo on pitkän yläpuolella, negatiivinen alapuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positif signifie que la moyenne courte est au-dessus de la longue, négatif en dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיובי פירושו שהממוצע הקצר מעל הארוך, שלילי – מתחתיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धनात्मक मतलब छोटा औसत लंबे औसत से ऊपर है, ऋणात्मक मतलब नीचे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pozitív azt jelenti, hogy a rövid átlag a hosszú felett van, a negatív, hogy alatta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positif berarti rata-rata pendek di atas rata-rata panjang, negatif berarti di bawahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positivo significa che la media breve è sopra quella lunga, negativo sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラスは短期平均が長期平均を上回り、マイナスは下回っていることを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러스면 단기 평균이 장기 평균보다 위, 마이너스면 아래라는 뜻입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiv betyr at det korte snittet ligger over det lange, negativ under."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positief betekent dat het korte gemiddelde boven het lange ligt, negatief eronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatni oznacza, że krótka średnia jest powyżej długiej, ujemny – poniżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positivo significa que a média curta está acima da longa; negativo, abaixo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positivo significa que a média curta está acima da longa; negativo, abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitiv înseamnă că media scurtă e peste cea lungă, negativ sub ea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положительное — короткая средняя выше длинной, отрицательное — ниже."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitive do të thotë se mesatarja e shkurtër është mbi të gjatën, negative poshtë saj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positivt betyder att det korta genomsnittet ligger över det långa, negativt under."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บวกหมายถึงค่าเฉลี่ยระยะสั้นอยู่เหนือระยะยาว ลบหมายถึงอยู่ต่ำกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitif, kısa ortalamanın uzun ortalamanın üzerinde; negatif ise altında olduğunu gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додатне — коротка середня вища за довгу, від’ємне — нижча."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dương nghĩa là trung bình ngắn hạn cao hơn trung bình dài hạn, âm nghĩa là thấp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正值表示短期均线高于长期均线，负值表示低于。"
          }
        }
      }
    },
