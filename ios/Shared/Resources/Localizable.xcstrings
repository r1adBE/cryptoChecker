        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالا یعنی ماینرها خیلی بیشتر از معمول درآمد دارند، پایین یعنی خیلی کمتر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korkea tarkoittaa, että louhijat ansaitsevat paljon tavallista enemmän, matala paljon vähemmän."
