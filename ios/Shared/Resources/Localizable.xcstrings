        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android تصمیم می‌گیرد کی بررسی شود – اینجا می‌بینی واقعاً کی انجام شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android päättää, milloin tarkistetaan – tässä näet, milloin se todella tapahtui."
