    "update_mode_sparsam_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إغلاق التطبيق: ليس أكثر من مرة كل %1$@، وغالبًا أبطأ (التنبيهات والأدوات). عند فتحه: مع كل فتح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zavřené aplikaci nejčastěji každých %1$@, často později (alarmy, widgety). Otevřená: při každém otevření."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med appen lukket ikke oftere end hvert %1$@, ofte senere (alarmer, widgets). Åben: hver gang du åbner den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei geschlossener App nicht öfter als alle %1$@, oft später (Alarme, Widgets). Offen: bei jedem Öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με κλειστή εφαρμογή όχι συχνότερα από κάθε %1$@, συχνά αργότερα (συναγερμοί, widget). Ανοιχτή: σε κάθε άνοιγμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the app closed, no more often than every %1$@, often later (alerts, widgets). Open: each time you open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la app cerrada, no más a menudo que cada %1$@ y a menudo más tarde (alarmas, widgets). Abierta: cada vez que la abres."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی برنامه بسته است حداکثر هر %1$@ یک بار، اغلب دیرتر (هشدارها، ابزارک‌ها). باز: هر بار که باز می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen ollessa suljettuna enintään %1$@ välein, usein harvemmin (hälytykset, widgetit). Auki: aina avattaessa."
          }
        },
        "fr" : {
