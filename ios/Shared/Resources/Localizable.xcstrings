    "settings_tts_alarms_only_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: يُقرأ كل تحديث لزوج مفعّل عليه «نطق السعر»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
