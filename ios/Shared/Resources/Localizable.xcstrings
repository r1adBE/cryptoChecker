    "market_info_unusual_how" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر لكل عملة الملاحظة الأبرز، وعلى الجانب التغير خلال 24 ساعة. حجم 2× يعني ضعف حجم التداول المعتاد. غير المعتاد لا يعني جيدًا ولا سيئًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U každé mince je uvedeno nejnápadnější pozorování, vpravo změna za 24 hodin. Objem 2× znamená dvojnásobný obrat oproti obvyklému. Nápadné neznamená dobré ani špatné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For hver coin står den mest påfaldende iagttagelse, til højre ændringen over 24 timer. Et volumen på 2× betyder dobbelt så meget omsætning som normalt. Påfaldende betyder hverken godt eller skidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Coin steht die auffälligste Beobachtung, rechts die Veränderung über 24 Stunden. Ein Volumen von 2× heisst: doppelt so viel Umsatz wie üblich. Auffällig heisst weder gut noch schlecht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για κάθε νόμισμα εμφανίζεται η πιο αξιοσημείωτη παρατήρηση, δεξιά η μεταβολή 24 ωρών. Όγκος 2× σημαίνει διπλάσιο τζίρο από τον συνηθισμένο. Ασυνήθιστο δεν σημαίνει ούτε καλό ούτε κακό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each coin shows its most notable observation, with the 24-hour change on the right. A volume of 2× means twice the usual turnover. Notable means neither good nor bad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada criptomoneda se muestra la observación más llamativa y, a la derecha, la variación en 24 horas. Un volumen de 2× significa el doble del volumen habitual. Inusual no significa ni bueno ni malo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای هر کوین چشمگیرترین مشاهده و در کنار آن تغییر ۲۴ ساعته نشان داده می‌شود. حجم ۲× یعنی دو برابر گردش معمول. غیرعادی نه به معنای خوب است و نه بد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen kolikon kohdalla näkyy huomattavin havainto, oikealla muutos 24 tunnissa. Volyymi 2× tarkoittaa kaksinkertaista vaihtoa tavalliseen verrattuna. Huomattava ei tarkoita hyvää eikä huonoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque crypto, l'observation la plus marquante est indiquée, avec la variation sur 24 heures à droite. Un volume de 2× signifie deux fois le volume habituel. Inhabituel ne veut dire ni bon ni mauvais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל מטבע מוצגת התצפית הבולטת ביותר, ולצידה השינוי ב־24 שעות. נפח של 2× פירושו פי שניים ממחזור המסחר הרגיל. חריג אינו אומר טוב או רע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कॉइन के लिए सबसे ध्यान देने लायक बात दिखती है, और साथ में 24 घंटे का बदलाव। 2× वॉल्यूम का मतलब है सामान्य से दोगुना कारोबार। असामान्य का मतलब न अच्छा है, न बुरा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden coinnál a legfeltűnőbb megfigyelés látszik, jobbra a 24 órás változás. A 2× forgalom a szokásos kétszeresét jelenti. A feltűnő nem jelent se jót, se rosszat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk setiap koin ditampilkan pengamatan yang paling mencolok, di sampingnya perubahan 24 jam. Volume 2× berarti dua kali lipat perdagangan biasa. Tidak biasa bukan berarti baik atau buruk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni crypto è indicata l'osservazione più evidente, a destra la variazione nelle 24 ore. Un volume di 2× significa il doppio degli scambi abituali. Insolito non vuol dire né buono né cattivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各コインには最も目立つ点が表示され、横に24時間の変化が出ます。出来高2×は、通常の2倍の取引高という意味です。目立つことは、良いとも悪いとも限りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코인마다 가장 눈에 띄는 점이 표시되고, 옆에 24시간 변동이 나옵니다. 거래량 2×는 평소의 두 배 거래라는 뜻입니다. 눈에 띈다는 것이 좋거나 나쁘다는 뜻은 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For hver mynt står den mest påfallende observasjonen, til høyre endringen over 24 timer. Et volum på 2× betyr dobbelt så mye omsetning som vanlig. Påfallende betyr verken bra eller dårlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per coin staat de meest opvallende waarneming, rechts de verandering over 24 uur. Een volume van 2× betekent twee keer zoveel omzet als normaal. Opvallend betekent niet goed of slecht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy każdej monecie widać najbardziej wyraźną obserwację, po prawej zmianę z 24 godzin. Wolumen 2× oznacza dwa razy większy obrót niż zwykle. Nietypowo nie znaczy dobrze ani źle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada criptomoeda aparece a observação mais marcante e, à direita, a variação em 24 horas. Um volume de 2× significa o dobro do volume habitual. Invulgar não quer dizer bom nem mau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada criptomoeda aparece a observação mais marcante e, à direita, a variação em 24 horas. Um volume de 2× significa o dobro do volume habitual. Incomum não quer dizer bom nem ruim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru fiecare monedă apare observația cea mai evidentă, iar în dreapta variația pe 24 de ore. Un volum de 2× înseamnă dublul volumului obișnuit. Neobișnuit nu înseamnă nici bine, nici rău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для каждой монеты указано самое заметное наблюдение, справа изменение за 24 часа. Объём 2× означает вдвое больший оборот, чем обычно. Необычно не значит ни хорошо, ни плохо."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Për çdo monedhë shfaqet vëzhgimi më i dukshëm, djathtas ndryshimi për 24 orë. Vëllim 2× do të thotë dyfishi i qarkullimit të zakonshëm. E pazakontë nuk do të thotë as mirë, as keq."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För varje mynt står den mest påfallande iakttagelsen, till höger förändringen över 24 timmar. En volym på 2× betyder dubbelt så hög omsättning som vanligt. Påfallande betyder varken bra eller dåligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละเหรียญจะแสดงข้อสังเกตที่โดดเด่นที่สุด และด้านข้างคือการเปลี่ยนแปลงใน 24 ชั่วโมง ปริมาณ 2× หมายถึงมูลค่าซื้อขายเป็นสองเท่าของปกติ ผิดปกติไม่ได้แปลว่าดีหรือไม่ดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her coin için en dikkat çekici gözlem, sağda 24 saatlik değişim gösterilir. 2× hacim, olağan işlem hacminin iki katı demektir. Olağan dışı, iyi ya da kötü anlamına gelmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для кожної монети вказано найпомітніше спостереження, праворуч зміна за 24 години. Обсяг 2× означає вдвічі більший оборот, ніж зазвичай. Незвично не означає ні добре, ні погано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi coin hiển thị điểm đáng chú ý nhất, bên cạnh là thay đổi trong 24 giờ. Khối lượng 2× nghĩa là gấp đôi mức giao dịch thường ngày. Bất thường không có nghĩa là tốt hay xấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种币显示最显著的一项观察，旁边是 24 小时涨跌。成交量 2× 表示成交额是平常的两倍。异常并不代表好或坏。"
          }
        }
      }
    },
