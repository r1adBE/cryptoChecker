          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preço médio de compra: a média de todas as compras, ponderada pela quantidade. As vendas são avaliadas por essa média."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preço médio de compra: a média de todas as compras, ponderada pela quantidade. As vendas são avaliadas por essa média."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preț mediu de cumpărare: media tuturor cumpărărilor, ponderată cu cantitatea. Vânzările sunt evaluate la această medie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средняя цена покупки: среднее по всем покупкам, взвешенное по количеству. Продажи оцениваются по этому среднему."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çmimi mesatar i blerjes: mesatarja e të gjitha blerjeve, e peshuar sipas sasisë. Shitjet vlerësohen me këtë mesatare."
