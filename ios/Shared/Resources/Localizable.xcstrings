        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도는 연간 모든 개인 매각 또는 용역을 합산해 적용됩니다 – 앱 밖의 것도 포함합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grensene gjelder alle private salg eller tjenester i året samlet – også utenfor appen."
          }
        },
