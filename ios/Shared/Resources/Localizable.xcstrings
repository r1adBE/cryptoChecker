    "neutral_indicators_disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيم مقاسة فقط دون تقييم. ليست توقعًا ولا نصيحة استثمارية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze naměřené hodnoty, bez hodnocení. Nejde o předpověď ani investiční poradenství."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun måleværdier uden vurdering. Ingen prognose og ingen investeringsrådgivning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Messwerte, ohne Bewertung. Keine Prognose und keine Anlageberatung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο μετρούμενες τιμές, χωρίς αξιολόγηση. Δεν είναι πρόβλεψη ούτε επενδυτική συμβουλή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured values only, without assessment. Not a forecast and no investment advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo valores medidos, sin valoración. No es un pronóstico ni asesoramiento de inversión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط مقادیر اندازه‌گیری‌شده، بدون ارزیابی. پیش‌بینی یا توصیه سرمایه‌گذاری نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mitattuja arvoja ilman arviota. Ei ennuste eikä sijoitusneuvontaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement des valeurs mesurées, sans évaluation. Ni prévision ni conseil en investissement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים מדודים בלבד, ללא הערכה. אין זו תחזית ואין זה ייעוץ השקעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल मापे गए मान, बिना आकलन के। यह कोई पूर्वानुमान या निवेश सलाह नहीं है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak mért értékek, értékelés nélkül. Nem előrejelzés és nem befektetési tanács."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya nilai terukur, tanpa penilaian. Bukan prakiraan dan bukan saran investasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo valori misurati, senza valutazione. Nessuna previsione e nessuna consulenza d'investimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定値のみで評価は含みません。予測でも投資助言でもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "측정값만 보여주며 평가는 하지 않습니다. 예측이나 투자 조언이 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare måleverdier, uten vurdering. Ingen prognose og ingen investeringsråd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen meetwaarden, zonder beoordeling. Geen voorspelling en geen beleggingsadvies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko wartości pomiarowe, bez oceny. To nie prognoza ani porada inwestycyjna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas valores medidos, sem avaliação. Não é uma previsão nem aconselhamento de investimento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas valores medidos, sem avaliação. Não é previsão nem recomendação de investimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar valori măsurate, fără evaluare. Nu este o prognoză și nici consultanță de investiții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только измеренные значения, без оценки. Не прогноз и не инвестиционная рекомендация."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetëm vlera të matura, pa vlerësim. Nuk është parashikim dhe as këshillë investimi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast mätvärden, utan bedömning. Ingen prognos och ingen investeringsrådgivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นเพียงค่าที่วัดได้ ไม่มีการประเมิน ไม่ใช่การพยากรณ์และไม่ใช่คำแนะนำการลงทุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca ölçülen değerler, yorum içermez. Tahmin veya yatırım tavsiyesi değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише виміряні значення, без оцінки. Не прогноз і не інвестиційна порада."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ là giá trị đo được, không có đánh giá. Không phải dự báo và không phải lời khuyên đầu tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅为测量值，不含评估。不是预测，也不是投资建议。"
          }
        }
      }
    },
    "neutral_info_alt_season_how" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض التطبيق العدد فقط ولا يسمّيه «موسمًا». تتغير القيمة عادة خلال أيام لا ساعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace ukazuje jen počet a nenazývá ho „sezónou“. Hodnota se obvykle mění v řádu dní, ne hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen viser kun optællingen og kalder den ikke en «sæson». Værdien ændrer sig som regel over dage, ikke timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App zeigt nur die Zählung und nennt sie nicht «Saison». Der Wert ändert sich meist über Tage, nicht Stunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή δείχνει μόνο την καταμέτρηση και δεν την ονομάζει «περίοδο». Η τιμή αλλάζει συνήθως μέσα σε μέρες, όχι ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app only shows the count and does not label it as a season. The value usually changes over days, not hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo muestra el recuento y no lo califica de «temporada». El valor suele cambiar en días, no en horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه فقط شمارش را نشان می‌دهد و آن را «فصل» نمی‌نامد. این مقدار معمولاً در طول چند روز تغییر می‌کند، نه چند ساعت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus näyttää vain lukumäärän eikä nimitä sitä ”kaudeksi”. Arvo muuttuu yleensä päivien, ei tuntien, aikana."
          }
        },
