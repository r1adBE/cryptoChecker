    "tax_de_explain_loss" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صافي خسارة: لا ضريبة على هذه البيوع. لا تُقاص الخسائر وفق § 23 EStG إلا بأرباح البيوع الخاصة – في السنة نفسها أو بترحيلها إلى السنة السابقة وإلى السنوات اللاحقة (§ 23 Abs. 3 / § 10d EStG). صرّح بالخسارة في إقرارك الضريبي ليتم إثباتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čistá ztráta: z těchto prodejů žádná daň. Ztráty podle § 23 EStG lze započíst jen se zisky ze soukromých prodejů – ve stejném roce nebo převodem do předchozího roku a do dalších let (§ 23 Abs. 3 / § 10d EStG). Uveď ztrátu v daňovém přiznání aby byla stanovena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettotab: ingen skat af disse salg. Tab efter § 23 EStG kan kun modregnes i gevinster fra private salg – i samme år eller ved tilbageførsel til året før og fremførsel til senere år (§ 23 Abs. 3 / § 10d EStG). Angiv tabet i din selvangivelse så det bliver fastsat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netto ein Verlust: keine Steuer auf diese Geschäfte. Verluste nach § 23 EStG sind nur mit Gewinnen aus privaten Veräusserungsgeschäften verrechenbar – im selben Jahr oder per Rücktrag ins Vorjahr bzw. Vortrag in Folgejahre (§ 23 Abs. 3 und § 10d EStG). Gib den Verlust in der Steuererklärung an – damit er festgestellt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθαρή ζημία: κανένας φόρος σε αυτές τις πωλήσεις. Οι ζημίες κατά το § 23 EStG συμψηφίζονται μόνο με κέρδη από ιδιωτικές πωλήσεις – στο ίδιο έτος ή με μεταφορά στο προηγούμενο και στα επόμενα έτη (§ 23 Abs. 3 / § 10d EStG). Δήλωσε τη ζημία στη φορολογική δήλωση ώστε να βεβαιωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net loss: no tax on these sales. Losses under § 23 EStG only offset gains from private sales – in the same year or by carryback to the previous year and carryforward to later years (§ 23 para. 3 and § 10d EStG). Declare the loss in your tax return so it is assessed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pérdida neta: sin impuesto sobre estas ventas. Las pérdidas según el § 23 EStG solo se compensan con ganancias de ventas privadas – en el mismo año o trasladándolas al año anterior y a años posteriores (§ 23 Abs. 3 / § 10d EStG). Declara la pérdida en tu declaración de impuestos para que se determine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیان خالص: بر این فروش‌ها مالیاتی نیست. زیان‌های طبق § 23 EStG فقط با سود فروش‌های شخصی تهاتر می‌شوند – در همان سال یا با انتقال به سال قبل و سال‌های بعد (§ 23 Abs. 3 / § 10d EStG). زیان را در اظهارنامهٔ مالیاتی اعلام کن تا ثبت شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettotappio: näistä myynneistä ei veroa. § 23 EStG:n mukaiset tappiot vähennetään vain yksityisten luovutusten voitoista – samana vuonna tai siirtämällä edelliseen vuoteen ja myöhempiin vuosiin (§ 23 Abs. 3 / § 10d EStG). Ilmoita tappio veroilmoituksessa jotta se vahvistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perte nette : aucun impôt sur ces ventes. Les pertes au sens du § 23 EStG ne s’imputent que sur les gains de ventes privées – la même année ou par report sur l’année précédente et sur les années suivantes (§ 23 Abs. 3 / § 10d EStG). Déclare la perte dans ta déclaration d’impôt afin qu’elle soit constatée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפסד נטו: אין מס על מכירות אלה. הפסדים לפי § 23 EStG מתקזזים רק מול רווחים ממכירות פרטיות – באותה שנה או בהעברה לשנה הקודמת ולשנים הבאות (§ 23 Abs. 3 / § 10d EStG). דווחו על ההפסד בדוח המס כדי שייקבע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुद्ध हानि: इन बिक्रियों पर कोई कर नहीं। § 23 EStG के तहत हानि केवल निजी बिक्री के लाभ से समायोजित होती है – उसी वर्ष में या पिछले वर्ष में पीछे ले जाकर और अगले वर्षों में आगे ले जाकर (§ 23 Abs. 3 / § 10d EStG)। हानि को टैक्स रिटर्न में दिखाओ ताकि वह निर्धारित हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettó veszteség: ezek után az eladások után nincs adó. A § 23 EStG szerinti veszteség csak magáneladások nyereségével számolható el – ugyanabban az évben vagy az előző évre visszahozva és későbbi évekre átvive (§ 23 Abs. 3 / § 10d EStG). Tüntesd fel a veszteséget az adóbevallásban hogy megállapítsák."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugi bersih: tidak ada pajak atas penjualan ini. Kerugian menurut § 23 EStG hanya dapat dikompensasi dengan keuntungan penjualan pribadi – di tahun yang sama atau dibawa ke tahun sebelumnya dan ke tahun berikutnya (§ 23 Abs. 3 / § 10d EStG). Laporkan kerugian di SPT agar ditetapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdita netta: nessuna imposta su queste vendite. Le perdite ai sensi del § 23 EStG si compensano solo con plusvalenze da vendite private – nello stesso anno o con riporto all’anno precedente e agli anni successivi (§ 23 Abs. 3 / § 10d EStG). Indica la perdita nella dichiarazione dei redditi perché venga accertata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "純損失：これらの売却に税金はかかりません。§ 23 EStG の損失は私的譲渡の利益とのみ相殺できます – 同じ年に、または前年への繰戻しと翌年以降への繰越しで（§ 23 Abs. 3 / § 10d EStG）。損失が確定されるよう確定申告に記載してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순손실: 이 매도에는 세금이 없습니다. § 23 EStG에 따른 손실은 사적 양도 이익과만 상계됩니다 – 같은 해에 또는 전년도로 소급하고 이후 연도로 이월하여(§ 23 Abs. 3 / § 10d EStG). 손실이 확정되도록 세금 신고서에 기재하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettotap: ingen skatt på disse salgene. Tap etter § 23 EStG kan bare motregnes mot gevinster fra private salg – samme år eller ved tilbakeføring til året før og fremføring til senere år (§ 23 Abs. 3 / § 10d EStG). Oppgi tapet i skattemeldingen slik at det blir fastsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoverlies: geen belasting op deze verkopen. Verliezen volgens § 23 EStG zijn alleen verrekenbaar met winsten uit privéverkopen – in hetzelfde jaar of door terugwenteling naar het vorige jaar en voorwaartse verrekening naar latere jaren (§ 23 Abs. 3 / § 10d EStG). Geef het verlies op in je belastingaangifte zodat het wordt vastgesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strata netto: brak podatku od tych transakcji. Straty z § 23 EStG można rozliczyć tylko z zyskami ze sprzedaży prywatnej – w tym samym roku albo przez przeniesienie na rok poprzedni i lata następne (§ 23 Abs. 3 / § 10d EStG). Wykaż stratę w zeznaniu podatkowym aby została ustalona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perda líquida: sem imposto sobre estas vendas. As perdas nos termos do § 23 EStG só se compensam com ganhos de vendas privadas – no mesmo ano ou por reporte ao ano anterior e aos anos seguintes (§ 23 Abs. 3 / § 10d EStG). Declara a perda na tua declaração de impostos para que seja apurada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prejuízo líquido: sem imposto sobre estas vendas. Os prejuízos pelo § 23 EStG só se compensam com ganhos de vendas privadas – no mesmo ano ou levando-os ao ano anterior e aos anos seguintes (§ 23 Abs. 3 / § 10d EStG). Informe o prejuízo na sua declaração de imposto para que seja apurado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierdere netă: niciun impozit pe aceste vânzări. Pierderile conform § 23 EStG se compensează doar cu câștiguri din vânzări private – în același an sau prin reportare în anul anterior și în anii următori (§ 23 Abs. 3 / § 10d EStG). Declară pierderea în declarația fiscală ca să fie stabilită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чистый убыток: налога на эти продажи нет. Убытки по § 23 EStG зачитываются только против прибыли от частных продаж – в том же году либо переносом на предыдущий год и на последующие годы (§ 23 Abs. 3 / § 10d EStG). Укажи убыток в налоговой декларации чтобы его зафиксировали."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humbje neto: asnjë tatim për këto shitje. Humbjet sipas § 23 EStG kompensohen vetëm me fitime nga shitje private – në të njëjtin vit ose duke i bartur në vitin e kaluar dhe në vitet në vijim (§ 23 Abs. 3 / § 10d EStG). Deklaroje humbjen në deklaratën tatimore që të përcaktohet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoförlust: ingen skatt på dessa försäljningar. Förluster enligt § 23 EStG kan bara kvittas mot vinster från privata försäljningar – samma år eller genom bakåtföring till föregående år och framföring till senare år (§ 23 Abs. 3 / § 10d EStG). Ange förlusten i din deklaration så att den fastställs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขาดทุนสุทธิ: ไม่มีภาษีสำหรับการขายเหล่านี้ ผลขาดทุนตาม § 23 EStG หักได้เฉพาะกับกำไรจากการขายส่วนบุคคล – ในปีเดียวกันหรือโดยยกย้อนไปปีก่อนและยกไปปีถัดไป (§ 23 Abs. 3 / § 10d EStG) แจ้งผลขาดทุนในแบบแสดงรายการภาษีเพื่อให้มีการรับรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net zarar: bu satışlarda vergi yok. § 23 EStG kapsamındaki zararlar yalnızca özel satış kazançlarıyla mahsup edilir – aynı yıl ya da önceki yıla geri ve sonraki yıllara ileri taşınarak (§ 23 Abs. 3 / § 10d EStG). Zararın tespit edilmesi için vergi beyannamende bildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чистий збиток: податку на ці продажі немає. Збитки за § 23 EStG зараховуються лише проти прибутку від приватних продажів – у тому самому році або перенесенням на попередній рік і на наступні роки (§ 23 Abs. 3 / § 10d EStG). Зазнач збиток у податковій декларації щоб його зафіксували."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lỗ ròng: không có thuế cho các lần bán này. Khoản lỗ theo § 23 EStG chỉ bù trừ với lãi từ bán riêng tư – trong cùng năm hoặc chuyển về năm trước và sang các năm sau (§ 23 Abs. 3 / § 10d EStG). Hãy khai khoản lỗ trong tờ khai thuế để được xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "净亏损：这些出售无需纳税。§ 23 EStG 下的亏损只能与私人出售收益抵扣——在同一年或向前一年结转及向以后年度结转（§ 23 Abs. 3 / § 10d EStG）。请在纳税申报中申报该亏损以便予以确认。"
          }
        }
      }
    },
    "tax_de_explain_reached" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتداءً من %1$@ يُحتسب المبلغ كله (حد إعفاء – وليس خصمًا)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od %1$@ se počítá celá částka (hranice osvobození – ne nezdanitelná částka)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra %1$@ tæller hele beløbet (fritagelsesgrænse – ikke et bundfradrag)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab %1$@ zählt der ganze Betrag (Freigrenze – kein Freibetrag)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από %1$@ μετρά όλο το ποσό (όριο απαλλαγής – όχι αφορολόγητο ποσό)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From %1$@ the whole amount counts (exemption limit – not an allowance)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde %1$@ cuenta todo el importe (límite exento – no una deducción)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از %1$@ کل مبلغ حساب می‌شود (سقف معافیت – نه کسر معاف)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summasta %1$@ alkaen koko summa lasketaan (verovapausraja – ei vähennys)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À partir de %1$@ tout le montant compte (seuil d’exonération – pas un abattement)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מ-%1$@ נספר כל הסכום (תקרת פטור – לא סכום פטור)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से पूरी राशि गिनी जाती है (छूट सीमा – कटौती नहीं)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-tól a teljes összeg számít (mentességi határ – nem adómentes keret)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai %1$@ seluruh jumlah dihitung (batas bebas pajak – bukan pengurangan)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da %1$@ conta l’intero importo (soglia di esenzione – non una franchigia)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 以上は全額が対象です（非課税限度 – 控除額ではありません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@부터는 전액이 계산됩니다(비과세 한도 – 공제액 아님)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra %1$@ teller hele beløpet (fritaksgrense – ikke et bunnfradrag)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanaf %1$@ telt het hele bedrag (vrijstellingsgrens – geen vrijgesteld bedrag)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od %1$@ liczy się cała kwota (próg zwolnienia – nie kwota wolna)."
          }
        },
