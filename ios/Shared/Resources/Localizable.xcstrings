    "tax_summary_uk_hmrc_report" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عائدات قبل الرسوم تتجاوز حد الإبلاغ (50,000 جنيه إسترليني؛ 2020/21–2022/23: 49,200 جنيه إسترليني): يلزم الإبلاغ إلى HMRC إذا كنت مسجلاً في Self Assessment، حتى دون ربح خاضع للضريبة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příjmy z prodeje před poplatky nad hranicí pro hlášení (50 000 £; 2020/21–2022/23: 49 200 £): hlášení HMRC, pokud máš registraci pro Self Assessment, i bez zdanitelného zisku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salgssummer før gebyrer over indberetningsgrænsen (£50.000; 2020/21–2022/23: £49.200): indberetning til HMRC, hvis du er registreret til Self Assessment, også uden skattepligtig gevinst"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlöse vor Gebühren über der Meldegrenze (£50,000; 2020/21–2022/23: £49,200): Meldung an HMRC, falls du für Self Assessment registriert bist – auch ohne steuerbaren Gewinn"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έσοδα πώλησης πριν από τέλη άνω του ορίου δήλωσης (50.000 £· 2020/21–2022/23: 49.200 £): δήλωση στην HMRC αν έχεις εγγραφεί στο Self Assessment, ακόμη και χωρίς φορολογητέο κέρδος"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proceeds before fees over the reporting limit (£50,000; 2020/21–2022/23: £49,200): report to HMRC if you are registered for Self Assessment, even without a taxable gain"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importes de venta antes de comisiones por encima del límite de declaración (50.000 £; 2020/21–2022/23: 49.200 £): declaración a HMRC si estás registrado en Self Assessment, incluso sin ganancia imponible"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عواید فروش پیش از کارمزد بیش از سقف گزارش (50,000 پوند؛ 2020/21–2022/23: 49,200 پوند): اگر در Self Assessment ثبت‌نام کرده‌ای، گزارش به HMRC لازم است، حتی بدون سود مشمول مالیات"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luovutushinnat ennen kuluja yli ilmoitusrajan (50 000 £; 2020/21–2022/23: 49 200 £): ilmoitus HMRC:lle, jos olet rekisteröitynyt Self Assessmentiin, myös ilman veronalaista voittoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produits de cession avant frais supérieurs au seuil de déclaration (50 000 £ ; 2020/21–2022/23 : 49 200 £) : déclaration à HMRC si tu es inscrit au Self Assessment, même sans plus-value imposable"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמורה לפני עמלות מעל סף הדיווח (50,000 ליש״ט; 2020/21–2022/23: 49,200 ליש״ט): דיווח ל-HMRC אם נרשמת ל-Self Assessment, גם ללא רווח חייב במס"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुल्क से पहले की बिक्री आय रिपोर्टिंग सीमा से अधिक (£50,000; 2020/21–2022/23: £49,200): यदि तुम Self Assessment के लिए पंजीकृत हो तो HMRC को सूचना दो, कर योग्य लाभ न होने पर भी"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díjak előtti eladási bevétel a bejelentési határ felett (50 000 £; 2020/21–2022/23: 49 200 £): bejelentés a HMRC-nek, ha regisztráltál a Self Assessmentre, adóköteles nyereség nélkül is"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil penjualan sebelum biaya di atas batas pelaporan (£50.000; 2020/21–2022/23: £49.200): lapor ke HMRC jika kamu terdaftar untuk Self Assessment, meskipun tanpa keuntungan kena pajak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrispettivi al lordo delle commissioni oltre la soglia di dichiarazione (50.000 £; 2020/21–2022/23: 49.200 £): dichiarazione a HMRC se sei registrato al Self Assessment, anche senza plusvalenza imponibile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手数料控除前の譲渡収入が報告基準額を超過（£50,000、2020/21–2022/23 は £49,200）：Self Assessment に登録している場合、課税対象の利益がなくても HMRC への申告が必要"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수수료 차감 전 양도 대금이 신고 기준 초과(£50,000, 2020/21–2022/23: £49,200): Self Assessment에 등록된 경우 과세 이익이 없어도 HMRC 신고 필요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
