    "explain_spot_supply" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتداول: العملات الموجودة في السوق الآن. الإجمالي: كل العملات المُنشأة ناقص المحروقة. الأقصى: أكبر كمية يمكن أن توجد على الإطلاق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V oběhu: mince, které jsou teď na trhu. Celková: všechny vytvořené mince bez spálených. Max.: nejvíc, kolik jich kdy může existovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirkulerende: coins på markedet nu. Samlet: alle skabte coins minus brændte. Maks.: det højeste antal, der nogensinde kan findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umlauf: Coins, die jetzt am Markt sind. Gesamt: alle geschaffenen Coins abzüglich verbrannter. Höchst: die grösste Menge, die es je geben kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κυκλοφορούσα: νομίσματα στην αγορά τώρα. Συνολική: όλα όσα δημιουργήθηκαν μείον όσα κάηκαν. Μέγιστη: το περισσότερο που μπορεί ποτέ να υπάρξει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circulating: coins on the market now. Total: all coins created minus burned ones. Max: the most that can ever exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circulante: monedas en el mercado ahora. Total: todas las creadas menos las quemadas. Máximo: lo máximo que puede existir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در گردش: کوین‌هایی که اکنون در بازارند. کل: همه کوین‌های ساخته‌شده منهای سوزانده‌شده‌ها. حداکثر: بیشترین مقداری که می‌تواند وجود داشته باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kierrossa: kolikot, jotka ovat nyt markkinoilla. Kokonais: kaikki luodut kolikot miinus poltetut. Enimmäis: suurin määrä, joka voi koskaan olla olemassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En circulation : coins sur le marché maintenant. Totale : tous les coins créés moins ceux brûlés. Maximale : le plus qui puisse jamais exister."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במחזור: מטבעות שנמצאים עכשיו בשוק. כולל: כל המטבעות שנוצרו פחות אלה שנשרפו. מרבי: הכמות הגדולה ביותר שיכולה להתקיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिसंचारी: अभी बाज़ार में मौजूद कॉइन। कुल: बनाए गए सभी कॉइन, जलाए गए घटाकर। अधिकतम: जितने कभी भी हो सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgalomban: most a piacon lévő érmék. Teljes: az összes létrehozott érme az elégetettek nélkül. Max.: a valaha létező legtöbb."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beredar: koin yang ada di pasar sekarang. Total: semua koin yang dibuat dikurangi yang dibakar. Maks.: jumlah terbanyak yang bisa ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circolante: monete ora sul mercato. Totale: tutte le monete create meno quelle bruciate. Massima: il massimo che potrà mai esistere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "循環: 現在市場にあるコイン。総: 発行されたコインからバーン分を除いたもの。最大: 存在しうる上限。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
