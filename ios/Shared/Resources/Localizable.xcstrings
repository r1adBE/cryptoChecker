    "battery_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في معلومات التطبيق، اضغط على البطارية (أو استخدام بطارية التطبيق) واختر غير مقيّد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V informacích o aplikaci klepněte na Baterie (nebo Využití baterie aplikací) a zvolte Neomezeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Batteri (eller Appens batteriforbrug) i appinfo, og vælg Ubegrænset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
