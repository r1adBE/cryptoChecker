      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ خلال 24 ساعة بينما السوق هادئ – ربما أمر يخص هذه العملة وحدها."
