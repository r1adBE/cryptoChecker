    "battery_delay_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤخّر Android الفحص – اضبط البطارية على «غير مقيّد»"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android může kontroly zpozdit – nastav baterii na „Neomezeno“"
