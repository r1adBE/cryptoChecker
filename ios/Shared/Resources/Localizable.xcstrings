    "market_info_dominance_what" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حصة Bitcoin من القيمة الإجمالية لجميع العملات المشفرة (القيمة السوقية). وتحتها حصة Ethereum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podíl Bitcoinu na celkové hodnotě všech kryptoměn (tržní kapitalizace). Pod ním je uveden podíl Etherea."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoins andel af den samlede værdi af alle kryptovalutaer (markedsværdi). Nedenunder står Ethereums andel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil von Bitcoin am Gesamtwert aller Kryptowährungen (Marktkapitalisierung). Darunter steht der Anteil von Ethereum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μερίδιο του Bitcoin στη συνολική αξία όλων των κρυπτονομισμάτων (κεφαλαιοποίηση αγοράς). Από κάτω εμφανίζεται το μερίδιο του Ethereum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share of Bitcoin in the total value of all cryptocurrencies (market capitalization). Below it is the share of Ethereum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte de Bitcoin en el valor total de todas las criptomonedas (capitalización de mercado). Debajo aparece la parte de Ethereum."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سهم Bitcoin از ارزش کل همه رمزارزها (ارزش بازار). زیر آن سهم Ethereum آمده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoinin osuus kaikkien kryptovaluuttojen yhteenlasketusta arvosta (markkina-arvo). Alla näkyy Ethereumin osuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part de Bitcoin dans la valeur totale de toutes les cryptomonnaies (capitalisation). En dessous figure la part d'Ethereum."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק של Bitcoin בשווי הכולל של כל המטבעות הקריפטוגרפיים (שווי שוק). מתחתיו מוצג החלק של Ethereum."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी क्रिप्टोकरेंसी के कुल मूल्य (मार्केट कैप) में Bitcoin का हिस्सा। उसके नीचे Ethereum का हिस्सा दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bitcoin részesedése az összes kriptovaluta együttes értékéből (piaci kapitalizáció). Alatta az Ethereum részesedése áll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porsi Bitcoin dari total nilai semua mata uang kripto (kapitalisasi pasar). Di bawahnya tertera porsi Ethereum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quota di Bitcoin sul valore totale di tutte le criptovalute (capitalizzazione di mercato). Sotto è indicata la quota di Ethereum."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての暗号資産の合計価値（時価総額）に占める Bitcoin の割合です。その下に Ethereum の割合が表示されます。"
          }
        },
        "ko" : {
