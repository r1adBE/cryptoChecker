    "alarm_speak_ios_open_only" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنطق فقط والتطبيق مفتوح – لا يسمح iOS بالنطق في الخلفية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čte se jen při otevřené aplikaci – iOS nepovoluje hlasový výstup na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læses kun op, mens appen er åben – iOS tillader ikke oplæsning i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur bei offener App vorgelesen – iOS erlaubt keine Sprachausgabe im Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκφωνείται μόνο όταν η εφαρμογή είναι ανοιχτή – το iOS δεν επιτρέπει φωνητική έξοδο στο παρασκήνιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoken only while the app is open – iOS does not allow speech in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se lee con la app abierta – iOS no permite la salida de voz en segundo plano."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط وقتی برنامه باز است خوانده می‌شود – iOS خواندن صوتی در پس‌زمینه را اجازه نمی‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luetaan ääneen vain sovelluksen ollessa auki – iOS ei salli puhetta taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annoncé uniquement lorsque l’app est ouverte – iOS n’autorise pas l’annonce vocale en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוקרא רק כשהאפליקציה פתוחה – iOS לא מאפשר הקראה ברקע."
          }
        },
