        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שמפעיל את %1$@ רואה את כל הכתובות שנשאלו מהארנק הזה ויכול לקשר ביניהן ולכתובת ה-IP שלכם."
          }
