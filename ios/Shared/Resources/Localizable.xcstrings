    "update_mode_sparsam_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إغلاق التطبيق يقرر iOS متى يتحقق (التنبيهات، الأدوات)، أحيانًا بعد ساعات. مفتوح: عند كل فتح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zavřené aplikaci rozhoduje iOS, kdy se kontroluje (alarmy, widgety), někdy až po hodinách. Otevřená: při každém otevření."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med appen lukket bestemmer iOS, hvornår der tjekkes (alarmer, widgets), nogle gange med timers mellemrum. Åben: hver gang du åbner den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei geschlossener App entscheidet iOS, wann geprüft wird (Alarme, Widgets), manchmal erst nach Stunden. Offen: bei jedem Öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με κλειστή την εφαρμογή, το iOS αποφασίζει πότε θα ελέγξει (συναγερμοί, widget), μερικές φορές με ώρες διαφορά. Ανοιχτή: σε κάθε άνοιγμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the app closed, iOS decides when to check (alerts, widgets), sometimes hours apart. Open: each time you open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la app cerrada, iOS decide cuándo comprobar (alarmas, widgets), a veces con horas de diferencia. Abierta: cada vez que la abres."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
