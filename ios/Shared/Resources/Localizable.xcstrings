    "market_info_macro_how" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يظهر التنبيه إلا إذا كان أحد هذه المواعيد اليوم أو غدًا. حول موعد النشر تتقلب الأسعار غالبًا أكثر من المعتاد. يعرض التطبيق الموعد فقط، لا الأرقام نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění se zobrazí, jen když je takový termín dnes nebo zítra. Kolem zveřejnění ceny často kolísají víc než obvykle. Aplikace ukazuje jen termín, ne samotná čísla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelelsen vises kun, når en sådan dato er i dag eller i morgen. Omkring offentliggørelsen svinger kurserne ofte mere end ellers. Appen viser kun datoen, ikke selve tallene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hinweis erscheint nur, wenn ein solcher Termin heute oder morgen ist. Rund um die Veröffentlichung schwanken die Kurse oft stärker als sonst. Die App zeigt nur den Termin, nicht die Zahlen selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ειδοποίηση εμφανίζεται μόνο όταν μια τέτοια ημερομηνία είναι σήμερα ή αύριο. Γύρω από τη δημοσίευση οι τιμές συχνά κυμαίνονται περισσότερο από το συνηθισμένο. Η εφαρμογή δείχνει μόνο την ημερομηνία, όχι τα ίδια τα στοιχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note only appears when such a date is today or tomorrow. Around the release, prices often swing more than usual. The app shows only the date, not the figures themselves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aviso solo aparece cuando una de estas fechas es hoy o mañana. En torno a la publicación, los precios suelen oscilar más de lo habitual. La app muestra solo la fecha, no las cifras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این یادآوری فقط وقتی نمایش داده می‌شود که چنین تاریخی امروز یا فردا باشد. حوالی انتشار، قیمت‌ها اغلب بیش از معمول نوسان دارند. برنامه فقط تاریخ را نشان می‌دهد، نه خود ارقام را."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitus näkyy vain, kun tällainen päivämäärä on tänään tai huomenna. Julkaisun aikaan kurssit heiluvat usein tavallista enemmän. Sovellus näyttää vain päivämäärän, ei itse lukuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note n'apparaît que si une telle date tombe aujourd'hui ou demain. Autour de la publication, les cours fluctuent souvent davantage. L'app indique seulement la date, pas les chiffres eux-mêmes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההודעה מופיעה רק כשמועד כזה חל היום או מחר. סביב הפרסום המחירים נוטים לתנודות חזקות מהרגיל. האפליקציה מציגה רק את המועד, לא את הנתונים עצמם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सूचना तभी दिखती है जब ऐसी कोई तारीख आज या कल हो। आँकड़े जारी होने के आसपास कीमतें अक्सर सामान्य से ज़्यादा उतार-चढ़ाव करती हैं। ऐप केवल तारीख दिखाता है, आँकड़े नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelzés csak akkor jelenik meg, ha ilyen időpont ma vagy holnap van. A közzététel körül az árfolyamok gyakran a szokásosnál jobban ingadoznak. Az alkalmazás csak az időpontot mutatja, magukat a számokat nem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan hanya muncul jika jadwal seperti itu jatuh hari ini atau besok. Di sekitar rilis, harga sering berfluktuasi lebih kuat dari biasanya. Aplikasi hanya menampilkan jadwalnya, bukan angkanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'avviso compare solo se una di queste date è oggi o domani. Intorno alla pubblicazione i prezzi oscillano spesso più del solito. L'app mostra solo la data, non i dati stessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この案内は、そうした発表日が今日か明日の場合にだけ表示されます。発表の前後は、価格がふだんより大きく動くことがよくあります。アプリが示すのは日程だけで、数値そのものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 안내는 그런 일정이 오늘이나 내일일 때만 나타납니다. 발표 전후에는 가격이 평소보다 크게 흔들리는 경우가 많습니다. 앱은 일정만 보여 주며 수치 자체는 보여 주지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen vises bare når en slik dato er i dag eller i morgen. Rundt publiseringen svinger kursene ofte mer enn ellers. Appen viser bare datoen, ikke selve tallene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De melding verschijnt alleen als zo’n datum vandaag of morgen is. Rond de publicatie schommelen de koersen vaak sterker dan anders. De app toont alleen de datum, niet de cijfers zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikat pojawia się tylko wtedy, gdy taki termin przypada dziś lub jutro. W okolicy publikacji kursy często wahają się mocniej niż zwykle. Aplikacja pokazuje tylko termin, a nie same dane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aviso só aparece quando uma destas datas é hoje ou amanhã. Em torno da publicação, os preços oscilam muitas vezes mais do que o habitual. A app mostra apenas a data, não os números."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aviso só aparece quando uma dessas datas é hoje ou amanhã. Perto da divulgação, os preços costumam oscilar mais que o normal. O app mostra só a data, não os números."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajul apare doar când o astfel de dată este azi sau mâine. În jurul publicării, prețurile oscilează adesea mai mult decât de obicei. Aplicația arată doar data, nu cifrele propriu-zise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсказка появляется, только если такая дата сегодня или завтра. Вокруг публикации курсы часто колеблются сильнее обычного. Приложение показывает только дату, а не сами данные."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njoftimi shfaqet vetëm kur një datë e tillë është sot ose nesër. Rreth publikimit, çmimet shpesh luhaten më shumë se zakonisht. Aplikacioni tregon vetëm datën, jo vetë shifrat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelandet visas bara när ett sådant datum är i dag eller i morgon. Runt publiceringen svänger kurserna ofta mer än vanligt. Appen visar bara datumet, inte själva siffrorna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนจะแสดงเฉพาะเมื่อมีวันประกาศแบบนี้ในวันนี้หรือพรุ่งนี้ ช่วงที่ประกาศราคามักแกว่งมากกว่าปกติ แอปแสดงเพียงวันประกาศ ไม่ใช่ตัวเลข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı yalnızca böyle bir tarih bugün ya da yarın olduğunda görünür. Açıklama sırasında fiyatlar çoğu zaman her zamankinden daha fazla dalgalanır. Uygulama yalnızca tarihi gösterir, verilerin kendisini değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підказка з’являється, лише якщо така дата сьогодні або завтра. Навколо публікації курси часто коливаються сильніше, ніж зазвичай. Застосунок показує лише дату, а не самі дані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo chỉ hiện khi có một ngày như vậy vào hôm nay hoặc ngày mai. Quanh thời điểm công bố, giá thường dao động mạnh hơn bình thường. Ứng dụng chỉ hiển thị lịch, không hiển thị các con số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当这类日期是今天或明天时才会显示提示。数据发布前后，价格往往比平时波动更大。应用只显示日期，不显示数据本身。"
          }
        }
      }
    },
