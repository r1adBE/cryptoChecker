    "settings_high_contrast_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألوان أسعار أقوى ونصوص ثانوية أغمق. يعمل أيضًا عندما يطلب النظام تباينًا أعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výraznější barvy cen a tmavší vedlejší text. Zapne se i tehdy, když systém požaduje vyšší kontrast."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraftigere kursfarver og mørkere sekundær tekst. Er også slået til, når systemet beder om mere kontrast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräftigere Kursfarben und dunklere Nebentexte. Auch aktiv, wenn das System mehr Kontrast verlangt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιο έντονα χρώματα τιμών και πιο σκούρο δευτερεύον κείμενο. Ενεργή και όταν το σύστημα ζητά περισσότερη αντίθεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stronger price colors and darker secondary text. Also on when the system asks for more contrast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores de precio más intensos y texto secundario más oscuro. También se activa cuando el sistema pide más contraste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ‌های قیمت پررنگ‌تر و متن‌های فرعی تیره‌تر. وقتی سیستم کنتراست بیشتری بخواهد هم فعال است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voimakkaammat hintavärit ja tummempi toissijainen teksti. Käytössä myös, kun järjestelmä pyytää suurempaa kontrastia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleurs des prix plus marquées et textes secondaires plus foncés. Également activé lorsque le système demande plus de contraste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבעי מחיר חזקים יותר וטקסט משני כהה יותר. פעיל גם כשהמערכת מבקשת ניגודיות גבוהה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाव के ज़्यादा गहरे रंग और गहरा सहायक टेक्स्ट। सिस्टम के ज़्यादा कंट्रास्ट माँगने पर भी चालू रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősebb árszínek és sötétebb másodlagos szöveg. Akkor is bekapcsol, ha a rendszer nagyobb kontrasztot kér."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna harga lebih kuat dan teks sekunder lebih gelap. Juga aktif saat sistem meminta kontras lebih tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori dei prezzi più intensi e testi secondari più scuri. Attivo anche quando il sistema richiede più contrasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格の色を濃くし、補足テキストを暗くします。システムがより高いコントラストを求めている場合もオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격 색상을 더 진하게, 보조 텍스트를 더 어둡게 표시합니다. 시스템이 더 높은 대비를 요청할 때도 켜집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterkere kursfarger og mørkere sekundærtekst. Også på når systemet ber om mer kontrast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krachtigere koerskleuren en donkerdere secundaire tekst. Ook aan wanneer het systeem om meer contrast vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyraźniejsze kolory cen i ciemniejszy tekst pomocniczy. Włączony także, gdy system wymaga większego kontrastu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores de preço mais fortes e textos secundários mais escuros. Também ativo quando o sistema pede mais contraste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores de preço mais fortes e textos secundários mais escuros. Também ativo quando o sistema pede mais contraste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culori de preț mai puternice și text secundar mai închis. Activ și când sistemul cere mai mult contrast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более яркие цвета цен и более тёмный второстепенный текст. Включается также, когда система запрашивает повышенную контрастность."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngjyra më të forta për çmimet dhe tekst dytësor më i errët. Aktiv edhe kur sistemi kërkon më shumë kontrast."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraftigare kursfärger och mörkare sekundär text. Är också på när systemet begär mer kontrast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีราคาเข้มขึ้นและข้อความรองเข้มขึ้น เปิดใช้งานด้วยเมื่อระบบขอคอนทราสต์มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha güçlü fiyat renkleri ve daha koyu ikincil metin. Sistem daha fazla kontrast istediğinde de açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яскравіші кольори цін і темніший другорядний текст. Вмикається також, коли система запитує вищу контрастність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu giá đậm hơn và chữ phụ tối hơn. Cũng bật khi hệ thống yêu cầu độ tương phản cao hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更鲜明的价格颜色和更深的次要文字。系统要求更高对比度时也会开启。"
          }
        }
      }
    },
