    "backup_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ القائمة مع الملاحظات والمجموعات، والتنبيهات والمفضلة والمحفظة والإعدادات في ملف تحتفظ به بنفسك – مثلًا لهاتف جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloží seznam s poznámkami a skupinami, alarmy, oblíbené, portfolio a nastavení do souboru, který si uschováš – např. pro nový telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmer liste med noter og grupper, alarmer, favoritter, portefølje og indstillinger i en fil, du selv opbevarer – fx til en ny telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Merkliste mit Notizen und Gruppen, Alarme, Favoriten, Portfolio und Einstellungen als Datei, die du selbst ablegst – z. B. für ein neues Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύει τη λίστα σου με σημειώσεις και ομάδες, συναγερμούς, αγαπημένα, χαρτοφυλάκιο και ρυθμίσεις σε αρχείο που κρατάς εσύ – π.χ. για νέο κινητό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your watchlist with notes and groups, alerts, favorites, portfolio and settings as a file you keep yourself – e.g. for a new phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu lista con notas y grupos, alarmas, favoritos, cartera y ajustes en un archivo que guardas tú, p. ej. para un móvil nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست همراه با یادداشت‌ها و گروه‌ها، هشدارها، علاقه‌مندی‌ها، پرتفوی و تنظیمات را در فایلی ذخیره می‌کند که خودت نگه می‌داری – مثلاً برای گوشی جدید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa listan muistiinpanoineen ja ryhmineen, hälytykset, suosikit, salkun ja asetukset tiedostoon, jonka säilytät itse – esim. uutta puhelinta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre liste avec notes et groupes, alertes, favoris, portefeuille et réglages dans un fichier que tu gardes – p. ex. pour un nouveau téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר את הרשימה עם ההערות והקבוצות, ההתראות, המועדפים, תיק ההשקעות וההגדרות בקובץ שנשאר אצלך – למשל לטלפון חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट और समूहों सहित सूची, अलार्म, पसंदीदा, पोर्टफ़ोलियो और सेटिंग एक फ़ाइल में सहेजता है जिसे तुम रखते हो – जैसे नए फ़ोन के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A listát jegyzetekkel és csoportokkal, a riasztásokat, kedvenceket, a portfóliót és a beállításokat egy fájlba menti, amelyet te őrzöl – pl. új telefonhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan daftar beserta catatan dan grup, alarm, favorit, portofolio, dan pengaturan ke file yang kamu simpan sendiri – mis. untuk ponsel baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva lista con note e gruppi, allarmi, preferiti, portafoglio e impostazioni in un file che conservi tu, ad es. per un nuovo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモとグループを含むリスト、アラーム、お気に入り、ポートフォリオ、設定を自分で保管するファイルに保存します（新しい端末用など）。"
