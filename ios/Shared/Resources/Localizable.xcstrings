          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handeln under senaste timmen ligger i linje med de senaste 24 timmarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซื้อขายในชั่วโมงล่าสุดสอดคล้องกับ 24 ชั่วโมงที่ผ่านมา"
