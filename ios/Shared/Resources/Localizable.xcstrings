    "backup_password_too_weak" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سهل التخمين جدًا – ليست أرقامًا فقط، ولا حرفًا واحدًا مكررًا، ولا تسلسلًا شائعًا مثل «12345678» أو «password»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš snadné uhodnout – ne jen číslice, ne jeden opakovaný znak, žádná běžná řada jako „12345678“ nebo „heslo“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For let at gætte – ikke kun tal, ikke ét gentaget tegn, ingen almindelig række som «12345678» eller «password»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu leicht zu erraten – nicht nur Ziffern, nicht ein wiederholtes Zeichen, keine gängige Folge wie «12345678» oder «passwort»."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ εύκολο να μαντευτεί – όχι μόνο ψηφία, όχι ένας επαναλαμβανόμενος χαρακτήρας, όχι συνηθισμένη σειρά όπως «12345678» ή «password»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too easy to guess – avoid only digits, one repeated character or common sequences like “12345678” or “password”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado fácil de adivinar: no solo dígitos, no un único carácter repetido, ni secuencias comunes como «12345678» o «contraseña»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدسش خیلی آسان است – فقط رقم نباشد، یک نویسهٔ تکراری نباشد، دنبالهٔ رایجی مثل «12345678» یا «password» نباشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian helppo arvata – ei pelkkiä numeroita, ei yhtä toistettua merkkiä eikä tavallista sarjaa kuten ”12345678” tai ”salasana”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop facile à deviner – pas uniquement des chiffres, pas un seul caractère répété, pas de suite courante comme « 12345678 » ou « motdepasse »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קל מדי לניחוש – לא רק ספרות, לא תו אחד חוזר, בלי רצף נפוץ כמו «12345678» או «password»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमान लगाना बहुत आसान – सिर्फ़ अंक नहीं, एक ही दोहराया अक्षर नहीं, “12345678” या “password” जैसा आम क्रम नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl könnyű kitalálni – ne csak számjegy, ne egy ismételt karakter, ne gyakori sor, mint „12345678” vagy „jelszo”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu mudah ditebak – jangan hanya angka, jangan satu karakter berulang, jangan urutan umum seperti “12345678” atau “password”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo facile da indovinare – non solo cifre, non un unico carattere ripetuto, nessuna sequenza comune come «12345678» o «password»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推測されやすすぎます。数字だけ、同じ文字の繰り返し、「12345678」や「password」のようなよくある並びは使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 쉽게 추측됩니다. 숫자만, 같은 문자 반복, “12345678”이나 “password” 같은 흔한 순서는 안 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For lett å gjette – ikke bare tall, ikke ett gjentatt tegn, ingen vanlig rekke som «12345678» eller «passord»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te makkelijk te raden – niet alleen cijfers, niet één herhaald teken, geen gangbare reeks zoals «12345678» of «wachtwoord»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt łatwe do odgadnięcia – nie same cyfry, nie jeden powtarzany znak, bez typowych ciągów jak „12345678” czy „haslo”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado fácil de adivinhar – não só algarismos, não um único carácter repetido, nada de sequências comuns como «12345678» ou «password»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fácil demais de adivinhar – não só números, não um único caractere repetido, nada de sequências comuns como “12345678” ou “senha”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea ușor de ghicit – nu doar cifre, nu un singur caracter repetat, fără secvențe comune ca „12345678” sau „parola”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком легко угадать – не только цифры, не один повторяющийся символ, без типичных последовательностей вроде «12345678» или «password»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shumë e lehtë për t’u gjetur – jo vetëm shifra, jo një shenjë e përsëritur, pa vargje të zakonshme si «12345678» ose «password»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För lätt att gissa – inte bara siffror, inte ett upprepat tecken, ingen vanlig följd som ”12345678” eller ”lösenord”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดาง่ายเกินไป – ไม่ใช่ตัวเลขล้วน ไม่ใช่อักขระซ้ำตัวเดียว ไม่ใช่ลำดับทั่วไปอย่าง “12345678” หรือ “password”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahmini çok kolay – yalnızca rakam olmasın, tek bir tekrar eden karakter olmasın, “12345678” ya da “sifre” gibi yaygın diziler olmasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надто легко вгадати – не лише цифри, не один повторюваний символ, без типових послідовностей на кшталт «12345678» чи «password»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá dễ đoán – không chỉ toàn số, không một ký tự lặp lại, không dãy phổ biến như “12345678” hay “password”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太容易被猜到——不能只有数字、不能是同一字符重复、不能是 「12345678」 或 「password」 这类常见序列。"
          }
        }
      }
    },
    "backup_password_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون كلمة المرور لا يمكن استعادة النسخة الاحتياطية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez hesla nelze zálohu obnovit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden adgangskoden kan sikkerhedskopien ikke gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Passwort lässt sich die Sicherung nicht wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς τον κωδικό, το αντίγραφο ασφαλείας δεν μπορεί να επαναφερθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without the password, the backup cannot be restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin la contraseña, la copia de seguridad no se puede restaurar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون گذرواژه، نسخهٔ پشتیبان بازیابی نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman salasanaa varmuuskopiota ei voi palauttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans le mot de passe, la sauvegarde ne peut pas être restaurée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי הסיסמה אי אפשר לשחזר את הגיבוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड के बिना बैकअप बहाल नहीं किया जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelszó nélkül a biztonsági mentés nem állítható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
