    "tax_summary_fr_address_no_cost" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب العناوين المراقَبة ضمن القيمة الإجمالية لكن ليست لها تكلفة اقتناء – لذلك يكون الربح على الأرجح أعلى من اللازم. سجّل التكلفة كعملية شراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledované adresy se započítávají do celkové hodnoty, ale nemají pořizovací cenu – zisk je proto spíše nadhodnocený. Zadej pořizovací cenu jako nákup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvågede adresser tæller med i den samlede værdi, men har ingen anskaffelsessum – gevinsten er derfor snarere for høj. Registrér anskaffelsessummen som et køb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachtete Adressen zählen zum Gesamtwert, haben aber keinen Einstand – der Gewinn ist dadurch eher zu hoch. Einstand als Kauf erfassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παρακολουθούμενες διευθύνσεις μετρούν στη συνολική αξία, αλλά δεν έχουν κόστος κτήσης – το κέρδος είναι επομένως μάλλον υψηλότερο. Καταχώρισε το κόστος ως αγορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watched addresses count towards the total value but have no acquisition cost – the gain is therefore likely too high. Record the cost as a purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones vigiladas cuentan en el valor total pero no tienen coste de adquisición: la ganancia probablemente resulta demasiado alta. Registra el coste como compra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آدرس‌های زیر نظر در ارزش کل حساب می‌شوند اما بهای تمام‌شده ندارند – بنابراین سود احتمالاً بیش از حد است. بهای تمام‌شده را به‌صورت خرید ثبت کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuratut osoitteet lasketaan kokonaisarvoon, mutta niillä ei ole hankintahintaa – voitto on siksi todennäköisesti liian suuri. Kirjaa hankintahinta ostona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adresses surveillées comptent dans la valeur globale mais n'ont pas de prix d'acquisition – la plus-value est donc plutôt surestimée. Saisis le prix d'acquisition comme achat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתובות במעקב נכללות בשווי הכולל אך אין להן עלות רכישה – לכן הרווח כנראה גבוה מדי. רשמו את העלות כרכישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निगरानी वाले पते कुल मूल्य में गिने जाते हैं, लेकिन उनकी कोई अधिग्रहण लागत नहीं है – इसलिए लाभ संभवतः अधिक दिखता है। लागत को खरीद के रूप में दर्ज करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A figyelt címek beleszámítanak a teljes értékbe, de nincs beszerzési áruk – ezért a nyereség inkább túl magas. Rögzítsd a beszerzési árat vételként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat yang dipantau dihitung dalam nilai total tetapi tidak memiliki biaya perolehan – karena itu keuntungan cenderung terlalu tinggi. Catat biaya sebagai pembelian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indirizzi osservati contano nel valore totale ma non hanno un costo di acquisto – il guadagno è quindi probabilmente troppo alto. Registra il costo come acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監視中のアドレスは総額に含まれますが、取得原価がありません。そのため利益は高めに出ている可能性があります。取得原価を購入として記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관찰 중인 주소는 총 가치에 포함되지만 취득원가가 없습니다. 따라서 이익이 과대 계산되었을 수 있습니다. 취득원가를 매수로 기록하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåkede adresser teller med i totalverdien, men har ingen inngangsverdi – gevinsten blir derfor trolig for høy. Registrer inngangsverdien som et kjøp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevolgde adressen tellen mee in de totale waarde, maar hebben geen aanschafwaarde – de winst is daardoor eerder te hoog. Leg de aanschafwaarde vast als aankoop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwowane adresy wliczają się do wartości całkowitej, ale nie mają kosztu nabycia – zysk jest przez to raczej zawyżony. Zapisz koszt jako zakup."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os endereços observados contam para o valor total, mas não têm custo de aquisição – o ganho tende, por isso, a ser demasiado alto. Regista o custo como compra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os endereços monitorados contam no valor total, mas não têm custo de aquisição – o ganho tende, por isso, a ficar alto demais. Registre o custo como compra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresele urmărite intră în valoarea totală, dar nu au cost de achiziție – câștigul este, prin urmare, probabil prea mare. Înregistrează costul ca achiziție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживаемые адреса входят в общую стоимость, но не имеют стоимости приобретения – поэтому прибыль, скорее всего, завышена. Внеси стоимость как покупку."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresat e vëzhguara llogariten në vlerën totale, por nuk kanë kosto blerjeje – prandaj fitimi ka gjasë të jetë më i lartë. Regjistroje koston si blerje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevakade adresser räknas in i det totala värdet men saknar anskaffningsvärde – vinsten blir därför sannolikt för hög. Registrera anskaffningsvärdet som ett köp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่ที่ติดตามนับรวมในมูลค่ารวม แต่ไม่มีต้นทุนการได้มา – กำไรจึงน่าจะสูงเกินจริง โปรดบันทึกต้นทุนเป็นการซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen adresler toplam değere dahildir ancak edinme maliyetleri yoktur – bu nedenle kazanç büyük olasılıkla fazla yüksektir. Maliyeti alım olarak kaydet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежувані адреси входять до загальної вартості, але не мають вартості придбання – тому прибуток, ймовірно, завищений. Внеси вартість як купівлю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các địa chỉ theo dõi được tính vào tổng giá trị nhưng không có giá vốn – vì vậy lãi có thể bị cao hơn thực tế. Hãy ghi giá vốn dưới dạng giao dịch mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观察地址计入总价值，但没有购入成本——因此收益可能偏高。请将成本记录为买入。"
          }
        }
      }
    },
