    "settings_battery_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«مقيّد» يعني أن Android قد يؤخر التحديثات في الخلفية لساعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezené znamená, že Android může aktualizace na pozadí odložit o hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrænset betyder, at Android kan forsinke opdateringer i baggrunden med flere timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeschränkt heisst: Android kann Aktualisierungen um Stunden verzögern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορισμένη σημαίνει ότι το Android μπορεί να καθυστερήσει τις ενημερώσεις παρασκηνίου κατά ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restricted means Android may delay background updates by hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringido significa que Android puede retrasar las actualizaciones en segundo plano varias horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محدود یعنی Android ممکن است به‌روزرسانی‌های پس‌زمینه را ساعت‌ها به تأخیر بیندازد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajoitettu tarkoittaa, että Android voi viivästää taustapäivityksiä tunteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restreinte signifie qu'Android peut retarder les actualisations en arrière-plan de plusieurs heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוגבל פירושו ש־Android עלול לעכב עדכוני רקע בשעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिबंधित होने पर Android बैकग्राउंड अपडेट में घंटों की देरी कर सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlátozott módban az Android órákkal késleltetheti a háttérfrissítéseket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibatasi berarti Android bisa menunda pembaruan latar belakang hingga berjam-jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con restrizioni significa che Android può ritardare gli aggiornamenti in background di ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限ありの場合、Android がバックグラウンド更新を数時間遅らせることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한됨 상태에서는 Android가 백그라운드 업데이트를 몇 시간씩 지연시킬 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenset betyr at Android kan forsinke oppdateringer i bakgrunnen med flere timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt betekent dat Android updates op de achtergrond uren kan uitstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograniczone oznacza, że Android może opóźniać aktualizacje w tle o kilka godzin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrito significa que o Android pode adiar as atualizações em segundo plano por horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrito significa que o Android pode adiar as atualizações em segundo plano por horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restricționat înseamnă că Android poate amâna actualizările în fundal cu ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При ограничении Android может откладывать фоновые обновления на несколько часов."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kufizuar do të thotë që Android mund t'i vonojë përditësimet në sfond me orë të tëra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsad innebär att Android kan fördröja uppdateringar i bakgrunden med flera timmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำกัด หมายความว่า Android อาจหน่วงการอัปเดตเบื้องหลังได้หลายชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısıtlı, Android'in arka plan güncellemelerini saatlerce geciktirebileceği anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежено означає, що Android може відкладати фонові оновлення на години."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bị hạn chế nghĩa là Android có thể trì hoãn cập nhật nền đến vài giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受限制意味着 Android 可能将后台更新推迟数小时。"
          }
        }
      }
