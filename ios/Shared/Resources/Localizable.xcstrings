      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستيراد يستبدل قائمتك (مع الملاحظات والمجموعات) وتنبيهاتك ومفضلتك ومحفظتك وإعداداتك بالنسخة الاحتياطية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import nahradí váš seznam (s poznámkami a skupinami), alarmy, oblíbené, portfolio a nastavení zálohou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import erstatter din liste (med noter og grupper), alarmer, favoritter, portefølje og indstillinger med backuppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Importieren werden Merkliste (mit Notizen und Gruppen), Alarme, Favoriten, Portfolio und Einstellungen durch die Sicherung ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εισαγωγή αντικαθιστά λίστα (με σημειώσεις και ομάδες), ειδοποιήσεις, αγαπημένα, χαρτοφυλάκιο και ρυθμίσεις με το αντίγραφο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importing replaces your current watchlist (with notes and groups), alarms, favorites, portfolio and settings with the backup."
          }
