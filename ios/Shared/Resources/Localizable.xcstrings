          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra hai lần mỗi ngày và thông báo khi Bitcoin đổi vùng, vd. từ Trung lập sang Bull."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天检查两次，比特币切换区间时提醒，例如从中性变为 Bull。"
