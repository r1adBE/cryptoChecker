          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të dhënat e vëllimit vijnë nga Binance — çiftet që nuk janë të listuara atje nuk aktivizohen kurrë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volymdata kommer från Binance – par som inte är noterade där utlöser aldrig larm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลปริมาณมาจาก Binance — คู่ที่ไม่มีใน Binance จะไม่ทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacim verileri Binance'ten gelir — orada listelenmeyen çiftlerde bu alarm tetiklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані про обсяг беруться з Binance — для пар, яких там немає, сигнал не спрацює."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu khối lượng lấy từ Binance — các cặp không niêm yết ở đó sẽ không bao giờ kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
