    "live_activity_hint_ends" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التحديث كلما فحص التطبيق الأسعار – في الخلفية يقرر iOS عدد المرات. ينهي iOS النشاط المباشر بعد 8 ساعات على الأكثر؛ شغّله هنا مجددًا عند الحاجة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje se, kdykoli aplikace kontroluje kurzy – na pozadí rozhoduje iOS, jak často. iOS ukončí živou aktivitu nejpozději po 8 hodinách; v případě potřeby ji zde znovu zapni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateres, når appen tjekker kurser – i baggrunden bestemmer iOS, hvor tit. iOS afslutter en Live-aktivitet efter højst 8 timer; slå den til igen her, hvis det er nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird aktualisiert, wenn die App Kurse prüft – im Hintergrund entscheidet iOS, wie oft. iOS beendet eine Live-Aktivität spätestens nach 8 Stunden; schalte sie hier bei Bedarf wieder ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνεται κάθε φορά που η εφαρμογή ελέγχει τιμές – στο παρασκήνιο το iOS αποφασίζει πόσο συχνά. Το iOS τερματίζει μια Ζωντανή δραστηριότητα το αργότερο μετά από 8 ώρες· ενεργοποίησέ την ξανά εδώ αν χρειάζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updated whenever the app checks prices – in the background iOS decides how often. iOS ends a Live Activity after 8 hours at the latest; turn it on again here if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualiza cada vez que la app comprueba los precios; en segundo plano, iOS decide con qué frecuencia. iOS finaliza una actividad en vivo como máximo a las 8 horas; vuelve a activarla aquí si hace falta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر بار که برنامه قیمت‌ها را بررسی می‌کند به‌روز می‌شود – در پس‌زمینه iOS تعیین می‌کند چند وقت یک‌بار. iOS فعالیت زنده را حداکثر پس از ۸ ساعت پایان می‌دهد؛ در صورت نیاز دوباره از اینجا روشنش کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittyy aina, kun sovellus tarkistaa kurssit – taustalla iOS päättää, kuinka usein. iOS lopettaa live-toiminnon viimeistään 8 tunnin kuluttua; käynnistä se tarvittaessa uudelleen täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis à jour chaque fois que l'app vérifie les cours – en arrière-plan, iOS décide de la fréquence. iOS arrête une activité en direct au bout de 8 heures au plus ; réactive-la ici si besoin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתעדכן בכל פעם שהאפליקציה בודקת שערים – ברקע, iOS מחליט באיזו תדירות. iOS מסיים פעילות חיה לכל המאוחר אחרי 8 שעות; הפעילו אותה כאן מחדש לפי הצורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी ऐप भाव जाँचता है, अपडेट होता है – बैकग्राउंड में iOS तय करता है कि कितनी बार। iOS किसी लाइव एक्टिविटी को अधिकतम 8 घंटे बाद बंद कर देता है; ज़रूरत हो तो इसे यहाँ फिर से चालू करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frissül, amikor az alkalmazás árfolyamot ellenőriz – a háttérben az iOS dönti el, milyen gyakran. Az iOS legfeljebb 8 óra után befejezi az élő tevékenységet; szükség esetén kapcsold be itt újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbarui setiap kali aplikasi memeriksa harga – di latar belakang, iOS yang menentukan seberapa sering. iOS mengakhiri Aktivitas Langsung paling lambat setelah 8 jam; nyalakan lagi di sini bila perlu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggiorna ogni volta che l'app controlla i prezzi – in background è iOS a decidere quanto spesso. iOS termina un’attività live al massimo dopo 8 ore; se serve, riattivala qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが価格を確認するたびに更新されます – バックグラウンドでの頻度は iOS が決めます。 iOS はライブアクティビティを最長 8 時間で終了します。必要ならここで再びオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 시세를 확인할 때마다 업데이트됩니다 – 백그라운드에서는 iOS가 빈도를 결정합니다. iOS는 실시간 현황을 최대 8시간 후에 종료합니다. 필요하면 여기서 다시 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateres hver gang appen sjekker kurser – i bakgrunnen bestemmer iOS hvor ofte. iOS avslutter en Live-aktivitet etter høyst 8 timer; slå den på igjen her ved behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt bijgewerkt telkens als de app koersen controleert – op de achtergrond bepaalt iOS hoe vaak. iOS beëindigt een live-activiteit na uiterlijk 8 uur; zet hem hier zo nodig weer aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje się za każdym razem, gdy aplikacja sprawdza kursy – w tle o częstotliwości decyduje iOS. iOS kończy aktywność na żywo najpóźniej po 8 godzinach; w razie potrzeby włącz ją tu ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualiza sempre que a app verifica os preços – em segundo plano, o iOS decide com que frequência. O iOS termina uma atividade em direto ao fim de 8 horas, no máximo; volta a ativá-la aqui se precisares."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualiza sempre que o app verifica os preços – em segundo plano, o iOS decide com que frequência. O iOS encerra uma Atividade ao Vivo após no máximo 8 horas; ative de novo aqui se precisar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualizează de fiecare dată când aplicația verifică prețurile – în fundal, iOS decide cât de des. iOS încheie o activitate live după cel mult 8 ore; reactiveaz-o aici dacă e nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновляется каждый раз, когда приложение проверяет курсы – в фоне iOS решает, как часто. iOS завершает активность Live не позже чем через 8 часов; при необходимости включи её здесь снова."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përditësohet sa herë që aplikacioni kontrollon çmimet – në sfond iOS vendos sa shpesh. iOS e mbyll një aktivitet live më së voni pas 8 orësh; aktivizoje sërish këtu nëse duhet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateras varje gång appen kollar kurser – i bakgrunden avgör iOS hur ofta. iOS avslutar en liveaktivitet efter högst 8 timmar; slå på den igen här vid behov."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเดตทุกครั้งที่แอปตรวจสอบราคา – ในเบื้องหลัง iOS เป็นผู้ตัดสินว่าบ่อยแค่ไหน iOS จะปิดกิจกรรมสดภายใน 8 ชั่วโมงเป็นอย่างช้า เปิดใหม่ได้ที่นี่หากต้องการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama fiyatları her kontrol ettiğinde güncellenir – arka planda ne sıklıkla olacağına iOS karar verir. iOS bir Canlı Etkinliği en geç 8 saat sonra bitirir; gerekirse burada yeniden aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлюється щоразу, коли застосунок перевіряє курси – у фоні iOS вирішує, як часто. iOS завершує активність Live щонайпізніше через 8 годин; за потреби увімкни її тут знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được cập nhật mỗi khi ứng dụng kiểm tra giá – ở chế độ nền, iOS quyết định tần suất. iOS kết thúc Hoạt động trực tiếp sau tối đa 8 giờ; bật lại tại đây nếu cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每当应用检查行情时更新——在后台由 iOS 决定频率。 iOS 最迟会在 8 小时后结束实时活动；如有需要，请在此重新开启。"
          }
        }
      }
    },
