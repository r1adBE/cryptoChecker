    "address_lots_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل تاريخ الشراء والكمية والتكلفة لرصيد هذا العنوان. تُحتسب الدفعات كمشتريات في هذا العنوان؛ وما لا يُغطّى يبقى بلا تكلفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadej datum nákupu, množství a pořizovací cenu pro zůstatek této adresy. Položky se počítají jako nákupy na této adrese; nepokrytá část zůstává bez pořizovací ceny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv købsdato, mængde og anskaffelsespris for saldoen på denne adresse. Posterne tæller som køb på denne adresse; resten forbliver uden anskaffelsespris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse Kaufdatum, Menge und Einstand für das Guthaben dieser Adresse. Die Posten zählen wie Käufe in dieser Adresse; was nicht belegt ist, bleibt ohne Einstand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταχώρισε ημερομηνία αγοράς, ποσότητα και κόστος για το υπόλοιπο αυτής της διεύθυνσης. Οι παρτίδες μετρούν ως αγορές σε αυτή τη διεύθυνση· ό,τι δεν καλύπτεται μένει χωρίς κόστος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter purchase date, amount and cost basis for the balance of this address. The lots count like purchases in this address; any part not covered stays without cost basis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce fecha de compra, cantidad y coste para el saldo de esta dirección. Los lotes cuentan como compras en esta dirección; lo no cubierto queda sin coste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخ خرید، مقدار و بهای تمام‌شده را برای موجودی این نشانی وارد کن. دسته‌ها مانند خرید در این نشانی حساب می‌شوند؛ بخش پوشش‌نیافته بدون بهای تمام‌شده می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä ostopäivä, määrä ja hankintahinta tämän osoitteen saldolle. Erät lasketaan ostoiksi tässä osoitteessa; kattamaton osa jää ilman hankintahintaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisis la date d’achat, la quantité et le prix de revient du solde de cette adresse. Les lots comptent comme des achats dans cette adresse ; la part non couverte reste sans prix de revient."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזינו תאריך רכישה, כמות ועלות ליתרת הכתובת הזו. המנות נספרות כרכישות בכתובת זו; החלק שאינו מכוסה נשאר ללא עלות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पते की शेष राशि के लिए खरीद तिथि, मात्रा और लागत दर्ज करो। लॉट इस पते में खरीद की तरह गिने जाते हैं; जो हिस्सा कवर नहीं है वह बिना लागत रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg a vásárlás dátumát, a mennyiséget és a bekerülési értéket ennek a címnek az egyenlegéhez. A tételek vásárlásként számítanak ezen a címen; a lefedetlen rész bekerülési érték nélkül marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tanggal beli, jumlah, dan harga perolehan untuk saldo alamat ini. Lot dihitung seperti pembelian di alamat ini; bagian yang tidak tercakup tetap tanpa harga perolehan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci data di acquisto, quantità e costo per il saldo di questo indirizzo. I lotti contano come acquisti in questo indirizzo; la parte non coperta resta senza costo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスの残高について購入日、数量、取得価額を入力します。ロットはこのアドレスでの購入として扱われ、カバーされない分は取得価額なしのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소의 잔액에 대해 구매일, 수량, 취득가액을 입력하세요. 로트는 이 주소에서의 구매처럼 계산되며, 포함되지 않은 부분은 취득가액 없이 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn kjøpsdato, mengde og inngangsverdi for saldoen på denne adressen. Postene teller som kjøp på denne adressen; resten forblir uten inngangsverdi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer aankoopdatum, hoeveelheid en kostprijs in voor het saldo van dit adres. De posten tellen als aankopen in dit adres; wat niet gedekt is, blijft zonder kostprijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz datę zakupu, ilość i koszt nabycia dla salda tego adresu. Partie liczą się jak zakupy na tym adresie; niepokryta część pozostaje bez kosztu nabycia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduz data de compra, quantidade e custo para o saldo deste endereço. Os lotes contam como compras neste endereço; o que não estiver coberto fica sem custo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe data de compra, quantidade e custo para o saldo deste endereço. Os lotes contam como compras neste endereço; o que não estiver coberto fica sem custo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdu data cumpărării, cantitatea și costul pentru soldul acestei adrese. Loturile contează ca achiziții în această adresă; partea neacoperită rămâne fără cost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажи дату покупки, количество и стоимость для баланса этого адреса. Партии считаются покупками на этом адресе; непокрытая часть остаётся без стоимости."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fut datën e blerjes, sasinë dhe koston për balancën e kësaj adrese. Pjesët llogariten si blerje në këtë adresë; pjesa e pambuluar mbetet pa kosto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange köpdatum, mängd och anskaffningsvärde för saldot på den här adressen. Posterna räknas som köp på adressen; det som inte täcks förblir utan anskaffningsvärde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกวันที่ซื้อ จำนวน และต้นทุนสำหรับยอดคงเหลือของที่อยู่นี้ ล็อตจะนับเหมือนการซื้อในที่อยู่นี้ ส่วนที่ไม่ครอบคลุมจะยังไม่มีต้นทุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adresin bakiyesi için alış tarihi, miktar ve maliyet gir. Partiler bu adreste alım gibi sayılır; karşılanmayan kısım maliyetsiz kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкажи дату купівлі, кількість і вартість для балансу цієї адреси. Партії вважаються купівлями на цій адресі; непокрита частина лишається без вартості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập ngày mua, số lượng và giá vốn cho số dư của địa chỉ này. Các lô được tính như giao dịch mua tại địa chỉ này; phần không được phủ vẫn chưa có giá vốn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为该地址的余额录入购买日期、数量和成本价。批次按在该地址的买入计算；未覆盖的部分仍无成本价。"
          }
        }
      }
    },
