    "settings_macro_notifications_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الساعة 08:00 في أيام صدور بيانات اقتصادية أمريكية مهمة (التضخم، الوظائف، قرار الفيدرالي). يُحمَّل التقويم من موقع التطبيق مرة واحدة يوميًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V 08:00 ve dnech s důležitými ekonomickými daty z USA (inflace, trh práce, rozhodnutí Fedu). Kalendář pochází z webu aplikace a načítá se jednou denně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kl. 08:00 på dage med vigtige amerikanske økonomiske tal (inflation, jobrapport, rentebeslutning). Kalenderen kommer fra appens hjemmeside og hentes én gang om dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um 08:00 an Tagen mit wichtigen US-Wirtschaftsdaten (Inflation, Arbeitsmarkt, Zinsentscheid). Der Kalender kommt von der Webseite der App und wird einmal am Tag geladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις 08:00 τις ημέρες με σημαντικά οικονομικά στοιχεία των ΗΠΑ (πληθωρισμός, απασχόληση, απόφαση της Fed). Το ημερολόγιο έρχεται από τον ιστότοπο της εφαρμογής και φορτώνεται μία φορά την ημέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At 08:00 on days with important US economic data (inflation, jobs report, Fed decision). The calendar comes from the app's website, loaded once a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las 08:00 los días con datos económicos importantes de EE. UU. (inflación, empleo, decisión de la Fed). El calendario viene de la web de la app y se carga una vez al día."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعت 08:00 در روزهایی که داده‌های مهم اقتصادی آمریکا منتشر می‌شود (تورم، اشتغال، تصمیم فدرال رزرو). تقویم روزی یک بار از وب‌سایت برنامه بارگیری می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klo 08:00 päivinä, joina julkaistaan tärkeitä Yhdysvaltain talouslukuja (inflaatio, työllisyys, korkopäätös). Kalenteri haetaan sovelluksen verkkosivulta kerran päivässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À 08:00 les jours de données économiques américaines importantes (inflation, emploi, décision de la Fed). Le calendrier provient du site web de l'app et est chargé une fois par jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב־08:00 בימים עם נתונים כלכליים חשובים מארה״ב (אינפלציה, תעסוקה, החלטת הפד). הלוח נטען מאתר האפליקציה פעם ביום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महत्वपूर्ण अमेरिकी आर्थिक आँकड़ों (महँगाई, जॉब्स रिपोर्ट, फ़ेड फ़ैसला) वाले दिनों में 08:00 बजे। कैलेंडर ऐप की वेबसाइट से दिन में एक बार लोड होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "08:00-kor azokon a napokon, amikor fontos amerikai gazdasági adatok jelennek meg (infláció, munkaerőpiac, kamatdöntés). A naptár az alkalmazás weboldaláról töltődik le naponta egyszer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pukul 08:00 pada hari dengan data ekonomi AS yang penting (inflasi, tenaga kerja, keputusan The Fed). Kalender diambil dari situs web aplikasi sekali sehari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 08:00 nei giorni con dati economici USA importanti (inflazione, occupazione, decisione della Fed). Il calendario arriva dal sito web dell'app e viene caricato una volta al giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要な米経済指標（インフレ、雇用統計、FOMC）の発表日の 08:00 に通知します。カレンダーはアプリのウェブサイトから1日1回読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요한 미국 경제 지표(물가, 고용보고서, 연준 금리 결정)가 나오는 날 08:00에 알려 줍니다. 일정은 앱 웹사이트에서 하루에 한 번 불러옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kl. 08:00 på dager med viktige amerikanske økonomiske tall (inflasjon, sysselsetting, rentebeslutning). Kalenderen kommer fra appens nettside og lastes inn én gang om dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 08:00 op dagen met belangrijke Amerikaanse economische cijfers (inflatie, banenrapport, rentebesluit). De agenda komt van de website van de app en wordt één keer per dag geladen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 08:00 w dni z ważnymi danymi gospodarczymi z USA (inflacja, rynek pracy, decyzja Fed). Kalendarz pochodzi ze strony aplikacji i jest pobierany raz dziennie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às 08:00 nos dias com dados económicos importantes dos EUA (inflação, emprego, decisão da Fed). O calendário vem do site da app e é carregado uma vez por dia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às 08:00 nos dias com dados econômicos importantes dos EUA (inflação, payroll, decisão do Fed). O calendário vem do site do app e é carregado uma vez por dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La 08:00 în zilele cu date economice importante din SUA (inflație, locuri de muncă, decizia Fed). Calendarul vine de pe site-ul aplicației și se încarcă o dată pe zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В 08:00 в дни важных экономических данных США (инфляция, рынок труда, решение ФРС). Календарь загружается с сайта приложения раз в день."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Në 08:00 në ditët me të dhëna të rëndësishme ekonomike të SHBA-së (inflacioni, punësimi, vendimi i Fed-it). Kalendari vjen nga faqja e internetit e aplikacionit dhe ngarkohet një herë në ditë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kl. 08:00 dagar med viktig amerikansk ekonomisk statistik (inflation, jobbrapport, räntebesked). Kalendern hämtas från appens webbplats en gång om dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลา 08:00 ในวันที่มีข้อมูลเศรษฐกิจสหรัฐฯ สำคัญ (เงินเฟ้อ การจ้างงาน การตัดสินใจของเฟด) ปฏิทินโหลดจากเว็บไซต์ของแอปวันละครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önemli ABD ekonomik verilerinin açıklandığı günlerde 08:00'de (enflasyon, istihdam, Fed kararı). Takvim uygulamanın web sitesinden günde bir kez yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О 08:00 у дні важливих економічних даних США (інфляція, ринок праці, рішення ФРС). Календар завантажується з вебсайту застосунку раз на день."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lúc 08:00 vào những ngày có dữ liệu kinh tế Mỹ quan trọng (lạm phát, việc làm, quyết định của Fed). Lịch được tải từ trang web của ứng dụng mỗi ngày một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在有重要美国经济数据（通胀、就业报告、美联储利率决议）的日子 08:00 提醒。日历每天从应用网站加载一次。"
          }
        }
      }
