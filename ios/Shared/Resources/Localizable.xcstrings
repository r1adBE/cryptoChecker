          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gns. købspris: gennemsnittet af alle køb, vægtet efter mængde. Salg værdisættes til dette gennemsnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ø Kaufpreis: Durchschnitt aller Käufe, gewichtet nach Menge. Verkäufe zählen zu diesem Durchschnitt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέση τιμή αγοράς: ο μέσος όρος όλων των αγορών, σταθμισμένος με την ποσότητα. Οι πωλήσεις αποτιμώνται σε αυτόν τον μέσο όρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avg. purchase price: the average of all buys, weighted by amount. Sells are valued at this average."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio medio de compra: la media de todas las compras, ponderada por cantidad. Las ventas se valoran a esa media."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میانگین قیمت خرید: میانگین همه خریدها، وزن‌دهی‌شده با مقدار. فروش‌ها با همین میانگین ارزش‌گذاری می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskim. ostohinta: kaikkien ostojen keskiarvo määrillä painotettuna. Myynnit arvostetaan tähän keskiarvoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix d’achat moyen : moyenne de tous les achats, pondérée par la quantité. Les ventes sont évaluées à cette moyenne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיר קנייה ממוצע: ממוצע כל הקניות, משוקלל לפי כמות. מכירות מוערכות לפי ממוצע זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "औसत खरीद भाव: सभी खरीदों का मात्रा-भारित औसत। बिक्री का मूल्यांकन इसी औसत पर होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Átl. vételár: az összes vétel mennyiséggel súlyozott átlaga. Az eladásokat ezen az átlagon értékeljük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga beli rata-rata: rata-rata semua pembelian, ditimbang menurut jumlah. Penjualan dinilai dengan rata-rata ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezzo medio di acquisto: media di tutti gli acquisti, ponderata per quantità. Le vendite sono valutate a questa media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均購入価格: すべての購入を数量で加重平均した価格です。売却はこの平均で評価します。"
