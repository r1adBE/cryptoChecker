    "settings_tradfi_futures_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض عند اختيار الزوج أيضًا العقود الآجلة على الأسهم والذهب وغيره من السلع والعملات والشركات قبل طرحها العام. هذه عقود وليست رموزًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při výběru páru zobrazí i futures na akcie, zlato a další komodity, měny a firmy před vstupem na burzu. Jsou to kontrakty, ne tokeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser også futures på aktier, guld og andre råvarer, valuta og selskaber før børsnotering, når du vælger et par. Det er kontrakter, ikke tokens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt bei der Auswahl auch Futures auf Aktien, Gold und andere Rohstoffe, Devisen und Firmen vor dem Börsengang. Das sind Kontrakte, keine Token."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην επιλογή ζεύγους δείχνει και futures σε μετοχές, χρυσό και άλλα εμπορεύματα, νομίσματα και εταιρείες πριν από την εισαγωγή τους στο χρηματιστήριο. Είναι συμβόλαια, όχι tokens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also shows futures on stocks, gold and other commodities, currencies and pre-IPO companies when you pick a pair. These are contracts, not tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al elegir un par, muestra también futuros sobre acciones, oro y otras materias primas, divisas y empresas antes de su salida a bolsa. Son contratos, no tokens."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام انتخاب جفت، قراردادهای آتی روی سهام، طلا و دیگر کالاها، ارزها و شرکت‌های پیش از عرضه اولیه را هم نشان می‌دهد. این‌ها قرارداد هستند، نه توکن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää parin valinnassa myös futuurit osakkeisiin, kultaan ja muihin raaka-aineisiin, valuuttoihin ja yhtiöihin ennen listautumista. Nämä ovat sopimuksia, eivät tokeneita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche aussi, lors du choix d’une paire, les futures sur actions, or et autres matières premières, devises et sociétés avant leur introduction en bourse. Ce sont des contrats, pas des jetons."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בבחירת צמד מוצגים גם חוזים עתידיים על מניות, זהב וסחורות אחרות, מטבעות וחברות לפני הנפקה. אלה חוזים, לא טוקנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेयर चुनते समय शेयरों, सोने व अन्य कमोडिटी, मुद्राओं और IPO से पहले की कंपनियों पर फ़्यूचर्स भी दिखाता है। ये अनुबंध हैं, टोकन नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párválasztáskor részvényekre, aranyra és más nyersanyagokra, devizákra és tőzsdére lépés előtti cégekre szóló határidős ügyleteket is mutat. Ezek szerződések, nem tokenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat memilih pasangan, juga menampilkan futures atas saham, emas dan komoditas lain, mata uang, serta perusahaan sebelum IPO. Ini kontrak, bukan token."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra anche, nella scelta della coppia, i futures su azioni, oro e altre materie prime, valute e società prima della quotazione. Sono contratti, non token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアを選ぶときに、株式、金などのコモディティ、為替、上場前企業の先物も表示します。これらはトークンではなく契約です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래쌍을 고를 때 주식, 금 등 원자재, 외환, 상장 전 기업에 대한 선물도 표시합니다. 토큰이 아니라 계약입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser også futures på aksjer, gull og andre råvarer, valuta og selskaper før børsnotering når du velger et par. Dette er kontrakter, ikke tokens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont bij het kiezen van een paar ook futures op aandelen, goud en andere grondstoffen, valuta en bedrijven vóór de beursgang. Dit zijn contracten, geen tokens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wyborze pary pokazuje też kontrakty futures na akcje, złoto i inne surowce, waluty oraz spółki przed debiutem giełdowym. To kontrakty, nie tokeny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escolher um par, mostra também futuros sobre ações, ouro e outras matérias-primas, divisas e empresas antes da entrada em bolsa. São contratos, não tokens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escolher um par, mostra também futuros de ações, ouro e outras commodities, câmbio e empresas antes do IPO. São contratos, não tokens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alegerea perechii arată și futures pe acțiuni, aur și alte mărfuri, valute și companii înainte de listare. Sunt contracte, nu tokenuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выборе пары показывает также фьючерсы на акции, золото и другое сырьё, валюты и компании до IPO. Это контракты, а не токены."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjatë zgjedhjes së çiftit shfaq edhe futures mbi aksione, ar dhe mallra të tjerë, valuta dhe kompani para kuotimit. Këto janë kontrata, jo tokenë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar även terminer på aktier, guld och andra råvaror, valutor och bolag före börsnotering när du väljer ett par. Det är kontrakt, inte tokens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือกคู่เหรียญ จะแสดงฟิวเจอร์สของหุ้น ทองคำและสินค้าโภคภัณฑ์อื่น สกุลเงิน และบริษัทก่อน IPO ด้วย เป็นสัญญา ไม่ใช่โทเค็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çift seçerken hisse senetleri, altın ve diğer emtialar, döviz ve halka arz öncesi şirketler üzerindeki vadeli işlemleri de gösterir. Bunlar token değil, sözleşmedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час вибору пари показує також ф’ючерси на акції, золото й іншу сировину, валюти та компанії до IPO. Це контракти, а не токени."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chọn cặp, cũng hiển thị hợp đồng tương lai trên cổ phiếu, vàng và hàng hóa khác, tiền tệ và công ty trước IPO. Đây là hợp đồng, không phải token."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择交易对时也显示股票、黄金等大宗商品、外汇以及上市前公司的合约。这些是合约，不是代币。"
          }
        }
      }
    },
