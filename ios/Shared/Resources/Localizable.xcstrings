    "widgets_manual_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستطيع شاشتك الرئيسية إضافة الأدوات من التطبيق. المس مكانًا فارغًا في الشاشة الرئيسية مع الاستمرار، واختر «الأدوات» وابحث عن «Crypto Checker»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje plocha neumí přidávat widgety z aplikace. Podrž prst na volném místě plochy, zvol „Widgety“ a vyhledej „Crypto Checker“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din startskærm kan ikke tilføje widgets fra appen. Hold fingeren på et tomt sted på startskærmen, vælg ”Widgets”, og find ”Crypto Checker”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Startbildschirm kann Widgets nicht aus der App hinzufügen. Halte eine freie Stelle auf dem Startbildschirm gedrückt, wähle «Widgets» und suche «Crypto Checker»."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αρχική σου οθόνη δεν μπορεί να προσθέσει widget από την εφαρμογή. Πάτα παρατεταμένα ένα κενό σημείο στην αρχική οθόνη, επίλεξε «Widget» και αναζήτησε το «Crypto Checker»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home screen can't add widgets from the app. Touch and hold an empty spot on the home screen, choose “Widgets” and look for “Crypto Checker”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pantalla de inicio no puede añadir widgets desde la app. Mantén pulsado un espacio vacío de la pantalla de inicio, elige «Widgets» y busca «Crypto Checker»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحه اصلی تو نمی‌تواند ابزارک‌ها را از داخل برنامه اضافه کند. انگشت خود را روی یک جای خالی صفحه اصلی نگه دار، «ابزارک‌ها» را انتخاب کن و «Crypto Checker» را پیدا کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloitusnäyttösi ei voi lisätä widgetejä sovelluksesta. Paina pitkään tyhjää kohtaa aloitusnäytöllä, valitse ”Widgetit” ja etsi ”Crypto Checker”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton écran d'accueil ne peut pas ajouter de widgets depuis l'app. Appuie longuement sur un espace vide de l'écran d'accueil, choisis « Widgets » et cherche « Crypto Checker »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסך הבית שלך לא יכול להוסיף ווידג׳טים מתוך האפליקציה. לחצו לחיצה ארוכה על מקום ריק במסך הבית, בחרו ״ווידג׳טים״ וחפשו ״Crypto Checker״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हारी होम स्क्रीन ऐप से विजेट नहीं जोड़ सकती। होम स्क्रीन पर किसी खाली जगह को दबाकर रखो, “विजेट” चुनो और “Crypto Checker” खोजो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kezdőképernyőd nem tud widgetet hozzáadni az alkalmazásból. Tartsd lenyomva a kezdőképernyő egy üres részét, válaszd a „Widgetek” lehetőséget, és keresd meg a „Crypto Checker” elemet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar utamamu tidak bisa menambahkan widget dari aplikasi. Sentuh lama area kosong di layar utama, pilih “Widget”, lalu cari “Crypto Checker”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua schermata Home non può aggiungere widget dall'app. Tieni premuto su uno spazio vuoto della schermata Home, scegli «Widget» e cerca «Crypto Checker»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのホーム画面はアプリからウィジェットを追加できません。ホーム画面の空いている場所を長押しし、「ウィジェット」を選んで「Crypto Checker」を探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 중인 홈 화면은 앱에서 위젯을 추가할 수 없습니다. 홈 화면의 빈 곳을 길게 누르고 ‘위젯’을 선택한 다음 ‘Crypto Checker’를 찾으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startskjermen din kan ikke legge til widgeter fra appen. Trykk og hold på et tomt sted på startskjermen, velg «Moduler» og se etter «Crypto Checker»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beginscherm kan geen widgets vanuit de app toevoegen. Houd een lege plek op het beginscherm ingedrukt, kies ‘Widgets’ en zoek ‘Crypto Checker’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój ekran główny nie może dodawać widżetów z aplikacji. Przytrzymaj puste miejsce na ekranie głównym, wybierz „Widżety” i znajdź „Crypto Checker”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu ecrã principal não consegue adicionar widgets a partir da app. Toca sem soltar num espaço vazio do ecrã principal, escolhe «Widgets» e procura «Crypto Checker»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua tela inicial não consegue adicionar widgets pelo app. Toque e segure um espaço vazio da tela inicial, escolha “Widgets” e procure “Crypto Checker”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecranul tău principal nu poate adăuga widgeturi din aplicație. Atinge lung un loc liber pe ecranul principal, alege „Widgeturi” și caută „Crypto Checker”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой главный экран не умеет добавлять виджеты из приложения. Нажми и удерживай свободное место на главном экране, выбери «Виджеты» и найди «Crypto Checker»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrani yt bazë nuk mund të shtojë widget-e nga aplikacioni. Mbaj shtypur një vend bosh në ekranin bazë, zgjidh «Widget-et» dhe kërko «Crypto Checker»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din hemskärm kan inte lägga till widgetar från appen. Tryck länge på en tom plats på hemskärmen, välj ”Widgetar” och leta upp ”Crypto Checker”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอหลักของคุณเพิ่มวิดเจ็ตจากแอปไม่ได้ ให้แตะค้างที่พื้นที่ว่างบนหน้าจอหลัก เลือก “วิดเจ็ต” แล้วค้นหา “Crypto Checker”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekranın uygulamadan widget ekleyemiyor. Ana ekranda boş bir yere dokunup basılı tut, “Widget'lar” seçeneğini seç ve “Crypto Checker” uygulamasını ara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій головний екран не може додавати віджети із застосунку. Натисни і утримуй вільне місце на головному екрані, вибери «Віджети» й знайди «Crypto Checker»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình chính của bạn không thể thêm tiện ích từ ứng dụng. Chạm và giữ một chỗ trống trên màn hình chính, chọn “Tiện ích” rồi tìm “Crypto Checker”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主屏幕无法从应用内添加小部件。请长按主屏幕上的空白处，选择“小部件”，然后查找“Crypto Checker”。"
          }
        }
      }
    },
