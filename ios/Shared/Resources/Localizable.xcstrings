        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage du portefeuille reste activé – une sauvegarde non chiffrée ne peut pas le désactiver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעילת תיק השקעות נשארת פעילה – גיבוי לא מוצפן לא יכול לכבות אותה."
