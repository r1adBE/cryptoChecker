    "ind_read_alt_season" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المرتفع يعني أن معظم العملات البديلة الكبيرة تفوقت على Bitcoin خلال 90 يومًا، والمنخفض يعني أن Bitcoin تفوق على معظمها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysoká znamená, že většina velkých altcoinů za 90 dní předběhla Bitcoin, nízká, že Bitcoin předběhl většinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høj betyder, at de fleste store altcoins slog Bitcoin over 90 dage, lav, at Bitcoin slog de fleste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch heisst, die meisten grossen Altcoins schlugen Bitcoin über 90 Tage, tief heisst, Bitcoin schlug die meisten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υψηλό σημαίνει ότι τα περισσότερα μεγάλα altcoins ξεπέρασαν το Bitcoin σε 90 ημέρες, χαμηλό ότι το Bitcoin ξεπέρασε τα περισσότερα."
          }
        },
        "en" : {
          "stringUnit" : {
