          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đã bị đóng khi đang khôi phục bản sao lưu. Dữ liệu trước đó của bạn đã được đặt lại; không giữ lại gì từ bản sao lưu."
          }
        },
        "zh-Hans" : {
