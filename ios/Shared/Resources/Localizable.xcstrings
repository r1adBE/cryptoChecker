        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ در ۲۴ ساعت در حالی که بازار آرام است – شاید موضوعی که فقط به همین کوین مربوط است."
          }
        },
        "fi" : {
