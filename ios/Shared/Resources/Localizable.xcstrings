    "settings_watchlist_names_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسم تحت الزوج، مثل Bitcoin أو NVIDIA. يأتي مع قوائم الشعارات، ويُحمَّل مرة واحدة لكل العملات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název pod párem, např. Bitcoin nebo NVIDIA. Přichází se seznamy log, načte se jednou pro všechny mince."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navn under parret, f.eks. Bitcoin eller NVIDIA. Følger med logolisterne og hentes én gang for alle mønter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name unter dem Paar, z. B. Bitcoin oder NVIDIA. Kommt mit den Logo-Listen, einmal für alle Coins geladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όνομα κάτω από το ζεύγος, π.χ. Bitcoin ή NVIDIA. Έρχεται με τις λίστες λογότυπων και φορτώνεται μία φορά για όλα τα νομίσματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name under the pair, e.g. Bitcoin or NVIDIA. Comes with the logo lists, loaded once for all coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre bajo el par, p. ej. Bitcoin o NVIDIA. Llega con las listas de logotipos y se carga una vez para todas las monedas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام زیر جفت، مثلاً Bitcoin یا NVIDIA. همراه فهرست‌های لوگو می‌آید و یک بار برای همه کوین‌ها بارگیری می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimi parin alla, esim. Bitcoin tai NVIDIA. Tulee logoluetteloiden mukana, ladataan kerran kaikille kolikoille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom sous la paire, p. ex. Bitcoin ou NVIDIA. Fourni avec les listes de logos, chargé une fois pour toutes les cryptos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם מתחת לצמד, למשל Bitcoin או NVIDIA. מגיע עם רשימות הלוגו, נטען פעם אחת לכל המטבעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोड़ी के नीचे नाम, जैसे Bitcoin या NVIDIA। लोगो सूचियों के साथ आता है, सभी कॉइन के लिए एक बार लोड होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Név a pár alatt, pl. Bitcoin vagy NVIDIA. A logólistákkal érkezik, egyszer töltődik be minden érméhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama di bawah pasangan, mis. Bitcoin atau NVIDIA. Datang bersama daftar logo, dimuat sekali untuk semua koin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome sotto la coppia, ad es. Bitcoin o NVIDIA. Arriva con gli elenchi dei loghi, caricato una volta per tutte le monete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
