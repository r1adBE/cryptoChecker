          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez la langue de l'app dans l'app Réglages d'iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "את שפת האפליקציה משנים באפליקציית ההגדרות של iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप की भाषा iOS की सेटिंग्स ऐप में बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás nyelvét az iOS Beállítások alkalmazásában módosíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
