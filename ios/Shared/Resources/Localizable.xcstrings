        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysoká znamená, že těžaři vydělávají mnohem víc než obvykle, nízká mnohem méně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høj betyder, at minerne tjener langt mere end normalt, lav langt mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch heisst, Miner verdienen viel mehr als üblich, tief heisst viel weniger."
