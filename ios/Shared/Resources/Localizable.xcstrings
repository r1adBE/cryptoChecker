    "about_data_connections" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الأسعار مباشرة من منصات أزواجك، إضافة إلى أسعار الصرف وقوائم العملات وشعاراتها ومرآة البيانات على GitHub؛ ترى هذه الجهات عنوان IP الخاص بك ولا ترى أبدًا ممتلكاتك (العناوين المراقَبة تُرسل إلى مزوّد الشبكة المعنية)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzy přicházejí přímo z burz tvých párů, k tomu směnné kurzy, seznamy a loga mincí a zrcadlo dat na GitHubu; vidí tvoji IP adresu, nikdy tvoje držby (sledované adresy jdou k poskytovateli příslušné sítě)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser kommer direkte fra børserne for dine par, plus valutakurser, coinlister og logoer og dataspejlet på GitHub; de ser din IP-adresse, aldrig dine beholdninger (overvågede adresser går til udbyderen af det pågældende netværk)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurse kommen direkt von den Börsen deiner Paare, dazu Devisenkurse, Coin-Listen und Logos sowie der Daten-Spiegel auf GitHub; sie sehen deine IP-Adresse, nie deine Bestände (beobachtete Adressen gehen an den Anbieter des jeweiligen Netzes)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές έρχονται απευθείας από τα ανταλλακτήρια των ζευγών σου, μαζί με συναλλαγματικές ισοτιμίες, λίστες και λογότυπα νομισμάτων και τον καθρέφτη δεδομένων στο GitHub· βλέπουν τη διεύθυνση IP σου, ποτέ τα διαθέσιμά σου (οι παρακολουθούμενες διευθύνσεις πηγαίνουν στον πάροχο του αντίστοιχου δικτύου)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices come directly from the exchanges of your pairs, plus exchange rates, coin lists and logos and the data mirror on GitHub; they see your IP address, never your holdings (watched addresses go to the provider of the respective network)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los precios llegan directamente de los exchanges de tus pares, además de tipos de cambio, listas y logotipos de monedas y el espejo de datos en GitHub; ven tu dirección IP, nunca tus tenencias (las direcciones vigiladas van al proveedor de la red correspondiente)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌ها مستقیم از صرافی‌های جفت‌هایت می‌آیند، به‌علاوهٔ نرخ ارز، فهرست‌ها و لوگوهای کوین و آینهٔ داده در GitHub؛ این سرویس‌ها نشانی IP تو را می‌بینند، هرگز دارایی‌هایت را (نشانی‌های تحت نظر به ارائه‌دهندهٔ شبکهٔ مربوط فرستاده می‌شوند)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurssit tulevat suoraan pariesi pörsseistä, lisäksi valuuttakurssit, kolikkolistat ja logot sekä datapeili GitHubissa; ne näkevät IP-osoitteesi, eivät koskaan omistuksiasi (seuratut osoitteet menevät kyseisen verkon palveluntarjoajalle)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cours viennent directement des plateformes de tes paires, avec les taux de change, les listes et logos de coins et le miroir de données sur GitHub ; ils voient ton adresse IP, jamais tes avoirs (les adresses suivies sont envoyées au fournisseur du réseau concerné)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השערים מגיעים ישירות מהבורסות של הצמדים שלך, וגם שערי מטבע, רשימות וסמלים של מטבעות ומראת הנתונים ב-GitHub; הם רואים את כתובת ה-IP שלך, אף פעם לא את האחזקות שלך (כתובות במעקב נשלחות לספק של הרשת המתאימה)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाव सीधे तुम्हारे पेयर के एक्सचेंजों से आते हैं, साथ में विनिमय दरें, कॉइन सूचियाँ व लोगो और GitHub पर डेटा मिरर; ये तुम्हारा IP पता देखते हैं, तुम्हारी होल्डिंग कभी नहीं (देखे जा रहे पते संबंधित नेटवर्क के प्रदाता को जाते हैं)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az árfolyamok közvetlenül a párjaid tőzsdéiről érkeznek, emellett devizaárfolyamok, coinlisták és logók, valamint a GitHubon lévő adattükör; ezek látják az IP-címedet, de soha a készleteidet (a figyelt címek az adott hálózat szolgáltatójához kerülnek)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga datang langsung dari bursa pasanganmu, ditambah kurs mata uang, daftar dan logo koin, serta cermin data di GitHub; mereka melihat alamat IP-mu, tidak pernah asetmu (alamat yang dipantau dikirim ke penyedia jaringan terkait)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prezzi arrivano direttamente dagli exchange delle tue coppie, più tassi di cambio, elenchi e loghi delle coin e il mirror dei dati su GitHub; vedono il tuo indirizzo IP, mai i tuoi saldi (gli indirizzi osservati vanno al fornitore della rispettiva rete)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格はペアの取引所から直接取得し、ほかに為替レート、コイン一覧とロゴ、GitHub 上のデータミラーを使います。これらは IP アドレスを見ますが、保有資産は決して見ません（監視中のアドレスは各ネットワークのプロバイダーに送られます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시세는 페어의 거래소에서 직접 받고, 환율, 코인 목록과 로고, GitHub의 데이터 미러도 사용합니다. 이들은 IP 주소를 보지만 보유 자산은 절대 보지 못합니다(관찰 중인 주소는 해당 네트워크 제공자에게 전송됩니다)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser kommer direkte fra børsene for parene dine, i tillegg valutakurser, coinlister og logoer og dataspeilet på GitHub; de ser IP-adressen din, aldri beholdningene dine (overvåkede adresser går til leverandøren av det aktuelle nettverket)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koersen komen rechtstreeks van de beurzen van je paren, plus wisselkoersen, coinlijsten en logo’s en de dataspiegel op GitHub; zij zien je IP-adres, nooit je bezit (gevolgde adressen gaan naar de aanbieder van het betreffende netwerk)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursy pochodzą bezpośrednio z giełd Twoich par, do tego kursy walut, listy i logo monet oraz kopia danych na GitHubie; widzą one Twój adres IP, nigdy Twoje zasoby (obserwowane adresy trafiają do dostawcy danej sieci)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cotações vêm diretamente das corretoras dos teus pares, além de taxas de câmbio, listas e logótipos de moedas e o espelho de dados no GitHub; estes veem o teu endereço IP, nunca os teus ativos (os endereços observados vão para o fornecedor da respetiva rede)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cotações vêm direto das corretoras dos seus pares, além de taxas de câmbio, listas e logos de moedas e o espelho de dados no GitHub; eles veem seu endereço IP, nunca seus saldos (endereços monitorados vão para o provedor da respectiva rede)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursurile vin direct de la bursele perechilor tale, plus cursuri valutare, liste și logo-uri de monede și oglinda de date de pe GitHub; acestea îți văd adresa IP, niciodată deținerile (adresele urmărite ajung la furnizorul rețelei respective)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсы приходят напрямую с бирж твоих пар, плюс курсы валют, списки и логотипы монет и зеркало данных на GitHub; они видят твой IP-адрес, но никогда твои активы (отслеживаемые адреса передаются провайдеру соответствующей сети)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurset vijnë drejtpërdrejt nga bursat e çifteve të tua, si dhe kurset e këmbimit, listat dhe logot e monedhave dhe pasqyra e të dhënave në GitHub; ata shohin adresën tënde IP, kurrë zotërimet e tua (adresat e ndjekura shkojnë te ofruesi i rrjetit përkatës)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser kommer direkt från börserna för dina par, plus växelkurser, coinlistor och logotyper och dataspegeln på GitHub; de ser din IP-adress, aldrig dina innehav (bevakade adresser går till leverantören av respektive nätverk)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคามาจากกระดานเทรดของคู่เทรดของคุณโดยตรง รวมถึงอัตราแลกเปลี่ยน รายการและโลโก้เหรียญ และมิเรอร์ข้อมูลบน GitHub ซึ่งเห็นที่อยู่ IP ของคุณ แต่ไม่เคยเห็นสินทรัพย์ของคุณ (ที่อยู่ที่ติดตามจะส่งไปยังผู้ให้บริการของเครือข่ายนั้น)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatlar doğrudan çiftlerinin borsalarından gelir, ayrıca döviz kurları, coin listeleri ve logolar ile GitHub’daki veri yansısı; bunlar IP adresini görür, varlıklarını asla (izlenen adresler ilgili ağın sağlayıcısına gider)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курси надходять безпосередньо з бірж твоїх пар, а також курси валют, списки й логотипи монет і дзеркало даних на GitHub; вони бачать твою IP-адресу, але ніколи твої активи (відстежувані адреси передаються постачальнику відповідної мережі)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá đến trực tiếp từ các sàn của cặp giao dịch của bạn, cùng tỷ giá, danh sách và logo coin và bản sao dữ liệu trên GitHub; họ thấy địa chỉ IP của bạn, không bao giờ thấy tài sản của bạn (địa chỉ theo dõi được gửi đến nhà cung cấp của mạng tương ứng)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格直接来自你所选交易对的交易所，另有汇率、币种列表和图标以及 GitHub 上的数据镜像；它们能看到你的 IP 地址，但绝不会看到你的持仓（关注的地址会发送给相应网络的服务商）。"
          }
        }
      }
    },
