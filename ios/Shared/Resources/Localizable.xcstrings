    "starter_source_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسعار من %1$@ بعملة %2$@. ألغِ تحديد ما لا تريده وأضف الباقي دفعة واحدة. يمكنك تغيير المنصة والزوج لكل عملة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny z burzy %1$@ v %2$@. Odznač, co nechceš, a zbytek přidej najednou. Burzu a pár můžeš změnit u každé mince."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser fra %1$@ i %2$@. Fravælg det, du ikke vil have, og tilføj resten på én gang. Du kan ændre børs og par for hver coin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurse von %1$@ in %2$@. Abwählen, was du nicht willst, und den Rest in einem Schritt hinzufügen. Börse und Paar kannst du je Coin ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τιμές από %1$@ σε %2$@. Αποεπίλεξε ό,τι δεν θέλεις και πρόσθεσε τα υπόλοιπα με μία κίνηση. Μπορείς να αλλάξεις ανταλλακτήριο και ζεύγος για κάθε νόμισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices from %1$@ in %2$@. Deselect what you don't want and add the rest in one go. You can change the exchange and pair for each coin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precios de %1$@ en %2$@. Desmarca lo que no quieras y añade el resto de una vez. Puedes cambiar el exchange y el par de cada moneda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌ها از %1$@ به %2$@. آنچه را نمی‌خواهی از انتخاب خارج کن و بقیه را یک‌جا اضافه کن. صرافی و جفت را برای هر کوین می‌توانی تغییر دهی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurssit pörssistä %1$@ valuutassa %2$@. Poista valinta niistä, joita et halua, ja lisää loput kerralla. Voit vaihtaa pörssin ja parin kolikkokohtaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cours de %1$@ en %2$@. Désélectionne ce que tu ne veux pas et ajoute le reste en une fois. Tu peux changer la plateforme et la paire pour chaque crypto."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחירים מ-%1$@ ב-%2$@. בטלו את הבחירה במה שלא תרצו והוסיפו את השאר בבת אחת. אפשר לשנות בורסה וצמד לכל מטבע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाव %1$@ से, %2$@ में। जो नहीं चाहिए उसका चयन हटाओ और बाकी को एक साथ जोड़ो। एक्सचेंज और पेयर तुम हर कॉइन के लिए बदल सकते हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árfolyamok forrása: %1$@, pénznem: %2$@. Vedd ki a jelölést abból, amit nem szeretnél, a többit add hozzá egyszerre. A tőzsdét és a párt érménként módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dari %1$@ dalam %2$@. Batalkan pilihan yang tidak kamu inginkan, lalu tambahkan sisanya sekaligus. Bursa dan pasangan bisa kamu ubah untuk tiap koin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezzi da %1$@ in %2$@. Deseleziona ciò che non vuoi e aggiungi il resto in un colpo solo. Puoi cambiare exchange e coppia per ogni coin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の価格（%2$@ 建て）。不要なものは選択を外し、残りをまとめて追加できます。取引所とペアはコインごとに変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 시세, %2$@ 기준. 원하지 않는 코인은 선택 해제하고 나머지를 한 번에 추가하세요. 거래소와 거래쌍은 코인마다 바꿀 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser fra %1$@ i %2$@. Velg bort det du ikke vil ha, og legg til resten på én gang. Du kan endre børs og par for hver coin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koersen van %1$@ in %2$@. Vink uit wat je niet wilt en voeg de rest in één keer toe. Beurs en paar kun je per coin wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursy z giełdy %1$@ w %2$@. Odznacz to, czego nie chcesz, a resztę dodaj za jednym razem. Giełdę i parę możesz zmienić dla każdej monety."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preços da %1$@ em %2$@. Desmarca o que não quiseres e adiciona o resto de uma só vez. Podes alterar a exchange e o par de cada moeda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preços da %1$@ em %2$@. Desmarque o que não quiser e adicione o resto de uma vez. Você pode alterar a exchange e o par de cada moeda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețuri de la %1$@ în %2$@. Debifează ce nu vrei și adaugă restul dintr-odată. Poți schimba bursa și perechea pentru fiecare monedă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цены с биржи %1$@ в %2$@. Сними отметку с ненужных и добавь остальные за один раз. Биржу и пару можно изменить для каждой монеты."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çmimet nga %1$@ në %2$@. Hiq zgjedhjen nga ato që nuk i do dhe shto të tjerat njëherësh. Bursën dhe çiftin mund t'i ndryshosh për çdo monedhë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurser från %1$@ i %2$@. Avmarkera det du inte vill ha och lägg till resten på en gång. Du kan ändra börs och par för varje coin."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคาจาก %1$@ เป็น %2$@ ยกเลิกเลือกเหรียญที่ไม่ต้องการ แล้วเพิ่มที่เหลือได้ในครั้งเดียว คุณเปลี่ยนกระดานเทรดและคู่เหรียญของแต่ละเหรียญได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatlar: %1$@, %2$@ cinsinden. İstemediklerinin seçimini kaldır, kalanları tek seferde ekle. Borsayı ve çifti her coin için değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ціни з біржі %1$@ у %2$@. Зніми позначку з непотрібних і додай решту за один раз. Біржу й пару можна змінити для кожної монети."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá từ %1$@ bằng %2$@. Bỏ chọn những coin bạn không muốn và thêm phần còn lại cùng lúc. Bạn có thể đổi sàn và cặp cho từng coin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格来自 %1$@，以 %2$@ 计价。取消不需要的，其余一次性全部添加。交易所和交易对可以按币种更改。"
          }
        }
      }
    },
