    "widget_configure_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الخلفية والشفافية. اللون يتبع التطبيق. تعرض الأداة قائمتك كاملة؛ اضغط على صف لفتح التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber pozadí a průhlednost. Barva odpovídá aplikaci. Widget ukazuje celý seznam; klepnutím na řádek otevřeš aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg baggrund og gennemsigtighed. Farven følger appen. Widgetten viser hele listen; tryk på en række for at åbne appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund und Deckkraft wählen. Die Farbe folgt der App. Das Widget zeigt die ganze Merkliste; ein Tipp auf eine Zeile öffnet die App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε φόντο και αδιαφάνεια. Το χρώμα ακολουθεί την εφαρμογή. Το widget δείχνει όλη τη λίστα· πάτα μια γραμμή για να ανοίξει η εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose background and opacity. The color follows the app. The widget shows your whole watchlist; tap a row to open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige fondo y opacidad. El color sigue a la app. El widget muestra toda la lista; toca una fila para abrir la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس‌زمینه و شفافیت را انتخاب کن. رنگ از برنامه پیروی می‌کند. ابزارک کل فهرست را نشان می‌دهد؛ برای باز کردن برنامه روی یک ردیف بزن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse tausta ja peittävyys. Väri seuraa sovellusta. Widget näyttää koko listan; avaa sovellus napauttamalla riviä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis l'arrière-plan et l'opacité. La couleur suit l'app. Le widget affiche toute la liste ; touche une ligne pour ouvrir l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו רקע ושקיפות. הצבע תואם לאפליקציה. הווידג׳ט מציג את כל הרשימה; הקישו על שורה כדי לפתוח את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पृष्ठभूमि और अपारदर्शिता चुनो। रंग ऐप के अनुसार रहता है। विजेट पूरी सूची दिखाता है; ऐप खोलने के लिए किसी पंक्ति पर टैप करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz hátteret és átlátszóságot. A szín az alkalmazást követi. A widget a teljes listát mutatja; egy sorra koppintva megnyílik az alkalmazás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih latar dan opasitas. Warna mengikuti aplikasi. Widget menampilkan seluruh daftar; ketuk baris untuk membuka aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli sfondo e opacità. Il colore segue l'app. Il widget mostra tutta la lista; tocca una riga per aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景と不透明度を選びます。色はアプリに合わせます。ウィジェットはリスト全体を表示し、行をタップするとアプリが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경과 불투명도를 선택하세요. 색상은 앱을 따릅니다. 위젯은 전체 목록을 보여 주며, 행을 탭하면 앱이 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg bakgrunn og gjennomsiktighet. Fargen følger appen. Widgeten viser hele listen; trykk på en rad for å åpne appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies achtergrond en dekking. De kleur volgt de app. De widget toont je hele lijst; tik op een rij om de app te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tło i krycie. Kolor jest jak w aplikacji. Widżet pokazuje całą listę; dotknij wiersza, by otworzyć aplikację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o fundo e a opacidade. A cor segue a app. O widget mostra toda a lista; toca numa linha para abrir a app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o fundo e a opacidade. A cor segue o app. O widget mostra a lista inteira; toque em uma linha para abrir o app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege fundalul și opacitatea. Culoarea urmează aplicația. Widgetul arată toată lista; atinge un rând pentru a deschide aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери фон и прозрачность. Цвет как в приложении. Виджет показывает весь список; коснись строки, чтобы открыть приложение."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgjidh sfondin dhe tejdukshmërinë. Ngjyra ndjek aplikacionin. Widget-i shfaq gjithë listën; prek një rresht për të hapur aplikacionin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj bakgrund och opacitet. Färgen följer appen. Widgeten visar hela listan; tryck på en rad för att öppna appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกพื้นหลังและความทึบ สีตามแอป วิดเจ็ตแสดงทั้งรายการ แตะแถวเพื่อเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planı ve opaklığı seç. Renk uygulamayı izler. Widget tüm listeyi gösterir; uygulamayı açmak için bir satıra dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибери фон і прозорість. Колір як у застосунку. Віджет показує весь список; торкнися рядка, щоб відкрити застосунок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn nền và độ mờ. Màu theo ứng dụng. Tiện ích hiển thị toàn bộ danh sách; chạm vào một dòng để mở ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择背景和不透明度。颜色跟随应用。小部件显示整个列表，点按一行即可打开应用。"
          }
        }
      }
    },
