    "welcome_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسعارك. تنبيهاتك. نظرتك العامة.\nبلا حساب. بلا إعلانات. بلا تتبع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje kurzy. Tvoje alarmy. Tvůj přehled.\nBez účtu. Bez reklam. Bez sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine kurser. Dine alarmer. Dit overblik.\nIngen konto. Ingen reklamer. Ingen sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kurse. Deine Alarme. Deine Übersicht.\nOhne Konto. Ohne Werbung. Ohne Tracking."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές σου. Οι συναγερμοί σου. Η επισκόπησή σου.\nΧωρίς λογαριασμό. Χωρίς διαφημίσεις. Χωρίς παρακολούθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your prices. Your alerts. Your overview.\nNo account. No ads. No tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus precios. Tus alarmas. Tu resumen.\nSin cuenta. Sin anuncios. Sin rastreo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌های تو. هشدارهای تو. نمای کلی تو.\nبدون حساب. بدون تبلیغات. بدون ردیابی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun hintasi. Sinun hälytyksesi. Sinun yleiskuvasi.\nEi tiliä. Ei mainoksia. Ei seurantaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes cours. Tes alertes. Ton aperçu.\nSans compte. Sans pub. Sans pistage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחירים שלך. ההתראות שלך. הסקירה שלך.\nבלי חשבון. בלי פרסומות. בלי מעקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हारे भाव। तुम्हारे अलार्म। तुम्हारा ओवरव्यू।\nकोई खाता नहीं। कोई विज्ञापन नहीं। कोई ट्रैकिंग नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A te árfolyamaid. A te riasztásaid. A te áttekintésed.\nFiók nélkül. Reklám nélkül. Követés nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hargamu. Alarmmu. Ringkasanmu.\nTanpa akun. Tanpa iklan. Tanpa pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi prezzi. I tuoi allarmi. La tua panoramica.\nNessun account. Nessuna pubblicità. Nessun tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの価格。あなたのアラーム。あなたの一覧。\nアカウント不要。広告なし。トラッキングなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 시세. 내 경보. 내 개요.\n계정 없음. 광고 없음. 추적 없음."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine kurser. Dine alarmer. Din oversikt.\nIngen konto. Ingen reklame. Ingen sporing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw koersen. Jouw alarmen. Jouw overzicht.\nGeen account. Geen advertenties. Geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje kursy. Twoje alarmy. Twój przegląd.\nBez konta. Bez reklam. Bez śledzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus preços. Os teus alarmes. A tua visão geral.\nSem conta. Sem anúncios. Sem rastreio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus preços. Seus alarmes. Sua visão geral.\nSem conta. Sem anúncios. Sem rastreamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețurile tale. Alarmele tale. Privirea ta de ansamblu.\nFără cont. Fără reclame. Fără urmărire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои курсы. Твои оповещения. Твой обзор.\nБез аккаунта. Без рекламы. Без отслеживания."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çmimet e tua. Alarmet e tua. Pasqyra jote.\nPa llogari. Pa reklama. Pa gjurmim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina kurser. Dina larm. Din översikt.\nInget konto. Ingen reklam. Ingen spårning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคาของคุณ สัญญาณเตือนของคุณ ภาพรวมของคุณ\nไม่ต้องมีบัญชี ไม่มีโฆษณา ไม่มีการติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatların. Alarmların. Genel bakışın.\nHesap yok. Reklam yok. Takip yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої курси. Твої сигнали. Твій огляд.\nБез акаунта. Без реклами. Без стеження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá của bạn. Cảnh báo của bạn. Tổng quan của bạn.\nKhông tài khoản. Không quảng cáo. Không theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
