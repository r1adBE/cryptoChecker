    "watchlist_refresh_report_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد تفصيل بعد: لم يكتمل أي تحديث كامل حتى الآن. اضغط على «تحديث» وانتظر حتى يتوقف مؤشر التحميل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádný rozpis: ještě neproběhlo úplné obnovení. Klepni na obnovit a počkej, až se indikátor zastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen oversigt endnu: der er endnu ikke gennemført en fuld opdatering. Tryk på opdater, og vent, til hjulet stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Aufschlüsselung – es gab noch keinen vollständigen Abruf. Tippe auf Aktualisieren und warte, bis der Kreis stoppt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ανάλυση ακόμα: δεν έχει γίνει ακόμη πλήρης ανανέωση. Πάτα ανανέωση και περίμενε να σταματήσει η ένδειξη φόρτωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No breakdown yet – no full refresh so far. Tap refresh and wait until the circle stops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay desglose: todavía no se ha hecho ninguna actualización completa. Toca Actualizar y espera a que el indicador se detenga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز جزئیاتی نیست: هنوز هیچ تازه‌سازی کاملی انجام نشده است. روی تازه‌سازی بزن و صبر کن تا نشانگر چرخان متوقف شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erittelyä ei vielä ole: täyttä päivitystä ei ole vielä tehty. Napauta päivitä ja odota, kunnes latausilmaisin pysähtyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de détail : aucune actualisation complète pour l'instant. Touche Actualiser et attends que l'indicateur s'arrête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין עדיין פירוט: טרם בוצע רענון מלא. הקישו על רענון והמתינו עד שסמל הטעינה ייעצר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई विवरण नहीं: अभी तक कोई पूरा रीफ़्रेश नहीं हुआ है। रीफ़्रेश पर टैप करो और स्पिनर रुकने तक इंतज़ार करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs részletezés: még nem volt teljes frissítés. Koppints a frissítésre, és várj, amíg a jelző megáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada rincian: belum ada pembaruan penuh. Ketuk muat ulang dan tunggu hingga ikon putar berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun dettaglio ancora: finora nessun aggiornamento completo. Tocca Aggiorna e attendi che l'indicatore si fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
