    "ios_storage_app_group_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التخزين المشترك للأدوات غير متاح – لا ترى الأدوات وعمليات الفحص في الخلفية بيانات التطبيق. عادةً ما تحل إعادة تثبيت التطبيق المشكلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílené úložiště pro widgety není dostupné – widgety a kontroly na pozadí nevidí data aplikace. Obvykle pomůže aplikaci přeinstalovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delt lager til widgets er ikke tilgængeligt – widgets og baggrundstjek kan ikke se appens data. Geninstallation af appen løser det som regel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gemeinsame Speicher für Widgets fehlt – Widgets und Hintergrund-Prüfung sehen die Daten der App nicht. Neu installieren behebt das meist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κοινόχρηστος χώρος αποθήκευσης για τα widget δεν είναι διαθέσιμος – τα widget και οι έλεγχοι στο παρασκήνιο δεν βλέπουν τα δεδομένα της εφαρμογής. Η επανεγκατάσταση της εφαρμογής συνήθως το διορθώνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared storage for widgets is not available – widgets and background checks do not see the app’s data. Reinstalling the app usually fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento compartido de los widgets no está disponible: los widgets y las comprobaciones en segundo plano no ven los datos de la app. Reinstalar la app suele solucionarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضای ذخیره‌سازی مشترک ابزارک‌ها در دسترس نیست – ابزارک‌ها و بررسی‌های پس‌زمینه داده‌های برنامه را نمی‌بینند. نصب دوباره برنامه معمولاً مشکل را حل می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgetien jaettu tallennustila ei ole käytettävissä – widgetit ja taustatarkistukset eivät näe sovelluksen tietoja. Sovelluksen uudelleenasennus yleensä korjaa tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage partagé des widgets n’est pas disponible – les widgets et les vérifications en arrière-plan ne voient pas les données de l’app. Réinstaller l’app règle généralement le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האחסון המשותף לווידג׳טים אינו זמין – הווידג׳טים והבדיקות ברקע לא רואים את נתוני האפליקציה. התקנה מחדש של האפליקציה פותרת זאת בדרך כלל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विजेट के लिए साझा स्टोरेज उपलब्ध नहीं है – विजेट और बैकग्राउंड जाँच ऐप का डेटा नहीं देख पाते। ऐप को दोबारा इंस्टॉल करने से आमतौर पर यह ठीक हो जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A widgetek közös tárhelye nem érhető el – a widgetek és a háttérben futó ellenőrzések nem látják az alkalmazás adatait. Az alkalmazás újratelepítése általában megoldja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan bersama untuk widget tidak tersedia – widget dan pemeriksaan latar belakang tidak melihat data aplikasi. Memasang ulang aplikasi biasanya memperbaikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archivio condiviso per i widget non è disponibile – widget e controlli in background non vedono i dati dell’app. Di solito basta reinstallare l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェット用の共有ストレージを利用できません – ウィジェットとバックグラウンドのチェックはアプリのデータを参照できません。通常はアプリを再インストールすると解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯용 공유 저장소를 사용할 수 없습니다 – 위젯과 백그라운드 확인이 앱 데이터를 볼 수 없습니다. 보통 앱을 다시 설치하면 해결됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delt lagring for widgeter er ikke tilgjengelig – widgeter og bakgrunnssjekker ser ikke appens data. Å installere appen på nytt løser det som regel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeelde opslag voor widgets is niet beschikbaar – widgets en controles op de achtergrond zien de gegevens van de app niet. Opnieuw installeren lost dit meestal op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólna pamięć dla widżetów jest niedostępna – widżety i sprawdzanie w tle nie widzą danych aplikacji. Ponowna instalacja aplikacji zwykle to naprawia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O armazenamento partilhado dos widgets não está disponível – os widgets e as verificações em segundo plano não veem os dados da app. Reinstalar a app costuma resolver."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O armazenamento compartilhado dos widgets não está disponível – os widgets e as verificações em segundo plano não veem os dados do app. Reinstalar o app geralmente resolve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiul de stocare partajat pentru widgeturi nu este disponibil – widgeturile și verificările în fundal nu văd datele aplicației. De obicei, reinstalarea aplicației rezolvă problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общее хранилище для виджетов недоступно – виджеты и фоновые проверки не видят данные приложения. Обычно помогает переустановка приложения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapësira e përbashkët për widget-et nuk është e disponueshme – widget-et dhe kontrollet në sfond nuk i shohin të dhënat e aplikacionit. Riinstalimi i aplikacionit zakonisht e zgjidh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delad lagring för widgetar är inte tillgänglig – widgetar och bakgrundskontroller ser inte appens data. Att installera om appen brukar lösa det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่เก็บข้อมูลที่ใช้ร่วมกันสำหรับวิดเจ็ตไม่พร้อมใช้งาน – วิดเจ็ตและการตรวจสอบเบื้องหลังมองไม่เห็นข้อมูลของแอป โดยทั่วไปการติดตั้งแอปใหม่จะแก้ปัญหานี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget’lar için ortak depolama kullanılamıyor – widget’lar ve arka plan kontrolleri uygulamanın verilerini göremiyor. Uygulamayı yeniden yüklemek genellikle sorunu çözer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільне сховище для віджетів недоступне – віджети й фонові перевірки не бачать даних застосунку. Зазвичай допомагає перевстановлення застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ dùng chung cho tiện ích không khả dụng – tiện ích và các lần kiểm tra trong nền không thấy dữ liệu của ứng dụng. Cài lại ứng dụng thường khắc phục được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小组件的共享存储不可用——小组件和后台检查无法读取应用的数据。通常重新安装应用即可解决。"
          }
        }
      }
    },
