    "portfolio_export_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرصيد في نهاية اليوم المختار، مقيّمًا بسعر إغلاق اليوم (UTC) بـ USDT ومحوّلًا بالسعر المرجعي للبنك المركزي الأوروبي في ذلك اليوم. غيّر العملة من «التحويل إلى»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držba na konci zvoleného dne, oceněná denní uzavírací cenou (UTC) v USDT a přepočtená referenčním kurzem ECB z tohoto dne. Měnu změníte v „Přepočítat na”."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholdning ved udgangen af den valgte dag, værdisat til dagens lukkekurs (UTC) i USDT og omregnet med ECB's referencekurs for den dag. Valutaen ændrer du under ”Omregn til”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestand am Ende des gewählten Tags, bewertet zum Tagesschlusskurs (UTC) in USDT und umgerechnet mit dem EZB-Referenzkurs dieses Tags. Die Währung änderst du über «Umrechnen in»."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατοχή στο τέλος της επιλεγμένης ημέρας, αποτιμημένη στην τιμή κλεισίματος της ημέρας (UTC) σε USDT και μετατρεπόμενη με την ισοτιμία αναφοράς της ΕΚΤ εκείνης της ημέρας. Αλλάξτε το νόμισμα από το «Μετατροπή σε»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holdings at the end of the chosen day, valued at the daily close (UTC) in USDT and converted with the ECB reference rate of that day. Change the currency with “Convert to”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenencia al final del día elegido, valorada al precio de cierre diario (UTC) en USDT y convertida con el tipo de referencia del BCE de ese día. Cambia la moneda en «Convertir a»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارایی در پایان روز انتخاب‌شده، ارزش‌گذاری‌شده با قیمت پایانی روز (UTC) به USDT و تبدیل‌شده با نرخ مرجع بانک مرکزی اروپا در همان روز. ارز را از «تبدیل به» تغییر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omistus valitun päivän lopussa, arvostettuna päivän päätöshintaan (UTC) USDT:nä ja muunnettuna EKP:n saman päivän viitekurssilla. Vaihda valuutta kohdasta „Muunna valuuttaan”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoirs à la fin du jour choisi, valorisés au cours de clôture du jour (UTC) en USDT et convertis au taux de référence de la BCE de ce jour. Changer la devise via « Convertir en »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזקה בסוף היום שנבחר, לפי מחיר הסגירה היומי (UTC) ב-USDT ומומרת לפי שער הייחוס של ה-ECB באותו יום. אפשר לשנות את המטבע דרך ״המרה ל״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए दिन के अंत में होल्डिंग, दिन के क्लोज़िंग भाव (UTC) पर USDT में आंकी गई और उस दिन की ECB संदर्भ दर से बदली गई। मुद्रा «इसमें बदलें» से बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állomány a választott nap végén, a napi záróárfolyamon (UTC) USDT-ben értékelve, és az EKB aznapi referencia-árfolyamával átváltva. A pénznemet az „Átváltás erre” menüben módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepemilikan di akhir hari yang dipilih, dinilai dengan harga penutupan harian (UTC) dalam USDT dan dikonversi dengan kurs acuan ECB hari itu. Ubah mata uang lewat «Konversi ke»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possesso alla fine del giorno scelto, valutato al prezzo di chiusura giornaliero (UTC) in USDT e convertito con il tasso di riferimento BCE di quel giorno. Cambia la valuta con «Converti in»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した日の終了時点の保有量。USDT建ての日次終値（UTC）で評価し、その日のECB参照レートで換算します。通貨は「換算通貨」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 날 마감 시점의 보유량으로, USDT 기준 일 종가(UTC)로 평가하고 그날의 ECB 기준 환율로 환산합니다. 통화는 ‘환산 통화’에서 바꾸세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholdning ved slutten av valgt dag, verdsatt til dagens sluttkurs (UTC) i USDT og regnet om med ECBs referansekurs for den dagen. Du endrer valutaen under «Regn om til»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezit aan het einde van de gekozen dag, gewaardeerd tegen de slotkoers van die dag (UTC) in USDT en omgerekend met de ECB-referentiekoers van die dag. Valuta wijzigen via „Omrekenen naar“."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan posiadania na koniec wybranego dnia, wyceniony po dziennym kursie zamknięcia (UTC) w USDT i przeliczony po kursie referencyjnym EBC z tego dnia. Walutę zmienisz w „Przelicz na“."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posse no fim do dia escolhido, avaliada ao preço de fecho diário (UTC) em USDT e convertida com a taxa de referência do BCE desse dia. Altere a moeda em «Converter para»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posição no fim do dia escolhido, avaliada pelo preço de fechamento diário (UTC) em USDT e convertida pela taxa de referência do BCE desse dia. Altere a moeda em “Converter para”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deținerea la sfârșitul zilei alese, evaluată la prețul de închidere zilnic (UTC) în USDT și convertită cu cursul de referință BCE din acea zi. Schimbă moneda din „Convertește în”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Владение на конец выбранного дня, оценённое по цене закрытия дня (UTC) в USDT и пересчитанное по референсному курсу ЕЦБ на этот день. Валюту можно изменить в «Пересчитать в»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotërimi në fund të ditës së zgjedhur, i vlerësuar me çmimin e mbylljes ditore (UTC) në USDT dhe i konvertuar me kursin e referencës së BQE-së për atë ditë. Ndrysho monedhën te «Konverto në»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehav vid slutet av vald dag, värderat till dagens stängningskurs (UTC) i USDT och omräknat med ECB:s referenskurs för den dagen. Du byter valuta under ”Räkna om till”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยอดถือครอง ณ สิ้นวันที่เลือก ประเมินมูลค่าด้วยราคาปิดรายวัน (UTC) เป็น USDT และแปลงด้วยอัตราอ้างอิงของ ECB ในวันนั้น เปลี่ยนสกุลเงินได้ที่ “แปลงเป็น”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen günün sonundaki varlık; USDT cinsinden günlük kapanış fiyatıyla (UTC) değerlenir ve o günün ECB referans kuruyla çevrilir. Para birimini „Şuna çevir“ ile değiştir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Володіння на кінець вибраного дня, оцінене за ціною закриття дня (UTC) в USDT і перераховане за референсним курсом ЄЦБ на цей день. Валюту можна змінити в «Перерахувати в»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượng nắm giữ vào cuối ngày đã chọn, định giá theo giá đóng cửa ngày (UTC) bằng USDT và quy đổi theo tỷ giá tham chiếu ECB của ngày đó. Đổi tiền tệ trong «Quy đổi sang»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选日期结束时的持仓，按 USDT 计的当日收盘价（UTC）估值，并按当日欧洲央行参考汇率换算。可在“换算为”中更改货币。"
          }
        }
      }
    },
