    "portfolio_export_address_lots_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: لعنوان مراقَب دفعات تكلفة بتاريخ بعد آخر فحص لرصيده قبل هذا التاريخ – قد تكون مفقودة هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění: sledovaná adresa má položky pořizovací ceny s datem po své poslední kontrole zůstatku před tímto datem – zde mohou chybět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: en overvåget adresse har anskaffelsesposter dateret efter dens seneste saldotjek før denne dato – de kan mangle her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Eine beobachtete Adresse hat Einstandsposten nach ihrer letzten Guthabenabfrage vor diesem Datum – sie können hier fehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημείωση: μια παρακολουθούμενη διεύθυνση έχει θέσεις κόστους κτήσης με ημερομηνία μετά τον τελευταίο έλεγχο υπολοίπου της πριν από αυτή την ημερομηνία – μπορεί να λείπουν εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: a watched address has cost-basis lots dated after its last balance check before this date – they may be missing here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: una dirección vigilada tiene lotes con coste fechados después de su última consulta de saldo antes de esta fecha; pueden faltar aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجه: یک آدرس تحت نظر اقلام بهای تمام‌شده‌ای دارد که تاریخشان پس از آخرین بررسی موجودی آن پیش از این تاریخ است – ممکن است اینجا نباشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomio: seuratulla osoitteella on hankintamenoeriä, jotka on päivätty sen viimeisimmän ennen tätä päivää tehdyn saldotarkistuksen jälkeen – ne voivat puuttua tästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : une adresse surveillée a des lots avec prix de revient datés après sa dernière consultation du solde avant cette date – ils peuvent manquer ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערה: לכתובת במעקב יש פריטי עלות רכישה שתאריכם אחרי בדיקת היתרה האחרונה שלה לפני תאריך זה – ייתכן שהם חסרים כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान दो: किसी निगरानी वाले पते में ऐसी लागत प्रविष्टियाँ हैं जिनकी तारीख इस तारीख से पहले उसकी आख़िरी बैलेंस जाँच के बाद की है – वे यहाँ गायब हो सकती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjegyzés: egy figyelt címnek olyan bekerülési tételei vannak, amelyek dátuma az e dátum előtti utolsó egyenleglekérdezése utánra esik – ezek itt hiányozhatnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan: sebuah alamat yang dipantau memiliki lot biaya perolehan bertanggal setelah pengecekan saldo terakhirnya sebelum tanggal ini – lot tersebut mungkin tidak tercantum di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: un indirizzo osservato ha lotti con costo datati dopo l'ultima verifica del saldo prima di questa data – qui possono mancare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：監視中のアドレスに、この日付より前の最後の残高確認より後の日付の取得価額ロットがあります。ここでは含まれていない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 관찰 중인 주소에 이 날짜 이전의 마지막 잔액 확인 이후 날짜의 취득가 항목이 있습니다. 여기에서 누락될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: en overvåket adresse har anskaffelsesposter datert etter siste saldosjekk før denne datoen – de kan mangle her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: een gevolgd adres heeft aanschafposten gedateerd na de laatste saldocontrole vóór deze datum – die kunnen hier ontbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: obserwowany adres ma pozycje kosztu nabycia z datą po ostatnim sprawdzeniu salda przed tą datą – może ich tu brakować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: um endereço observado tem lotes com custo de aquisição datados após a última consulta de saldo antes desta data – podem estar em falta aqui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: um endereço monitorado tem lotes com custo de aquisição datados após a última consulta de saldo antes desta data – eles podem estar faltando aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notă: o adresă urmărită are loturi cu cost de achiziție datate după ultima verificare a soldului înainte de această dată – pot lipsi aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: у отслеживаемого адреса есть позиции со стоимостью приобретения, датированные после последней проверки баланса до этой даты, — здесь они могут отсутствовать."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shënim: një adresë e vëzhguar ka pozicione me kosto blerjeje të datuara pas kontrollit të fundit të bilancit para kësaj date – mund të mungojnë këtu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs: en bevakad adress har anskaffningsposter daterade efter dess senaste saldokontroll före detta datum – de kan saknas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเหตุ: ที่อยู่ที่ติดตามมีรายการต้นทุนที่ลงวันที่หลังการตรวจยอดคงเหลือครั้งล่าสุดก่อนวันที่นี้ – รายการเหล่านั้นอาจไม่ปรากฏที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not: izlenen bir adresin, bu tarihten önceki son bakiye sorgusundan sonra tarihli maliyet kalemleri var – bunlar burada eksik olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: відстежувана адреса має позиції з вартістю придбання, датовані після останньої перевірки балансу до цієї дати, — тут їх може не бути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý: một địa chỉ đang theo dõi có các lô giá vốn ghi ngày sau lần kiểm tra số dư cuối cùng của nó trước ngày này – chúng có thể bị thiếu ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：某个被关注地址有成本价条目，其日期晚于该地址在此日期之前最后一次查询余额的时间——这些条目在此可能缺失。"
          }
        }
      }
    },
