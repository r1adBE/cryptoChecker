    "live_activity_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التحديث كلما فحص التطبيق الأسعار – في الخلفية يقرر iOS عدد المرات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje se, kdykoli aplikace kontroluje kurzy – na pozadí rozhoduje iOS, jak často."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateres, når appen tjekker kurser – i baggrunden bestemmer iOS, hvor tit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird aktualisiert, wenn die App Kurse prüft – im Hintergrund entscheidet iOS, wie oft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνεται κάθε φορά που η εφαρμογή ελέγχει τιμές – στο παρασκήνιο το iOS αποφασίζει πόσο συχνά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updated whenever the app checks prices – in the background iOS decides how often."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualiza cada vez que la app comprueba los precios; en segundo plano, iOS decide con qué frecuencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر بار که برنامه قیمت‌ها را بررسی می‌کند به‌روز می‌شود – در پس‌زمینه iOS تعیین می‌کند چند وقت یک‌بار."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittyy aina, kun sovellus tarkistaa kurssit – taustalla iOS päättää, kuinka usein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis à jour chaque fois que l'app vérifie les cours – en arrière-plan, iOS décide de la fréquence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתעדכן בכל פעם שהאפליקציה בודקת שערים – ברקע, iOS מחליט באיזו תדירות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी ऐप भाव जाँचता है, अपडेट होता है – बैकग्राउंड में iOS तय करता है कि कितनी बार।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frissül, amikor az alkalmazás árfolyamot ellenőriz – a háttérben az iOS dönti el, milyen gyakran."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbarui setiap kali aplikasi memeriksa harga – di latar belakang, iOS yang menentukan seberapa sering."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggiorna ogni volta che l'app controlla i prezzi – in background è iOS a decidere quanto spesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが価格を確認するたびに更新されます – バックグラウンドでの頻度は iOS が決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 시세를 확인할 때마다 업데이트됩니다 – 백그라운드에서는 iOS가 빈도를 결정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateres hver gang appen sjekker kurser – i bakgrunnen bestemmer iOS hvor ofte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt bijgewerkt telkens als de app koersen controleert – op de achtergrond bepaalt iOS hoe vaak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje się za każdym razem, gdy aplikacja sprawdza kursy – w tle o częstotliwości decyduje iOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualiza sempre que a app verifica os preços – em segundo plano, o iOS decide com que frequência."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
