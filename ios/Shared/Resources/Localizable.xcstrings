    "address_lots_capped" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز الدفعات الرصيد بمقدار %1$@ – تُستهلك الأقدم أولاً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky převyšují zůstatek o %1$@ – nejstarší se spotřebují jako první."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posterne overstiger saldoen med %1$@ – de ældste bruges først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Posten übersteigen das Guthaben um %1$@ – die ältesten werden zuerst verbraucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παρτίδες υπερβαίνουν το υπόλοιπο κατά %1$@ – οι παλαιότερες καταναλώνονται πρώτες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lots exceed the balance by %1$@ – the oldest are used up first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lotes superan el saldo en %1$@; los más antiguos se consumen primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسته‌ها به اندازهٔ %1$@ از موجودی بیشترند – قدیمی‌ترها اول مصرف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erät ylittävät saldon määrällä %1$@ – vanhimmat käytetään ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lots dépassent le solde de %1$@ – les plus anciens sont consommés en premier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המנות חורגות מהיתרה ב-%1$@ – הוותיקות ביותר נצרכות ראשונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉट शेष राशि से %1$@ अधिक हैं – सबसे पुराने पहले खर्च होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tételek %1$@ értékkel meghaladják az egyenleget – a legrégebbiek fogynak el először."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lot melebihi saldo sebesar %1$@ – yang tertua dipakai lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I lotti superano il saldo di %1$@ – i più vecchi vengono consumati per primi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロットが残高を %1$@ 上回っています – 古いものから先に消費されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로트가 잔액을 %1$@ 초과합니다 – 가장 오래된 것부터 소진됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postene overstiger saldoen med %1$@ – de eldste brukes først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De posten overschrijden het saldo met %1$@ – de oudste worden eerst verbruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partie przekraczają saldo o %1$@ – najstarsze są zużywane jako pierwsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lotes excedem o saldo em %1$@ – os mais antigos são consumidos primeiro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lotes excedem o saldo em %1$@ – os mais antigos são consumidos primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loturile depășesc soldul cu %1$@ – cele mai vechi sunt consumate primele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Партии превышают баланс на %1$@ — самые старые расходуются первыми."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pjesët e tejkalojnë balancën me %1$@ – më të vjetrat përdoren të parat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posterna överstiger saldot med %1$@ – de äldsta förbrukas först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อตเกินยอดคงเหลือ %1$@ – ล็อตที่เก่าที่สุดถูกใช้ก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partiler bakiyeyi %1$@ aşıyor – en eskiler önce kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Партії перевищують баланс на %1$@ — найстаріші витрачаються першими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lô vượt số dư %1$@ – lô cũ nhất được dùng trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批次超出余额 %1$@——最早的批次先被消耗。"
          }
        }
      }
    },
