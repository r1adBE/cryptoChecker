    "settings_gas_alert_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّه مرة واحدة عندما تنخفض الرسوم العادية تحت الحد. يتم الفحص عند تحديث الأسعار، مرة كل 10 دقائق على الأكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní jednou, když běžný poplatek klesne pod limit. Kontroluje se při aktualizaci kurzů, nejvýše každých 10 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver besked én gang, når det normale gebyr falder under grænsen. Tjekkes ved kursopdatering, højst hvert 10. minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet einmal, wenn die normale Gebühr unter die Grenze fällt. Geprüft wird bei der Kursaktualisierung, höchstens alle 10 Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποιεί μία φορά όταν το κανονικό τέλος πέσει κάτω από το όριο. Ελέγχεται κατά την ενημέρωση τιμών, το πολύ κάθε 10 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifies once when the normal fee drops below the limit. Checked during price updates, at most every 10 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa una vez cuando la comisión normal baja del límite. Se comprueba al actualizar los precios, como máximo cada 10 minutos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کارمزد عادی به زیر حد برسد، یک بار اعلان می‌دهد. هنگام به‌روزرسانی قیمت‌ها بررسی می‌شود، حداکثر هر 10 دقیقه یک بار."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoittaa kerran, kun normaali maksu laskee rajan alle. Tarkistetaan hintapäivityksen yhteydessä, enintään 10 minuutin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévient une fois quand les frais normaux passent sous la limite. Vérifié lors de la mise à jour des cours, au plus toutes les 10 minutes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתריע פעם אחת כשהעמלה הרגילה יורדת מתחת לסף. נבדק בעדכון השערים, לכל היותר כל 10 דקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामान्य शुल्क सीमा से नीचे जाने पर एक बार सूचित करता है। कीमत अपडेट के समय जाँचा जाता है, ज़्यादा से ज़्यादा हर 10 मिनट में।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszer értesít, ha a normál díj a határ alá esik. Az árfrissítéskor ellenőrizzük, legfeljebb 10 percenként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu sekali saat biaya normal turun di bawah batas. Diperiksa saat pembaruan harga, paling sering setiap 10 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa una volta quando la commissione normale scende sotto il limite. Controllato durante l'aggiornamento dei prezzi, al massimo ogni 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常の手数料がしきい値を下回ると1回通知します。価格の更新時に、最短10分間隔で確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 수수료가 한도 아래로 내려가면 한 번 알립니다. 시세 업데이트 때 최대 10분마다 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler én gang når det normale gebyret faller under grensen. Sjekkes ved kursoppdatering, høyst hvert 10. minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt één keer wanneer de normale kosten onder de grens zakken. Gecontroleerd bij het bijwerken van de koersen, hoogstens elke 10 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia raz, gdy zwykła opłata spadnie poniżej limitu. Sprawdzane przy aktualizacji kursów, najwyżej co 10 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa uma vez quando a taxa normal desce abaixo do limite. Verificado na atualização das cotações, no máximo a cada 10 minutos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa uma vez quando a taxa normal cai abaixo do limite. Verificado na atualização das cotações, no máximo a cada 10 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anunță o dată când comisionul normal scade sub limită. Verificat la actualizarea cursurilor, cel mult la 10 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает один раз, когда обычная комиссия опускается ниже порога. Проверяется при обновлении курсов, не чаще раза в 10 минут."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njofton një herë kur tarifa normale bie nën kufi. Kontrollohet gjatë përditësimit të çmimeve, më së shumti çdo 10 minuta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelar en gång när den normala avgiften sjunker under gränsen. Kontrolleras vid kursuppdatering, högst var 10:e minut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งหนึ่งครั้งเมื่อค่าธรรมเนียมปกติลดต่ำกว่าขีดจำกัด ตรวจสอบระหว่างอัปเดตราคา อย่างมากทุก 10 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal ücret sınırın altına düştüğünde bir kez bildirir. Fiyat güncellemesinde, en fazla 10 dakikada bir kontrol edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє один раз, коли звичайна комісія опускається нижче межі. Перевіряється під час оновлення курсів, не частіше ніж раз на 10 хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo một lần khi phí thông thường xuống dưới ngưỡng. Kiểm tra khi cập nhật giá, tối đa mỗi 10 phút một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通手续费低于阈值时提醒一次。在行情更新时检查，最多每 10 分钟一次。"
          }
        }
      }
    },
