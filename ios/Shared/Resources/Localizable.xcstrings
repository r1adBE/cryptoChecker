          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La negociación de la última hora está en línea con las últimas 24 horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاملات ساعت گذشته با ۲۴ ساعت اخیر همخوانی دارد."
          }
        },
