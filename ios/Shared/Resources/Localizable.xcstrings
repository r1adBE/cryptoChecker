    "settings_notification_change_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يظهر الإشعار إلا بعد أن يتحرك السعر بهذا القدر على الأقل منذ الإشعار السابق. لا يُعرض شيء أثناء غياب البيانات. لا تتأثر التنبيهات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení se zobrazí, až když se cena od posledního oznámení změní alespoň o tuto hodnotu. Pokud chybí data, nezobrazí se nic. Alarmů se to netýká."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notifikation vises først, når kursen har bevæget sig mindst så meget siden den forrige. Der vises intet, mens der mangler data. Alarmer påvirkes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kursmitteilung erscheint erst, wenn sich der Kurs seit der letzten um mindestens so viel bewegt hat. Fehlen Daten, wird nichts gezeigt. Alarme bleiben davon unberührt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ειδοποίηση τιμής εμφανίζεται μόνο όταν η τιμή έχει κινηθεί τουλάχιστον τόσο από την προηγούμενη. Όσο λείπουν δεδομένα, δεν εμφανίζεται τίποτα. Οι συναγερμοί δεν επηρεάζονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A price notification appears only once the price has moved by at least this much since the last one. Nothing is shown while data is missing. Alerts are unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo aparece una notificación cuando el precio se ha movido al menos esta cantidad desde la última. No se muestra nada mientras falten datos. Las alarmas no se ven afectadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان فقط زمانی نمایش داده می‌شود که قیمت از اعلان قبلی دست‌کم به این اندازه تغییر کرده باشد. وقتی داده‌ای در دسترس نیست چیزی نمایش داده نمی‌شود. هشدارها تحت تأثیر قرار نمی‌گیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitus näytetään vasta, kun hinta on muuttunut vähintään tämän verran edellisestä ilmoituksesta. Kun tietoja puuttuu, mitään ei näytetä. Ei vaikuta hälytyksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification n'apparaît que si le prix a varié d'au moins cette valeur depuis la dernière. Rien n'est affiché tant que des données manquent. Les alertes ne sont pas concernées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכון מחיר מופיע רק כשהמחיר זז לפחות בשיעור זה מאז העדכון הקודם. כשחסרים נתונים לא מוצג דבר. ההתראות אינן מושפעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले नोटिफ़िकेशन के बाद कीमत कम से कम इतनी बदलने पर ही नोटिफ़िकेशन दिखता है। डेटा न होने पर कुछ नहीं दिखाया जाता। अलार्म पर इसका असर नहीं पड़ता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesítés csak akkor jelenik meg, ha az ár az előző óta legalább ennyivel elmozdult. Hiányzó adatok esetén semmi sem jelenik meg. A riasztásokat ez nem érinti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi hanya muncul jika harga sudah bergerak setidaknya sebesar ini sejak notifikasi terakhir. Tidak ada yang ditampilkan selama data belum tersedia. Alarm tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica appare solo quando il prezzo si è mosso almeno di questo valore dall'ultima. Se mancano dati non viene mostrato nulla. Gli allarmi non ne sono influenzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の通知から価格がこの幅以上動いたときだけ通知します。データがない間は何も表示しません。アラームには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 알림 이후 가격이 이만큼 이상 움직였을 때만 알림이 표시됩니다. 데이터가 없으면 아무것도 표시되지 않습니다. 경보에는 영향이 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et varsel vises først når kursen har beveget seg minst så mye siden forrige varsel. Ingenting vises mens data mangler. Alarmer påvirkes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een melding verschijnt pas als de koers sinds de vorige minstens zoveel is bewogen. Zolang gegevens ontbreken, wordt niets getoond. Alarmen worden niet beïnvloed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienie pojawi się dopiero, gdy cena zmieni się co najmniej o tyle od poprzedniego. Gdy brakuje danych, nic nie jest wyświetlane. Nie dotyczy alarmów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só aparece uma notificação quando o preço variou pelo menos este valor desde a última. Nada é mostrado enquanto faltarem dados. Os alarmes não são afetados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação só aparece quando o preço variou pelo menos esse valor desde a última. Nada é mostrado enquanto faltarem dados. Os alarmes não são afetados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O notificare apare doar după ce prețul s-a modificat cu cel puțin această valoare față de ultima. Cât timp lipsesc date, nu se afișează nimic. Alarmele nu sunt afectate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомление появится, только когда цена изменится хотя бы на эту величину с момента предыдущего. Пока данных нет, ничего не показывается. На оповещения не влияет."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njoftimi shfaqet vetëm kur çmimi ka lëvizur të paktën kaq që nga njoftimi i fundit. Kur mungojnë të dhënat nuk shfaqet asgjë. Alarmet nuk ndikohen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avisering visas först när kursen har rört sig minst så här mycket sedan den förra. Inget visas när data saknas. Larm påverkas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนจะแสดงเมื่อราคาเปลี่ยนอย่างน้อยเท่านี้นับจากครั้งก่อนเท่านั้น จะไม่แสดงอะไรขณะไม่มีข้อมูล สัญญาณเตือนไม่ได้รับผลกระทบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim, fiyat bir öncekinden bu yana en az bu kadar değiştiğinde gösterilir. Veri eksikken hiçbir şey gösterilmez. Alarmlar etkilenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення з'являється лише тоді, коли ціна змінилася щонайменше на цю величину від попереднього. Поки даних немає, нічого не показується. На сигнали це не впливає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo chỉ xuất hiện khi giá đã thay đổi ít nhất mức này so với lần trước. Không hiển thị gì khi thiếu dữ liệu. Cảnh báo không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当价格自上次通知以来变动至少达到此幅度时才会通知。数据缺失时不显示任何内容。提醒不受影响。"
          }
        }
      }
    },
