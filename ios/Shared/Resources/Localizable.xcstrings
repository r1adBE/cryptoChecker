    "settings_tts_hint_silent" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ الأسعار والتنبيهات بصوت عالٍ. يبقى صامتًا ما دام الجهاز في وضع الصامت أو الاهتزاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čte ceny a alarmy nahlas. Mlčí, dokud je zařízení v tichém režimu nebo na vibracích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser kurser og alarmer højt. Forbliver tavs, mens enheden er på lydløs eller vibration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest Kurse und Alarme vor. Schweigt, solange das Gerät lautlos oder auf Vibration gestellt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκφωνεί τιμές και συναγερμούς. Παραμένει σιωπηλό όσο η συσκευή είναι σε αθόρυβη λειτουργία ή δόνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads prices and alerts aloud. Stays quiet while the device is in silent or vibrate mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee en voz alta precios y alarmas. Permanece en silencio mientras el dispositivo está en modo silencio o vibración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌ها و هشدارها را با صدای بلند می‌خواند. تا وقتی دستگاه در حالت بی‌صدا یا لرزش است، ساکت می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukee hinnat ja hälytykset ääneen. Pysyy hiljaa, kun laite on äänettömällä tai värinätilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les prix et les alertes à voix haute. Reste silencieux tant que l'appareil est en mode silencieux ou vibreur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקריא מחירים והתראות בקול. שותק כל עוד המכשיר במצב שקט או רטט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमतें और अलार्म बोलकर सुनाता है। जब तक डिवाइस साइलेंट या वाइब्रेट मोड में है, चुप रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felolvassa az árakat és a riasztásokat. Néma marad, amíg a készülék néma vagy rezgő módban van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membacakan harga dan alarm. Tetap diam selama perangkat dalam mode senyap atau getar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge ad alta voce prezzi e allarmi. Resta in silenzio finché il dispositivo è in modalità silenziosa o vibrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格とアラームを読み上げます。端末が消音モードまたはバイブレーションモードの間は読み上げません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격과 경보를 소리 내어 읽어줍니다. 기기가 무음 또는 진동 모드일 때는 읽지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leser opp kurser og alarmer. Er stille så lenge enheten står på lydløs eller vibrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest koersen en alarmen voor. Blijft stil zolang het apparaat op stil of trillen staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje na głos ceny i alarmy. Milczy, gdy urządzenie jest w trybie cichym lub wibracji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê em voz alta preços e alarmes. Fica em silêncio enquanto o dispositivo estiver em modo silencioso ou de vibração."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê em voz alta preços e alarmes. Fica em silêncio enquanto o dispositivo estiver no modo silencioso ou de vibração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citește cu voce tare prețurile și alarmele. Tace cât timp dispozitivul este în modul silențios sau pe vibrații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зачитывает цены и оповещения вслух. Молчит, пока устройство в беззвучном режиме или режиме вибрации."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lexon me zë çmimet dhe alarmet. Hesht sa kohë që pajisja është në modalitetin e heshtur ose me dridhje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser upp kurser och larm. Är tyst så länge enheten är på ljudlöst eller vibration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านราคาและสัญญาณเตือนออกเสียง และจะเงียบขณะที่อุปกรณ์อยู่ในโหมดปิดเสียงหรือโหมดสั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatları ve alarmları sesli okur. Cihaz sessiz veya titreşim modundayken sessiz kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зачитує ціни й сигнали вголос. Мовчить, поки пристрій у беззвучному режимі або режимі вібрації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc to giá và cảnh báo. Giữ im lặng khi thiết bị ở chế độ im lặng hoặc rung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朗读价格和提醒。设备处于静音或振动模式时保持安静。"
          }
        }
      }
    },
