    "settings_zone_alerts_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفحص مرتين يوميًا وينبّه عندما يغيّر البيتكوين منطقته، مثلًا من محايد إلى Bull."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroluje dvakrát denně a upozorní, když bitcoin změní zónu, např. z Neutrální na Bull."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjekker to gange dagligt og giver besked, når Bitcoin skifter zone, fx fra Neutral til Bull."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft zweimal täglich und meldet, wenn Bitcoin die Zone wechselt, z. B. von Neutral zu Bull."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχει δύο φορές την ημέρα και ειδοποιεί όταν το Bitcoin αλλάζει ζώνη, π.χ. από Ουδέτερο σε Bull."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks twice a day and notifies when Bitcoin changes zone, e.g. from Neutral to Bull."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba dos veces al día y avisa cuando Bitcoin cambia de zona, p. ej. de Neutral a Bull."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزی دو بار بررسی می‌کند و وقتی بیت‌کوین منطقه‌اش را عوض کند خبر می‌دهد، مثلاً از خنثی به Bull."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistaa kahdesti päivässä ja ilmoittaa, kun Bitcoin vaihtaa vyöhykettä, esim. Neutraalista Bulliksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie deux fois par jour et prévient quand le Bitcoin change de zone, p. ex. de Neutre à Bull."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בודק פעמיים ביום ומודיע כשביטקוין מחליף אזור, למשל מניטרלי ל-Bull."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन में दो बार जाँचता है और बिटकॉइन के ज़ोन बदलने पर सूचित करता है, जैसे तटस्थ से Bull।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naponta kétszer ellenőriz, és értesít, ha a Bitcoin zónát vált, pl. Semlegesről Bullra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memeriksa dua kali sehari dan memberi tahu saat Bitcoin berpindah zona, mis. dari Netral ke Bull."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla due volte al giorno e avvisa quando Bitcoin cambia zona, ad es. da Neutrale a Bull."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日2回確認し、ビットコインのゾーンが変わると通知します（例: 中立 → Bull）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 두 번 확인하고 비트코인 구간이 바뀌면 알립니다 (예: 중립 → Bull)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekker to ganger daglig og varsler når Bitcoin bytter sone, f.eks. fra Nøytral til Bull."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert twee keer per dag en meldt wanneer Bitcoin van zone wisselt, bijv. van Neutraal naar Bull."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza dwa razy dziennie i powiadamia, gdy Bitcoin zmieni strefę, np. z Neutralnej na Bull."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica duas vezes por dia e avisa quando a Bitcoin muda de zona, p. ex. de Neutro para Bull."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica duas vezes por dia e avisa quando o Bitcoin muda de zona, por ex. de Neutral para Bull."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică de două ori pe zi și anunță când Bitcoin schimbă zona, de ex. din Neutru în Bull."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет дважды в день и сообщает, когда биткоин меняет зону, например с Нейтральной на Bull."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollon dy herë në ditë dhe njofton kur Bitcoin ndryshon zonë, p.sh. nga Neutral në Bull."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar två gånger om dagen och meddelar när Bitcoin byter zon, t.ex. från Neutral till Bull."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจวันละสองครั้งและแจ้งเมื่อบิตคอยน์เปลี่ยนโซน เช่น จากเป็นกลางเป็น Bull"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde iki kez kontrol eder ve Bitcoin bölge değiştirdiğinde bildirir, ör. Nötr'den Bull'a."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
