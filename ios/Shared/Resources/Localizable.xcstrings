          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare gli allarmi: i dati salvati non sono leggibili al momento. Riavvia l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームを保存できません：保存済みのデータを今は読み取れません。アプリを再起動してください。"
