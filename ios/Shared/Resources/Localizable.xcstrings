          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar adresa publică este trimisă la %1$@ – niciodată chei sau fraze seed. Furnizorul o vede împreună cu adresa ta IP. Verificată cel mult o dată la 10 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
