    "alarm_timing_hint_android" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون «%1$@» يفحص Android بشكل غير منتظم عندما يكون الجهاز في وضع السكون – أحيانًا بعد ساعات. ومعه كل 15 دقيقة تقريبًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez „%1$@“ kontroluje Android v klidu zařízení nepravidelně – někdy až po hodinách. S ním zhruba každých 15 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden «%1$@» tjekker Android uregelmæssigt, når enheden hviler – nogle gange først efter timer. Med den ca. hvert 15. minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne «%1$@» prüft Android bei ruhendem Gerät unregelmässig, manchmal erst nach Stunden. Damit etwa alle 15 Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς «%1$@», το Android ελέγχει ακανόνιστα όταν η συσκευή ηρεμεί – μερικές φορές μετά από ώρες. Με αυτό, περίπου κάθε 15 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without “%1$@”, Android checks irregularly while the device rests – sometimes only after hours. With it, about every 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin «%1$@», Android comprueba de forma irregular con el dispositivo en reposo, a veces tras horas. Con ella, cada 15 minutos aprox."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون «%1$@»، Android وقتی دستگاه در حالت استراحت است نامنظم بررسی می‌کند – گاهی پس از چند ساعت. با آن، حدود هر 15 دقیقه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman asetusta ”%1$@” Android tarkistaa laitteen levätessä epäsäännöllisesti, joskus vasta tuntien päästä. Sen kanssa noin 15 min välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans « %1$@ », Android vérifie irrégulièrement quand l’appareil est en veille, parfois après des heures. Avec, environ toutes les 15 min."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי «%1$@», Android בודק באופן לא סדיר כשהמכשיר במנוחה – לפעמים רק אחרי שעות. עם ההגדרה, בערך כל 15 דקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” के बिना, डिवाइस निष्क्रिय होने पर Android अनियमित रूप से जाँचता है – कभी-कभी घंटों बाद। इसके साथ लगभग हर 15 मिनट।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” nélkül az Android nyugvó eszközön rendszertelenül ellenőriz, néha csak órák múlva. Vele kb. 15 percenként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa “%1$@”, Android memeriksa tidak teratur saat perangkat diam – terkadang baru setelah berjam-jam. Dengan itu, kira-kira tiap 15 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza «%1$@», a dispositivo inattivo Android controlla in modo irregolare, a volte solo dopo ore. Con essa, circa ogni 15 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」がオフだと、端末の休止中は Android の確認が不定期になり、数時間後になることもあります。オンなら約15分ごとです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”이 꺼져 있으면 기기가 쉬는 동안 Android는 불규칙하게 확인하며, 몇 시간 뒤에야 확인하기도 합니다. 켜면 약 15분마다 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten «%1$@» sjekker Android uregelmessig når enheten hviler – noen ganger først etter timer. Med den omtrent hvert 15. minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder «%1$@» controleert Android onregelmatig als het toestel rust – soms pas na uren. Met deze optie ongeveer elke 15 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez „%1$@” Android sprawdza nieregularnie, gdy urządzenie odpoczywa – czasem dopiero po godzinach. Z nią mniej więcej co 15 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem «%1$@», o Android verifica de forma irregular com o dispositivo em repouso, por vezes só após horas. Com ela, cerca de 15 em 15 min."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem “%1$@”, o Android verifica de forma irregular com o aparelho em repouso, às vezes só após horas. Com ela, a cada 15 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără „%1$@”, Android verifică neregulat când dispozitivul stă în repaus – uneori abia după ore. Cu ea, cam la fiecare 15 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без «%1$@» Android проверяет нерегулярно, пока устройство в покое, – иногда лишь через несколько часов. С ней – примерно каждые 15 минут."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa «%1$@», Android kontrollon parregullisht kur pajisja pushon – ndonjëherë vetëm pas orësh. Me të, afërsisht çdo 15 minuta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan ”%1$@” kontrollerar Android oregelbundet när enheten vilar – ibland först efter timmar. Med den ungefär var 15:e minut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่เปิด “%1$@” Android จะตรวจไม่สม่ำเสมอขณะเครื่องพัก บางครั้งหลายชั่วโมงต่อครั้ง หากเปิดจะตรวจประมาณทุก 15 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” kapalıyken Android, cihaz dinlenirken düzensiz kontrol eder – bazen ancak saatler sonra. Açıkken yaklaşık 15 dakikada bir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без «%1$@» Android перевіряє нерегулярно, коли пристрій у спокої, – іноді лише через кілька годин. З ним – приблизно кожні 15 хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt “%1$@”, Android kiểm tra không đều lúc thiết bị nghỉ – đôi khi sau nhiều giờ. Khi bật, khoảng mỗi 15 phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未开启「%1$@」时，设备静置期间 Android 的检查不规律，有时要隔几小时。开启后约每 15 分钟检查一次。"
          }
        }
      }
    },
    "alarm_timing_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إغلاق التطبيق يفحص iOS غالبًا بعد أكثر من 15 دقيقة، وأحيانًا فقط عند فتحه التالي. قد تفوتك القفزات القصيرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zavřené aplikaci kontroluje iOS často později než po 15 minutách, někdy až při dalším otevření. Krátké výkyvy mohou uniknout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når appen er lukket, tjekker iOS ofte senere end 15 minutter, nogle gange først når du åbner appen igen. Korte udsving kan blive overset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei geschlossener App prüft iOS oft später als 15 Minuten, manchmal erst beim nächsten Öffnen. Kurze Spitzen können fehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με κλειστή εφαρμογή, το iOS συχνά ελέγχει αργότερα από 15 λεπτά, μερικές φορές μόνο στο επόμενο άνοιγμα. Σύντομες αιχμές μπορεί να χαθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the app closed, iOS often checks later than 15 minutes, sometimes only when you next open the app. Short spikes can be missed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la app cerrada, iOS suele comprobar tras más de 15 minutos, a veces solo al volver a abrirla. Pueden escaparse picos breves."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی برنامه بسته است، iOS اغلب دیرتر از 15 دقیقه بررسی می‌کند، گاهی فقط در باز کردن بعدی. جهش‌های کوتاه ممکن است از دست بروند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus suljettuna iOS tarkistaa usein yli 15 minuutin välein, joskus vasta seuraavalla avauskerralla. Lyhyet piikit voivat jäädä huomaamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App fermée, iOS vérifie souvent après plus de 15 minutes, parfois seulement à la prochaine ouverture. De brefs pics peuvent passer inaperçus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפליקציה סגורה, iOS בודק לעיתים קרובות אחרי יותר מ-15 דקות, לפעמים רק בפתיחה הבאה. קפיצות קצרות עלולות להתפספס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बंद होने पर iOS अक्सर 15 मिनट से देर से जाँचता है, कभी-कभी अगली बार ऐप खोलने पर ही। छोटे उछाल छूट सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezárt alkalmazásnál az iOS gyakran 15 percnél később ellenőriz, néha csak a következő megnyitáskor. Rövid kiugrások kimaradhatnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat aplikasi ditutup, iOS sering memeriksa lebih lambat dari 15 menit, kadang baru saat aplikasi dibuka lagi. Lonjakan singkat bisa terlewat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l’app chiusa, iOS controlla spesso dopo più di 15 minuti, a volte solo alla successiva apertura. Brevi picchi possono sfuggire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを閉じていると iOS の確認は15分より遅れることが多く、次に開くまで行われないこともあります。短い急変を見逃すことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 닫으면 iOS는 15분보다 늦게 확인할 때가 많고, 다음에 앱을 열 때에야 확인하기도 합니다. 짧은 급등락을 놓칠 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når appen er lukket, sjekker iOS ofte senere enn 15 minutter, noen ganger først neste gang du åpner appen. Korte topper kan bli oversett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de app gesloten controleert iOS vaak later dan na 15 minuten, soms pas bij de volgende keer openen. Korte pieken kunnen worden gemist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy zamkniętej aplikacji iOS często sprawdza później niż po 15 minutach, czasem dopiero przy następnym otwarciu. Krótkie skoki mogą umknąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a app fechada, o iOS verifica muitas vezes após mais de 15 minutos, por vezes só quando a voltares a abrir. Picos curtos podem escapar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o app fechado, o iOS muitas vezes verifica após mais de 15 minutos, às vezes só quando você abre o app de novo. Picos curtos podem passar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu aplicația închisă, iOS verifică adesea mai târziu de 15 minute, uneori abia la următoarea deschidere. Salturile scurte pot fi ratate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При закрытом приложении iOS часто проверяет позже чем через 15 минут, иногда только при следующем открытии. Короткие скачки можно пропустить."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me aplikacionin të mbyllur, iOS shpesh kontrollon më vonë se 15 minuta, ndonjëherë vetëm kur e hap herën tjetër. Kulmet e shkurtra mund të humbasin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När appen är stängd kontrollerar iOS ofta senare än efter 15 minuter, ibland först när du öppnar appen nästa gång. Korta toppar kan missas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิดแอป iOS มักตรวจช้ากว่า 15 นาที บางครั้งจนกว่าจะเปิดแอปครั้งถัดไป อาจพลาดการพุ่งขึ้นลงช่วงสั้น ๆ"
