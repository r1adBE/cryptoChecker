        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de détail : cette version n'a pas encore terminé d'actualisation complète. Touchez Actualiser et attendez que l'indicateur s'arrête."
          }
        },
        "he" : {
          "stringUnit" : {
