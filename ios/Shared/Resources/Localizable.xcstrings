        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comisión de retirada en USDT o efectivo no es pérdida: en efectivo no es deducible, en USDT es una enajenación a la par sin ganancia – figura solo como información (%1$@)."
