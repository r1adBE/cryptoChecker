    "settings_portfolio_system_backup_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: لا تُضمَّن معاملاتك في نسخ النظام الاحتياطي للجهاز ولا في النقل من هاتف إلى هاتف. لنقلها إلى هاتف جديد، استخدم النسخة الاحتياطية الخاصة بالتطبيق مع كلمة مرور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto: transakce nebudou v systémové záloze zařízení ani při přenosu do nového telefonu. Pro přesun do nového telefonu použij zálohu aplikace s heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra: Dine transaktioner kommer ikke med i enhedens systembackup eller ved overførsel til en ny telefon. Brug appens egen sikkerhedskopi med adgangskode til at flytte dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Deine Transaktionen kommen nicht in die Systemsicherung des Geräts und nicht in die Übertragung auf ein neues Gerät. Zum Umziehen die eigene Sicherung der App mit Passwort verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό: οι συναλλαγές σου δεν περιλαμβάνονται στο αντίγραφο ασφαλείας συστήματος της συσκευής ούτε στη μεταφορά σε νέο τηλέφωνο. Για μεταφορά, χρησιμοποίησε το αντίγραφο ασφαλείας της εφαρμογής με κωδικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: your transactions stay out of the device’s system backup and phone-to-phone transfers. To move them to a new phone, use the app’s own backup with a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: tus transacciones no se incluyen en la copia del sistema del dispositivo ni en la transferencia a un teléfono nuevo. Para trasladarlas, usa la copia de seguridad de la app con contraseña."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموش: تراکنش‌هایت در پشتیبان سیستم دستگاه و انتقال به گوشی جدید قرار نمی‌گیرند. برای انتقال، از پشتیبان خود برنامه با گذرواژه استفاده کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois: tapahtumasi eivät tule laitteen järjestelmän varmuuskopioon eivätkä siirtoon uuteen puhelimeen. Siirrä ne sovelluksen omalla salasanalla suojatulla varmuuskopiolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : tes transactions ne figurent ni dans la sauvegarde système de l’appareil ni dans le transfert vers un nouveau téléphone. Pour les déplacer, utilise la sauvegarde de l’app protégée par mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי: העסקאות שלך לא נכללות בגיבוי המערכת של המכשיר ולא בהעברה לטלפון חדש. כדי להעביר אותן, השתמשו בגיבוי של האפליקציה עם סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: तुम्हारे लेन-देन डिवाइस के सिस्टम बैकअप और नए फ़ोन में ट्रांसफ़र में शामिल नहीं होते। उन्हें नए फ़ोन पर ले जाने के लिए ऐप का अपना पासवर्ड वाला बैकअप इस्तेमाल करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki: a tranzakciók nem kerülnek bele az eszköz rendszermentésébe és az új telefonra való átvitelbe. Átköltöztetéshez használd az alkalmazás saját, jelszóval védett mentését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif: transaksimu tidak disertakan dalam cadangan sistem perangkat maupun transfer ke ponsel baru. Untuk memindahkannya, gunakan cadangan aplikasi dengan kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: le tue transazioni non sono incluse nel backup di sistema del dispositivo né nel trasferimento a un nuovo telefono. Per spostarle, usa il backup dell’app con password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：取引は端末のシステムバックアップや新しい端末への移行に含まれません。移行するには、パスワード付きのアプリのバックアップを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: 거래 내역이 기기의 시스템 백업과 새 휴대폰으로의 이전에 포함되지 않습니다. 옮기려면 비밀번호를 설정한 앱 자체 백업을 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: Transaksjonene dine tas ikke med i enhetens systemsikkerhetskopi eller ved overføring til en ny telefon. Bruk appens egen sikkerhetskopi med passord for å flytte dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: je transacties zitten niet in de systeemback-up van het apparaat en niet in de overdracht naar een nieuwe telefoon. Gebruik de eigen back-up van de app met wachtwoord om ze te verhuizen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: transakcje nie trafiają do kopii systemowej urządzenia ani do przenoszenia na nowy telefon. Aby je przenieść, użyj kopii zapasowej aplikacji z hasłem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: as tuas transações não são incluídas na cópia do sistema do dispositivo nem na transferência para um novo telemóvel. Para as mudar, usa a cópia de segurança da app com palavra-passe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: suas transações não entram no backup do sistema do dispositivo nem na transferência para um novo celular. Para levá-las, use o backup do próprio app com senha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivat: tranzacțiile tale nu sunt incluse în copia de sistem a dispozitivului și nici în transferul pe un telefon nou. Pentru a le muta, folosește copia de rezervă a aplicației cu parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: твои сделки не попадают в системную резервную копию устройства и при переносе на новый телефон. Чтобы перенести их, используй резервную копию приложения с паролем."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joaktiv: transaksionet e tua nuk përfshihen në kopjen e sistemit të pajisjes as në transferimin në një telefon të ri. Për t’i zhvendosur, përdor kopjen rezervë të aplikacionit me fjalëkalim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: Dina transaktioner ingår inte i enhetens systemsäkerhetskopia eller vid överföring till en ny telefon. Använd appens egen säkerhetskopia med lösenord för att flytta dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด: รายการซื้อขายของคุณจะไม่อยู่ในการสำรองของระบบและการย้ายไปยังโทรศัพท์เครื่องใหม่ หากต้องการย้าย ให้ใช้ไฟล์สำรองของแอปที่ตั้งรหัสผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: işlemlerin cihazın sistem yedeğine ve yeni telefona aktarıma dahil edilmez. Taşımak için uygulamanın parolalı kendi yedeğini kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимк.: твої угоди не потрапляють до системної резервної копії пристрою та під час перенесення на новий телефон. Щоб перенести їх, використовуй резервну копію застосунку з паролем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt: giao dịch của bạn không nằm trong bản sao lưu hệ thống của thiết bị và khi chuyển sang điện thoại mới. Để chuyển, hãy dùng bản sao lưu của ứng dụng có mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：你的交易不会包含在设备的系统备份和换机迁移中。如需迁移，请使用应用自带的密码保护备份。"
          }
        }
      }
    },
    "settings_portfolio_system_backup_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف: لا تدخل معاملاتك في نسخ iCloud أو الكمبيوتر الاحتياطية. تشغيل: لا يمكن استعادتها إلا على هذا الـiPhone – على iPhone جديد يبقى الملف غير قابل للقراءة لأن المفتاح لا يغادر الجهاز أبدًا. للانتقال إلى هاتف جديد استخدم نسخة التطبيق الاحتياطية بكلمة مرور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyp.: transakce nejsou součástí záloh iCloud ani počítače. Zap.: lze je obnovit jen na tomto iPhonu – na novém iPhonu zůstane soubor nečitelný, protože klíč nikdy neopustí zařízení. Při přechodu na nový telefon použij zálohu aplikace s heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra: Dine transaktioner kommer ikke med i iCloud- eller computersikkerhedskopier. Til: De kan kun gendannes på denne iPhone – på en ny iPhone forbliver filen ulæselig, fordi nøglen aldrig forlader enheden. Brug appens egen sikkerhedskopi med adgangskode, når du skifter telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Deine Transaktionen kommen nicht in die iCloud- oder Computer-Sicherung. Ein: Sie lassen sich nur auf diesem iPhone wiederherstellen – auf einem neuen iPhone bleibt die Datei unlesbar, weil der Schlüssel das Gerät nie verlässt. Zum Umziehen die eigene Sicherung der App mit Passwort verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό: οι συναλλαγές σου δεν μπαίνουν στα αντίγραφα iCloud ή υπολογιστή. Ενεργό: επαναφέρονται μόνο σε αυτό το iPhone – σε νέο iPhone το αρχείο μένει μη αναγνώσιμο, γιατί το κλειδί δεν φεύγει ποτέ από τη συσκευή. Για αλλαγή τηλεφώνου χρησιμοποίησε το αντίγραφο της εφαρμογής με κωδικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: your transactions are not included in iCloud or computer backups. On: they can only be restored on this iPhone – on a new iPhone the file stays unreadable because the key never leaves the device. To move to a new phone, use the app's own backup with a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: tus transacciones no se incluyen en las copias de iCloud ni del ordenador. Activado: solo se pueden restaurar en este iPhone; en un iPhone nuevo el archivo sigue ilegible porque la clave nunca sale del dispositivo. Para cambiar de teléfono, usa la copia de la app con contraseña."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموش: تراکنش‌هایت در پشتیبان iCloud یا رایانه قرار نمی‌گیرند. روشن: فقط روی همین iPhone قابل بازیابی‌اند – روی iPhone جدید فایل خوانا نیست، چون کلید هرگز دستگاه را ترک نمی‌کند. برای تعویض گوشی از پشتیبان رمزدار خود برنامه استفاده کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois: tapahtumasi eivät tule iCloud- tai tietokonevarmuuskopioihin. Päällä: ne voi palauttaa vain tähän iPhoneen – uudessa iPhonessa tiedosto pysyy lukukelvottomana, koska avain ei koskaan poistu laitteesta. Käytä puhelinta vaihtaessa sovelluksen omaa salasanalla suojattua varmuuskopiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : tes transactions ne figurent pas dans les sauvegardes iCloud ou ordinateur. Activé : elles ne peuvent être restaurées que sur cet iPhone – sur un nouvel iPhone, le fichier reste illisible car la clé ne quitte jamais l'appareil. Pour changer de téléphone, utilise la sauvegarde de l'app avec mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי: העסקאות שלך לא נכללות בגיבויי iCloud או המחשב. פועל: אפשר לשחזר אותן רק ב-iPhone הזה – ב-iPhone חדש הקובץ יישאר בלתי קריא, כי המפתח לעולם לא עוזב את המכשיר. כדי לעבור לטלפון חדש השתמשו בגיבוי של האפליקציה עם סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: तुम्हारे लेन-देन iCloud या कंप्यूटर बैकअप में नहीं जाते। चालू: इन्हें केवल इसी iPhone पर बहाल किया जा सकता है – नए iPhone पर फ़ाइल पढ़ी नहीं जा सकती, क्योंकि कुंजी कभी डिवाइस नहीं छोड़ती। फ़ोन बदलने के लिए ऐप का पासवर्ड वाला बैकअप इस्तेमाल करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki: a tranzakciók nem kerülnek az iCloud- vagy számítógépes mentésbe. Be: csak ezen az iPhone-on állíthatók vissza – új iPhone-on a fájl olvashatatlan marad, mert a kulcs sosem hagyja el az eszközt. Telefonváltáshoz használd az alkalmazás jelszavas mentését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mati: transaksimu tidak masuk ke cadangan iCloud atau komputer. Nyala: hanya bisa dipulihkan di iPhone ini – di iPhone baru file tetap tidak terbaca karena kunci tidak pernah meninggalkan perangkat. Untuk pindah ponsel, gunakan cadangan aplikasi dengan kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: le transazioni non finiscono nei backup iCloud o del computer. Attivato: si possono ripristinare solo su questo iPhone – su un nuovo iPhone il file resta illeggibile perché la chiave non lascia mai il dispositivo. Per cambiare telefono usa il backup dell'app con password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：取引は iCloud やコンピュータのバックアップに含まれません。オン：この iPhone にのみ復元できます。鍵が端末から出ることはないため、新しい iPhone ではファイルを読めません。機種変更にはアプリのパスワード付きバックアップを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: 거래 내역이 iCloud나 컴퓨터 백업에 포함되지 않습니다. 켬: 이 iPhone에서만 복원할 수 있습니다. 키가 기기를 떠나지 않으므로 새 iPhone에서는 파일을 읽을 수 없습니다. 휴대폰을 바꿀 때는 앱의 암호 백업을 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: transaksjonene dine kommer ikke med i iCloud- eller datamaskinsikkerhetskopier. På: de kan bare gjenopprettes på denne iPhonen – på en ny iPhone forblir filen uleselig fordi nøkkelen aldri forlater enheten. Bruk appens egen sikkerhetskopi med passord når du bytter telefon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: je transacties komen niet in iCloud- of computerback-ups. Aan: ze zijn alleen op deze iPhone terug te zetten – op een nieuwe iPhone blijft het bestand onleesbaar, omdat de sleutel het apparaat nooit verlaat. Gebruik voor een nieuwe telefoon de eigen back-up van de app met wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wył.: transakcje nie trafiają do kopii iCloud ani komputera. Wł.: można je przywrócić tylko na tym iPhonie – na nowym iPhonie plik pozostaje nieczytelny, bo klucz nigdy nie opuszcza urządzenia. Przy zmianie telefonu użyj kopii zapasowej aplikacji z hasłem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: as transações não entram nas cópias do iCloud nem do computador. Ligado: só podem ser restauradas neste iPhone – num iPhone novo o ficheiro fica ilegível porque a chave nunca sai do dispositivo. Para mudar de telefone, usa a cópia da app com palavra-passe."
