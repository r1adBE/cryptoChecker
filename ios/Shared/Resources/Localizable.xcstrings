    "market_info_fear_greed_what" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مؤشر لمزاج سوق العملات المشفرة من 0 إلى 100. يحسبه موقع alternative.me من عدة بيانات، منها تقلبات الأسعار وحجم التداول ووسائل التواصل الاجتماعي وهيمنة Bitcoin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Index nálady na kryptotrhu od 0 do 100. alternative.me ho počítá z několika údajů, mimo jiné z cenových výkyvů, objemu obchodů, sociálních sítí a dominance Bitcoinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et stemningsindeks for kryptomarkedet fra 0 til 100. alternative.me beregner det ud fra flere data, blandt andet kursudsving, handelsvolumen, sociale medier og Bitcoin-dominans."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
