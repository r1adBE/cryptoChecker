    "market_info_fear_greed_how" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من 25 يعني خوفًا شديدًا، وأكثر من 75 طمعًا شديدًا، وحول 50 حيادًا. عند فتح البطاقة تظهر قيم الأمس وقبل أسبوع وقبل شهر. ليس إشارة شراء أو بيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod 25 znamená extrémní strach, nad 75 extrémní chamtivost, kolem 50 neutrální náladu. Po rozbalení jsou vidět hodnoty ze včerejška, před týdnem a před měsícem. Není to signál k nákupu ani prodeji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 25 betyder ekstrem frygt, over 75 ekstrem grådighed, omkring 50 neutral. Foldet ud står værdierne fra i går, for en uge siden og for en måned siden. Intet købs- eller salgssignal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 25 bedeutet extreme Angst, über 75 extreme Gier, um 50 neutral. Aufgeklappt stehen die Werte von gestern, vor einer Woche und vor einem Monat. Kein Kauf- oder Verkaufssignal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτω από 25 σημαίνει ακραίο φόβο, πάνω από 75 ακραία απληστία, γύρω στο 50 ουδέτερο. Ανοιχτή η κάρτα δείχνει τις τιμές της χθες, πριν από μία εβδομάδα και πριν από έναν μήνα. Δεν είναι σήμα αγοράς ή πώλησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below 25 means extreme fear, above 75 extreme greed, around 50 neutral. Expanded, the card shows the values from yesterday, a week ago and a month ago. Not a buy or sell signal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo de 25 indica miedo extremo, por encima de 75 codicia extrema, en torno a 50 neutral. Al desplegar la tarjeta se ven los valores de ayer, de hace una semana y de hace un mes. No es una señal de compra ni de venta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیر ۲۵ یعنی ترس شدید، بالای ۷۵ طمع شدید و حدود ۵۰ خنثی. با باز کردن کارت مقادیر دیروز، یک هفته پیش و یک ماه پیش دیده می‌شود. سیگنال خرید یا فروش نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 25 tarkoittaa äärimmäistä pelkoa, yli 75 äärimmäistä ahneutta, noin 50 neutraalia. Avattuna näkyvät eilisen, viikon takaisen ja kuukauden takaisen arvot. Ei osto- eikä myyntisignaali."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dessous de 25 : peur extrême, au-dessus de 75 : avidité extrême, autour de 50 : neutre. La carte dépliée montre les valeurs d'hier, d'il y a une semaine et d'il y a un mois. Ce n'est pas un signal d'achat ou de vente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחת ל־25 פירושו פחד קיצוני, מעל 75 תאוות בצע קיצונית, סביב 50 ניטרלי. בכרטיס הפתוח מופיעים הערכים של אתמול, לפני שבוע ולפני חודש. זה לא אות קנייה או מכירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 से नीचे अत्यधिक डर, 75 से ऊपर अत्यधिक लालच और 50 के आसपास तटस्थ। कार्ड खोलने पर कल, एक हफ़्ते पहले और एक महीने पहले के मान दिखते हैं। यह खरीदने या बेचने का संकेत नहीं है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 alatt extrém félelmet, 75 felett extrém kapzsiságot, 50 körül semleges hangulatot jelent. Kinyitva látszanak a tegnapi, egy héttel és egy hónappal korábbi értékek. Nem vételi vagy eladási jelzés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di bawah 25 berarti ketakutan ekstrem, di atas 75 keserakahan ekstrem, sekitar 50 netral. Saat kartu dibuka, terlihat nilai kemarin, seminggu lalu, dan sebulan lalu. Bukan sinyal beli atau jual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 25 indica paura estrema, sopra 75 avidità estrema, intorno a 50 neutrale. Aprendo la scheda si vedono i valori di ieri, di una settimana fa e di un mese fa. Non è un segnale di acquisto o di vendita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25未満は極度の恐怖、75超は極度の強欲、50前後は中立です。カードを開くと、昨日・1週間前・1か月前の値が表示されます。売買のシグナルではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 미만은 극도의 공포, 75 초과는 극도의 탐욕, 50 안팎은 중립입니다. 카드를 펼치면 어제, 일주일 전, 한 달 전 값이 나옵니다. 매수나 매도 신호가 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 25 betyr ekstrem frykt, over 75 ekstrem grådighet, rundt 50 nøytral. Utvidet står verdiene fra i går, for en uke siden og for en måned siden. Ikke et kjøps- eller salgssignal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder 25 betekent extreme angst, boven 75 extreme hebzucht, rond 50 neutraal. Uitgeklapt staan de waarden van gisteren, een week geleden en een maand geleden. Geen koop- of verkoopsignaal."
