    "tax_export_day_close_rule" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم السوقية دون سعر مسجّل (الرسوم، الإهداء/الدفع، المبادلة، المكافآت، رسوم الشبكة، قيمة المحفظة) بسعر الإغلاق اليومي (UTC) ليوم المعاملة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tržní hodnoty bez zadané ceny (poplatky, darováno/zaplaceno, směna, odměny, síťové poplatky, hodnota portfolia) podle denního závěrečného kurzu (UTC) dne transakce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedsværdier uden registreret pris (gebyrer, givet væk/betalt, bytte, belønninger, netværksgebyrer, porteføljeværdi) til dagens lukkekurs (UTC) på transaktionsdagen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marktwerte ohne erfassten Preis (Gebühren, Verschenkt/bezahlt, Tausch, Belohnungen, Netzwerkgebühren, Gesamtwert) zum Tagesschluss (UTC) des Transaktionstags"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγοραίες αξίες χωρίς καταχωρημένη τιμή (χρεώσεις, δωρεά/πληρωμή, ανταλλαγή, ανταμοιβές, χρεώσεις δικτύου, αξία χαρτοφυλακίου) στο ημερήσιο κλείσιμο (UTC) της ημέρας της συναλλαγής"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Market values without a recorded price (fees, gifts/payments, swaps, rewards, network fees, portfolio value) at the daily close (UTC) of the transaction day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de mercado sin precio registrado (comisiones, regalado/pagado, intercambio, recompensas, comisiones de red, valor de la cartera) al cierre diario (UTC) del día de la transacción"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارزش‌های بازار بدون قیمت ثبت‌شده (کارمزدها، هدیه/پرداخت، مبادله، پاداش‌ها، کارمزد شبکه، ارزش سبد) با قیمت بسته‌شدن روزانه (UTC) روز تراکنش"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markkina-arvot ilman kirjattua hintaa (kulut, lahjoitettu/maksettu, vaihto, palkkiot, verkkomaksut, salkun arvo) tapahtumapäivän päätöskurssiin (UTC)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeurs de marché sans prix saisi (frais, donné/payé, échange, récompenses, frais de réseau, valeur du portefeuille) à la clôture journalière (UTC) du jour de la transaction"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שווי שוק ללא מחיר רשום (עמלות, ניתן במתנה/שולם, החלפה, תגמולים, עמלות רשת, שווי התיק) לפי מחיר הסגירה היומי (UTC) של יום העסקה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्ज कीमत के बिना बाज़ार मूल्य (शुल्क, उपहार/भुगतान, स्वैप, रिवॉर्ड, नेटवर्क शुल्क, पोर्टफ़ोलियो मूल्य) लेन-देन के दिन के दैनिक क्लोज़ (UTC) पर"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzített ár nélküli piaci értékek (díjak, elajándékozva/fizetve, csere, jutalmak, hálózati díjak, portfólióérték) a tranzakció napjának napi záróárán (UTC)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai pasar tanpa harga tercatat (biaya, diberikan/dibayar, tukar, imbalan, biaya jaringan, nilai portofolio) pada harga penutupan harian (UTC) hari transaksi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori di mercato senza prezzo registrato (commissioni, regalato/pagato, scambio, ricompense, commissioni di rete, valore del portafoglio) alla chiusura giornaliera (UTC) del giorno della transazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格の記録がない時価（手数料、贈与/支払い、交換、報酬、ネットワーク手数料、ポートフォリオ総額）は取引日の終値（UTC）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록된 가격이 없는 시장 가치(수수료, 증여/결제, 교환, 보상, 네트워크 수수료, 포트폴리오 가치)는 거래일의 일일 종가(UTC) 기준"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedsverdier uten registrert pris (gebyrer, gitt bort/betalt, bytte, belønninger, nettverksgebyrer, porteføljeverdi) til dagens sluttkurs (UTC) på transaksjonsdagen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marktwaarden zonder ingevoerde prijs (kosten, weggegeven/betaald, ruil, beloningen, netwerkkosten, portefeuillewaarde) tegen de dagslotkoers (UTC) van de transactiedag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości rynkowe bez wpisanej ceny (opłaty, podarowane/zapłacone, zamiana, nagrody, opłaty sieciowe, wartość portfela) według dziennego kursu zamknięcia (UTC) z dnia transakcji"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de mercado sem preço registado (comissões, oferecido/pago, troca, recompensas, comissões de rede, valor da carteira) ao fecho diário (UTC) do dia da transação"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de mercado sem preço registrado (taxas, doado/pago, troca, recompensas, taxas de rede, valor da carteira) pelo fechamento diário (UTC) do dia da transação"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori de piață fără preț înregistrat (comisioane, dăruit/plătit, schimb, recompense, comisioane de rețea, valoarea portofoliului) la închiderea zilnică (UTC) a zilei tranzacției"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рыночная стоимость без указанной цены (комиссии, подарено/оплачено, обмен, вознаграждения, сетевые комиссии, стоимость портфеля) по дневной цене закрытия (UTC) дня операции"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlerat e tregut pa çmim të regjistruar (tarifat, dhuruar/paguar, shkëmbim, shpërblime, tarifat e rrjetit, vlera e portofolit) me mbylljen ditore (UTC) të ditës së transaksionit"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marknadsvärden utan registrerat pris (avgifter, bortskänkt/betalt, byte, belöningar, nätverksavgifter, portföljvärde) till dagens stängningskurs (UTC) på transaktionsdagen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มูลค่าตลาดที่ไม่มีราคาบันทึก (ค่าธรรมเนียม, ให้/ชำระ, แลกเปลี่ยน, รางวัล, ค่าธรรมเนียมเครือข่าย, มูลค่าพอร์ต) ใช้ราคาปิดรายวัน (UTC) ของวันที่ทำรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatı girilmemiş piyasa değerleri (ücretler, hediye/ödeme, takas, ödüller, ağ ücretleri, portföy değeri) işlem gününün günlük kapanışından (UTC)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ринкова вартість без указаної ціни (комісії, подаровано/сплачено, обмін, винагороди, мережеві комісії, вартість портфеля) за денною ціною закриття (UTC) дня операції"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị thị trường không có giá đã ghi (phí, tặng/thanh toán, hoán đổi, phần thưởng, phí mạng, giá trị danh mục) theo giá đóng cửa ngày (UTC) của ngày giao dịch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有记录价格的市值（手续费、赠送/支付、兑换、奖励、网络手续费、组合总值）按交易当日（UTC）收盘价计"
          }
        }
      }
