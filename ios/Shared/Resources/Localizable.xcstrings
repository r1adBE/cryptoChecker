    "portfolio_alarm_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفحص بعد كل تحديث. مثل التنبيهات: ينبّه عند تجاوز الحد، ثم مجددًا فقط بعد عودة القيمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroluje se po každé aktualizaci. Jako alarmy: upozorní při překročení hranice a znovu až poté, co se hodnota vrátí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleres efter hver opdatering. Som alarmer: giver besked, når grænsen krydses, og først igen når værdien er vendt tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach jeder Aktualisierung geprüft. Wie bei Alarmen: meldet beim Überschreiten der Marke und erst wieder, wenn der Wert zurückgekehrt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχεται μετά από κάθε ανανέωση. Όπως οι συναγερμοί: ενεργοποιείται όταν περάσει το όριο και ξανά μόνο αφού η αξία επιστρέψει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checked after every refresh. Like alerts, it fires when the mark is crossed and only again after the value has moved back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprueba tras cada actualización. Como las alarmas: avisa al cruzar el umbral y de nuevo solo cuando el valor haya vuelto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از هر به‌روزرسانی بررسی می‌شود. مانند هشدارها: هنگام عبور از حد خبر می‌دهد و دوباره فقط پس از بازگشت ارزش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistetaan jokaisen päivityksen jälkeen. Kuten hälytykset: ilmoittaa rajan ylittyessä ja uudelleen vasta, kun arvo on palannut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiée après chaque actualisation. Comme les alertes : se déclenche au franchissement du seuil, puis seulement après le retour de la valeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נבדק אחרי כל רענון. כמו התראות: מתריע בחציית הסף, ושוב רק אחרי שהערך חזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर रीफ़्रेश के बाद जाँचा जाता है। अलार्म की तरह: सीमा पार होने पर सूचना देता है और दोबारा तभी जब मूल्य लौट आए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden frissítés után ellenőrizzük. Mint a riasztások: a határ átlépésekor jelez, újra csak akkor, ha az érték visszatért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperiksa setelah setiap pembaruan. Seperti alarm: memberi tahu saat batas dilewati, dan lagi hanya setelah nilainya kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllato dopo ogni aggiornamento. Come gli allarmi: scatta al superamento della soglia e di nuovo solo dopo che il valore è tornato indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新のたびに確認します。アラームと同様、しきい値を超えたときに通知し、値が戻るまで再通知しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로고침할 때마다 확인합니다. 경보처럼 기준을 넘으면 알리고, 값이 되돌아온 뒤에만 다시 알립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekkes etter hver oppdatering. Som alarmer: varsler når grensen krysses, og først igjen når verdien har gått tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt na elke vernieuwing gecontroleerd. Net als alarmen: meldt bij het overschrijden van de grens en pas opnieuw als de waarde is teruggekeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzany po każdym odświeżeniu. Jak alarmy: powiadamia po przekroczeniu progu i ponownie dopiero, gdy wartość wróci za próg."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificado após cada atualização. Como os alarmes: avisa ao cruzar o limite e só volta a avisar depois de o valor ter regressado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificado após cada atualização. Como os alarmes: avisa ao cruzar o limite e só de novo depois que o valor voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificată după fiecare actualizare. Ca alarmele: anunță la depășirea pragului și din nou doar după ce valoarea a revenit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяется после каждого обновления. Как оповещения: срабатывает при пересечении порога и снова — только после возврата значения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollohet pas çdo rifreskimi. Si alarmet: njofton kur kalohet kufiri dhe përsëri vetëm pasi vlera të jetë kthyer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleras efter varje uppdatering. Som larm: meddelar när gränsen passeras och först igen när värdet har gått tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบหลังการรีเฟรชทุกครั้ง เหมือนสัญญาณเตือน: แจ้งเมื่อข้ามเกณฑ์ และแจ้งอีกครั้งหลังจากมูลค่ากลับมาแล้วเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yenilemeden sonra kontrol edilir. Alarmlar gibi: eşik aşıldığında tetiklenir, yeniden ancak değer geri döndükten sonra tetiklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряється після кожного оновлення. Як сигнали: спрацьовує при перетині порогу і знову — лише після повернення значення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được kiểm tra sau mỗi lần làm mới. Giống cảnh báo: báo khi vượt ngưỡng và chỉ báo lại sau khi giá trị đã quay về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次刷新后检查。与提醒相同：越过阈值时通知，数值回落后才会再次通知。"
          }
        }
      }
    },
