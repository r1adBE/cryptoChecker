      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعر كمضاعف لسعر يوم التنصيف (مقياس لوغاريتمي). الدورات السابقة نمط وليست توقعًا."
