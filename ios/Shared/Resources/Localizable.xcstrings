    "app_lock_turn_off_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون قفل الشاشة لا يمكن فتح المحفظة. عند إيقافه يعرض التطبيق محفظتك مجددًا دون سؤال. بعد ضبط قفل الشاشة يمكنك إعادة تشغيل القفل من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zámku obrazovky nelze portfolio odemknout. Po vypnutí aplikace zobrazí portfolio opět bez dotazu. Až nastavíš zámek obrazovky, můžeš zámek znovu zapnout v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden skærmlås kan porteføljen ikke låses op. Slået fra viser appen din portefølje igen uden at spørge. Når en skærmlås er sat op, kan du slå låsen til igen i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Displaysperre lässt sich das Portfolio nicht entsperren. Ausgeschaltet zeigt die App dein Portfolio wieder ohne Abfrage. Mit eingerichteter Displaysperre kannst du die Sperre in den Einstellungen wieder einschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς κλείδωμα οθόνης το χαρτοφυλάκιο δεν ξεκλειδώνει. Απενεργοποιημένο, η εφαρμογή δείχνει ξανά το χαρτοφυλάκιο χωρίς ερώτηση. Μόλις ρυθμίσεις κλείδωμα οθόνης, μπορείς να το ενεργοποιήσεις ξανά στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a screen lock the portfolio cannot be unlocked. Turned off, the app shows your portfolio again without asking. Once a screen lock is set up, you can turn the lock back on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin bloqueo de pantalla no se puede desbloquear la cartera. Desactivado, la app vuelve a mostrar tu cartera sin preguntar. Cuando configures un bloqueo de pantalla, podrás activarlo de nuevo en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون قفل صفحه، سبد باز نمی‌شود. با خاموش کردن، برنامه سبد را دوباره بدون پرسش نشان می‌دهد. پس از تنظیم قفل صفحه می‌توانی قفل را در تنظیمات دوباره روشن کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman näytön lukitusta salkkua ei voi avata. Kun lukitus on pois päältä, sovellus näyttää salkun taas kysymättä. Kun näytön lukitus on otettu käyttöön, voit kytkeä lukituksen takaisin asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans verrouillage d'écran, le portefeuille ne peut pas être déverrouillé. Désactivé, l'app affiche de nouveau ton portefeuille sans demander. Une fois un verrouillage d'écran configuré, tu pourras réactiver le verrouillage dans les Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ללא נעילת מסך לא ניתן לפתוח את התיק. כשהנעילה כבויה, האפליקציה מציגה שוב את התיק בלי לשאול. לאחר הגדרת נעילת מסך אפשר להפעיל שוב את הנעילה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन लॉक के बिना पोर्टफ़ोलियो अनलॉक नहीं हो सकता। बंद करने पर ऐप बिना पूछे फिर से पोर्टफ़ोलियो दिखाएगा। स्क्रीन लॉक सेट होने के बाद तुम सेटिंग्स में लॉक फिर से चालू कर सकते हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Képernyőzár nélkül a portfólió nem oldható fel. Kikapcsolva az alkalmazás ismét kérdés nélkül mutatja a portfóliót. Képernyőzár beállítása után a zárat a Beállításokban újra bekapcsolhatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa kunci layar, portofolio tidak dapat dibuka. Jika dimatikan, aplikasi menampilkan portofolio lagi tanpa bertanya. Setelah kunci layar diatur, kunci bisa diaktifkan lagi di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza blocco schermo il portafoglio non si può sbloccare. Disattivato, l'app mostra di nuovo il portafoglio senza chiedere. Una volta impostato un blocco schermo, puoi riattivare il blocco nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面ロックがないとポートフォリオのロックを解除できません。オフにすると、アプリは確認なしで再びポートフォリオを表示します。画面ロックを設定したら、設定でロックを再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 잠금이 없으면 포트폴리오 잠금을 해제할 수 없습니다. 끄면 앱이 다시 묻지 않고 포트폴리오를 표시합니다. 화면 잠금을 설정한 뒤 설정에서 잠금을 다시 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten skjermlås kan porteføljen ikke låses opp. Slått av viser appen porteføljen igjen uten å spørre. Når en skjermlås er konfigurert, kan du slå på låsen igjen i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder schermvergrendeling kan het portfolio niet worden ontgrendeld. Uitgezet toont de app je portfolio weer zonder te vragen. Zodra er een schermvergrendeling is ingesteld, kun je de vergrendeling weer aanzetten in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez blokady ekranu nie da się odblokować portfela. Po wyłączeniu aplikacja znów pokazuje portfel bez pytania. Po skonfigurowaniu blokady ekranu możesz ponownie włączyć blokadę w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem bloqueio de ecrã não é possível desbloquear a carteira. Desligado, a app volta a mostrar a carteira sem perguntar. Depois de configurares um bloqueio de ecrã, podes voltar a ligar o bloqueio nas Definições."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem bloqueio de tela não é possível desbloquear a carteira. Desativado, o app volta a mostrar sua carteira sem perguntar. Depois de configurar um bloqueio de tela, você pode reativar o bloqueio nas Configurações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără blocarea ecranului, portofoliul nu poate fi deblocat. Dezactivată, aplicația îți arată din nou portofoliul fără să întrebe. După ce configurezi blocarea ecranului, poți reactiva blocarea din Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без блокировки экрана портфель нельзя разблокировать. После отключения приложение снова показывает портфель без запроса. Когда блокировка экрана будет настроена, блокировку можно снова включить в настройках."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa kyçje ekrani portofoli nuk mund të zhbllokohet. Kur çaktivizohet, aplikacioni e shfaq sërish portofolin pa pyetur. Pasi të caktosh një kyçje ekrani, mund ta aktivizosh sërish kyçjen te Cilësimet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan skärmlås kan portföljen inte låsas upp. Avstängt visar appen portföljen igen utan att fråga. När ett skärmlås är inställt kan du slå på låset igen i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีล็อกหน้าจอจะปลดล็อกพอร์ตโฟลิโอไม่ได้ เมื่อปิดไว้ แอปจะแสดงพอร์ตโฟลิโออีกครั้งโดยไม่ถาม เมื่อตั้งค่าล็อกหน้าจอแล้ว คุณเปิดการล็อกอีกครั้งได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kilidi olmadan portföyün kilidi açılamaz. Kapatıldığında uygulama portföyünü yeniden sormadan gösterir. Ekran kilidi ayarlandıktan sonra kilidi Ayarlar'dan yeniden açabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без блокування екрана портфель не можна розблокувати. Після вимкнення застосунок знову показує портфель без запиту. Коли блокування екрана буде налаштовано, блокування можна знову ввімкнути в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có khóa màn hình thì không thể mở khóa danh mục. Khi tắt, ứng dụng lại hiển thị danh mục mà không hỏi. Sau khi thiết lập khóa màn hình, bạn có thể bật lại khóa trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有屏幕锁定就无法解锁投资组合。关闭后，应用会再次无需确认地显示投资组合。设置好屏幕锁定后，可在设置中重新开启锁定。"
          }
        }
      }
    },
