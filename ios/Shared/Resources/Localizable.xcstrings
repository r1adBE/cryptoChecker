            "value" : "Ανενεργό: κάθε ενημέρωση ζεύγους με «Εκφώνηση τιμής» εκφωνείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: every update of a pair marked “Speak price” is read aloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
