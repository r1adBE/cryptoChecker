    "tax_note_stable_swap" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيع مقابل عملة مستقرة (USDT/USDC/DAI …) تحتفظ بها يُعد هنا تبادل عملة مشفرة بأخرى ولا يخضع للضريبة – سجّله كمبادلة إلى العملة المستقرة. لا يخضع للضريبة إلا البيع مقابل اليورو – ويُحتسب «بيع» بيعًا مقابل اليورو."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodej za stablecoin (USDT/USDC/DAI …), který si ponecháš, je zde krypto za krypto a nedaní se – zapiš ho jako směnu do stablecoinu. Daní se až prodej za eura – „Prodej“ se počítá jako prodej za eura."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et salg mod en stablecoin (USDT/USDC/DAI …), som du beholder, er her krypto mod krypto og ikke skattepligtigt – registrér det som bytte til stablecoinen. Kun et salg mod euro er skattepligtigt – «Salg» tæller som salg mod euro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verkauf gegen einen Stablecoin (USDT/USDC/DAI …), den du behältst, ist hier Krypto gegen Krypto und nicht steuerbar – erfasse ihn als Tausch in den Stablecoin. Steuerbar ist erst der Verkauf gegen Euro – «Verkauf» gilt als Verkauf gegen Euro."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πώληση έναντι stablecoin (USDT/USDC/DAI …) που κρατάς είναι εδώ κρύπτο έναντι κρύπτο και δεν φορολογείται – κατάγραψέ την ως ανταλλαγή στο stablecoin. Φορολογείται μόνο η πώληση έναντι ευρώ – η «Πώληση» μετρά ως πώληση έναντι ευρώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selling crypto for a stablecoin (USDT/USDC/DAI …) that you keep is crypto-to-crypto here and not taxed – record it as a swap into the stablecoin. Only a sale for euros is taxed – “Sell” counts as a sale for euros."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una venta a cambio de una stablecoin (USDT/USDC/DAI …) que conservas es aquí cripto por cripto y no tributa – regístrala como intercambio a la stablecoin. Solo tributa la venta a cambio de euros – «Venta» cuenta como venta a cambio de euros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فروش در برابر استیبل‌کوینی (USDT/USDC/DAI …) که نگه می‌داری اینجا رمزارز در برابر رمزارز است و مشمول مالیات نیست – آن را به‌صورت تبادل به استیبل‌کوین ثبت کن. فقط فروش در برابر یورو مشمول مالیات است – «فروش» فروش در برابر یورو حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myynti stablecoinia (USDT/USDC/DAI …) vastaan, jonka pidät, on tässä kryptoa kryptoa vastaan eikä verotettavaa – kirjaa se vaihdoksi stablecoiniin. Vain myynti euroja vastaan on verotettavaa – ”Myynti” lasketaan myynniksi euroja vastaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vente contre un stablecoin (USDT/USDC/DAI …) que tu conserves est ici un échange crypto contre crypto et n’est pas imposable – saisis-la comme échange vers le stablecoin. Seule une vente contre des euros est imposable – « Vente » compte comme vente contre des euros."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכירה תמורת מטבע יציב (USDT/USDC/DAI …) שנשאר אצלך נחשבת כאן קריפטו מול קריפטו ואינה חייבת במס – רשמו אותה כהחלפה למטבע היציב. רק מכירה תמורת יורו חייבת במס – «מכירה» נחשבת מכירה תמורת יורו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस स्टेबलकॉइन (USDT/USDC/DAI …) को तुम रखते हो, उसके बदले बिक्री यहाँ क्रिप्टो से क्रिप्टो है और कर योग्य नहीं – इसे स्टेबलकॉइन में स्वैप के रूप में दर्ज करो। केवल यूरो के बदले बिक्री कर योग्य है – “बिक्री” यूरो के बदले बिक्री मानी जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megtartott stablecoinért (USDT/USDC/DAI …) történő eladás itt kripto kriptóért és nem adóköteles – rögzítsd cseréként a stablecoinba. Csak az euróért történő eladás adóköteles – az „Eladás” euróért történő eladásnak számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penjualan ke stablecoin (USDT/USDC/DAI …) yang kamu simpan di sini dianggap kripto ke kripto dan tidak dikenai pajak – catat sebagai tukar ke stablecoin. Hanya penjualan ke euro yang dikenai pajak – “Jual” dihitung sebagai penjualan ke euro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vendita contro uno stablecoin (USDT/USDC/DAI …) che tieni è qui cripto contro cripto e non è tassata – registrala come scambio nello stablecoin. È tassata solo la vendita contro euro – «Vendita» vale come vendita contro euro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
