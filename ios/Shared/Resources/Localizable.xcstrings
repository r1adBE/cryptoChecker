      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد علامات نشطة على قمة أو قاع: مرحلة وسطى هادئة، واتجاه السعر هو الحاسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejsou aktivní žádné známky vrcholu ani dna: klidná střední fáze, rozhoduje cenový trend."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tegn på en top eller bund er aktive: rolig mellemfase, kurstrenden afgør."
