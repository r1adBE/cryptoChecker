    "delivery_battery_optimized" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسَّن – قد يؤخر Android عمليات الفحص. لا يطلب التطبيق استثناءً؛ يمكنك تغيير ذلك من إعدادات البطارية للتطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalizováno – Android může kontroly zdržet. Aplikace nežádá o výjimku; změnit to můžeš v nastavení baterie aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimeret – Android kan forsinke tjek. Appen beder ikke om en undtagelse; du kan ændre det i appens batteriindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiert – Android kann Prüfungen verzögern. Die App bittet nicht um eine Ausnahme; ändern kannst du das in den Akku-Einstellungen der App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βελτιστοποιημένη – το Android μπορεί να καθυστερεί τους ελέγχους. Η εφαρμογή δεν ζητά εξαίρεση· μπορείς να το αλλάξεις στις ρυθμίσεις μπαταρίας της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized – Android may delay checks. The app doesn't ask for an exception; you can change this in the app's battery settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizada – Android puede retrasar las comprobaciones. La app no pide una excepción; puedes cambiarlo en los ajustes de batería de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بهینه‌شده – Android ممکن است بررسی‌ها را به تأخیر بیندازد. برنامه درخواست استثنا نمی‌کند؛ می‌توانی این را در تنظیمات باتری برنامه تغییر دهی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimoitu – Android voi viivästyttää tarkistuksia. Sovellus ei pyydä poikkeusta; voit muuttaa tämän sovelluksen akkuasetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimisée – Android peut retarder les vérifications. L'app ne demande pas d'exception ; tu peux le modifier dans les réglages de batterie de l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "באופטימיזציה – Android עלול לעכב בדיקות. האפליקציה לא מבקשת חריגה; אפשר לשנות זאת בהגדרות הסוללה של האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑप्टिमाइज़्ड – Android जाँच में देरी कर सकता है। ऐप छूट नहीं माँगता; तुम इसे ऐप की बैटरी सेटिंग में बदल सकते हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalizált – az Android késleltetheti az ellenőrzéseket. Az app nem kér kivételt; ezt az app akkumulátor-beállításaiban módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dioptimalkan – Android bisa menunda pemeriksaan. Aplikasi tidak meminta pengecualian; kamu bisa mengubahnya di pengaturan baterai aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimizzata – Android può ritardare i controlli. L'app non chiede un'eccezione; puoi cambiarlo nelle impostazioni batteria dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
