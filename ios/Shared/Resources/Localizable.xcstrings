        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A withdrawal fee in USDT or cash is not a loss: a cash fee is not a deductible cost, a USDT fee is a disposal at par without gain – it is listed as information only (%1$@)."
