    "ios_low_power_mode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع الطاقة المنخفضة مفعّل. نادرًا ما يتحقق iOS في الخلفية، لذا قد تتأخر التنبيهات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsporný režim je zapnutý. iOS na pozadí kontroluje jen zřídka, alarmy se mohou zpozdit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparetilstand er slået til. iOS tjekker sjældent i baggrunden, så alarmer kan komme for sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus ist an. iOS prüft im Hintergrund kaum, Alarme können sich verspäten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λειτουργία χαμηλής ισχύος είναι ενεργή. Το iOS σπάνια ελέγχει στο παρασκήνιο, οι συναγερμοί μπορεί να καθυστερήσουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Power Mode is on. iOS rarely checks in the background, so alerts may come late."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado. iOS apenas comprueba en segundo plano y las alarmas pueden llegar tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالت کم‌مصرف روشن است. iOS به‌ندرت در پس‌زمینه بررسی می‌کند، پس هشدارها ممکن است دیر برسند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virransäästötila on päällä. iOS tarkistaa taustalla harvoin, joten hälytykset voivat viivästyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Économie d’énergie est activé. iOS vérifie rarement en arrière-plan, les alertes peuvent arriver en retard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב חיסכון בסוללה פעיל. iOS כמעט לא בודק ברקע, ולכן התראות עלולות להתעכב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लो पावर मोड चालू है। iOS बैकग्राउंड में कम ही जाँचता है, इसलिए अलार्म देर से आ सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alacsony fogyasztású mód be van kapcsolva. Az iOS ritkán ellenőriz a háttérben, a riasztások késhetnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode Daya Rendah aktif. iOS jarang memeriksa di latar belakang, jadi alarm bisa terlambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Risparmio energetico è attiva. iOS controlla raramente in background, gli allarmi possono arrivare in ritardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードがオンです。iOS はバックグラウンドでほとんど確認しないため、アラームが遅れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 켜져 있습니다. iOS가 백그라운드에서 거의 확인하지 않아 경보가 늦을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparingsmodus er på. iOS sjekker sjelden i bakgrunnen, så alarmer kan komme sent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energiebesparingsmodus staat aan. iOS controleert zelden op de achtergrond, dus alarmen kunnen te laat komen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb niskiego zużycia energii jest włączony. iOS rzadko sprawdza w tle, więc alarmy mogą się spóźniać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de baixo consumo está ativo. O iOS raramente verifica em segundo plano e os alarmes podem chegar tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de Pouca Energia está ativado. O iOS raramente verifica em segundo plano e os alarmes podem atrasar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul consum redus este activ. iOS verifică rar în fundal, așa că alarmele pot întârzia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён режим энергосбережения. iOS редко проверяет в фоне, оповещения могут опаздывать."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modaliteti i kursimit të energjisë është aktiv. iOS kontrollon rrallë në sfond, ndaj alarmet mund të vonohen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömsparläge är på. iOS kontrollerar sällan i bakgrunden, så larm kan komma sent."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดพลังงานต่ำเปิดอยู่ iOS แทบไม่ตรวจในเบื้องหลัง สัญญาณเตือนจึงอาจมาช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük Güç Modu açık. iOS arka planda nadiren kontrol eder, alarmlar gecikebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнено режим енергозбереження. iOS рідко перевіряє у фоні, сигнали можуть запізнюватися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nguồn điện thấp đang bật. iOS hiếm khi kiểm tra trong nền nên cảnh báo có thể đến muộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低电量模式已开启。iOS 很少在后台检查，提醒可能会延迟。"
          }
        }
      }
    },
