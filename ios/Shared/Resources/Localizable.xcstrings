    "delivery_live_activity_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض السعر على شاشة القفل، لكنه لا يتحدث إلا عندما يفحص التطبيق – ولا يجعل التنبيهات تُفحص أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje kurz na zamčené obrazovce, ale aktualizuje se jen při kontrole aplikace – alarmy se tím nekontrolují častěji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser kursen på låseskærmen, men opdateres kun, når appen tjekker – alarmer bliver ikke tjekket oftere af den grund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Kurs auf dem Sperrbildschirm, wird aber nur bei einer Prüfung der App aktualisiert – Alarme werden dadurch nicht öfter geprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει την τιμή στην οθόνη κλειδώματος, αλλά ενημερώνεται μόνο όταν ελέγχει η εφαρμογή – οι συναγερμοί δεν ελέγχονται γι' αυτό συχνότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the price on the Lock Screen but only updates when the app checks – it doesn't make alerts check more often."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el precio en la pantalla de bloqueo, pero solo se actualiza cuando la app comprueba – no hace que las alarmas se comprueben más a menudo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت را روی صفحه قفل نشان می‌دهد، اما فقط هنگام بررسی برنامه به‌روز می‌شود – با این کار هشدارها بیشتر بررسی نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää kurssin lukitusnäytöllä, mutta päivittyy vain, kun sovellus tarkistaa – hälytyksiä ei tarkisteta sen vuoksi useammin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le cours sur l'écran verrouillé, mais n'est mise à jour que lorsque l'app vérifie – les alertes ne sont pas vérifiées plus souvent pour autant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציגה את השער במסך הנעילה, אבל מתעדכנת רק כשהאפליקציה בודקת – ההתראות לא נבדקות בגלל זה לעיתים קרובות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक स्क्रीन पर भाव दिखाती है, लेकिन सिर्फ़ ऐप की जाँच पर अपडेट होती है – इससे अलार्म ज़्यादा बार नहीं जाँचे जाते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjeleníti az árfolyamot a zárolási képernyőn, de csak akkor frissül, amikor az app ellenőriz – ettől a riasztásokat nem ellenőrzi gyakrabban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan harga di Layar Terkunci, tetapi hanya diperbarui saat aplikasi memeriksa – alarm tidak jadi diperiksa lebih sering."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il prezzo sulla schermata di blocco, ma si aggiorna solo quando l'app controlla – non fa controllare gli allarmi più spesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面に価格を表示しますが、更新されるのはアプリが確認したときだけです。アラームの確認回数は増えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면에 가격을 보여 주지만 앱이 확인할 때만 업데이트되며, 경보를 더 자주 확인하게 하지는 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser kursen på låseskjermen, men oppdateres bare når appen sjekker – alarmer sjekkes ikke oftere av den grunn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de koers op het toegangsscherm, maar wordt alleen bijgewerkt als de app controleert – alarmen worden daardoor niet vaker gecontroleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje kurs na ekranie blokady, ale aktualizuje się tylko wtedy, gdy aplikacja sprawdza – alarmy nie są przez to sprawdzane częściej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a cotação no ecrã bloqueado, mas só é atualizada quando a app verifica – não faz com que os alarmes sejam verificados mais vezes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a cotação na Tela Bloqueada, mas só é atualizada quando o app verifica – não faz os alarmes serem verificados com mais frequência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează cursul pe ecranul de blocare, dar se actualizează doar când aplicația verifică – alarmele nu sunt verificate mai des din cauza asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает курс на экране блокировки, но обновляется только при проверке приложением – оповещения от этого не проверяются чаще."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shfaq kursin në ekranin e kyçjes, por përditësohet vetëm kur aplikacioni kontrollon – alarmet nuk kontrollohen më shpesh për këtë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar kursen på låsskärmen men uppdateras bara när appen kontrollerar – larmen kontrolleras inte oftare för det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงราคาบนหน้าจอล็อก แต่จะอัปเดตเฉพาะเมื่อแอปตรวจสอบ – ไม่ได้ทำให้สัญญาณเตือนถูกตรวจสอบบ่อยขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatı kilit ekranında gösterir ama yalnızca uygulama kontrol ettiğinde güncellenir – alarmlar bu yüzden daha sık kontrol edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує курс на замкненому екрані, але оновлюється лише під час перевірки застосунком – сигнали від цього не перевіряються частіше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị giá trên màn hình khóa nhưng chỉ cập nhật khi ứng dụng kiểm tra – không làm cảnh báo được kiểm tra thường xuyên hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕上显示价格，但只在应用检查时更新 – 并不会让提醒检查得更频繁。"
          }
        }
      }
    },
