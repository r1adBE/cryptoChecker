          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația a fost închisă în timpul restaurării unui backup. Datele anterioare au fost puse la loc; nimic din backup nu a fost păstrat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение было закрыто во время восстановления из копии. Прежние данные возвращены; из копии ничего не сохранено."
          }
        },
        "sq" : {
          "stringUnit" : {
