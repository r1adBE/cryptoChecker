    },
    "watchlist_first_alarm_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على إشعار عند وصول السعر إلى الحد الذي تختاره – عند إغلاق التطبيق يتحقق Android على فترات غير منتظمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaneš upozornění, když cena dosáhne tvé hranice – při zavřené aplikaci Android kontroluje nepravidelně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få besked, når en kurs når dit niveau – når appen er lukket, tjekker Android uregelmæssigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich benachrichtigen, wenn ein Kurs deine Marke erreicht – bei geschlossener App prüft Android unregelmässig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβε ειδοποίηση όταν μια τιμή φτάσει το όριό σου – με την εφαρμογή κλειστή, το Android ελέγχει ακανόνιστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified when a price reaches your mark – with the app closed, Android checks irregularly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso cuando un precio alcance tu nivel: con la app cerrada, Android comprueba de forma irregular."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی قیمت به حد تو رسید، باخبر شو – وقتی برنامه بسته است، Android به‌طور نامنظم بررسی می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun kurssi saavuttaa rajasi – kun sovellus on suljettu, Android tarkistaa epäsäännöllisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reçois une alerte quand un cours atteint ton seuil – app fermée, Android vérifie de façon irrégulière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבלו הודעה כשמחיר מגיע לרף שלך – כשהאפליקציה סגורה, Android בודק באופן לא סדיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई भाव तुम्हारी तय सीमा तक पहुँचे, सूचना पाओ – ऐप बंद होने पर Android अनियमित रूप से जाँचता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesítést kapsz, ha egy árfolyam eléri a megadott szintet – bezárt alkalmazásnál az Android rendszertelenül ellenőriz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan notifikasi saat harga mencapai batasmu – saat aplikasi ditutup, Android memeriksa secara tidak teratur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando un prezzo raggiunge la tua soglia – ad app chiusa, Android controlla in modo irregolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格が設定した水準に達したら通知します。アプリを閉じている間、Android の確認は不定期です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격이 정한 기준에 도달하면 알려 드립니다. 앱을 닫으면 Android가 불규칙하게 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få varsel når en kurs når grensen din – når appen er lukket, sjekker Android uregelmessig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg een melding wanneer een koers je grens bereikt – met de app gesloten controleert Android onregelmatig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymaj powiadomienie, gdy kurs osiągnie twój próg – przy zamkniętej aplikacji Android sprawdza nieregularnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recebe um aviso quando um preço atingir o teu limite – com a app fechada, o Android verifica de forma irregular."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um aviso quando um preço atingir o seu limite – com o app fechado, o Android verifica de forma irregular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primești o notificare când un preț atinge pragul tău – cu aplicația închisă, Android verifică neregulat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получай уведомление, когда цена достигнет твоего уровня – при закрытом приложении Android проверяет нерегулярно."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merr njoftim kur një çmim të arrijë kufirin tënd – kur aplikacioni është i mbyllur, Android kontrollon në mënyrë të parregullt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en avisering när en kurs når din nivå – när appen är stängd kontrollerar Android oregelbundet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับการแจ้งเตือนเมื่อราคาถึงระดับที่คุณกำหนด – เมื่อปิดแอป Android จะตรวจสอบไม่สม่ำเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fiyat belirlediğin seviyeye ulaştığında bildirim al – uygulama kapalıyken Android düzensiz aralıklarla kontrol eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отримуй сповіщення, коли ціна досягне твого рівня – коли застосунок закрито, Android перевіряє нерегулярно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận thông báo khi giá chạm mức bạn đặt – khi ứng dụng đóng, Android kiểm tra không đều đặn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格到达你设定的位置时通知你——应用关闭时，Android 的检查时间不固定。"
          }
        }
      }
    },
