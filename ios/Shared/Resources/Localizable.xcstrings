        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλείδωμα χαρτοφυλακίου παραμένει ενεργό – ένα μη κρυπτογραφημένο αντίγραφο δεν μπορεί να το απενεργοποιήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
