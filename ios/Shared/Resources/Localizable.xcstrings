          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבר אי אפשר לבטל – הצמדים יישארו ברשימת המעקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब पूर्ववत नहीं किया जा सकता – पेयर वॉचलिस्ट में बने रहेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
