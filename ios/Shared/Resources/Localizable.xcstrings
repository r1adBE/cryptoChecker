      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسوم السحب بـ USDT أو نقدًا ليست خسارة: الرسوم النقدية غير قابلة للخصم، ورسوم USDT تصرّف بالقيمة الاسمية بلا ربح – تظهر للعلم فقط (%1$@)."
