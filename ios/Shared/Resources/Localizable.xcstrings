    "widgets_ios_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح iOS للتطبيقات بإضافة الأدوات بنفسها. الأمر لا يستغرق سوى لحظة:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS aplikacím nedovoluje přidávat widgety samy. Zabere to jen chvilku:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lader ikke apps tilføje widgets selv. Det tager kun et øjeblik:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter iOS können Apps Widgets nicht selbst hinzufügen. So geht es in wenigen Sekunden:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS δεν επιτρέπει στις εφαρμογές να προσθέτουν widget μόνες τους. Χρειάζεται μόνο μια στιγμή:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't let apps add widgets themselves. It only takes a moment:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no permite que las apps añadan widgets por sí mismas. Solo lleva un momento:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS اجازه نمی‌دهد برنامه‌ها خودشان ابزارک اضافه کنند. فقط یک لحظه طول می‌کشد:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ei anna sovellusten lisätä widgetejä itse. Se käy hetkessä:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne permet pas aux apps d'ajouter elles-mêmes des widgets. Cela ne prend qu'un instant :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב־iOS אפליקציות לא יכולות להוסיף ווידג׳טים בעצמן. זה לוקח רק רגע:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ऐप्स को खुद विजेट जोड़ने नहीं देता। इसमें बस एक पल लगता है:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iOS nem engedi, hogy az alkalmazások maguk adjanak hozzá widgetet. Csak egy pillanat:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS tidak mengizinkan aplikasi menambahkan widget sendiri. Hanya perlu sebentar:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non permette alle app di aggiungere widget da sole. Basta un attimo:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ではアプリが自分でウィジェットを追加することはできません。すぐに済みます："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서는 앱이 직접 위젯을 추가할 수 없습니다. 금방 끝납니다:"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lar ikke apper legge til widgeter selv. Det tar bare et øyeblikk:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS laat apps niet zelf widgets toevoegen. Het is zo gedaan:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nie pozwala aplikacjom samodzielnie dodawać widżetów. To zajmie tylko chwilę:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não permite que as apps adicionem widgets por si próprias. Demora só um momento:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não permite que apps adicionem widgets sozinhos. Leva só um instante:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nu permite aplicațiilor să adauge singure widgeturi. Durează doar o clipă:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не позволяет приложениям самим добавлять виджеты. Это займёт всего минуту:"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nuk i lejon aplikacionet të shtojnë vetë widget-e. Zgjat vetëm një çast:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS låter inte appar lägga till widgetar själva. Det tar bara ett ögonblick:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ไม่อนุญาตให้แอปเพิ่มวิดเจ็ตเอง ใช้เวลาเพียงครู่เดียว:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, uygulamaların kendi başına widget eklemesine izin vermiyor. Sadece bir dakikanı alır:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не дозволяє застосункам самим додавати віджети. Це займе лише мить:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS không cho phép ứng dụng tự thêm tiện ích. Chỉ mất một chút thời gian:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不允许应用自行添加小部件。只需片刻："
          }
