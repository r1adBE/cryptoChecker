    "tax_de_limit_scope" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الحدود على جميع المبيعات الخاصة أو الخدمات في السنة مجتمعة – بما في ذلك خارج التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hranice platí pro všechny soukromé prodeje nebo služby za rok dohromady – i mimo aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grænserne gælder for alle private salg eller ydelser i året samlet – også uden for appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigrenzen gelten für alle privaten Veräusserungsgeschäfte bzw. Leistungen des Jahres zusammen – auch ausserhalb der App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα όρια ισχύουν για όλες τις ιδιωτικές πωλήσεις ή υπηρεσίες του έτους μαζί – και εκτός εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits apply to all private sales or services of the year together – including outside the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los límites se aplican a todas las ventas privadas o prestaciones del año en conjunto – también fuera de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سقف‌ها برای همهٔ فروش‌های شخصی یا خدمات سال روی هم اعمال می‌شوند – حتی بیرون از برنامه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajat koskevat kaikkia vuoden yksityisiä myyntejä tai palveluja yhteensä – myös sovelluksen ulkopuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les seuils s’appliquent à l’ensemble des ventes privées ou des prestations de l’année – y compris hors de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התקרות חלות על כל המכירות הפרטיות או השירותים בשנה יחד – גם מחוץ לאפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमाएँ साल की सभी निजी बिक्री या सेवाओं पर एक साथ लागू होती हैं – ऐप के बाहर की भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A határok az év összes magáneladására vagy szolgáltatására együtt vonatkoznak – az alkalmazáson kívül is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas berlaku untuk semua penjualan pribadi atau jasa dalam setahun secara gabungan – termasuk di luar aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soglie valgono per tutte le vendite private o prestazioni dell’anno insieme – anche fuori dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
