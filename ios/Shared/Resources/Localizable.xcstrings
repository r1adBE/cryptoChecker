        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊँचा मतलब माइनर सामान्य से कहीं ज़्यादा कमा रहे हैं, नीचा मतलब कहीं कम।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A magas azt jelenti, hogy a bányászok jóval többet keresnek a szokásosnál, az alacsony, hogy jóval kevesebbet."
