        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android rozhoduje, kdy se kontroluje – tady vidíš, kdy k tomu opravdu došlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android bestemmer, hvornår der tjekkes – her ser du, hvornår det faktisk skete."
