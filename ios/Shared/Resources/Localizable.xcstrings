        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt je Börse die vollständige öffentliche Liste – für alle gleich. Deine Suche bleibt auf dem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φορτώνει την πλήρη δημόσια λίστα κάθε ανταλλακτηρίου – ίδια για όλους. Η αναζήτησή σου μένει στη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loads each exchange’s complete public list – the same for everyone. Your search stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga la lista pública completa de cada exchange, igual para todos. Tu búsqueda se queda en el dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست عمومی کامل هر صرافی را بارگیری می‌کند – برای همه یکسان. جستجوی تو روی دستگاه می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa jokaisen pörssin koko julkisen listan – sama kaikille. Hakusi pysyy laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge la liste publique complète de chaque plateforme – la même pour tous. Ta recherche reste sur l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טוען את הרשימה הציבורית המלאה של כל בורסה – זהה לכולם. החיפוש שלך נשאר במכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर एक्सचेंज की पूरी सार्वजनिक सूची लोड करता है – सबके लिए एक जैसी। तुम्हारी खोज डिवाइस पर ही रहती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betölti minden tőzsde teljes nyilvános listáját – mindenkinek ugyanazt. A keresésed az eszközön marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memuat daftar publik lengkap tiap bursa – sama untuk semua orang. Pencarianmu tetap di perangkat."
