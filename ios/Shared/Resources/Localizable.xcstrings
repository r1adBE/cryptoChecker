          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt unten im Tab «Hinzufügen» die Anfragen an die Börsen – für die Fehlersuche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει στο κάτω μέρος της καρτέλας «Προσθήκη» τα αιτήματα προς τα ανταλλακτήρια – για αντιμετώπιση προβλημάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the requests to the exchanges at the bottom of the Add tab – for troubleshooting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra al final de la pestaña «Añadir» las solicitudes a los exchanges – para diagnosticar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درخواست‌های ارسالی به صرافی‌ها را پایین برگه «افزودن» نشان می‌دهد – برای عیب‌یابی."
