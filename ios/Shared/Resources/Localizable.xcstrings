    "tax_de_disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاسترشاد – ليس إقرارًا ضريبيًا ولا استشارة ضريبية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientační – nejde o daňové přiznání ani daňové poradenství."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejledende – ikke en selvangivelse og ikke skatterådgivning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientierung – keine Steuererklärung und keine Steuerberatung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενδεικτικό – όχι φορολογική δήλωση ούτε φορολογική συμβουλή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For guidance only – not a tax return and not tax advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – no es una declaración de impuestos ni asesoramiento fiscal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای راهنمایی – نه اظهارنامهٔ مالیاتی و نه مشاورهٔ مالیاتی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuntaa antava – ei veroilmoitus eikä veroneuvontaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À titre indicatif – ni déclaration fiscale ni conseil fiscal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתמצאות – לא דוח מס ולא ייעוץ מס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मार्गदर्शन हेतु – न टैक्स रिटर्न और न टैक्स सलाह।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tájékoztató – nem adóbevallás és nem adótanácsadás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientasi – bukan SPT dan bukan nasihat pajak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – non è una dichiarazione dei redditi né una consulenza fiscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目安 – 税務申告書でも税務アドバイスでもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고용 – 세금 신고서도 세무 조언도 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veiledende – ikke en skattemelding og ikke skatteråd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatief – geen belastingaangifte en geen belastingadvies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientacyjnie – nie zeznanie podatkowe ani porada podatkowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – não é uma declaração fiscal nem aconselhamento fiscal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – não é declaração de imposto nem consultoria tributária."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativ – nu este declarație fiscală și nici consultanță fiscală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ориентир – не налоговая декларация и не налоговая консультация."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientuese – jo deklaratë tatimore dhe jo këshillë tatimore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vägledande – ingen deklaration och ingen skatterådgivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อเป็นแนวทาง – ไม่ใช่แบบแสดงรายการภาษีและไม่ใช่คำแนะนำด้านภาษี"
