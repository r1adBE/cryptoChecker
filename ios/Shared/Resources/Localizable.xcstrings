    "dex_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز خارج المنصات الكبيرة، من المنصات اللامركزية (Uniswap، PancakeSwap، Raydium …) عبر DexScreener. ابحث عن رمز وأضف أحد مجمّعات التداول الخاصة به – الأسعار بالدولار الأمريكي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny mimo velké burzy, z decentralizovaných burz (Uniswap, PancakeSwap, Raydium …) přes DexScreener. Vyhledej token a přidej jeden z jeho obchodních poolů – ceny v amerických dolarech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens uden for de store børser, fra decentraliserede børser (Uniswap, PancakeSwap, Raydium …) via DexScreener. Søg efter en token, og tilføj en af dens handelspools – kurser i amerikanske dollar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ausserhalb der grossen Börsen, von dezentralen Börsen (Uniswap, PancakeSwap, Raydium …) über DexScreener. Token suchen und einen seiner Handelspools hinzufügen – Kurse in US-Dollar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens εκτός των μεγάλων ανταλλακτηρίων, από αποκεντρωμένα ανταλλακτήρια (Uniswap, PancakeSwap, Raydium …) μέσω DexScreener. Αναζήτησε ένα token και πρόσθεσε ένα από τα pools συναλλαγών του – τιμές σε δολάρια ΗΠΑ."
          }
        },
        "en" : {
          "stringUnit" : {
