    "alarm_log_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متى انطلق تنبيه – ومتى كان سينطلق لكنه أُوقف. يُحفظ على هذا الجهاز فقط لمدة 14 يومًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdy se alarm spustil – a kdy by se spustil, ale byl pozdržen. Uloženo jen v tomto zařízení, po dobu 14 dnů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvornår en alarm blev udløst – og hvornår den ville være udløst, men blev holdt tilbage. Gemmes kun på denne enhed i 14 dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann ein Alarm ausgelöst hat – und wann er ausgelöst hätte, aber zurückgehalten wurde. Nur auf diesem Gerät gespeichert, 14 Tage lang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πότε ενεργοποιήθηκε ένας συναγερμός – και πότε θα ενεργοποιούνταν, αλλά κρατήθηκε. Αποθηκεύεται μόνο σε αυτή τη συσκευή για 14 ημέρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an alert fired – and when it would have fired but was held back. Stored only on this device, for 14 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo saltó una alarma – y cuándo habría saltado, pero se retuvo. Se guarda solo en este dispositivo durante 14 días."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چه زمانی یک هشدار فعال شد – و چه زمانی فعال می‌شد اما نگه داشته شد. فقط روی همین دستگاه و به مدت ۱۴ روز ذخیره می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milloin hälytys laukesi – ja milloin se olisi lauennut, mutta pidätettiin. Tallennetaan vain tälle laitteelle 14 päiväksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une alerte s'est déclenchée – et quand elle se serait déclenchée mais a été retenue. Enregistré uniquement sur cet appareil, pendant 14 jours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתי התראה הופעלה – ומתי היא הייתה מופעלת אבל עוכבה. נשמר רק במכשיר הזה למשך 14 יום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अलार्म कब बजा – और कब बजता, लेकिन रोका गया। केवल इसी डिवाइस पर 14 दिनों तक सहेजा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikor jelzett egy riasztás – és mikor jelzett volna, de vissza lett tartva. Csak ezen az eszközön tárolódik, 14 napig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapan alarm berbunyi – dan kapan seharusnya berbunyi tetapi ditahan. Hanya disimpan di perangkat ini selama 14 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un allarme è scattato – e quando sarebbe scattato ma è stato trattenuto. Salvato solo su questo dispositivo per 14 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームが鳴ったとき――そして鳴るはずだったのに保留されたときを記録します。この端末にのみ 14 日間保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경보가 울린 시점과, 울렸어야 했지만 보류된 시점을 기록합니다. 이 기기에만 14일 동안 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en alarm ble utløst – og når den ville blitt utløst, men ble holdt tilbake. Lagres bare på denne enheten i 14 dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een alarm afging – en wanneer het zou zijn afgegaan, maar werd tegengehouden. Alleen op dit apparaat opgeslagen, 14 dagen lang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy alarm zadziałał – i kiedy by zadziałał, ale został wstrzymany. Zapisywane tylko na tym urządzeniu przez 14 dni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um alarme disparou – e quando teria disparado, mas foi retido. Guardado apenas neste dispositivo durante 14 dias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um alarme disparou – e quando teria disparado, mas foi segurado. Salvo só neste dispositivo por 14 dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când s-a declanșat o alarmă – și când s-ar fi declanșat, dar a fost reținută. Salvat doar pe acest dispozitiv, timp de 14 zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда оповещение сработало – и когда оно сработало бы, но было задержано. Хранится только на этом устройстве 14 дней."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kur u aktivizua një alarm – dhe kur do të ishte aktivizuar, por u mbajt. Ruhet vetëm në këtë pajisje për 14 ditë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ett larm utlöstes – och när det skulle ha utlösts men hölls tillbaka. Sparas bara på den här enheten i 14 dagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใดที่สัญญาณเตือนทำงาน – และเมื่อใดที่ควรทำงานแต่ถูกระงับไว้ จัดเก็บเฉพาะในอุปกรณ์นี้เป็นเวลา 14 วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir alarmın ne zaman çaldığı – ve ne zaman çalacakken bekletildiği. Yalnızca bu cihazda 14 gün saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сигнал спрацював – і коли він спрацював би, але був затриманий. Зберігається лише на цьому пристрої 14 днів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nào cảnh báo đã kích hoạt – và khi nào lẽ ra đã kích hoạt nhưng bị giữ lại. Chỉ lưu trên thiết bị này trong 14 ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录提醒何时触发——以及何时本应触发却被暂缓。仅保存在此设备上，保留 14 天。"
          }
        }
      }
    },
