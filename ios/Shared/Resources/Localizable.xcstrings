            "value" : "Lähellä nollaa tarkoittaa, että keskiarvot melkein kohtaavat, selvästi negatiivinen, että ne ovat kaukana toisistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proche de zéro signifie que les deux moyennes se rejoignent presque, très négatif qu’elles sont éloignées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרוב לאפס פירושו ששני הממוצעים כמעט נפגשים, שלילי מאוד – שהם רחוקים זה מזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शून्य के पास मतलब दोनों औसत लगभग मिल रहे हैं, काफ़ी ऋणात्मक मतलब वे दूर हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nullához közeli azt jelenti, hogy a két átlag majdnem összeér, az erősen negatív, hogy messze vannak egymástól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendekati nol berarti kedua rata-rata hampir bertemu, sangat negatif berarti keduanya berjauhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vicino a zero significa che le due medie quasi si toccano, molto negativo che sono lontane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゼロに近いと2本の平均線がほぼ交わり、大きくマイナスだと離れていることを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0에 가까우면 두 평균이 거의 만나고, 크게 마이너스면 멀리 떨어져 있다는 뜻입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nær null betyr at de to snittene nesten møtes, sterkt negativ at de ligger langt fra hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijna nul betekent dat de twee gemiddelden elkaar bijna raken, sterk negatief dat ze ver uit elkaar liggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blisko zera oznacza, że obie średnie prawie się spotykają, mocno ujemny – że są daleko od siebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perto de zero significa que as duas médias quase se cruzam; muito negativo, que estão muito afastadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perto de zero significa que as duas médias quase se cruzam; muito negativo, que estão muito afastadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproape de zero înseamnă că cele două medii aproape se ating, puternic negativ că sunt departe una de alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около нуля — две средние почти сходятся, сильно отрицательное — они далеко друг от друга."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afër zeros do të thotë se dy mesataret pothuajse takohen, shumë negative se janë larg njëra-tjetrës."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nära noll betyder att de två genomsnitten nästan möts, starkt negativt att de ligger långt isär."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใกล้ศูนย์หมายถึงค่าเฉลี่ยทั้งสองเกือบบรรจบกัน ติดลบมากหมายถึงห่างกันมาก"
