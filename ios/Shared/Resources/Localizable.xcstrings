    "backup_restore_interrupted_incomplete" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلق التطبيق أثناء استعادة نسخة احتياطية، وتعذّرت إعادة البيانات السابقة بالكامل. يُرجى التحقق من قائمة المتابعة والمحفظة، أو استعادة النسخة مجددًا من «%1$@» في الإعدادات."
