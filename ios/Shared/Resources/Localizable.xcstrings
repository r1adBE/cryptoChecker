    "portfolio_address_xpub_operator" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يشغّل %1$@ يرى كل العناوين المستعلَم عنها من هذه المحفظة ويمكنه ربطها ببعضها وبعنوان IP الخاص بك."
