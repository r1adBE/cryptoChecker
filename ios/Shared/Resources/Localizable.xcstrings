    "settings_reset_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الإعدادات فأُعيد ضبطها على القيم الافتراضية. يُرجى التحقق من قفل المحفظة والفاصل الزمني للتنبيهات والعملة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení se nepodařilo načíst a bylo obnoveno na výchozí hodnoty. Zkontroluj prosím zámek portfolia, interval alarmů a měnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingerne kunne ikke læses og er nulstillet til standardværdierne. Kontrollér porteføljelåsen, alarmintervallet og valutaen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen liessen sich nicht lesen und wurden auf die Standardwerte zurückgesetzt. Bitte Portfolio-Sperre, Intervall der Alarme und Währung prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των ρυθμίσεων και έγινε επαναφορά στις προεπιλογές. Έλεγξε το κλείδωμα χαρτοφυλακίου, το διάστημα των συναγερμών και το νόμισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your settings could not be read and were reset to the defaults. Please check the portfolio lock, the alerts interval and the currency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los ajustes y se restablecieron los valores predeterminados. Revisa el bloqueo de la cartera, el intervalo de las alarmas y la moneda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات خوانده نشد و به مقادیر پیش‌فرض بازنشانی شد. لطفاً قفل پرتفوی، فاصله زمانی هشدارها و ارز را بررسی کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetuksia ei voitu lukea, joten ne palautettiin oletusarvoihin. Tarkista salkun lukitus, hälytysten aikaväli ja valuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages n’ont pas pu être lus et ont été réinitialisés aux valeurs par défaut. Vérifie le verrouillage du portefeuille, l’intervalle des alertes et la devise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא את ההגדרות והן אופסו לברירות המחדל. בדקו את נעילת תיק ההשקעות, מרווח ההתראות והמטבע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स पढ़ी नहीं जा सकीं और डिफ़ॉल्ट पर रीसेट कर दी गईं। कृपया पोर्टफ़ोलियो लॉक, अलार्म का अंतराल और मुद्रा जाँच लो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállításokat nem sikerült beolvasni, ezért visszaálltak az alapértékekre. Ellenőrizd a portfóliózárat, a riasztások időközét és a pénznemet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan tidak dapat dibaca dan telah direset ke nilai bawaan. Periksa kunci portofolio, interval alarm, dan mata uang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere le impostazioni, che sono state riportate ai valori predefiniti. Controlla il blocco portafoglio, l’intervallo degli allarmi e la valuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を読み込めなかったため、初期値にリセットしました。ポートフォリオのロック、アラームの間隔、通貨を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 읽을 수 없어 기본값으로 초기화했습니다. 포트폴리오 잠금, 경보 간격, 통화를 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillingene kunne ikke leses og er tilbakestilt til standardverdiene. Kontroller porteføljelåsen, alarmintervallet og valutaen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instellingen konden niet worden gelezen en zijn teruggezet naar de standaardwaarden. Controleer de Portfolio-vergrendeling, het interval van de alarmen en de valuta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać ustawień, więc przywrócono wartości domyślne. Sprawdź blokadę portfela, interwał alarmów i walutę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as definições, que foram repostas para os valores predefinidos. Verifica o bloqueio do portfólio, o intervalo dos alarmes e a moeda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as configurações, que foram redefinidas para os valores padrão. Verifique o bloqueio do portfólio, o intervalo dos alarmes e a moeda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările nu au putut fi citite și au fost resetate la valorile implicite. Verifică blocarea portofoliului, intervalul alarmelor și moneda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать настройки, поэтому они сброшены к значениям по умолчанию. Проверь блокировку портфеля, интервал оповещений и валюту."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilësimet nuk u lexuan dot dhe u rivendosën në vlerat e parazgjedhura. Kontrollo kyçjen e portofolit, intervalin e alarmeve dhe monedhën."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningarna kunde inte läsas och har återställts till standardvärdena. Kontrollera portföljlåset, larmintervallet och valutan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านการตั้งค่าไม่ได้ จึงรีเซ็ตเป็นค่าเริ่มต้น โปรดตรวจสอบล็อกพอร์ตโฟลิโอ ช่วงเวลาของสัญญาณเตือน และสกุลเงิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar okunamadı ve varsayılan değerlere sıfırlandı. Lütfen portföy kilidini, alarm aralığını ve para birimini kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати налаштування, тому їх скинуто до типових значень. Перевір блокування портфеля, інтервал сигналів і валюту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được cài đặt nên đã đặt lại về mặc định. Vui lòng kiểm tra khóa danh mục, chu kỳ cảnh báo và tiền tệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取设置，已恢复为默认值。请检查投资组合锁、提醒间隔和货币。"
          }
        }
      }
    },
