        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfıra yakın, iki ortalamanın neredeyse buluştuğunu; çok negatif ise birbirinden uzak olduklarını gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близько нуля — дві середні майже сходяться, сильно від’ємне — вони далеко одна від одної."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gần 0 nghĩa là hai đường trung bình gần chạm nhau, âm nhiều nghĩa là chúng cách xa nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接近零表示两条均线几乎相交，明显为负表示相距很远。"
          }
        }
      }
    },
    "ind_read_puell" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المرتفع يعني أن المعدّنين يكسبون أكثر بكثير من المعتاد، والمنخفض أقل بكثير."
          }
