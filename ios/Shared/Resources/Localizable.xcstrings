          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có mã PIN hoặc mật mã thiết bị thì khóa không ẩn được gì – hãy thiết lập khóa màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有设备 PIN 或密码，锁定什么也隐藏不了——请设置屏幕锁定。"
