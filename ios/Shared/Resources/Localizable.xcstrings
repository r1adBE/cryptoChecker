    "system_backup_not_imported_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة نسخة المحفظة من نسخة Android الاحتياطية للنظام حتى في المحاولة الثانية، وقد حُذفت. إذا كان لديك ملف نسخ احتياطي، فاستعده من «%1$@» في الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopii portfolia ze systémové zálohy Androidu se nepodařilo přečíst ani na druhý pokus a byla smazána. Pokud máš soubor zálohy, obnov ho v Nastavení pod „%1$@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porteføljekopien fra Androids systembackup kunne ikke læses, heller ikke ved andet forsøg, og er slettet. Har du en backupfil, så gendan den under “%1$@” i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Portfolio-Kopie aus der Android-Systemsicherung liess sich auch beim zweiten Versuch nicht lesen und wurde gelöscht. Hast du eine Sicherungsdatei, spiele sie in den Einstellungen unter «%1$@» ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αντίγραφο του χαρτοφυλακίου από το αντίγραφο ασφαλείας συστήματος του Android δεν διαβάστηκε ούτε στη δεύτερη προσπάθεια και διαγράφηκε. Αν έχεις αρχείο αντιγράφου ασφαλείας, επανάφερέ το στις Ρυθμίσεις, στο «%1$@»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The portfolio copy from the Android system backup could not be read, even on a second attempt, and has been deleted. If you have a backup file, restore it under “%1$@” in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia del portafolio de la copia de seguridad del sistema Android no se pudo leer, ni siquiera en un segundo intento, y se ha eliminado. Si tienes un archivo de copia, restáuralo en Ajustes, en «%1$@»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ سبد از پشتیبان سیستم Android حتی در تلاش دوم خوانده نشد و حذف شد. اگر فایل پشتیبان داری، آن را در تنظیمات از «%1$@» بازیابی کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salkun kopiota Androidin järjestelmävarmuuskopiosta ei voitu lukea toisellakaan yrityksellä, ja se poistettiin. Jos sinulla on varmuuskopiotiedosto, palauta se Asetuksissa kohdassa ”%1$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie du portefeuille issue de la sauvegarde système Android n'a pas pu être lue, même au second essai, et a été supprimée. Si tu as un fichier de sauvegarde, restaure-le dans les Réglages, sous « %1$@ »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא את עותק התיק מגיבוי המערכת של Android, גם בניסיון השני, והוא נמחק. אם יש לך קובץ גיבוי, שחזרו אותו בהגדרות תחת „%1$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android सिस्टम बैकअप से पोर्टफ़ोलियो की कॉपी दूसरी कोशिश में भी पढ़ी नहीं जा सकी और हटा दी गई। अगर तुम्हारे पास बैकअप फ़ाइल है, तो उसे सेटिंग्स में “%1$@” के तहत बहाल करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A portfólió másolata az Android rendszermentéséből második próbálkozásra sem volt olvasható, ezért törlődött. Ha van mentési fájlod, állítsd vissza a Beállításokban, a „%1$@” alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan portofolio dari cadangan sistem Android tidak dapat dibaca, bahkan pada percobaan kedua, dan telah dihapus. Jika kamu punya file cadangan, pulihkan di Pengaturan pada “%1$@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia del portafoglio dal backup di sistema Android non è stata letta nemmeno al secondo tentativo ed è stata eliminata. Se hai un file di backup, ripristinalo in Impostazioni, in «%1$@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android のシステムバックアップにあるポートフォリオのコピーは 2 回目の試行でも読み込めなかったため削除されました。バックアップファイルがある場合は、設定の「%1$@」から復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 시스템 백업의 포트폴리오 사본을 두 번째 시도에서도 읽지 못해 삭제했습니다. 백업 파일이 있으면 설정의 “%1$@”에서 복원하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porteføljekopien fra Androids systemsikkerhetskopi kunne ikke leses, heller ikke ved andre forsøk, og er slettet. Har du en sikkerhetskopifil, gjenoppretter du den under «%1$@» i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De portfoliokopie uit de Android-systeemback-up kon ook bij een tweede poging niet worden gelezen en is verwijderd. Heb je een back-upbestand, zet het dan terug via “%1$@” in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopii portfela z kopii systemowej Androida nie udało się odczytać nawet za drugim razem i została usunięta. Jeśli masz plik kopii, przywróć go w Ustawieniach w sekcji „%1$@”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia do portefólio da cópia de segurança do sistema Android não pôde ser lida, nem numa segunda tentativa, e foi eliminada. Se tiveres um ficheiro de cópia, restaura-o nas Definições, em «%1$@»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia do portfólio do backup do sistema Android não pôde ser lida, nem em uma segunda tentativa, e foi excluída. Se você tiver um arquivo de backup, restaure-o em “%1$@” nas Configurações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia portofoliului din backupul de sistem Android nu a putut fi citită nici la a doua încercare și a fost ștearsă. Dacă ai un fișier de backup, restaurează-l în Setări, la „%1$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копию портфеля из системной резервной копии Android не удалось прочитать даже со второй попытки, и она удалена. Если у тебя есть файл резервной копии, восстанови его в настройках в разделе «%1$@»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopja e portofolit nga kopja rezervë e sistemit Android nuk u lexua as në provën e dytë dhe u fshi. Nëse ke një skedar kopjeje rezervë, rikthe atë te Cilësimet, nën “%1$@”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portföljkopian från Androids systemsäkerhetskopia kunde inte läsas, inte ens vid andra försöket, och har raderats. Har du en säkerhetskopiefil återställer du den under ”%1$@” i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านสำเนาพอร์ตโฟลิโอจากข้อมูลสำรองของระบบ Android ไม่ได้แม้ในครั้งที่สอง จึงลบทิ้งแล้ว หากคุณมีไฟล์สำรอง ให้กู้คืนได้ที่ “%1$@” ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sistem yedeğindeki portföy kopyası ikinci denemede de okunamadı ve silindi. Yedek dosyan varsa Ayarlar'da “%1$@” altında geri yükle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копію портфеля із системної резервної копії Android не вдалося прочитати навіть з другої спроби, тому її видалено. Якщо маєш файл резервної копії, віднови його в налаштуваннях у розділі «%1$@»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được bản sao danh mục từ bản sao lưu hệ thống Android, kể cả ở lần thử thứ hai, nên đã xóa. Nếu có tệp sao lưu, hãy khôi phục trong Cài đặt, mục “%1$@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 Android 系统备份的投资组合副本在第二次尝试时仍无法读取，已被删除。如果你有备份文件，请在设置的“%1$@”中恢复。"
          }
        }
      }
    },
