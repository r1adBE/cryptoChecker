    "macro_hint_list" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – في أيام كهذه تتقلب الأسواق غالبًا أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – v takové dny trh často kolísá víc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – på sådanne dage svinger markedet ofte mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – an solchen Tagen schwankt der Markt oft stärker."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – τέτοιες μέρες οι αγορές συχνά κινούνται πιο έντονα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – markets often swing more on days like this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – en días así los mercados suelen moverse más."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – در چنین روزهایی بازار اغلب نوسان بیشتری دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – tällaisina päivinä markkinat heiluvat usein enemmän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – les marchés bougent souvent davantage ces jours-là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – בימים כאלה השווקים נוטים לתנודות חזקות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – ऐसे दिनों में बाज़ार अक्सर ज़्यादा उतार-चढ़ाव दिखाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – ilyen napokon a piac gyakran erősebben ingadozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – pada hari seperti ini pasar sering bergejolak lebih kuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – in giorni come questo i mercati oscillano spesso di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – こうした日は相場が大きく動きやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – 이런 날에는 시장 변동이 커지는 경우가 많습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – på slike dager svinger markedet ofte mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – op zulke dagen schommelt de markt vaak sterker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – w takie dni rynek często waha się mocniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – em dias assim os mercados oscilam muitas vezes mais."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – em dias assim o mercado costuma oscilar mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – în astfel de zile piețele fluctuează adesea mai mult."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – в такие дни рынок часто колеблется сильнее."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – në ditë të tilla tregjet shpesh luhaten më shumë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – sådana dagar svänger marknaden ofta mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – วันแบบนี้ตลาดมักผันผวนมากกว่าปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – böyle günlerde piyasa çoğu zaman daha sert dalgalanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – у такі дні ринок часто коливається сильніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – những ngày như vậy thị trường thường dao động mạnh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@——这类日子市场往往波动更大。"
          }
        }
      }
    },
