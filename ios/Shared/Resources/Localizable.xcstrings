            "value" : "Нужен Android 9 или новее – более старые версии сохранили бы портфель без шифрования в резервной копии Google."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkon Android 9 ose më të ri – versionet më të vjetra do ta ruanin portofolin pa enkriptim në kopjen e Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver Android 9 eller senare – äldre versioner skulle spara portföljen okrypterad i Google-säkerhetskopian."
          }
