    "backup_not_enough_memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد ذاكرة متاحة كافية لحماية النسخة الاحتياطية أو فتحها بكلمة مرور. أغلق التطبيقات الأخرى وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostatek volné paměti k ochraně nebo otevření zálohy heslem. Zavři jiné aplikace a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke nok ledig hukommelse til at beskytte eller åbne sikkerhedskopien med en adgangskode. Luk andre apps, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu wenig freier Arbeitsspeicher, um die Sicherung mit Passwort zu schützen oder zu öffnen. Andere Apps schliessen und erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει αρκετή ελεύθερη μνήμη για την προστασία ή το άνοιγμα του αντιγράφου ασφαλείας με κωδικό. Κλείσε άλλες εφαρμογές και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free memory to protect or open the backup with a password. Close other apps and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente memoria libre para proteger o abrir la copia de seguridad con contraseña. Cierra otras apps e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظهٔ آزاد کافی برای محافظت یا باز کردن نسخهٔ پشتیبان با گذرواژه وجود ندارد. برنامه‌های دیگر را ببند و دوباره تلاش کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaata muistia ei ole tarpeeksi varmuuskopion suojaamiseen tai avaamiseen salasanalla. Sulje muita sovelluksia ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire libre insuffisante pour protéger ou ouvrir la sauvegarde avec un mot de passe. Ferme d’autres apps et réessaie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מספיק זיכרון פנוי כדי להגן על הגיבוי או לפתוח אותו עם סיסמה. סגרו אפליקציות אחרות ונסו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड से बैकअप को सुरक्षित करने या खोलने के लिए पर्याप्त खाली मेमोरी नहीं है। दूसरे ऐप बंद करो और फिर से कोशिश करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs elég szabad memória a biztonsági mentés jelszavas védelméhez vagy megnyitásához. Zárj be más alkalmazásokat, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memori kosong tidak cukup untuk melindungi atau membuka cadangan dengan kata sandi. Tutup aplikasi lain dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria libera insufficiente per proteggere o aprire il backup con una password. Chiudi altre app e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードでバックアップを保護または開くための空きメモリが不足しています。ほかのアプリを閉じてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호로 백업을 보호하거나 열기에 사용 가능한 메모리가 부족합니다. 다른 앱을 닫고 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke nok ledig minne til å beskytte eller åpne sikkerhetskopien med passord. Lukk andre apper og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onvoldoende vrij geheugen om de back-up met een wachtwoord te beveiligen of te openen. Sluit andere apps en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mało wolnej pamięci, aby zabezpieczyć lub otworzyć kopię zapasową hasłem. Zamknij inne aplikacje i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória livre insuficiente para proteger ou abrir a cópia de segurança com palavra-passe. Fecha outras apps e tenta novamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória livre insuficiente para proteger ou abrir o backup com senha. Feche outros apps e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorie liberă insuficientă pentru a proteja sau deschide copia de rezervă cu parolă. Închide alte aplicații și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободной памяти, чтобы защитить или открыть резервную копию паролем. Закрой другие приложения и повтори попытку."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk ka mjaftueshëm memorie të lirë për të mbrojtur ose hapur kopjen rezervë me fjalëkalim. Mbyll aplikacionet e tjera dhe provo përsëri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte tillräckligt med ledigt minne för att skydda eller öppna säkerhetskopian med lösenord. Stäng andra appar och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน่วยความจำว่างไม่พอสำหรับป้องกันหรือเปิดข้อมูลสำรองด้วยรหัสผ่าน ปิดแอปอื่นแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeği parolayla korumak veya açmak için yeterli boş bellek yok. Diğer uygulamaları kapatıp tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостатньо вільної пам’яті, щоб захистити або відкрити резервну копію паролем. Закрий інші застосунки й спробуй ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ bộ nhớ trống để bảo vệ hoặc mở bản sao lưu bằng mật khẩu. Hãy đóng các ứng dụng khác và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用内存不足，无法用密码保护或打开备份。请关闭其他应用后重试。"
          }
        }
      }
    },
    "backup_not_verified" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من ملف النسخة الاحتياطية بعد حفظه، إذ يُقرأ بشكل مختلف. يُرجى حفظ النسخة في ملف جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor zálohy se po uložení nepodařilo ověřit – při zpětném čtení se liší. Ulož prosím zálohu do nového souboru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backupfilen kunne ikke bekræftes efter gemning – den læses anderledes tilbage. Gem backuppet i en ny fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherungsdatei liess sich nach dem Speichern nicht bestätigen – sie liest sich anders zurück. Bitte speichere die Sicherung in eine neue Datei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχείο αντιγράφου δεν επαληθεύτηκε μετά την αποθήκευση – διαβάζεται διαφορετικά. Αποθήκευσε το αντίγραφο σε νέο αρχείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup file could not be verified after saving – it reads back differently. Please save the backup to a new file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el archivo de copia tras guardarlo: al leerlo de nuevo es distinto. Guarda la copia en un archivo nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل پشتیبان پس از ذخیره تأیید نشد؛ هنگام خواندن دوباره متفاوت است. لطفاً نسخهٔ پشتیبان را در فایل جدیدی ذخیره کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiotiedostoa ei voitu vahvistaa tallennuksen jälkeen – se luetaan takaisin erilaisena. Tallenna varmuuskopio uuteen tiedostoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de sauvegarde n'a pas pu être vérifié après l'enregistrement : relu, il diffère. Enregistre la sauvegarde dans un nouveau fichier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לאמת את קובץ הגיבוי לאחר השמירה – בקריאה חוזרת הוא שונה. נא לשמור את הגיבוי בקובץ חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजने के बाद बैकअप फ़ाइल की पुष्टि नहीं हो सकी – वापस पढ़ने पर वह अलग है। कृपया बैकअप किसी नई फ़ाइल में सहेजो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentésfájlt mentés után nem sikerült ellenőrizni – visszaolvasva eltér. Mentsd a biztonsági mentést új fájlba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File cadangan tidak dapat diverifikasi setelah disimpan – saat dibaca ulang isinya berbeda. Simpan cadangan ke file baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare il file di backup dopo il salvataggio: riletto risulta diverso. Salva il backup in un nuovo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後にバックアップファイルを確認できませんでした（読み戻すと内容が異なります）。新しいファイルに保存し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 후 백업 파일을 확인하지 못했습니다. 다시 읽으면 내용이 다릅니다. 새 파일에 백업을 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopifilen kunne ikke bekreftes etter lagring – den leses tilbake annerledes. Lagre sikkerhetskopien i en ny fil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het back-upbestand kon na het opslaan niet worden gecontroleerd – teruggelezen wijkt het af. Sla de back-up op in een nieuw bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zweryfikować pliku kopii po zapisaniu – odczytany ponownie różni się. Zapisz kopię w nowym pliku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o ficheiro da cópia após guardá-lo – ao ser relido é diferente. Guarda a cópia num ficheiro novo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o arquivo de backup depois de salvo – ao ser lido de novo ele é diferente. Salve o backup em um arquivo novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul de backup nu a putut fi verificat după salvare – recitit, este diferit. Salvează backupul într-un fișier nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить файл копии после сохранения: при повторном чтении он отличается. Сохрани копию в новый файл."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedari i kopjes rezervë nuk u verifikua pas ruajtjes – i rilexuar ndryshon. Ruaje kopjen në një skedar të ri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopiefilen kunde inte bekräftas efter sparandet – den läses tillbaka annorlunda. Spara säkerhetskopian i en ny fil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันไฟล์ข้อมูลสำรองหลังบันทึกไม่ได้ เพราะอ่านกลับมาแล้วไม่ตรงกัน โปรดบันทึกข้อมูลสำรองลงไฟล์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedek dosyası kaydedildikten sonra doğrulanamadı; geri okunduğunda farklı. Lütfen yedeği yeni bir dosyaya kaydet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перевірити файл копії після збереження: під час повторного читання він відрізняється. Збережи копію в новий файл."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh tệp sao lưu sau khi lưu – khi đọc lại thì khác. Hãy lưu bản sao lưu vào một tệp mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存后无法验证备份文件——读回的内容不一致。请将备份保存到新文件。"
          }
        }
      }
    },
