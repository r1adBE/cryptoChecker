    "tax_summary_ch_wealth_orientation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المرجع هو قائمة أسعار ESTV (ictax.admin.ch). للعملات غير المدرجة فيها يُطبَّق عادةً سعر إغلاق المنصة. ضريبة الثروة غير محسوبة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozhodující je kurzovní lístek ESTV (ictax.admin.ch). Pro coiny bez záznamu v lístku platí zpravidla závěrečný kurz burzy. Daň z majetku se nepočítá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESTV-kurslisten (ictax.admin.ch) er afgørende. For coins uden notering på listen gælder som regel børsens lukkekurs. Formueskat beregnes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massgebend ist die Kursliste der ESTV (ictax.admin.ch). Für Coins ohne Kurslisten-Eintrag gilt in der Regel der Schlusskurs der Börse. Vermögenssteuer nicht gerechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθοριστικός είναι ο κατάλογος τιμών της ESTV (ictax.admin.ch). Για κρυπτονομίσματα χωρίς καταχώριση ισχύει κατά κανόνα η τιμή κλεισίματος του ανταλλακτηρίου. Ο φόρος περιουσίας δεν υπολογίζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ESTV price list (ictax.admin.ch) is authoritative. For coins not on the list, the exchange closing price generally applies. Wealth tax not calculated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevalece la lista de cotizaciones de la ESTV (ictax.admin.ch). Para las monedas sin cotización en la lista se aplica por lo general el precio de cierre del exchange. Impuesto sobre el patrimonio no calculado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاک، فهرست نرخ ESTV است (ictax.admin.ch). برای کوین‌هایی که در فهرست نیستند، معمولاً قیمت پایانی صرافی ملاک است. مالیات بر ثروت محاسبه نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratkaiseva on ESTV:n kurssiluettelo (ictax.admin.ch). Coineille, joita luettelossa ei ole, käytetään yleensä pörssin päätöskurssia. Varallisuusveroa ei laskettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des cours de l’AFC (ictax.admin.ch) fait foi. Pour les coins sans cours dans la liste, le cours de clôture de la plateforme s’applique en règle générale. Impôt sur la fortune non calculé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקובע הוא רשימת השערים של ESTV (ictax.admin.ch). למטבעות שאינם ברשימה חל בדרך כלל שער הסגירה של הבורסה. מס עושר לא מחושב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESTV मूल्य सूची (ictax.admin.ch) निर्णायक है। सूची में न होने वाले कॉइन के लिए सामान्यतः एक्सचेंज का समापन मूल्य लागू होता है। संपत्ति कर की गणना नहीं की गई।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ESTV árfolyamlistája (ictax.admin.ch) az irányadó. A listán nem szereplő coinoknál általában a tőzsdei záróár érvényes. Vagyonadó nincs kiszámítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang menentukan adalah daftar kurs ESTV (ictax.admin.ch). Untuk koin tanpa entri di daftar, biasanya berlaku harga penutupan bursa. Pajak kekayaan tidak dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa stato la lista dei corsi dell’AFC (ictax.admin.ch). Per i coin senza corso nella lista vale di regola il prezzo di chiusura della piattaforma. Imposta sulla sostanza non calcolata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基準は ESTV 価格リスト（ictax.admin.ch）です。リストにないコインには通常、取引所の終値が適用されます。財産税は計算していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기준은 ESTV 시세표(ictax.admin.ch)입니다. 시세표에 없는 코인은 일반적으로 거래소 종가가 적용됩니다. 재산세는 계산하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESTV-kurslisten (ictax.admin.ch) er avgjørende. For coins uten notering på listen gjelder som regel børsens sluttkurs. Formuesskatt beregnes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepalend is de koerslijst van de ESTV (ictax.admin.ch). Voor coins zonder vermelding op de lijst geldt doorgaans de slotkoers van de beurs. Vermogensbelasting niet berekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiążąca jest lista kursów ESTV (ictax.admin.ch). Dla coinów bez wpisu na liście obowiązuje z reguły kurs zamknięcia giełdy. Podatek od majątku nie jest liczony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevalece a lista de cotações da ESTV (ictax.admin.ch). Para moedas sem cotação na lista aplica-se, em regra, o preço de fecho da plataforma. Imposto sobre o património não calculado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a lista de cotações da ESTV (ictax.admin.ch). Para moedas sem cotação na lista vale, em regra, o preço de fechamento da corretora. Imposto sobre patrimônio não calculado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determinantă este lista de cursuri ESTV (ictax.admin.ch). Pentru monedele fără curs în listă se aplică de regulă prețul de închidere al bursei. Impozitul pe avere nu se calculează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяющим является курсовой лист ESTV (ictax.admin.ch). Для монет без записи в листе, как правило, применяется цена закрытия биржи. Налог на имущество не рассчитывается."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendimtare është lista e kurseve e ESTV (ictax.admin.ch). Për monedhat pa regjistrim në listë vlen zakonisht çmimi i mbylljes së bursës. Tatimi mbi pasurinë nuk llogaritet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESTV:s kurslista (ictax.admin.ch) är avgörande. För coins utan notering i listan gäller i regel börsens stängningskurs. Förmögenhetsskatt beräknas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยึดตามรายการราคา ESTV (ictax.admin.ch) สำหรับเหรียญที่ไม่มีในรายการ โดยทั่วไปใช้ราคาปิดของกระดานเทรด ไม่ได้คำนวณภาษีทรัพย์สิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esas olan ESTV kur listesidir (ictax.admin.ch). Listede yer almayan coinler için genellikle borsanın kapanış fiyatı geçerlidir. Servet vergisi hesaplanmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначальним є курсовий лист ESTV (ictax.admin.ch). Для монет без запису в листі, як правило, застосовується ціна закриття біржі. Податок на майно не розраховується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căn cứ là bảng giá ESTV (ictax.admin.ch). Với coin không có trong bảng, thường áp dụng giá đóng cửa của sàn. Không tính thuế tài sản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 ESTV 价目表（ictax.admin.ch）为准。价目表未列出的币种通常适用交易所收盘价。不计算财富税。"
          }
        }
      }
    },
