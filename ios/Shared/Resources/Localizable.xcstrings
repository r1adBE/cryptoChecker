            "value" : "اليوم لم ينتهِ بعد: يُستخدم السعر الحالي بدلًا من سعر الإغلاق اليومي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní den ještě neskončil: místo denní závěrečné ceny se použije aktuální kurz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen i dag er ikke slut endnu: den aktuelle kurs bruges i stedet for dagens lukkekurs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der heutige Tag ist noch nicht abgeschlossen: Statt des Tagesschlusskurses wird der aktuelle Kurs verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σημερινή ημέρα δεν έχει ολοκληρωθεί ακόμη: χρησιμοποιείται η τρέχουσα τιμή αντί για την τιμή κλεισίματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is not finished yet: the current price is used instead of the daily close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El día de hoy aún no ha terminado: se usa el precio actual en lugar del cierre diario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امروز هنوز تمام نشده است: به‌جای قیمت بسته شدن روزانه، قیمت فعلی استفاده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä päivä ei ole vielä päättynyt: päivän päätöskurssin sijaan käytetään nykyistä kurssia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée n'est pas encore terminée : le cours actuel est utilisé à la place du cours de clôture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היום עוד לא הסתיים: במקום שער הסגירה היומי נעשה שימוש בשער הנוכחי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का दिन अभी पूरा नहीं हुआ: दिन के क्लोज़िंग भाव की जगह मौजूदा भाव इस्तेमाल होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai nap még nem zárult le: a napi záróár helyett az aktuális árfolyam szerepel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini belum selesai: harga saat ini digunakan sebagai pengganti harga penutupan harian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La giornata di oggi non è ancora conclusa: al posto della chiusura giornaliera si usa il prezzo attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はまだ終わっていません：日足の終値の代わりに現在の価格を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 아직 끝나지 않았습니다: 일일 종가 대신 현재 가격을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen i dag er ikke over ennå: gjeldende kurs brukes i stedet for dagens sluttkurs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
