    "portfolio_address_xpub_gap" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف البحث عندما يبلغ عدد العناوين غير المستخدمة المتتالية %1$ld (معيار BIP44 الذي تستخدمه معظم المحافظ). لا يُحتسب عنوان مستخدم يقع بعد هذه الفجوة – أضفه بشكل منفصل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledání skončí po %1$ld nepoužitých adresách za sebou (standard BIP44, který používá většina peněženek). Použitá adresa za touto mezerou se nezapočítá – přidej ji samostatně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søgningen stopper efter %1$ld ubrugte adresser i træk (BIP44-standarden, som de fleste wallets bruger). En brugt adresse efter dette hul tælles ikke med – tilføj den separat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche endet nach %1$ld unbenutzten Adressen in Folge (BIP44-Standard, den die meisten Wallets nutzen). Eine benutzte Adresse hinter dieser Lücke wird nicht mitgezählt – füge sie einzeln hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναζήτηση σταματά μετά από %1$ld αχρησιμοποίητες διευθύνσεις στη σειρά (το πρότυπο BIP44 που χρησιμοποιούν τα περισσότερα πορτοφόλια). Μια χρησιμοποιημένη διεύθυνση πέρα από αυτό το κενό δεν μετράται – πρόσθεσέ την ξεχωριστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The search stops after %1$ld unused addresses in a row (the BIP44 standard most wallets use). A used address beyond that gap is not counted – add it separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda se detiene tras %1$ld direcciones sin usar seguidas (el estándar BIP44 que usan la mayoría de los monederos). Una dirección usada más allá de ese hueco no se cuenta: añádela por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جستجو پس از %1$ld نشانی استفاده‌نشده پشت سر هم متوقف می‌شود (استاندارد BIP44 که بیشتر کیف‌پول‌ها به کار می‌برند). نشانی استفاده‌شده‌ای که پس از این فاصله باشد شمرده نمی‌شود – آن را جداگانه اضافه کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haku päättyy %1$ld peräkkäisen käyttämättömän osoitteen jälkeen (useimpien lompakoiden käyttämä BIP44-standardi). Tämän aukon jälkeistä käytettyä osoitetta ei lasketa – lisää se erikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche s'arrête après %1$ld adresses inutilisées consécutives (norme BIP44 utilisée par la plupart des portefeuilles). Une adresse utilisée au-delà de cet écart n'est pas comptée – ajoute-la séparément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיפוש נעצר אחרי %1$ld כתובות לא בשימוש ברצף (תקן BIP44 שבו משתמשים רוב הארנקים). כתובת בשימוש שנמצאת מעבר לפער הזה לא נספרת – הוסיפו אותה בנפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार %1$ld अप्रयुक्त पतों के बाद खोज रुक जाती है (BIP44 मानक, जिसका उपयोग अधिकांश वॉलेट करते हैं)। इस अंतराल के बाद का कोई उपयोग किया गया पता नहीं गिना जाता – उसे अलग से जोड़ो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A keresés %1$ld egymást követő használatlan cím után leáll (a legtöbb tárca által használt BIP44-szabvány). Az ezen a résen túli használt címet nem számolja – add hozzá külön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian berhenti setelah %1$ld alamat tidak terpakai berturut-turut (standar BIP44 yang dipakai sebagian besar dompet). Alamat terpakai di luar celah itu tidak dihitung – tambahkan secara terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca si ferma dopo %1$ld indirizzi inutilizzati consecutivi (lo standard BIP44 usato dalla maggior parte dei wallet). Un indirizzo usato oltre questo intervallo non viene contato – aggiungilo separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未使用のアドレスが連続 %1$ld 件続くと検索を終了します（多くのウォレットが採用する BIP44 標準）。その先にある使用済みアドレスは集計されません。個別に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하지 않은 주소가 연속으로 %1$ld개 나오면 검색을 멈춥니다(대부분의 지갑이 쓰는 BIP44 표준). 그 간격 뒤에 있는 사용된 주소는 계산되지 않으니 따로 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søket stopper etter %1$ld ubrukte adresser på rad (BIP44-standarden de fleste lommebøker bruker). En brukt adresse etter dette gapet telles ikke med – legg den til separat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zoeken stopt na %1$ld ongebruikte adressen op rij (de BIP44-standaard die de meeste wallets gebruiken). Een gebruikt adres voorbij dat gat wordt niet meegeteld – voeg het apart toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie kończy się po %1$ld nieużywanych adresach z rzędu (standard BIP44 stosowany przez większość portfeli). Używany adres za tą luką nie jest liczony – dodaj go osobno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pesquisa termina após %1$ld endereços não utilizados seguidos (a norma BIP44 usada pela maioria das carteiras). Um endereço utilizado para além desse intervalo não é contado – adiciona-o em separado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca para depois de %1$ld endereços não usados em sequência (o padrão BIP44 usado pela maioria das carteiras). Um endereço usado além desse intervalo não é contado – adicione-o separadamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căutarea se oprește după %1$ld adrese nefolosite consecutive (standardul BIP44 folosit de majoritatea portofelelor). O adresă folosită dincolo de acest gol nu este numărată – adaug-o separat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск останавливается после %1$ld неиспользованных адресов подряд (стандарт BIP44, который используют большинство кошельков). Использованный адрес за этим промежутком не учитывается – добавь его отдельно."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkimi ndalon pas %1$ld adresash të papërdorura radhazi (standardi BIP44 që përdorin shumica e portofolave). Një adresë e përdorur përtej këtij boshllëku nuk numërohet – shtoje veçmas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökningen avbryts efter %1$ld oanvända adresser i rad (BIP44-standarden som de flesta plånböcker använder). En använd adress efter det glappet räknas inte – lägg till den separat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การค้นหาจะหยุดหลังพบที่อยู่ที่ไม่ได้ใช้ติดต่อกัน %1$ld รายการ (มาตรฐาน BIP44 ที่วอลเล็ตส่วนใหญ่ใช้) ที่อยู่ที่ใช้แล้วซึ่งอยู่ถัดจากช่วงนี้จะไม่ถูกนับ – ให้เพิ่มแยกต่างหาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama, art arda %1$ld kullanılmamış adresten sonra durur (çoğu cüzdanın kullandığı BIP44 standardı). Bu boşluğun ötesindeki kullanılmış bir adres sayılmaz – onu ayrıca ekle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук зупиняється після %1$ld невикористаних адрес поспіль (стандарт BIP44, який використовує більшість гаманців). Використана адреса за цим проміжком не враховується – додай її окремо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc tìm kiếm dừng sau %1$ld địa chỉ chưa dùng liên tiếp (chuẩn BIP44 mà hầu hết ví sử dụng). Địa chỉ đã dùng nằm sau khoảng trống đó sẽ không được tính – hãy thêm riêng địa chỉ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续出现 %1$ld 个未使用的地址后停止搜索（大多数钱包采用的 BIP44 标准）。此间隔之后的已使用地址不会被计入，请单独添加。"
          }
        }
      }
    },
