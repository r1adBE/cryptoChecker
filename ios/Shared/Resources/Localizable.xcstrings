    "battery_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في معلومات التطبيق، اضغط على البطارية (أو استخدام بطارية التطبيق) واختر غير مقيّد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V informacích o aplikaci klepni na Baterie (nebo Využití baterie aplikací) a zvol Neomezeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Batteri (eller Appens batteriforbrug) i appinfo, og vælg Ubegrænset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der App-Info auf «Akku» (bzw. «Akkunutzung der App») tippen und «Nicht eingeschränkt» wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις πληροφορίες εφαρμογής πάτα Μπαταρία (ή Χρήση μπαταρίας εφαρμογής) και επίλεξε Χωρίς περιορισμούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the app info, tap Battery (or App battery usage) and choose Unrestricted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la información de la app, toca Batería (o Uso de batería de la app) y elige Sin restricciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در اطلاعات برنامه روی باتری (یا مصرف باتری برنامه) بزن و نامحدود را انتخاب کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta sovelluksen tiedoissa Akku (tai Sovelluksen akun käyttö) ja valitse Rajoittamaton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les infos de l'app, touche Batterie (ou Utilisation de la batterie) et choisis Non restreinte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפרטי האפליקציה הקישו על סוללה (או שימוש בסוללה של האפליקציה) ובחרו ללא הגבלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप जानकारी में बैटरी (या ऐप बैटरी उपयोग) पर टैप करो और अप्रतिबंधित चुनो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazásinformációban koppints az Akkumulátor (vagy Alkalmazás akkuhasználata) elemre, és válaszd a Korlátlan lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di info aplikasi, ketuk Baterai (atau Penggunaan baterai aplikasi) lalu pilih Tidak dibatasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle info dell'app tocca Batteria (o Utilizzo batteria app) e scegli Senza restrizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ情報で「バッテリー」（または「アプリのバッテリー使用量」）をタップし、「制限なし」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 정보에서 배터리(또는 앱 배터리 사용량)를 누르고 제한 없음을 선택하세요."
