    "alarm_sentence_above" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغني عندما يرتفع %1$@ فوق %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornit, až %1$@ stoupne nad %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv mig besked, når %1$@ stiger over %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir Bescheid, wenn %1$@ über %2$@ steigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποίηση όταν το %1$@ ανέβει πάνω από %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me when %1$@ rises above %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avísame cuando %1$@ supere %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی %1$@ از %2$@ بالاتر رفت، به من خبر بده."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoita, kun %1$@ nousee yli %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me prévenir quand %1$@ dépasse %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להודיע לי כש־%1$@ עולה מעל %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब %1$@ %2$@ से ऊपर जाए, तो मुझे बताओ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – értesítés, ha az ár %2$@ fölé emelkedik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri tahu saya saat %1$@ naik di atas %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisami quando %1$@ sale sopra %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ が %2$@ を上回ったら知らせる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 가격이 %2$@ 위로 오르면 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi meg beskjed når %1$@ stiger over %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het me weten als %1$@ boven %2$@ stijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadom mnie, gdy %1$@ wzrośnie powyżej %2$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar-me quando %1$@ subir acima de %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise-me quando %1$@ subir acima de %2$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anunță-mă când %1$@ urcă peste %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщить, когда %1$@ поднимется выше %2$@."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më njofto kur %1$@ të ngjitet mbi %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddela mig när %1$@ stiger över %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งฉันเมื่อ %1$@ ขึ้นเหนือ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fiyatı %2$@ üzerine çıktığında bana haber ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомити, коли %1$@ підніметься вище %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cho tôi khi %1$@ tăng lên trên %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 %1$@ 涨破 %2$@ 时提醒我。"
          }
        }
      }
    },
