        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores de Bitcoin, verificados duas vezes por dia. Você escolhe os limites – o app não avalia os valores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatori Bitcoin, verificați de două ori pe zi. Limitele le alegi tu – aplicația nu evaluează valorile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показатели биткоина проверяются дважды в день. Границы выбираешь ты – приложение не оценивает значения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treguesit e Bitcoin, kontrollohen dy herë në ditë. Kufijtë i zgjedh ti – aplikacioni nuk i vlerëson vlerat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-nyckeltal, kontrolleras två gånger om dagen. Du väljer gränserna – appen bedömer inte värdena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวชี้วัด Bitcoin ตรวจวันละสองครั้ง คุณเลือกเกณฑ์เอง – แอปไม่ประเมินค่า"
