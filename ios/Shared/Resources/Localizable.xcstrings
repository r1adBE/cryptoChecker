    "notification_permission_preprompt_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكي تصلك التنبيهات وإشعارات الأسعار، يحتاج التطبيق إلى إذن الإشعارات. يستخدمها التطبيق فقط لتنبيهاتك وإشعارات الأسعار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby k tobě alarmy a cenová oznámení dorazily, aplikace potřebuje povolení k oznámením. Aplikace je používá jen pro tvoje alarmy a cenová oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at alarmer og kursnotifikationer kan nå frem, skal appen have tilladelse til notifikationer. Appen bruger dem kun til dine alarmer og kursnotifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Alarme und Kursmitteilungen ankommen, braucht die App die Erlaubnis für Mitteilungen. Die App nutzt sie nur für deine Alarme und Kursmitteilungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να σε φτάνουν οι συναγερμοί και οι ειδοποιήσεις τιμής, η εφαρμογή χρειάζεται άδεια για ειδοποιήσεις. Η εφαρμογή τις χρησιμοποιεί μόνο για τους συναγερμούς σου και τις ειδοποιήσεις τιμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So that alerts and price notifications reach you, the app needs permission to send notifications. The app only uses them for your alerts and price notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que te lleguen las alarmas y las notificaciones de precio, la app necesita permiso para enviar notificaciones. La app solo las usa para tus alarmas y notificaciones de precio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اینکه هشدارها و اعلان‌های قیمت به تو برسند، برنامه به اجازهٔ اعلان‌ها نیاز دارد. برنامه فقط برای هشدارها و اعلان‌های قیمت تو از آن‌ها استفاده می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotta hälytykset ja hintailmoitukset tavoittavat sinut, sovellus tarvitsee luvan ilmoituksiin. Sovellus käyttää niitä vain hälytyksiisi ja hintailmoituksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que les alertes et les notifications de prix te parviennent, l’app a besoin de l’autorisation d’envoyer des notifications. L’app ne les utilise que pour tes alertes et tes notifications de prix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי שההתראות שהגדרת ועדכוני המחיר יגיעו אליך, האפליקציה צריכה הרשאה להתראות מערכת. האפליקציה משתמשת בהן רק להתראות שהגדרת ולעדכוני המחיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म और प्राइस नोटिफ़िकेशन तुम तक पहुँचें, इसके लिए ऐप को नोटिफ़िकेशन की अनुमति चाहिए। ऐप इनका उपयोग केवल तुम्हारे अलार्म और प्राइस नोटिफ़िकेशन के लिए करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahhoz, hogy a riasztások és az árértesítések megérkezzenek, az alkalmazásnak engedély kell az értesítésekhez. Az alkalmazás csak a riasztásaidhoz és az árértesítésekhez használja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar alarm dan notifikasi harga sampai kepadamu, aplikasi memerlukan izin notifikasi. Aplikasi hanya menggunakannya untuk alarm dan notifikasi hargamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché gli allarmi e le notifiche di prezzo ti arrivino, l’app ha bisogno del permesso per le notifiche. L’app le usa solo per i tuoi allarmi e le notifiche di prezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームと価格通知を受け取るには、アプリに通知の許可が必要です。アプリは通知をアラームと価格通知にのみ使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경보와 가격 알림을 받으려면 앱에 알림 권한이 필요합니다. 앱은 알림을 경보와 가격 알림에만 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at alarmer og kursvarsler skal nå frem, trenger appen tillatelse til å sende varsler. Appen bruker dem bare til alarmene og kursvarslene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodat alarmen en koersmeldingen aankomen, heeft de app toestemming nodig voor meldingen. De app gebruikt ze alleen voor je alarmen en koersmeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby alarmy i powiadomienia o cenie do Ciebie docierały, aplikacja potrzebuje zgody na powiadomienia. Aplikacja używa ich tylko do Twoich alarmów i powiadomień o cenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que os alarmes e as notificações de preço te cheguem, a app precisa de autorização para enviar notificações. A app usa-as apenas para os teus alarmes e notificações de preço."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que os alarmes e as notificações de preço cheguem até você, o app precisa de permissão para enviar notificações. O app as usa só para os seus alarmes e notificações de preço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca alarmele și notificările de preț să ajungă la tine, aplicația are nevoie de permisiunea pentru notificări. Aplicația le folosește doar pentru alarmele și notificările tale de preț."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы оповещения и уведомления о цене доходили до тебя, приложению нужно разрешение на уведомления. Приложение использует их только для твоих оповещений и уведомлений о цене."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Që alarmet dhe njoftimet e çmimit të të arrijnë, aplikacioni ka nevojë për leje për njoftime. Aplikacioni i përdor vetëm për alarmet dhe njoftimet e tua të çmimit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att larm och kursaviseringar ska nå fram behöver appen tillåtelse att skicka aviseringar. Appen använder dem bara för dina larm och kursaviseringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อให้สัญญาณเตือนและการแจ้งเตือนราคาถึงคุณ แอปต้องได้รับอนุญาตให้ส่งการแจ้งเตือน แอปจะใช้การแจ้งเตือนเฉพาะกับสัญญาณเตือนและการแจ้งเตือนราคาของคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmların ve fiyat bildirimlerinin sana ulaşması için uygulamanın bildirim iznine ihtiyacı var. Uygulama bildirimleri yalnızca alarmların ve fiyat bildirimlerin için kullanır."
          }
        },
