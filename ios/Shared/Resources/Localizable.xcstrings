    "portfolio_storage_in_memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التشفير غير مفعّل بعد – لا يتم حفظ المحفظة، وتضيع التغييرات عند إغلاق التطبيق. سيحاول التطبيق مجددًا عند التشغيل التالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrování ještě není aktivní – portfolio se neukládá a změny se po zavření aplikace ztratí. Aplikace to zkusí znovu při příštím spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryptering er endnu ikke aktiv – porteføljen gemmes ikke, og ændringer går tabt, når appen lukkes. Appen prøver igen ved næste start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselung noch nicht aktiv – das Portfolio wird nicht gespeichert, Änderungen gehen beim Schliessen der App verloren. Die App versucht es beim nächsten Start erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κρυπτογράφηση δεν είναι ακόμη ενεργή – το χαρτοφυλάκιο δεν αποθηκεύεται και οι αλλαγές χάνονται όταν κλείσει η εφαρμογή. Η εφαρμογή θα δοκιμάσει ξανά στην επόμενη εκκίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encryption not active yet – the portfolio is not being saved, changes are lost when the app closes. The app will try again at the next start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cifrado aún no está activo: la cartera no se guarda y los cambios se pierden al cerrar la app. La app lo intentará de nuevo en el próximo inicio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمزگذاری هنوز فعال نیست – سبد ذخیره نمی‌شود و تغییرات با بستن برنامه از بین می‌روند. برنامه در اجرای بعدی دوباره تلاش می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salaus ei ole vielä käytössä – salkkua ei tallenneta, ja muutokset katoavat, kun sovellus suljetaan. Sovellus yrittää uudelleen seuraavalla käynnistyskerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrement pas encore actif – le portefeuille n'est pas enregistré, les modifications sont perdues à la fermeture de l'app. L'app réessaiera au prochain démarrage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההצפנה עדיין לא פעילה – התיק לא נשמר, ושינויים יאבדו כשהאפליקציה תיסגר. האפליקציה תנסה שוב בהפעלה הבאה."
