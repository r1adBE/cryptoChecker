        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος λειτουργεί το %1$@ βλέπει όλες τις διευθύνσεις αυτού του πορτοφολιού που ερωτώνται και μπορεί να τις συνδέσει μεταξύ τους και με τη διεύθυνση IP σου."
          }
        },
        "en" : {
          "stringUnit" : {
