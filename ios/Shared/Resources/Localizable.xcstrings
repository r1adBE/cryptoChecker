    "widget_pulse_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يلفت الانتباه في السوق الآن: عنوان وملخص قصير، إضافةً إلى Bitcoin وEthereum وSolana."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co je teď na trhu nápadné: titulek, krátké shrnutí a také Bitcoin, Ethereum a Solana."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der skiller sig ud i markedet lige nu: overskrift, kort resumé samt Bitcoin, Ethereum og Solana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was im Markt gerade auffällt: Schlagzeile, kurze Zusammenfassung sowie Bitcoin, Ethereum und Solana."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι ξεχωρίζει τώρα στην αγορά: τίτλος, σύντομη περίληψη καθώς και Bitcoin, Ethereum και Solana."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What stands out in the market right now: headline, short summary and Bitcoin, Ethereum and Solana."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que destaca ahora en el mercado: titular, resumen breve y Bitcoin, Ethereum y Solana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آنچه اکنون در بازار به چشم می‌آید: تیتر، خلاصه کوتاه و همچنین Bitcoin، Ethereum و Solana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä markkinoilla erottuu juuri nyt: otsikko, lyhyt yhteenveto sekä Bitcoin, Ethereum ja Solana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui ressort du marché en ce moment : titre, bref résumé ainsi que Bitcoin, Ethereum et Solana."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מה בולט כרגע בשוק: כותרת, סיכום קצר וגם Bitcoin, Ethereum ו־Solana."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाज़ार में अभी क्या ख़ास है: हेडलाइन, छोटा सारांश और साथ में Bitcoin, Ethereum और Solana।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami most kiemelkedik a piacon: címsor, rövid összefoglaló, valamint Bitcoin, Ethereum és Solana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang menonjol di pasar saat ini: judul, ringkasan singkat, serta Bitcoin, Ethereum, dan Solana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa spicca ora sul mercato: titolo, breve riassunto e Bitcoin, Ethereum e Solana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の市場で目立つこと：見出し、短い要約、Bitcoin・Ethereum・Solana。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 시장에서 눈에 띄는 것: 헤드라인, 짧은 요약, 그리고 Bitcoin, Ethereum, Solana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som skiller seg ut i markedet akkurat nå: overskrift, kort sammendrag og Bitcoin, Ethereum og Solana."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er nu opvalt in de markt: kop, korte samenvatting en Bitcoin, Ethereum en Solana."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co teraz wyróżnia się na rynku: nagłówek, krótkie podsumowanie oraz Bitcoin, Ethereum i Solana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que se destaca agora no mercado: título, resumo breve e ainda Bitcoin, Ethereum e Solana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que se destaca agora no mercado: manchete, resumo curto e também Bitcoin, Ethereum e Solana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce iese în evidență acum pe piață: titlu, scurt rezumat, plus Bitcoin, Ethereum și Solana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что сейчас выделяется на рынке: заголовок, краткая сводка, а также Bitcoin, Ethereum и Solana."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çfarë bie në sy tani në treg: titulli, përmbledhje e shkurtër, si dhe Bitcoin, Ethereum dhe Solana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som sticker ut på marknaden just nu: rubrik, kort sammanfattning samt Bitcoin, Ethereum och Solana."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่โดดเด่นในตลาดตอนนี้: พาดหัว สรุปสั้น รวมถึง Bitcoin, Ethereum และ Solana"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piyasada şu anda öne çıkanlar: başlık, kısa özet ve ayrıca Bitcoin, Ethereum ve Solana."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що зараз вирізняється на ринку: заголовок, короткий підсумок, а також Bitcoin, Ethereum і Solana."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều nổi bật trên thị trường lúc này: tiêu đề, tóm tắt ngắn cùng Bitcoin, Ethereum và Solana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市场当前亮点：标题、简短摘要，以及 Bitcoin、Ethereum 和 Solana。"
          }
        }
      }
    },
