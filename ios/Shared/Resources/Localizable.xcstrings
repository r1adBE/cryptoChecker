    "tax_export_method_change_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل غيّرت الطريقة أو القالب؟ تُعاد أيضًا حسابات السنوات السابقة – قارن بما قدّمته سابقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změnila se metoda nebo šablona? Přepočítají se i dřívější roky – porovnej s tím, co jsi už podal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændret metode eller skabelon? Tidligere år genberegnes også – sammenlign med det, du allerede har indberettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Methode oder Vorlage geändert? Auch frühere Jahre werden neu gerechnet – mit der abgegebenen Steuererklärung vergleichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξες μέθοδο ή πρότυπο; Υπολογίζονται ξανά και τα προηγούμενα έτη – σύγκρινε με ό,τι έχεις ήδη δηλώσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the method or template recalculates earlier years too – compare with what you already filed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cambiaste el método o la plantilla? También se recalculan los años anteriores; compáralo con lo que ya declaraste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روش یا قالب را تغییر دادی؟ سال‌های قبل هم دوباره محاسبه می‌شوند – با آنچه قبلاً اظهار کرده‌ای مقایسه کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutitko menetelmää tai pohjaa? Myös aiemmat vuodet lasketaan uudelleen – vertaa jo ilmoittamaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méthode ou modèle modifié ? Les années précédentes sont aussi recalculées – compare avec ce que tu as déjà déclaré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינית שיטה או תבנית? גם שנים קודמות מחושבות מחדש – השוו למה שכבר הגשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तरीका या टेम्पलेट बदला? पिछले साल भी दोबारा गिने जाते हैं – जो पहले दाखिल किया उससे मिलान करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módszert vagy sablont váltottál? A korábbi évek is újraszámolódnak – vesd össze a már beadottal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metode atau templat diubah? Tahun-tahun sebelumnya juga dihitung ulang – bandingkan dengan yang sudah kamu laporkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metodo o modello cambiato? Anche gli anni precedenti vengono ricalcolati – confronta con quanto già dichiarato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方法やテンプレートを変更しましたか？過去の年も再計算されます – 提出済みの申告と比べてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방법이나 템플릿을 바꿨나요? 이전 연도도 다시 계산됩니다 – 이미 신고한 내용과 비교하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endret metode eller mal? Også tidligere år beregnes på nytt – sammenlign med det du allerede har levert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Methode of sjabloon gewijzigd? Ook eerdere jaren worden opnieuw berekend – vergelijk met wat je al hebt aangegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniono metodę lub szablon? Wcześniejsze lata też zostaną przeliczone – porównaj z tym, co już złożono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudaste o método ou o modelo? Os anos anteriores também são recalculados – compara com o que já declaraste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudou o método ou o modelo? Os anos anteriores também são recalculados – compare com o que você já declarou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai schimbat metoda sau șablonul? Și anii anteriori sunt recalculați – compară cu ce ai declarat deja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Метод или шаблон изменён? Прошлые годы тоже пересчитываются – сравни с уже поданной декларацией."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndryshove metodën ose shabllonin? Edhe vitet e mëparshme rillogariten – krahasoji me atë që ke deklaruar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrad metod eller mall? Även tidigare år räknas om – jämför med det du redan deklarerat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนวิธีหรือเทมเพลตแล้วใช่ไหม ปีก่อนหน้าจะถูกคำนวณใหม่ด้วย – เทียบกับที่ยื่นไปแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöntem veya şablon değişti mi? Önceki yıllar da yeniden hesaplanır – zaten beyan ettiklerinle karşılaştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Метод або шаблон змінено? Попередні роки теж перераховуються – порівняй з уже поданою декларацією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đổi phương pháp hoặc mẫu? Các năm trước cũng được tính lại – hãy đối chiếu với những gì đã khai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改了方法或模板？以前的年份也会重新计算——请与已申报的内容核对。"
          }
        }
      }
    },
