    "about_data_device" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى القائمة والتنبيهات والمحفظة مشفّرة على هذا الجهاز؛ بلا حساب وبلا خادم خاص بنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam, alarmy a portfolio jsou uloženy šifrovaně v tomto zařízení; žádný účet, žádný vlastní server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste, alarmer og portefølje ligger krypteret på denne enhed; ingen konto, ingen egen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkliste, Alarme und Portfolio liegen verschlüsselt auf diesem Gerät; kein Konto, kein eigener Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λίστα, οι συναγερμοί και το χαρτοφυλάκιο αποθηκεύονται κρυπτογραφημένα σε αυτή τη συσκευή· χωρίς λογαριασμό, χωρίς δικό μας διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your watchlist, alerts and portfolio are stored encrypted on this device; no account, no server of our own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu lista, tus alarmas y tu cartera se guardan cifradas en este dispositivo; sin cuenta y sin servidor propio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست، هشدارها و سبد دارایی به‌صورت رمزگذاری‌شده روی همین دستگاه می‌مانند؛ بدون حساب کاربری، بدون سرور اختصاصی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, hälytykset ja salkku ovat salattuina tällä laitteella; ei tiliä, ei omaa palvelinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta liste, tes alertes et ton portefeuille sont stockés chiffrés sur cet appareil ; aucun compte, aucun serveur propre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה, ההתראות והתיק נשמרים מוצפנים במכשיר הזה; בלי חשבון, בלי שרת משלנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूची, अलार्म और पोर्टफ़ोलियो इसी डिवाइस पर एन्क्रिप्ट होकर रहते हैं; कोई खाता नहीं, कोई अपना सर्वर नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista, a riasztások és a portfólió titkosítva maradnak ezen az eszközön; nincs fiók, nincs saját szerver."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar, alarm, dan portofolio tersimpan terenkripsi di perangkat ini; tanpa akun, tanpa server sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, allarmi e portafoglio restano cifrati su questo dispositivo; nessun account, nessun server proprio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リスト、アラーム、ポートフォリオはこの端末に暗号化して保存されます。アカウントも独自サーバーもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록, 경보, 포트폴리오는 이 기기에 암호화되어 저장됩니다. 계정도 자체 서버도 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste, alarmer og portefølje ligger kryptert på denne enheten; ingen konto, ingen egen server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijst, alarmen en portfolio staan versleuteld op dit apparaat; geen account, geen eigen server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, alarmy i portfel są przechowywane w postaci zaszyfrowanej na tym urządzeniu; bez konta, bez własnego serwera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista, os alarmes e o portefólio ficam encriptados neste dispositivo; sem conta, sem servidor próprio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, alarmes e portfólio ficam criptografados neste aparelho; sem conta, sem servidor próprio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, alarmele și portofoliul rămân criptate pe acest dispozitiv; fără cont, fără server propriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список, оповещения и портфель хранятся в зашифрованном виде на этом устройстве; без аккаунта, без собственного сервера."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, alarmet dhe portofoli ruhen të enkriptuara në këtë pajisje; pa llogari, pa server të vetin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista, larm och portfölj ligger krypterade på den här enheten; inget konto, ingen egen server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการ สัญญาณเตือน และพอร์ตโฟลิโอถูกเก็บแบบเข้ารหัสบนอุปกรณ์นี้ ไม่มีบัญชี ไม่มีเซิร์ฟเวอร์ของเราเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste, alarmlar ve portföy bu cihazda şifreli olarak durur; hesap yok, kendi sunucumuz yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список, сигнали й портфель зберігаються зашифрованими на цьому пристрої; без облікового запису, без власного сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách, cảnh báo và danh mục đầu tư được lưu mã hóa trên thiết bị này; không tài khoản, không máy chủ riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表、提醒和投资组合加密保存在本设备上；无需账户，没有自有服务器。"
          }
        }
      }
    },
    "about_data_device_change" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى المفتاح على الجهاز القديم – أنشئ ملف نسخة احتياطية أولًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč zůstává ve starém zařízení – nejprve vytvoř soubor zálohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøglen bliver på den gamle enhed – opret først en sikkerhedskopifil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel bleibt auf dem alten Gerät – erstelle vorher eine Sicherungsdatei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί μένει στην παλιά συσκευή – δημιούργησε πρώτα ένα αρχείο αντιγράφου ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key stays on the old device – create a backup file first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se queda en el dispositivo antiguo: crea antes un archivo de copia de seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید روی دستگاه قدیمی می‌ماند – پیش از آن یک فایل پشتیبان بساز."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avain jää vanhaan laitteeseen – luo ensin varmuuskopiotiedosto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé reste sur l’ancien appareil – crée d’abord un fichier de sauvegarde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפתח נשאר במכשיר הישן – צרו קודם קובץ גיבוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुंजी पुराने डिवाइस पर ही रहती है – पहले एक बैकअप फ़ाइल बनाओ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcs a régi eszközön marad – előbb készíts egy mentési fájlt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
