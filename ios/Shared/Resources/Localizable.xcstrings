          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: “कीमत बोलो” वाले हर पेयर का हर अपडेट बोला जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki: minden „Ár felolvasása” jelölésű pár minden frissítése felolvasásra kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif: setiap pembaruan pasangan dengan “Ucapkan harga” akan dibacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
