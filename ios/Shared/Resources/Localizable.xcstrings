        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää Lisää-välilehden alaosassa pyynnöt pörsseihin – vianetsintään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
