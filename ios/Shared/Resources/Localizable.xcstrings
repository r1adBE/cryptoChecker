    "backup_storage_kept" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخ الاحتياطي غير ممكن: تعذّرت قراءة البيانات المحفوظة الآن. أعد تشغيل التطبيق وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohování není možné: uložená data teď nelze přečíst. Restartuj aplikaci a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopi er ikke mulig: Gemte data kan ikke læses lige nu. Genstart appen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern und Einspielen gehen nicht: Gespeicherte Daten gerade nicht lesbar. Starte die App neu und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αντιγραφή ασφαλείας δεν είναι δυνατή: τα αποθηκευμένα δεδομένα δεν μπορούν να διαβαστούν αυτή τη στιγμή. Επανεκκίνησε την εφαρμογή και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup isn't possible: saved data can't be read right now. Restart the app and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad no es posible: ahora no se pueden leer los datos guardados. Reinicia la app e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبان‌گیری ممکن نیست: داده‌های ذخیره‌شده الان خوانده نمی‌شوند. برنامه را دوباره راه‌اندازی کن و دوباره امتحان کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiointi ei ole mahdollista: tallennettuja tietoja ei voi juuri nyt lukea. Käynnistä sovellus uudelleen ja yritä uudestaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde impossible : les données enregistrées sont illisibles pour l'instant. Redémarre l'app et réessaie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גיבוי אינו אפשרי: לא ניתן לקרוא כרגע את הנתונים השמורים. הפעילו מחדש את האפליקציה ונסו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप संभव नहीं है: सहेजा गया डेटा अभी पढ़ा नहीं जा सकता। ऐप दोबारा शुरू करो और फिर से कोशिश करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonsági mentés nem lehetséges: a mentett adatok most nem olvashatók. Indítsd újra az alkalmazást, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencadangan tidak dapat dilakukan: data tersimpan tidak dapat dibaca saat ini. Mulai ulang aplikasi lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup non possibile: i dati salvati non sono leggibili al momento. Riavvia l'app e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップできません：保存済みのデータを今は読み取れません。アプリを再起動して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업할 수 없습니다: 저장된 데이터를 지금 읽을 수 없습니다. 앱을 다시 시작한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopi er ikke mulig: Lagrede data kan ikke leses akkurat nå. Start appen på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back-up is niet mogelijk: opgeslagen gegevens zijn nu niet leesbaar. Start de app opnieuw en probeer het nog eens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa nie jest możliwa: zapisanych danych nie można teraz odczytać. Uruchom aplikację ponownie i spróbuj jeszcze raz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia de segurança não é possível: os dados guardados não podem ser lidos agora. Reinicia a app e tenta novamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup não é possível: os dados salvos não podem ser lidos agora. Reinicie o app e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de rezervă nu este posibilă: datele salvate nu pot fi citite acum. Repornește aplicația și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервное копирование невозможно: сохранённые данные сейчас не удаётся прочитать. Перезапусти приложение и попробуй снова."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopja rezervë nuk është e mundur: të dhënat e ruajtura nuk mund të lexohen tani. Rinis aplikacionin dhe provo përsëri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopiering går inte: Sparade data kan inte läsas just nu. Starta om appen och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำรองข้อมูลไม่ได้: ยังอ่านข้อมูลที่บันทึกไว้ไม่ได้ในขณะนี้ โปรดเริ่มแอปใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekleme mümkün değil: kayıtlı veriler şu anda okunamıyor. Uygulamayı yeniden başlatıp tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервне копіювання неможливе: збережені дані зараз не вдається прочитати. Перезапусти застосунок і спробуй знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể sao lưu: hiện không đọc được dữ liệu đã lưu. Hãy khởi động lại ứng dụng và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法备份：暂时无法读取已保存的数据。请重启应用后再试。"
          }
        }
