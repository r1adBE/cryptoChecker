    "settings_activity_alerts_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرة واحدة كحد أقصى في الساعة لكل زوج: حركات سعرية غير عادية وقفزات في الحجم وقيم متطرفة في العقود الآجلة (البيانات من Binance)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejvýše jednou za hodinu pro každý pár: neobvyklé cenové pohyby, skoky objemu a extrémy na futures (data z Binance)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højst én gang i timen pr. par: usædvanlige kursbevægelser, volumen-spikes og futures-ekstremer (data fra Binance)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens einmal pro Stunde je Paar: ungewöhnliche Kursbewegungen, Volumensprünge und Futures-Extreme (Daten von Binance)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πολύ μία φορά την ώρα ανά ζεύγος: ασυνήθιστες κινήσεις τιμής, άλματα όγκου και ακραίες τιμές στα futures (δεδομένα από Binance)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At most once an hour per pair: unusual price moves, volume spikes and futures extremes (data from Binance)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como máximo una vez por hora y par: movimientos de precio inusuales, picos de volumen y extremos en futuros (datos de Binance)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حداکثر یک بار در ساعت برای هر جفت: حرکات غیرعادی قیمت، جهش‌های حجم و مقادیر حدی در فیوچرز (داده‌ها از Binance)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enintään kerran tunnissa paria kohden: epätavalliset hintaliikkeet, volyymipiikit ja futuurien ääriarvot (tiedot Binancesta)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au plus une fois par heure et par paire : mouvements de prix inhabituels, pics de volume et extrêmes sur les futures (données Binance)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל היותר פעם בשעה לכל צמד: תנועות מחיר חריגות, זינוקי מחזור וקיצוניות בחוזים עתידיים (נתונים מ-Binance)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पेयर के लिए घंटे में अधिकतम एक बार: असामान्य भाव हलचल, वॉल्यूम स्पाइक और फ़्यूचर्स की चरम स्थितियाँ (डेटा Binance से)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páronként legfeljebb óránként egyszer: szokatlan ármozgások, forgalmi kiugrások és határidős szélsőértékek (adatok: Binance)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paling banyak sekali per jam per pasangan: pergerakan harga tidak biasa, lonjakan volume, dan kondisi ekstrem futures (data dari Binance)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al massimo una volta all'ora per coppia: movimenti di prezzo insoliti, picchi di volume ed estremi sui futures (dati da Binance)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアごとに1時間に最大1回：異常な値動き、出来高急増、先物の極端な値（データは Binance）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래쌍당 최대 1시간에 한 번: 이상 가격 움직임, 거래량 급증, 선물 극단값 (데이터: Binance)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyst én gang i timen per par: uvanlige kursbevegelser, volum-spikes og futures-ekstremer (data fra Binance)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooguit eens per uur per paar: ongewone koersbewegingen, volumepieken en futures-extremen (gegevens van Binance)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyżej raz na godzinę dla każdej pary: nietypowe ruchy cen, skoki wolumenu i ekstrema na kontraktach (dane z Binance)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No máximo uma vez por hora por par: movimentos de preço invulgares, picos de volume e extremos nos futuros (dados da Binance)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No máximo uma vez por hora por par: movimentos de preço incomuns, picos de volume e extremos nos futuros (dados da Binance)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel mult o dată pe oră pentru fiecare pereche: mișcări de preț neobișnuite, salturi de volum și extreme pe futures (date de la Binance)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не чаще раза в час для каждой пары: необычные движения цены, всплески объёма и экстремумы на фьючерсах (данные Binance)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më së shumti një herë në orë për çift: lëvizje të pazakonta çmimi, kërcime vëllimi dhe ekstreme në futures (të dhëna nga Binance)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högst en gång i timmen per par: ovanliga kursrörelser, volymspikar och extremer på terminsmarknaden (data från Binance)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สูงสุดชั่วโมงละครั้งต่อคู่: ราคาเคลื่อนไหวผิดปกติ ปริมาณพุ่ง และค่าสุดขั้วในฟิวเจอร์ส (ข้อมูลจาก Binance)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çift başına saatte en fazla bir kez: olağandışı fiyat hareketleri, hacim sıçramaları ve vadeli işlemlerdeki uç değerler (veriler Binance'ten)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не частіше разу на годину для кожної пари: незвичайні рухи ціни, сплески обсягу та екстремуми на ф'ючерсах (дані Binance)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tối đa mỗi giờ một lần cho mỗi cặp: biến động giá bất thường, khối lượng tăng vọt và mức cực đoan trên futures (dữ liệu từ Binance)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个交易对每小时最多一次：异常价格波动、成交量激增和合约极端值（数据来自 Binance）。"
          }
        }
      }
    },
