            "value" : "اختر العملات وأضفها دفعة واحدة. يمكنك تغيير المنصة والزوج لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte mince a přidejte je najednou. Burzu a pár můžete později změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg mønter, og tilføj dem på én gang. Du kan ændre børs og par senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins auswählen und in einem Schritt hinzufügen. Börse und Paar kannst du später ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε νομίσματα και προσθέστε τα με μία κίνηση. Μπορείτε να αλλάξετε ανταλλακτήριο και ζεύγος αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose coins and add them in one go. You can change exchange and pair later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige monedas y añádelas de una vez. Puedes cambiar el exchange y el par más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارزها را انتخاب کنید و یک‌جا اضافه کنید. صرافی و جفت را بعداً می‌توانید تغییر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kolikot ja lisää ne kerralla. Voit vaihtaa pörssin ja parin myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez des cryptos et ajoutez-les en une fois. Vous pourrez changer la plateforme et la paire plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו מטבעות והוסיפו אותם בבת אחת. אפשר לשנות בורסה וצמד מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉइन चुनें और उन्हें एक साथ जोड़ें। एक्सचेंज और पेयर आप बाद में बदल सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon érméket, és adja hozzá őket egyszerre. A tőzsdét és a párt később módosíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih koin dan tambahkan sekaligus. Bursa dan pasangan bisa Anda ubah nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le monete e aggiungile in un colpo solo. Puoi cambiare exchange e coppia in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインを選んでまとめて追加できます。取引所とペアは後で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코인을 선택해 한 번에 추가하세요. 거래소와 거래쌍은 나중에 바꿀 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg mynter og legg dem til på én gang. Du kan endre børs og par senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies munten en voeg ze in één keer toe. Exchange en paar kun je later wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz monety i dodaj je za jednym razem. Giełdę i parę możesz zmienić później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha moedas e adicione-as de uma só vez. Pode alterar a exchange e o par mais tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha moedas e adicione todas de uma vez. Você pode alterar a exchange e o par depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți monedele și adăugați-le dintr-odată. Puteți schimba bursa și perechea mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите монеты и добавьте их за один раз. Биржу и пару можно изменить позже."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgjidh monedhat dhe shtoji njëherësh. Bursën dhe çiftin mund t'i ndryshosh më vonë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj mynt och lägg till dem på en gång. Du kan ändra börs och par senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเหรียญแล้วเพิ่มได้ในครั้งเดียว คุณเปลี่ยนกระดานเทรดและคู่เหรียญได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
