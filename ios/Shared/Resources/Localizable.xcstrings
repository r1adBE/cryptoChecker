    "cost_gaps_sheet_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفتقد هذه الواردات إلى تكلفة الاقتناء. الاقتراح هو سعر إغلاق اليوم – يمكنك تعديله في الإدخال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Těmto příjmům chybí pořizovací cena. Návrh je denní závěrečný kurz data – můžeš jej upravit v záznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse tilgange mangler anskaffelsespris. Forslaget er dagens lukkekurs for datoen – du kan justere det i posten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Zugänge fehlt der Einstand. Der Vorschlag ist der Tagesschluss des Datums – du kannst ihn im Eintrag anpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε αυτές τις εισροές λείπει το κόστος κτήσης. Η πρόταση είναι η τιμή κλεισίματος της ημέρας – μπορείς να την αλλάξεις στην εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These inflows have no cost basis. The suggestion is the daily close of the date – you can adjust it in the entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estas entradas les falta el coste de adquisición. La sugerencia es el cierre diario de la fecha; puedes ajustarlo en la entrada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ورودی‌ها بهای تمام‌شده ندارند. پیشنهاد، قیمت بسته‌شدن روز است – می‌توانی آن را در ورودی تغییر دهی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiltä tuloilta puuttuu hankintahinta. Ehdotus on päivän päätöskurssi – voit muokata sitä merkinnässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces entrées n’ont pas de prix de revient. La suggestion est le cours de clôture du jour – tu peux l’ajuster dans l’entrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכניסות האלה חסרה עלות רכישה. ההצעה היא שער הסגירה היומי של התאריך – אפשר לשנות אותה ברשומה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन प्राप्तियों में लागत मूल्य नहीं है। सुझाव उस तारीख का दैनिक बंद भाव है – तुम इसे प्रविष्टि में बदल सकते हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeknél a jóváírásoknál hiányzik a bekerülési érték. A javaslat a dátum napi záróárfolyama – a tételben módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemasukan ini tidak memiliki harga perolehan. Sarannya adalah harga penutupan harian tanggal itu – kamu bisa mengubahnya di entri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per queste entrate manca il costo di acquisto. Il suggerimento è la chiusura giornaliera della data – puoi modificarlo nella voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの入金には取得価額がありません。提案はその日の終値です – 記録で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 입금 항목에는 취득가액이 없습니다. 제안 값은 해당 날짜의 일일 종가이며 항목에서 수정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse tilgangene mangler inngangsverdi. Forslaget er sluttkursen for datoen – du kan justere den i oppføringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor deze ontvangsten ontbreekt de kostprijs. Het voorstel is de dagslotkoers van de datum – je kunt het in het item aanpassen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tym wpływom brakuje kosztu nabycia. Sugestia to kurs zamknięcia z tego dnia – możesz go zmienić we wpisie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas entradas não têm custo de aquisição. A sugestão é o fecho diário da data – podes ajustá-lo na entrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas entradas não têm custo de aquisição. A sugestão é o fechamento diário da data – você pode ajustá-lo na entrada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestor intrări le lipsește costul de achiziție. Sugestia este prețul de închidere al zilei – îl poți ajusta în intrare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этих поступлений нет стоимости приобретения. Предложение — цена закрытия дня; её можно изменить в записи."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Këtyre hyrjeve u mungon kosto e blerjes. Sugjerimi është çmimi i mbylljes së ditës – mund ta ndryshosh te hyrja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa tillflöden saknar anskaffningsvärde. Förslaget är dagens stängningskurs för datumet – du kan justera det i posten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการรับเข้าเหล่านี้ไม่มีต้นทุน คำแนะนำคือราคาปิดรายวันของวันนั้น – คุณแก้ไขได้ในรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu girişlerin maliyeti eksik. Öneri, tarihin günlük kapanış fiyatıdır – kayıtta değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цим надходженням бракує вартості придбання. Пропозиція — ціна закриття дня; її можна змінити в записі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản nhận này chưa có giá vốn. Gợi ý là giá đóng cửa trong ngày – bạn có thể sửa trong mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些转入缺少成本价。建议值为当日收盘价——可在记录中修改。"
          }
        }
      }
    },
