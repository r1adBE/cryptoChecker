    "settings_rolling_futures_tradfi_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جزء من الرموز المميزة. مقفل عند اختيار «TradFi فقط»؛ ويظل ساريًا على العقود ذات الاستحقاق الموجودة في القائمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patří k tokenům. Při „Jen TradFi“ uzamčeno; dál platí pro termínované futures už v seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hører til tokens. Låst ved »Kun TradFi«; gælder stadig for futures med udløb på din liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehört zu Token. Bei «Nur TradFi» gesperrt; gilt weiter für gemerkte Laufzeit-Futures."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανήκει στα tokens. Κλειδωμένο με «Μόνο TradFi»· ισχύει ακόμη για τα futures με λήξη που είναι στη λίστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belongs to Tokens. Unavailable while “TradFi only” is selected; still applies to dated futures already in your watchlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma parte de tokens. Bloqueado con «Solo TradFi»; sigue aplicándose a los futuros con vencimiento ya guardados en la lista."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بخشی از توکن‌ها است. با «فقط TradFi» قفل است؛ برای فیوچرز سررسیددار موجود در فهرست همچنان اعمال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuluu tokeneihin. Lukittu, kun ”Vain TradFi” on valittu; koskee yhä listalla olevia määräaikaisia futuureja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait partie des jetons. Verrouillé avec « TradFi uniquement » ; s’applique toujours aux futures à échéance déjà dans la liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שייך לטוקנים. נעול כשנבחר „TradFi בלבד”; עדיין חל על חוזים מתוארכים שכבר ברשימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन का हिस्सा। “केवल TradFi” पर लॉक; सूची में मौजूद एक्सपायरी वाले फ़्यूचर्स पर अब भी लागू।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tokenekhez tartozik. „Csak TradFi” mellett zárolva; a listán lévő lejáratos ügyletekre továbbra is érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian dari token. Terkunci saat “Hanya TradFi”; tetap berlaku untuk futures jatuh tempo yang sudah ada di daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa parte dei token. Bloccato con «Solo TradFi»; vale ancora per i futures con scadenza già nella lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンの設定です。「TradFiのみ」ではロックされますが、リストにある期日付き先物には引き続き適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰에 속합니다. 'TradFi만'에서는 잠기며, 목록에 있는 만기 선물에는 계속 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hører til tokens. Låst ved «Bare TradFi»; gjelder fortsatt for futures med forfall på listen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoort bij tokens. Vergrendeld bij ‘Alleen TradFi’; geldt nog steeds voor futures met vervaldatum in je volglijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Należy do tokenów. Zablokowane przy „Tylko TradFi”; nadal dotyczy kontraktów terminowych już na liście."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz parte dos tokens. Bloqueado com «Só TradFi»; continua a aplicar-se aos futuros com vencimento já na lista."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz parte dos tokens. Bloqueado com “Só TradFi”; continua valendo para os futuros com vencimento já na lista."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține de tokenuri. Blocat la „Doar TradFi”; se aplică în continuare futures-urilor cu scadență din listă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Относится к токенам. Заблокировано при «Только TradFi»; по-прежнему действует для срочных фьючерсов в списке."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I përket tokenëve. I kyçur me «Vetëm TradFi»; vlen ende për futures me afat që janë në listë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör till tokens. Låst vid ”Endast TradFi”; gäller fortfarande för terminer med förfall i din lista."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นส่วนของโทเคน ล็อกไว้เมื่อเลือก “เฉพาะ TradFi” แต่ยังใช้กับฟิวเจอร์สที่มีวันหมดอายุในรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenlere aittir. “Yalnızca TradFi” seçiliyken kilitli; listedeki vade tarihli kontratlar için geçerli olmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Належить до токенів. Заблоковано за «Лише TradFi»; і далі діє для строкових ф’ючерсів у списку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuộc về token. Bị khóa khi chọn “Chỉ TradFi”; vẫn áp dụng cho futures có kỳ hạn đã có trong danh sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "属于代币。选择“仅 TradFi”时锁定；仍适用于列表中已有的交割合约。"
          }
        }
      }
    },
