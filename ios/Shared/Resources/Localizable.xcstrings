        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-indicatoren, twee keer per dag gecontroleerd. Jij kiest de grenzen – de app beoordeelt de waarden niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskaźniki Bitcoina, sprawdzane dwa razy dziennie. Progi wybierasz sam – aplikacja nie ocenia wartości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores de Bitcoin, verificados duas vezes por dia. Os limites escolhes tu – a app não avalia os valores."
          }
