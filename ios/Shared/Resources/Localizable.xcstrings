    "ios_local_network_usage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب فقط إذا كان خادمك الخاص للعناوين موجودًا في شبكتك المنزلية."
