        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 복원하는 중에 앱이 종료되었습니다. 이전 데이터를 되돌렸으며 백업의 내용은 반영되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen ble lukket mens en sikkerhetskopi ble gjenopprettet. De tidligere dataene dine er lagt tilbake; ingenting fra sikkerhetskopien ble beholdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app werd gesloten tijdens het terugzetten van een back-up. Je vorige gegevens zijn teruggezet; er is niets uit de back-up behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja została zamknięta podczas przywracania kopii. Poprzednie dane zostały przywrócone; z kopii nic nie zachowano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A app foi fechada durante o restauro de uma cópia de segurança. Os teus dados anteriores foram repostos; nada da cópia foi mantido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
