            "state" : "translated",
            "value" : "Liikkeen takana on vähän kauppaa – tällaiset liikkeet ovat usein epävakaampia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu d'échanges derrière le mouvement – ce type de mouvement est souvent moins stable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעט מסחר מאחורי התנועה – תנועות כאלה לרוב פחות יציבות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हलचल के पीछे कम ट्रेडिंग है — ऐसी हलचल अक्सर कम स्थिर होती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevés kereskedés áll a mozgás mögött – az ilyen mozgások gyakran kevésbé stabilak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedikit perdagangan di balik pergerakan ini – pergerakan seperti ini sering kurang stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochi scambi dietro il movimento – movimenti simili sono spesso meno stabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きの裏にある取引は少なめです — こうした動きは安定しにくいことがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 뒤의 거래가 적습니다 — 이런 움직임은 흔히 덜 안정적입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite handel bak bevegelsen – slike bevegelser er ofte mindre stabile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weinig handel achter de beweging – zulke bewegingen zijn vaak minder stabiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za ruchem stoi niewielki handel – takie ruchy są często mniej stabilne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouca negociação por trás do movimento – estes movimentos são muitas vezes menos estáveis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouca negociação por trás do movimento – esses movimentos costumam ser menos estáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puține tranzacții în spatele mișcării – astfel de mișcări sunt adesea mai puțin stabile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За движением стоит мало сделок – такие движения часто менее устойчивы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak tregtim pas lëvizjes – lëvizje të tilla shpesh janë më pak të qëndrueshme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite handel bakom rörelsen – sådana rörelser är ofta mindre stabila."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีการซื้อขายน้อยเบื้องหลังการเคลื่อนไหว — การเคลื่อนไหวแบบนี้มักมีเสถียรภาพน้อยกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketin arkasında az işlem var – bu tür hareketler çoğu zaman daha az istikrarlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За рухом стоїть мало угод – такі рухи часто менш стійкі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ít giao dịch đứng sau biến động – những biến động như vậy thường kém ổn định hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这波走势背后成交较少——此类走势往往不太稳定。"
          }
        }
      }
    },
    "why_volume_normal_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التداول في الساعة الأخيرة يتماشى مع آخر 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obchodování za poslední hodinu odpovídá posledním 24 hodinám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
