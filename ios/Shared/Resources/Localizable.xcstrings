          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crypto Checker é um projeto independente de Rich1e: uma visão tranquila dos preços sem conta, anúncios nem rastreio. Perguntas e sugestões: %1$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
