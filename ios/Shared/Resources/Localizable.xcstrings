        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruan listën me shënime dhe grupe, alarmet, të preferuarat, portofolin dhe cilësimet në një skedar që e mban vetë – p.sh. për një telefon të ri."
