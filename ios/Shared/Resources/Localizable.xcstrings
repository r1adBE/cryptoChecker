          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปถูกปิดระหว่างกู้คืนข้อมูลสำรอง ข้อมูลเดิมของคุณถูกนำกลับมาแล้ว และไม่ได้เก็บสิ่งใดจากข้อมูลสำรองไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
