          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones vigiladas cuentan desde el primer saldo observado; los cambios posteriores son entradas/salidas, no ganancia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
