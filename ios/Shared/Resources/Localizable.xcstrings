        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τιμή ως πολλαπλάσιο της τιμής την ημέρα του halving (λογαριθμική κλίμακα). Οι παλιοί κύκλοι είναι μοτίβο, όχι πρόβλεψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price as a multiple of the halving-day price (log scale). Earlier cycles are a pattern, not a forecast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio como múltiplo del precio el día del halving (escala log). Los ciclos pasados son un patrón, no una previsión."
          }
        },
        "fa" : {
          "stringUnit" : {
