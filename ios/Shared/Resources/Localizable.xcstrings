    "tax_export_rule" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> سنة: بيع بعد تاريخ الشراء + سنة تقويمية. التواريخ بالتوقيت المحلي. الأسعار: السعر اليومي للبنك المركزي الأوروبي ليوم المعاملة؛ وإن لم يتوفر، فآخر سعر خلال 7 أيام قبله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 rok: prodáno po datu nákupu + 1 kalendářní rok. Data v místním čase. Kurzy: denní kurz ECB ze dne transakce; pokud chybí, poslední kurz nejvýše 7 dní předtím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 år: solgt efter købsdato + 1 kalenderår. Datoer i lokal tid. Kurser: ECB-dagskurs på transaktionsdagen; mangler den, den seneste kurs op til 7 dage før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 Jahr: Verkauf nach Kaufdatum + 1 Kalenderjahr. Daten in Ortszeit. Kurse: EZB-Tageskurs des Transaktionstags; fehlt er, der letzte Kurs bis 7 Tage davor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 έτος: πώληση μετά την ημερομηνία αγοράς + 1 ημερολογιακό έτος. Ημερομηνίες σε τοπική ώρα. Ισοτιμίες: ημερήσια ισοτιμία ΕΚΤ της ημέρας της συναλλαγής· αν λείπει, η τελευταία ισοτιμία έως 7 ημέρες πριν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 year: sold after purchase date + 1 calendar year. Dates in local time. Rates: ECB daily rate of the transaction day; if there is none, the last rate up to 7 days before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 año: vendido después de la fecha de compra + 1 año natural. Fechas en hora local. Cambios: cambio diario del BCE del día de la operación; si no lo hay, el último cambio hasta 7 días antes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 سال: فروش پس از تاریخ خرید + 1 سال تقویمی. تاریخ‌ها به وقت محلی. نرخ‌ها: نرخ روزانهٔ بانک مرکزی اروپا در روز تراکنش؛ اگر نباشد، آخرین نرخ تا 7 روز پیش از آن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 vuosi: myyty ostopäivän + 1 kalenterivuoden jälkeen. Päivämäärät paikallista aikaa. Kurssit: EKP:n päiväkurssi tapahtumapäivältä; jos sitä ei ole, viimeisin kurssi enintään 7 päivää aiemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 an : vendu après la date d’achat + 1 année civile. Dates en heure locale. Cours : cours journalier BCE du jour de l’opération ; à défaut, le dernier cours jusqu’à 7 jours avant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> שנה: נמכר אחרי תאריך הקנייה + שנה קלנדרית. תאריכים בשעון מקומי. שערים: שער יומי של ה-ECB ביום העסקה; אם אין, השער האחרון עד 7 ימים לפני כן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 वर्ष: खरीद तिथि + 1 कैलेंडर वर्ष के बाद बेचा गया। तिथियाँ स्थानीय समय में। दरें: लेन-देन के दिन की ECB दैनिक दर; न हो तो उससे पहले 7 दिनों के भीतर की अंतिम दर।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 év: eladás a vétel dátuma + 1 naptári év után. Dátumok helyi idő szerint. Árfolyamok: az ügylet napjának EKB napi árfolyama; ha nincs, az utolsó árfolyam legfeljebb 7 nappal korábbról."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 tahun: dijual setelah tanggal beli + 1 tahun kalender. Tanggal dalam waktu lokal. Kurs: kurs harian ECB pada hari transaksi; jika tidak ada, kurs terakhir hingga 7 hari sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 anno: venduto dopo la data d’acquisto + 1 anno solare. Date in ora locale. Cambi: cambio giornaliero BCE del giorno dell’operazione; in mancanza, l’ultimo cambio fino a 7 giorni prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1年：購入日 + 1暦年より後に売却。日付は現地時間。レート：取引日の ECB 日次レート（ない場合は 7 日前までの直近のレート）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1년: 매수일 + 1역년 이후 매도. 날짜는 현지 시간 기준. 환율: 거래일의 ECB 일별 환율(없으면 7일 전까지의 마지막 환율)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 år: solgt etter kjøpsdato + 1 kalenderår. Datoer i lokal tid. Kurser: ESBs dagskurs på transaksjonsdagen; mangler den, siste kurs inntil 7 dager før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 jaar: verkocht na aankoopdatum + 1 kalenderjaar. Datums in lokale tijd. Koersen: ECB-dagkoers van de transactiedag; ontbreekt die, de laatste koers tot 7 dagen ervoor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 rok: sprzedaż po dacie zakupu + 1 rok kalendarzowy. Daty w czasie lokalnym. Kursy: dzienny kurs EBC z dnia transakcji; jeśli go brak, ostatni kurs do 7 dni wcześniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 ano: vendido após a data de compra + 1 ano civil. Datas em hora local. Câmbios: taxa diária do BCE do dia da transação; se não existir, a última taxa até 7 dias antes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 ano: vendido após a data de compra + 1 ano civil. Datas no horário local. Câmbio: taxa diária do BCE do dia da transação; se não houver, a última taxa até 7 dias antes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 an: vândut după data cumpărării + 1 an calendaristic. Date în ora locală. Cursuri: cursul zilnic BCE din ziua tranzacției; dacă lipsește, ultimul curs de până la 7 zile înainte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 года: продано позже даты покупки + 1 календарный год. Даты по местному времени. Курсы: дневной курс ЕЦБ на день операции; если его нет — последний курс не более чем за 7 дней до этого."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 vit: shitur pas datës së blerjes + 1 vit kalendarik. Datat në orën lokale. Kurset: kursi ditor i BQE i ditës së transaksionit; nëse mungon, kursi i fundit deri në 7 ditë më parë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 år: sålt efter köpdatum + 1 kalenderår. Datum i lokal tid. Kurser: ECB:s dagskurs för transaktionsdagen; saknas den, den senaste kursen upp till 7 dagar före."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 ปี: ขายหลังวันที่ซื้อ + 1 ปีปฏิทิน วันที่เป็นเวลาท้องถิ่น อัตรา: อัตรารายวันของ ECB ในวันที่ทำรายการ หากไม่มี ใช้อัตราล่าสุดย้อนหลังไม่เกิน 7 วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 yıl: alış tarihi + 1 takvim yılından sonra satıldı. Tarihler yerel saatle. Kurlar: işlem gününün ECB günlük kuru; yoksa en fazla 7 gün öncesine kadarki son kur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 року: продано пізніше дати купівлі + 1 календарний рік. Дати за місцевим часом. Курси: денний курс ЄЦБ на день операції; якщо його немає — останній курс не більше ніж за 7 днів до того."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 năm: bán sau ngày mua + 1 năm dương lịch. Ngày theo giờ địa phương. Tỷ giá: tỷ giá ngày của ECB vào ngày giao dịch; nếu không có, tỷ giá gần nhất trong vòng 7 ngày trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> 1 年：在买入日期 + 1 个日历年之后卖出。日期为本地时间。汇率：交易当日的欧洲央行每日汇率；若无，则取此前最多 7 天内的最近汇率。"
          }
        }
      }
    },
