    "settings_price_colors_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسهل تمييز الأزرق / البرتقالي مع كل أنواع ضعف رؤية الألوان (الأحمر-الأخضر والأزرق-الأصفر). ويُعرض الاتجاه دائمًا أيضًا بالرمز + / −."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modrá / oranžová je dobře rozlišitelná při každé poruše barvocitu (červeno-zelené i modro-žluté). Směr se navíc vždy zobrazuje jako + / −."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blå / orange er let at skelne ved alle former for farvesynsdefekt (rød-grøn og blå-gul). Retningen vises desuden altid med + / −."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blau / Orange ist bei jeder Farbsehschwäche (Rot-Grün und Blau-Gelb) gut unterscheidbar. Die Richtung steht zusätzlich immer als + / −."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μπλε / πορτοκαλί ξεχωρίζει εύκολα σε κάθε μορφή δυσχρωματοψίας (κόκκινου-πράσινου και μπλε-κίτρινου). Η κατεύθυνση εμφανίζεται επίσης πάντα με + / −."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blue / orange is easy to tell apart with every color vision deficiency (red-green and blue-yellow). The direction is always shown with + / − as well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azul / naranja se distingue bien con cualquier deficiencia de visión del color (rojo-verde y azul-amarillo). Además, la dirección siempre se indica con + / −."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آبی / نارنجی با هر نوع ضعف دید رنگ (قرمز-سبز و آبی-زرد) به‌خوبی قابل تشخیص است. جهت تغییر نیز همیشه با + / − نشان داده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sininen / oranssi erottuu hyvin kaikissa värinäön poikkeamissa (puna-viher ja sini-kelta). Suunta näytetään lisäksi aina merkeillä + / −."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bleu / orange se distingue facilement quel que soit le trouble de la vision des couleurs (rouge-vert et bleu-jaune). Le sens est en outre toujours indiqué par + / −."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כחול / כתום קל להבחנה בכל סוג של ליקוי בראיית צבעים (אדום-ירוק וכחול-צהוב). הכיוון מוצג תמיד גם באמצעות + / −."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीला / नारंगी हर तरह की रंग-दृष्टि कमी (लाल-हरा और नीला-पीला) में आसानी से पहचाना जाता है। दिशा हमेशा + / − से भी दिखाई जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kék / narancs minden színlátási zavar (vörös-zöld és kék-sárga) esetén jól megkülönböztethető. Az irányt ezenfelül mindig + / − is jelzi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biru / oranye mudah dibedakan untuk setiap jenis buta warna (merah-hijau dan biru-kuning). Arah perubahan juga selalu ditampilkan dengan + / −."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blu / arancione si distingue bene con qualsiasi deficit della visione dei colori (rosso-verde e blu-giallo). La direzione è inoltre sempre indicata con + / −."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青 / オレンジは、あらゆる色覚特性（赤緑・青黄）で見分けやすい配色です。方向は常に + / − でも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파랑 / 주황은 모든 색각 이상(적록 및 청황)에서 쉽게 구분됩니다. 방향은 항상 + / −로도 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blå / oransje er lett å skille ved alle former for fargesynsvansker (rød-grønn og blå-gul). Retningen vises i tillegg alltid med + / −."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blauw / oranje is bij elke kleurenzienstoornis (rood-groen en blauw-geel) goed te onderscheiden. De richting wordt bovendien altijd met + / − aangegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niebieski / pomarańczowy łatwo odróżnić przy każdym zaburzeniu widzenia barw (czerwono-zielonym i niebiesko-żółtym). Kierunek jest też zawsze pokazywany jako + / −."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azul / laranja é fácil de distinguir com qualquer deficiência na visão das cores (vermelho-verde e azul-amarelo). A direção também é sempre indicada com + / −."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azul / laranja é fácil de distinguir com qualquer deficiência na visão de cores (vermelho-verde e azul-amarelo). A direção também é sempre indicada com + / −."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albastru / portocaliu se deosebesc ușor la orice deficiență de vedere a culorilor (roșu-verde și albastru-galben). În plus, direcția este afișată mereu cu + / −."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синий / оранжевый хорошо различимы при любом нарушении цветового зрения (красно-зелёном и сине-жёлтом). Направление к тому же всегда показано знаками + / −."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluja / portokallia dallohen lehtë me çdo lloj mangësie të shikimit të ngjyrave (e kuqe-e gjelbër dhe blu-e verdhë). Drejtimi tregohet gjithmonë edhe me + / −."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blå / orange är lätt att skilja åt vid alla former av färgseendeavvikelse (röd-grön och blå-gul). Riktningen visas dessutom alltid med + / −."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีน้ำเงิน / ส้มแยกแยะได้ง่ายสำหรับภาวะบกพร่องในการมองเห็นสีทุกแบบ (แดง-เขียว และน้ำเงิน-เหลือง) และจะแสดงทิศทางด้วย + / − เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mavi / turuncu her renk görme bozukluğunda (kırmızı-yeşil ve mavi-sarı) kolayca ayırt edilir. Yön ayrıca her zaman + / − ile gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синій / помаранчевий добре розрізняються за будь-якого порушення колірного зору (червоно-зеленого та синьо-жовтого). Напрямок до того ж завжди позначено знаками + / −."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xanh dương / cam dễ phân biệt với mọi dạng rối loạn sắc giác (đỏ-xanh lá và xanh dương-vàng). Hướng thay đổi cũng luôn được hiển thị bằng + / −."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝 / 橙在各种色觉障碍（红绿和蓝黄）下都易于区分。方向还会始终以 + / − 显示。"
          }
        }
      }
    },
