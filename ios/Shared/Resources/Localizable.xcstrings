            "value" : "Změny portfolia čekají na šifrované uložení. Uloží se, jakmile bude klíčenka opět dostupná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porteføljeændringer venter på at blive gemt krypteret. De gemmes, så snart nøgleringen er tilgængelig igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfolio-Änderungen warten auf verschlüsseltes Speichern – sie werden gespeichert, sobald der Schlüsselbund wieder verfügbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές του χαρτοφυλακίου περιμένουν κρυπτογραφημένη αποθήκευση. Θα αποθηκευτούν μόλις η κλειδοθήκη είναι ξανά διαθέσιμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfolio changes are waiting to be saved encrypted. They will be saved as soon as the keychain is available again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de la cartera esperan a guardarse cifrados. Se guardarán en cuanto el llavero vuelva a estar disponible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییرات سبد منتظر ذخیرهٔ رمزگذاری‌شده‌اند و به‌محض در دسترس بودن دوبارهٔ زنجیرهٔ کلید ذخیره می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salkun muutokset odottavat salattua tallennusta. Ne tallennetaan heti, kun avainnippu on taas käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications du portefeuille attendent d'être enregistrées chiffrées. Elles le seront dès que le trousseau sera de nouveau disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינויים בתיק ממתינים לשמירה מוצפנת. הם יישמרו ברגע שמחזיק המפתחות יהיה זמין שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोर्टफ़ोलियो के बदलाव एन्क्रिप्टेड सहेजे जाने की प्रतीक्षा में हैं। कीचेन फिर से उपलब्ध होते ही वे सहेज दिए जाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A portfólió változásai titkosított mentésre várnak. Amint a kulcskarika ismét elérhető, mentésre kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan portofolio menunggu disimpan terenkripsi. Perubahan akan disimpan begitu keychain tersedia lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche al portafoglio attendono di essere salvate cifrate. Verranno salvate non appena il portachiavi sarà di nuovo disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
