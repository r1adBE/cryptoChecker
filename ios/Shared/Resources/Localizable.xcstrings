    "explain_bid_ask" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سعر الشراء هو أعلى سعر يعرضه المشترون الآن، وسعر البيع هو أدنى سعر يقبله البائعون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup je nejvyšší cena, kterou kupující právě nabízejí, Prodej nejnižší cena, kterou prodávající přijmou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bud er den højeste pris, købere byder lige nu, Udbud den laveste pris, sælgere vil acceptere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geld ist der höchste Preis, den Käufer gerade bieten, Brief der tiefste, den Verkäufer verlangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bid είναι η υψηλότερη τιμή που προσφέρουν τώρα οι αγοραστές, Ask η χαμηλότερη τιμή που δέχονται οι πωλητές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bid is the highest price buyers are offering right now, ask the lowest price sellers will accept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra es el precio más alto que ofrecen ahora los compradores; Venta, el más bajo que aceptan los vendedores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خرید بالاترین قیمتی است که خریداران همین حالا پیشنهاد می‌دهند و فروش پایین‌ترین قیمتی که فروشندگان می‌پذیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osto on korkein hinta, jota ostajat juuri nyt tarjoavat, Myynti alin hinta, jonka myyjät hyväksyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat est le prix le plus élevé que proposent les acheteurs en ce moment, Vente le prix le plus bas qu’acceptent les vendeurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביקוש הוא המחיר הגבוה ביותר שקונים מציעים כרגע, והיצע הוא המחיר הנמוך ביותר שמוכרים מוכנים לקבל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिड वह सबसे ऊँची कीमत है जो खरीदार अभी दे रहे हैं, आस्क वह सबसे कम कीमत जिस पर विक्रेता बेचने को तैयार हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vételi ár a legmagasabb ár, amelyet a vevők most kínálnak, az eladási ár pedig a legalacsonyabb, amelyet az eladók elfogadnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bid adalah harga tertinggi yang ditawarkan pembeli saat ini, Ask harga terendah yang diterima penjual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denaro è il prezzo più alto che i compratori offrono ora, Lettera il prezzo più basso che i venditori accettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買気配は買い手がいま提示している最も高い価格、売気配は売り手が応じる最も低い価格です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매수호가는 지금 매수자가 제시하는 가장 높은 가격이고, 매도호가는 매도자가 받아들이는 가장 낮은 가격입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøp er den høyeste prisen kjøpere byr akkurat nå, Salg den laveste prisen selgere godtar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bied is de hoogste prijs die kopers nu bieden, Laat de laagste prijs die verkopers accepteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupno to najwyższa cena, jaką kupujący oferują w tej chwili, a Sprzedaż – najniższa, jaką akceptują sprzedający."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra é o preço mais alto que os compradores oferecem agora; Venda, o preço mais baixo que os vendedores aceitam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra é o maior preço que os compradores oferecem agora; Venda, o menor preço que os vendedores aceitam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerere este cel mai mare preț oferit acum de cumpărători, Ofertă cel mai mic preț acceptat de vânzători."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка — самая высокая цена, которую сейчас предлагают покупатели, Продажа — самая низкая цена, на которую согласны продавцы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blerje është çmimi më i lartë që ofrojnë blerësit tani, Shitje çmimi më i ulët që pranojnë shitësit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp är det högsta pris köpare bjuder just nu, Sälj det lägsta pris säljare accepterar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคาเสนอซื้อคือราคาสูงสุดที่ผู้ซื้อเสนออยู่ตอนนี้ ส่วนราคาเสนอขายคือราคาต่ำสุดที่ผู้ขายยอมรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alış, alıcıların şu anda teklif ettiği en yüksek fiyat; Satış, satıcıların kabul ettiği en düşük fiyattır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купівля — найвища ціна, яку зараз пропонують покупці, Продаж — найнижча ціна, на яку погоджуються продавці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá mua là mức giá cao nhất người mua đang trả lúc này, giá bán là mức giá thấp nhất người bán chấp nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买价是买方当前愿出的最高价，卖价是卖方愿接受的最低价。"
          }
        }
      }
    },
    "explain_funding" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثيرون يراهنون بأموال مقترضة على ارتفاع الأسعار أو انخفاضها. رسوم تُدفع بين مراكز الشراء والبيع. القيمة الموجبة بقوة تعني أن كثيرين يراهنون على ارتفاع الأسعار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mnoho lidí sází s půjčenými penězi na růst nebo pokles cen. Poplatek mezi long a short pozicemi. Silně kladný znamená, že mnozí sázejí na růst cen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mange satser med lånte penge på stigende eller faldende kurser. Gebyr mellem long- og short-positioner. Stærkt positiv betyder, at mange satser på stigende kurser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele wetten mit Kredit auf steigende oder fallende Kurse. Gebühr zwischen Long- und Short-Positionen. Stark positiv heisst: viele wetten auf steigende Kurse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολλοί ποντάρουν με δανεικά χρήματα σε άνοδο ή πτώση των τιμών. Χρέωση μεταξύ θέσεων long και short. Έντονα θετική σημαίνει ότι πολλοί ποντάρουν σε άνοδο των τιμών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Many traders bet on rising or falling prices with borrowed money. Fee between long and short positions. Strongly positive means many are betting on rising prices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muchos apuestan con dinero prestado a que los precios suben o bajan. Comisión entre posiciones largas y cortas. Muy positiva significa que muchos apuestan por precios al alza."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بسیاری با پول قرضی روی بالا یا پایین رفتن قیمت شرط می‌بندند. کارمزدی بین موقعیت‌های لانگ و شورت. مثبتِ زیاد یعنی بسیاری روی افزایش قیمت شرط بسته‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moni lyö vetoa lainarahalla hintojen noususta tai laskusta. Long- ja short-positioiden välinen maksu. Vahvasti positiivinen tarkoittaa, että moni veikkaa hintojen nousua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beaucoup parient avec de l’argent emprunté sur la hausse ou la baisse des cours. Frais entre positions longues et courtes. Fortement positif signifie que beaucoup parient sur la hausse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רבים מהמרים בכסף שאול על עליית מחירים או על ירידתם. עמלה בין פוזיציות לונג לשורט. ערך חיובי מאוד פירושו שרבים מהמרים על עליית מחירים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत से लोग उधार के पैसे से भाव बढ़ने या गिरने पर दाँव लगाते हैं। लॉन्ग और शॉर्ट पोज़िशन के बीच शुल्क। काफ़ी पॉज़िटिव होने का मतलब है कि कई लोग कीमतें बढ़ने पर दाँव लगा रहे हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokan kölcsönpénzzel fogadnak emelkedő vagy eső árfolyamra. Díj a long és short pozíciók között. Erősen pozitív érték: sokan emelkedő árfolyamra fogadnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banyak orang bertaruh dengan uang pinjaman pada harga naik atau turun. Biaya antara posisi long dan short. Sangat positif berarti banyak yang bertaruh harga naik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molti scommettono con denaro preso in prestito sul rialzo o sul ribasso dei prezzi. Commissione tra posizioni long e short. Fortemente positivo significa che molti scommettono su prezzi in salita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くの人が借りたお金で値上がりや値下がりに賭けています。ロングとショートの間で支払われる手数料。大きくプラスなら、多くが値上がりに賭けています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많은 사람이 빌린 돈으로 가격 상승이나 하락에 베팅합니다. 롱과 숏 포지션 사이에 오가는 수수료. 크게 양수이면 많은 사람이 가격 상승에 베팅하고 있다는 뜻입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mange satser med lånte penger på stigende eller fallende kurser. Avgift mellom long- og short-posisjoner. Sterkt positiv betyr at mange satser på stigende kurser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel mensen wedden met geleend geld op stijgende of dalende koersen. Vergoeding tussen long- en shortposities. Sterk positief betekent dat velen op stijgende koersen wedden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wielu gra za pożyczone pieniądze na wzrost lub spadek cen. Opłata między pozycjami long i short. Mocno dodatnia oznacza, że wielu stawia na wzrost cen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitos apostam com dinheiro emprestado na subida ou descida dos preços. Taxa entre posições longas e curtas. Fortemente positiva significa que muitos apostam na subida dos preços."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muita gente aposta com dinheiro emprestado na alta ou na queda dos preços. Taxa entre posições longas e curtas. Fortemente positiva significa que muitos apostam na subida dos preços."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulți pariază cu bani împrumutați pe creșterea sau scăderea prețurilor. Taxă între pozițiile long și short. Puternic pozitivă înseamnă că mulți pariază pe creșterea prețurilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Многие ставят на рост или падение цен на заёмные деньги. Плата между длинными и короткими позициями. Сильно положительная — многие ставят на рост цен."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shumë vënë baste me para të huazuara për rritje ose rënie të çmimeve. Tarifë midis pozicioneve long dhe short. Shumë pozitive do të thotë se shumë vënë bast për rritjen e çmimeve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Många satsar med lånade pengar på stigande eller fallande kurser. Avgift mellan long- och short-positioner. Starkt positiv betyder att många satsar på stigande kurser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลายคนเดิมพันว่าราคาจะขึ้นหรือลงด้วยเงินที่กู้ยืมมา ค่าธรรมเนียมระหว่างสถานะ Long และ Short ค่าบวกสูงหมายความว่าหลายคนเดิมพันว่าราคาจะขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birçok kişi borç parayla fiyatların yükselmesine ya da düşmesine bahis oynuyor. Long ve short pozisyonlar arasındaki ücret. Güçlü pozitif değer, birçok kişinin fiyatların yükselmesine oynadığı anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Багато хто ставить позиченими грошима на зростання або падіння цін. Плата між довгими та короткими позиціями. Сильно додатна — багато хто ставить на зростання цін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhiều người dùng tiền vay để đặt cược giá tăng hoặc giảm. Phí giữa vị thế long và short. Dương mạnh nghĩa là nhiều người đang đặt cược giá tăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很多人借钱押注价格上涨或下跌。多头与空头之间支付的费用。大幅为正表示许多人押注价格上涨。"
          }
        }
      }
    },
    "explain_open_interest" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العقود الآجلة رهانات على السعر، غالبًا بأموال مقترضة. قيمة جميع مراكز العقود الآجلة المفتوحة. إذا ارتفعت، فهناك أموال أكثر تراهن على الحركة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures jsou sázky na cenu, často s půjčenými penězi. Hodnota všech otevřených futures pozic. Když roste, na pohyb sází více peněz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures er væddemål på kursen, ofte med lånte penge. Værdien af alle åbne futures-positioner. Stiger den, satser flere penge på bevægelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures sind Wetten auf den Kurs, oft mit Kredit. Wert aller offenen Futures-Positionen. Steigt er, setzt mehr Geld auf die Bewegung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα futures είναι στοιχήματα στην τιμή, συχνά με δανεικά χρήματα. Αξία όλων των ανοιχτών θέσεων futures. Όταν αυξάνεται, περισσότερα χρήματα ποντάρουν στην κίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures are bets on the price, often with borrowed money. Value of all open futures positions. If it rises, more money is betting on the move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los futuros son apuestas sobre el precio, a menudo con dinero prestado. Valor de todas las posiciones de futuros abiertas. Si sube, más dinero apuesta por el movimiento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراردادهای آتی شرط‌بندی روی قیمت‌اند، اغلب با پول قرضی. ارزش همه موقعیت‌های باز فیوچرز. اگر بالا برود، پول بیشتری روی این حرکت شرط بسته شده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futuurit ovat vetoja hinnasta, usein lainarahalla. Kaikkien avoimien futuuripositioiden arvo. Kun se nousee, liikkeen puolesta on enemmän rahaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futures sont des paris sur le cours, souvent avec de l’argent emprunté. Valeur de toutes les positions ouvertes sur les futures. S'il augmente, davantage d'argent parie sur le mouvement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוזים עתידיים הם הימורים על המחיר, לרוב בכסף שאול. שווי כל פוזיציות החוזים העתידיים הפתוחות. אם הוא עולה, יותר כסף מהמר על התנועה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्यूचर्स भाव पर दाँव होते हैं, अक्सर उधार के पैसे से। सभी खुली फ़्यूचर्स पोज़िशन का मूल्य। अगर यह बढ़ता है, तो उस चाल पर ज़्यादा पैसा लगा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A futures ügyletek fogadások az árfolyamra, gyakran kölcsönpénzzel. Az összes nyitott futures pozíció értéke. Ha nő, több pénz fogad a mozgásra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures adalah taruhan pada harga, sering dengan uang pinjaman. Nilai semua posisi futures yang terbuka. Jika naik, makin banyak uang yang bertaruh pada pergerakan itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I futures sono scommesse sul prezzo, spesso con denaro preso in prestito. Valore di tutte le posizioni futures aperte. Se sale, più denaro scommette sul movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先物は価格への賭けで、借りたお金で行われることが多いです。未決済の先物ポジションの総額。増えるほど、その値動きに賭ける資金が増えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선물은 가격에 거는 베팅이며, 빌린 돈으로 하는 경우가 많습니다. 열려 있는 모든 선물 포지션의 가치. 늘어나면 그 움직임에 더 많은 돈이 걸려 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures er veddemål på kursen, ofte med lånte penger. Verdien av alle åpne futures-posisjoner. Stiger den, satser mer penger på bevegelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures zijn weddenschappen op de koers, vaak met geleend geld. Waarde van alle open futuresposities. Stijgt die, dan wedt er meer geld op de beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrakty futures to zakłady na cenę, często za pożyczone pieniądze. Wartość wszystkich otwartych pozycji futures. Gdy rośnie, więcej pieniędzy stawia na ten ruch."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os futuros são apostas no preço, muitas vezes com dinheiro emprestado. Valor de todas as posições de futuros abertas. Se sobe, mais dinheiro aposta no movimento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futuros são apostas no preço, muitas vezes com dinheiro emprestado. Valor de todas as posições de futuros abertas. Se aumenta, mais dinheiro está apostando no movimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures sunt pariuri pe preț, adesea cu bani împrumutați. Valoarea tuturor pozițiilor futures deschise. Dacă crește, mai mulți bani pariază pe mișcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фьючерсы – это ставки на цену, часто на заёмные деньги. Стоимость всех открытых фьючерсных позиций. Если растёт, на движение ставится больше денег."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futures janë baste mbi çmimin, shpesh me para të huazuara. Vlera e të gjitha pozicioneve të hapura futures. Nëse rritet, më shumë para vihen bast për lëvizjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer är vad på kursen, ofta med lånade pengar. Värdet av alla öppna terminspositioner. Stiger det satsar mer pengar på rörelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟิวเจอร์สคือการเดิมพันกับราคา ซึ่งมักใช้เงินที่กู้ยืมมา มูลค่าของสถานะฟิวเจอร์สที่เปิดอยู่ทั้งหมด หากเพิ่มขึ้น แปลว่ามีเงินเดิมพันกับการเคลื่อนไหวนี้มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vadeli işlemler fiyat üzerine bahislerdir, çoğu zaman borç parayla. Tüm açık vadeli işlem pozisyonlarının değeri. Yükselmesi, harekete daha fazla paranın yatırıldığı anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ф'ючерси – це ставки на ціну, часто позиченими грошима. Вартість усіх відкритих ф'ючерсних позицій. Якщо зростає, на рух ставлять більше грошей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hợp đồng tương lai là đặt cược vào giá, thường bằng tiền vay. Giá trị của tất cả vị thế hợp đồng tương lai đang mở. Nếu tăng, có nhiều tiền hơn đặt cược vào biến động đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期货是对价格的押注，常常用借来的钱。所有未平仓合约头寸的价值。上升表示有更多资金押注这一走势。"
          }
        }
      }
    },
