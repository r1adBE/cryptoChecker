        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android entscheidet, wann geprüft wird – hier siehst du, wann es wirklich geschah."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
