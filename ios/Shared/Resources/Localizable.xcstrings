    "settings_exact_checks_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفحص Android تقريبًا كل 15 دقيقة حتى عندما يكون الجهاز خاملًا. يستهلك بطارية أكثر قليلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android kontroluje zhruba každých 15 minut, i když zařízení odpočívá. Spotřebuje trochu víc baterie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tjekker cirka hvert 15. minut, også når enheden er i dvale. Bruger lidt mere batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android prüft etwa alle 15 Minuten, auch wenn das Gerät ruht. Braucht etwas mehr Akku."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Android ελέγχει περίπου κάθε 15 λεπτά, ακόμη και όταν η συσκευή είναι σε αδράνεια. Καταναλώνει λίγο περισσότερη μπαταρία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android checks about every 15 minutes, even when the device is idle. Uses a little more battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android comprueba aproximadamente cada 15 minutos, incluso con el dispositivo en reposo. Gasta algo más de batería."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android تقریباً هر 15 دقیقه بررسی می‌کند، حتی وقتی دستگاه بیکار است. کمی باتری بیشتری مصرف می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tarkistaa noin 15 minuutin välein myös laitteen ollessa levossa. Kuluttaa hieman enemmän akkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android vérifie environ toutes les 15 minutes, même quand l’appareil est en veille. Consomme un peu plus de batterie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android בודק בערך כל 15 דקות, גם כשהמכשיר במנוחה. צורך מעט יותר סוללה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android लगभग हर 15 मिनट में जाँचता है, डिवाइस निष्क्रिय होने पर भी। थोड़ी ज़्यादा बैटरी लगती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Android körülbelül 15 percenként ellenőriz, akkor is, ha az eszköz pihen. Kicsit több akkut fogyaszt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android memeriksa kira-kira setiap 15 menit, bahkan saat perangkat diam. Memakai sedikit lebih banyak baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android controlla circa ogni 15 minuti, anche quando il dispositivo è inattivo. Consuma un po’ più di batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
