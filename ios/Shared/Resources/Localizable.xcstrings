    "settings_portfolio_lock_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القفل يُخفي ما يُعرض على الشاشة. تُحفظ البيانات على هذا الجهاز ويحميها تشفير الجهاز. يمكنك حماية النسخ الاحتياطية بكلمة مرور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zámek skrývá zobrazení. Data jsou uložena v tomto zařízení a chrání je šifrování zařízení. Zálohy můžeš chránit heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låsen skjuler visningen. Dataene ligger på denne enhed og er beskyttet af enhedens kryptering. Du kan beskytte sikkerhedskopier med en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sperre verdeckt die Anzeige. Die Daten liegen auf diesem Gerät und sind durch die Geräteverschlüsselung geschützt. Sicherungen kannst du mit einem Passwort schützen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλείδωμα κρύβει την προβολή. Τα δεδομένα βρίσκονται σε αυτή τη συσκευή και προστατεύονται από την κρυπτογράφηση της συσκευής. Μπορείς να προστατέψεις τα αντίγραφα ασφαλείας με κωδικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lock hides what’s shown on screen. Your data is stored on this device and is protected by the device encryption. You can protect backups with a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo oculta lo que se muestra. Los datos se guardan en este dispositivo y están protegidos por el cifrado del dispositivo. Puedes proteger las copias de seguridad con una contraseña."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قفل آنچه را نمایش داده می‌شود پنهان می‌کند. داده‌ها روی همین دستگاه ذخیره می‌شوند و رمزگذاری دستگاه از آن‌ها محافظت می‌کند. می‌توانی از نسخه‌های پشتیبان با گذرواژه محافظت کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitus piilottaa näkymän. Tiedot ovat tällä laitteella, ja laitteen salaus suojaa ne. Voit suojata varmuuskopiot salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage masque l’affichage. Les données sont stockées sur cet appareil et sont protégées par le chiffrement de l’appareil. Tu peux protéger les sauvegardes par un mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנעילה מסתירה את מה שמוצג במסך. הנתונים נשמרים במכשיר הזה ומוגנים בהצפנת המכשיר. אפשר להגן על גיבויים באמצעות סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लॉक स्क्रीन पर दिखने वाली जानकारी को छिपाता है। डेटा इसी डिवाइस पर रहता है और डिवाइस एन्क्रिप्शन से सुरक्षित है। तुम बैकअप को पासवर्ड से सुरक्षित कर सकते हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zár eltakarja a megjelenítést. Az adatok ezen az eszközön vannak, és az eszköz titkosítása védi őket. A biztonsági mentéseket jelszóval védheted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci menyembunyikan tampilan. Data disimpan di perangkat ini dan dilindungi oleh enkripsi perangkat. Kamu bisa melindungi cadangan dengan kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco nasconde ciò che è visualizzato. I dati si trovano su questo dispositivo e sono protetti dalla crittografia del dispositivo. Puoi proteggere i backup con una password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックは画面の表示を隠します。データはこの端末に保存され、端末の暗号化で保護されています。バックアップはパスワードで保護できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금은 화면에 표시되는 내용을 가립니다. 데이터는 이 기기에 저장되며 기기 암호화로 보호됩니다. 백업은 비밀번호로 보호할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låsen skjuler visningen. Dataene ligger på denne enheten og er beskyttet av enhetens kryptering. Du kan beskytte sikkerhetskopier med et passord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vergrendeling verbergt wat er wordt weergegeven. De gegevens staan op dit apparaat en worden beschermd door de apparaatversleuteling. Back-ups kun je met een wachtwoord beveiligen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokada zasłania to, co widać na ekranie. Dane są przechowywane na tym urządzeniu i chronione przez szyfrowanie urządzenia. Kopie zapasowe możesz zabezpieczyć hasłem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio oculta o que é mostrado. Os dados ficam neste dispositivo e estão protegidos pela encriptação do dispositivo. Podes proteger as cópias de segurança com uma palavra-passe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio oculta o que aparece na tela. Os dados ficam neste dispositivo e são protegidos pela criptografia do dispositivo. Você pode proteger os backups com uma senha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocarea ascunde afișarea. Datele sunt stocate pe acest dispozitiv și sunt protejate de criptarea dispozitivului. Poți proteja copiile de rezervă cu o parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка скрывает то, что видно на экране. Данные хранятся на этом устройстве и защищены шифрованием устройства. Резервные копии можно защитить паролем."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyçja fsheh atë që shfaqet. Të dhënat ruhen në këtë pajisje dhe mbrohen nga enkriptimi i pajisjes. Kopjet rezervë mund t’i mbrosh me fjalëkalim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låset döljer det som visas. Data finns på den här enheten och skyddas av enhetens kryptering. Du kan skydda säkerhetskopior med ett lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การล็อกจะซ่อนสิ่งที่แสดงบนหน้าจอ ข้อมูลอยู่ในอุปกรณ์นี้และได้รับการปกป้องด้วยการเข้ารหัสของอุปกรณ์ คุณป้องกันไฟล์สำรองด้วยรหัสผ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit, görüntülenen bilgileri gizler. Veriler bu cihazda tutulur ve cihaz şifrelemesiyle korunur. Yedekleri bir parolayla koruyabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокування приховує те, що видно на екрані. Дані зберігаються на цьому пристрої й захищені шифруванням пристрою. Резервні копії можна захистити паролем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ẩn nội dung hiển thị. Dữ liệu nằm trên thiết bị này và được bảo vệ bằng mã hóa của thiết bị. Bạn có thể bảo vệ bản sao lưu bằng mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定只隐藏屏幕上的显示内容。数据存储在此设备上，并受设备加密保护。你可以用密码保护备份。"
          }
        }
      }
    },
    "settings_portfolio_lock_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخفي المحفظة فقط: افتح القفل ببصمة الإصبع أو الوجه أو رمز PIN للجهاز. يُقفل مجددًا بعد أكثر من دقيقة في الخلفية. تبقى قائمة المتابعة والتنبيهات والأدوات الأخرى مفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrývá jen portfolio: odemknutí otiskem prstu, obličejem nebo PIN zařízení. Znovu se zamkne po více než minutě na pozadí. Sledované, alarmy a ostatní widgety zůstávají přístupné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler kun porteføljen: lås op med fingeraftryk, ansigt eller enhedens PIN. Låser igen efter mere end et minut i baggrunden. Overvågningsliste, alarmer og andre widgets forbliver åbne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdeckt nur das Portfolio: entsperren mit Fingerabdruck, Gesicht oder Geräte-PIN. Sperrt wieder nach mehr als einer Minute im Hintergrund. Merkliste, Alarme und übrige Widgets bleiben offen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρύβει μόνο το χαρτοφυλάκιο: ξεκλείδωμα με δακτυλικό αποτύπωμα, πρόσωπο ή PIN συσκευής. Κλειδώνει ξανά μετά από περισσότερο από ένα λεπτό στο παρασκήνιο. Η λίστα παρακολούθησης, οι συναγερμοί και τα άλλα widget μένουν ανοιχτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides only the portfolio: unlock with fingerprint, face or device PIN. Locks again after more than a minute in the background. Watchlist, alerts and other widgets stay open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta solo la cartera: desbloquea con huella, rostro o PIN del dispositivo. Se vuelve a bloquear tras más de un minuto en segundo plano. La lista de seguimiento, las alarmas y los demás widgets siguen accesibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط پرتفوی را پنهان می‌کند: با اثر انگشت، چهره یا پین دستگاه باز کن. پس از بیش از یک دقیقه در پس‌زمینه دوباره قفل می‌شود. واچ‌لیست، هشدارها و ابزارک‌های دیگر باز می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa vain salkun: avaa sormenjäljellä, kasvoilla tai laitteen PIN-koodilla. Lukittuu uudelleen, kun sovellus on ollut taustalla yli minuutin. Seurantalista, hälytykset ja muut widgetit pysyvät avoimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque uniquement le portefeuille : déverrouillage par empreinte, visage ou code PIN de l'appareil. Se reverrouille après plus d'une minute en arrière-plan. La liste de suivi, les alertes et les autres widgets restent accessibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתירה רק את תיק ההשקעות: ביטול נעילה בטביעת אצבע, בפנים או בקוד PIN של המכשיר. ננעל שוב אחרי יותר מדקה ברקע. רשימת המעקב, ההתראות ושאר הווידג׳טים נשארים פתוחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल पोर्टफ़ोलियो को छिपाता है: फ़िंगरप्रिंट, चेहरे या डिवाइस PIN से अनलॉक करो। बैकग्राउंड में एक मिनट से ज़्यादा रहने पर फिर लॉक हो जाता है। वॉचलिस्ट, अलार्म और बाकी विजेट खुले रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a portfóliót takarja el: feloldás ujjlenyomattal, arccal vagy az eszköz PIN-kódjával. Több mint egy perc háttérben töltött idő után újra zárol. A figyelőlista, a riasztások és a többi widget szabadon elérhető marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menyembunyikan portofolio: buka dengan sidik jari, wajah, atau PIN perangkat. Terkunci lagi setelah lebih dari satu menit di latar belakang. Daftar pantau, alarm, dan widget lain tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde solo il portafoglio: sblocco con impronta, volto o PIN del dispositivo. Si blocca di nuovo dopo più di un minuto in background. Lista di osservazione, allarmi e altri widget restano accessibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポートフォリオだけを隠します：指紋、顔、または端末のPINでロック解除。バックグラウンドに1分以上あると再びロックされます。ウォッチリスト、アラーム、その他のウィジェットはそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트폴리오만 가립니다: 지문, 얼굴 또는 기기 PIN으로 잠금 해제. 백그라운드에서 1분 넘게 있으면 다시 잠깁니다. 관심 목록, 경보 및 다른 위젯은 잠기지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler bare porteføljen: lås opp med fingeravtrykk, ansikt eller enhetens PIN. Låses igjen etter mer enn ett minutt i bakgrunnen. Overvåkingsliste, alarmer og andre widgeter forblir åpne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt alleen de portfolio: ontgrendelen met vingerafdruk, gezicht of pincode van het apparaat. Vergrendelt opnieuw na meer dan een minuut op de achtergrond. Volglijst, alarmen en andere widgets blijven open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasłania tylko portfel: odblokowanie odciskiem palca, twarzą lub PIN-em urządzenia. Blokuje się ponownie po ponad minucie w tle. Lista obserwowanych, alarmy i pozostałe widżety pozostają dostępne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta apenas o portfólio: desbloqueia com impressão digital, rosto ou PIN do dispositivo. Volta a bloquear após mais de um minuto em segundo plano. A lista de acompanhamento, os alarmes e os outros widgets continuam acessíveis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta apenas o portfólio: desbloqueie com impressão digital, rosto ou PIN do dispositivo. Bloqueia de novo após mais de um minuto em segundo plano. A lista de acompanhamento, os alarmes e os outros widgets continuam acessíveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde doar portofoliul: deblochează cu amprenta, fața sau PIN-ul dispozitivului. Se blochează din nou după mai mult de un minut în fundal. Lista de urmărire, alarmele și celelalte widgeturi rămân accesibile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает только портфель: разблокировка отпечатком пальца, лицом или PIN-кодом устройства. Снова блокируется после более чем минуты в фоне. Список наблюдения, оповещения и другие виджеты остаются доступными."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fsheh vetëm portofolin: shkyç me gjurmë gishti, fytyrë ose PIN të pajisjes. Kyçet përsëri pas më shumë se një minute në sfond. Lista e ndjekjes, alarmet dhe widget-et e tjera mbeten të hapura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer bara portföljen: lås upp med fingeravtryck, ansikte eller enhetens PIN. Låses igen efter mer än en minut i bakgrunden. Bevakningslista, larm och andra widgetar förblir öppna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนเฉพาะพอร์ตโฟลิโอ: ปลดล็อกด้วยลายนิ้วมือ ใบหน้า หรือ PIN ของอุปกรณ์ ล็อกอีกครั้งเมื่ออยู่เบื้องหลังนานกว่าหนึ่งนาที รายการติดตาม สัญญาณเตือน และวิดเจ็ตอื่นยังเปิดใช้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca portföyü gizler: parmak izi, yüz veya cihaz PIN'i ile kilidi aç. Arka planda bir dakikadan uzun kaldıktan sonra yeniden kilitlenir. İzleme listesi, alarmlar ve diğer widget'lar açık kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує лише портфель: розблокування відбитком пальця, обличчям або PIN-кодом пристрою. Знову блокується після понад хвилини у фоні. Список спостереження, сигнали та інші віджети залишаються доступними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ ẩn danh mục: mở khóa bằng vân tay, khuôn mặt hoặc mã PIN thiết bị. Khóa lại sau hơn một phút chạy nền. Danh sách theo dõi, cảnh báo và các tiện ích khác vẫn mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅隐藏投资组合：使用指纹、面容或设备 PIN 解锁。在后台超过一分钟后会再次锁定。自选列表、提醒和其他小部件不受影响。"
          }
        }
      }
    },
    "settings_portfolio_lock_no_device_lock" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون رمز PIN أو رمز مرور للجهاز لا يُخفي القفل شيئًا – اضبط قفلًا للشاشة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez PIN nebo kódu zařízení zámek nic neskryje – nastav zámek obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden enhedens pinkode eller adgangskode skjuler låsen intet – opsæt en skærmlås."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Geräte-PIN/Code verdeckt die Sperre nichts – richte eine Bildschirmsperre ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς PIN ή κωδικό συσκευής το κλείδωμα δεν κρύβει τίποτα – ρύθμισε κλείδωμα οθόνης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a device PIN or passcode the lock hides nothing – set up a screen lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin PIN o código del dispositivo el bloqueo no oculta nada: configura un bloqueo de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون PIN یا رمز دستگاه، قفل چیزی را پنهان نمی‌کند – قفل صفحه را تنظیم کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman laitteen PIN-koodia tai pääsykoodia lukitus ei piilota mitään – ota näytön lukitus käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans code PIN ou code de l’appareil, le verrouillage ne masque rien – configure un verrouillage d’écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ללא PIN או קוד גישה במכשיר הנעילה לא מסתירה כלום – הגדירו נעילת מסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस PIN या पासकोड के बिना लॉक कुछ भी नहीं छिपाता – स्क्रीन लॉक सेट करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eszköz-PIN vagy jelkód nélkül a zár semmit sem takar el – állíts be képernyőzárat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa PIN atau kode sandi perangkat, kunci tidak menyembunyikan apa pun – atur kunci layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza PIN o codice del dispositivo il blocco non nasconde nulla – imposta un blocco schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の PIN やパスコードがないとロックは何も隠しません。画面ロックを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 PIN이나 암호가 없으면 잠금은 아무것도 가리지 않습니다. 화면 잠금을 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten PIN-kode eller passkode på enheten skjuler ikke låsen noe – konfigurer en skjermlås."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder pincode of toegangscode op het apparaat verbergt de vergrendeling niets – stel een schermvergrendeling in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez PIN-u lub kodu urządzenia blokada niczego nie zasłania – ustaw blokadę ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem PIN ou código do dispositivo, o bloqueio não oculta nada – configura um bloqueio de ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem PIN ou senha do dispositivo, o bloqueio não oculta nada – configure um bloqueio de tela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără PIN sau cod al dispozitivului, blocarea nu ascunde nimic – setează o blocare a ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без PIN-кода или пароля устройства блокировка ничего не скрывает – настрой блокировку экрана."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa PIN ose kod të pajisjes, kyçja nuk fsheh asgjë – vendos një kyçje ekrani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan enhetens pinkod eller lösenkod döljer låset ingenting – ställ in ett skärmlås."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มี PIN หรือรหัสผ่านของอุปกรณ์ การล็อกจะไม่ซ่อนอะไรเลย – ตั้งค่าล็อกหน้าจอ"
