    "dex_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز خارج المنصات الكبيرة، من المنصات اللامركزية (Uniswap، PancakeSwap، Raydium …) عبر DexScreener. ابحث عن رمز وأضف مجمّع التداول الخاص به – الأسعار بالدولار الأمريكي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny mimo velké burzy, z decentralizovaných burz (Uniswap, PancakeSwap, Raydium …) přes DexScreener. Vyhledejte token a přidejte jeho obchodní pool – ceny v amerických dolarech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens uden for de store børser, fra decentraliserede børser (Uniswap, PancakeSwap, Raydium …) via DexScreener. Søg efter en token, og tilføj dens handelspool – kurser i amerikanske dollar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ausserhalb der grossen Börsen, von dezentralen Börsen (Uniswap, PancakeSwap, Raydium …) über DexScreener. Token suchen und seinen Handelspool hinzufügen – Kurse in US-Dollar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens εκτός των μεγάλων ανταλλακτηρίων, από αποκεντρωμένα ανταλλακτήρια (Uniswap, PancakeSwap, Raydium …) μέσω DexScreener. Αναζητήστε ένα token και προσθέστε το pool συναλλαγών του – τιμές σε δολάρια ΗΠΑ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens outside the big exchanges, from decentralized exchanges (Uniswap, PancakeSwap, Raydium …) via DexScreener. Search for a token and add its trading pool – prices in US dollars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens fuera de los grandes exchanges, de exchanges descentralizados (Uniswap, PancakeSwap, Raydium …) a través de DexScreener. Busca un token y añade su pool de trading – precios en dólares estadounidenses."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توکن‌های خارج از صرافی‌های بزرگ، از صرافی‌های غیرمتمرکز (Uniswap، PancakeSwap، Raydium …) از طریق DexScreener. توکن را جست‌وجو کنید و استخر معاملاتی آن را اضافه کنید – قیمت‌ها به دلار آمریکا."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeneita suurten pörssien ulkopuolelta, hajautetuista pörsseistä (Uniswap, PancakeSwap, Raydium …) DexScreenerin kautta. Hae tokenia ja lisää sen kaupankäyntipooli – hinnat Yhdysvaltain dollareina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens hors des grandes plateformes, issus de plateformes décentralisées (Uniswap, PancakeSwap, Raydium …) via DexScreener. Recherchez un token et ajoutez son pool d'échange – prix en dollars américains."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טוקנים מחוץ לבורסות הגדולות, מבורסות מבוזרות (Uniswap, PancakeSwap, Raydium …) דרך DexScreener. חפשו טוקן והוסיפו את מאגר המסחר שלו – מחירים בדולר אמריקאי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े एक्सचेंजों से बाहर के टोकन, विकेंद्रीकृत एक्सचेंजों (Uniswap, PancakeSwap, Raydium …) से DexScreener के ज़रिए। टोकन खोजें और उसका ट्रेडिंग पूल जोड़ें – कीमतें अमेरिकी डॉलर में।"
          }
        },
        "hu" : {
          "stringUnit" : {
