    "widgets_ios_step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مكانًا فارغًا في الشاشة الرئيسية مع الاستمرار حتى تهتز التطبيقات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na volném místě plochy, dokud se aplikace nezačnou třást."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på et tomt sted på hjemmeskærmen, indtil apps begynder at vrikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine freie Stelle auf dem Home-Bildschirm gedrückt, bis die Apps wackeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε παρατεταμένα ένα κενό σημείο στην οθόνη Αφετηρίας μέχρι να αρχίσουν να κουνιούνται οι εφαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty spot on the Home Screen until the apps jiggle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un espacio vacío de la pantalla de inicio hasta que las apps se muevan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انگشت خود را روی یک جای خالی صفحه اصلی نگه دارید تا برنامه‌ها شروع به لرزیدن کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina pitkään tyhjää kohtaa Koti-valikossa, kunnes apit alkavat heilua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un espace vide de l'écran d'accueil jusqu'à ce que les apps se mettent à trembler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצו לחיצה ארוכה על מקום ריק במסך הבית עד שהאפליקציות מתחילות לרעוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम स्क्रीन पर किसी खाली जगह को तब तक दबाकर रखें जब तक ऐप्स हिलने न लगें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva a Főképernyő egy üres részét, amíg az appok remegni nem kezdenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh lama area kosong di Layar Utama hingga aplikasi bergoyang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto su uno spazio vuoto della schermata Home finché le app iniziano a tremare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが揺れ始めるまで、ホーム画面の空いている場所を長押しします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 흔들릴 때까지 홈 화면의 빈 곳을 길게 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på et tomt sted på Hjem-skjermen til appene begynner å vrikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een lege plek op het beginscherm ingedrukt tot de apps gaan wiebelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj puste miejsce na ekranie początkowym, aż aplikacje zaczną drgać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o dedo num espaço vazio do ecrã principal até as apps começarem a abanar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure um espaço vazio da Tela de Início até os apps começarem a tremer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge lung un loc liber pe ecranul principal până când aplicațiile încep să tremure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте свободное место на экране «Домой», пока приложения не начнут покачиваться."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbaj shtypur një vend bosh në ekranin bazë derisa aplikacionet të fillojnë të lëkunden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll fingret på en tom plats på hemskärmen tills apparna börjar vicka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะค้างที่พื้นที่ว่างบนหน้าจอโฮมจนกว่าแอปจะเริ่มสั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar kıpırdamaya başlayana kadar Ana Ekran'da boş bir yere dokunup basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть і утримуйте вільне місце на початковому екрані, доки програми не почнуть ворушитися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ một chỗ trống trên Màn hình chính cho đến khi các ứng dụng rung lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按主屏幕上的空白处，直到应用开始晃动。"
          }
        }
      }
    },
    "widgets_ios_step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط في الأعلى على «تعديل» › «إضافة أداة» (أو «+» في إصدارات iOS الأقدم)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahoře klepněte na „Upravit” › „Přidat widget” (ve starších verzích iOS na „+”)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på ”Rediger” › ”Tilføj widget” øverst (eller ”+” i ældre iOS-versioner)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben auf «Bearbeiten» › «Widget hinzufügen» (in älteren iOS-Versionen auf «+»)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε επάνω «Επεξεργασία» › «Προσθήκη widget» (ή «+» σε παλαιότερες εκδόσεις iOS)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Edit” › “Add Widget” at the top (or “+” on older iOS versions)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Editar» › «Añadir widget» arriba (o «+» en versiones anteriores de iOS)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در بالا روی «ویرایش» › «افزودن ابزارک» بزنید (یا در نسخه‌های قدیمی‌تر iOS روی «+»)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ylhäällä ”Muokkaa” › ”Lisää widget” (tai vanhemmissa iOS-versioissa ”+”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Modifier » › « Ajouter un widget » en haut (ou « + » dans les anciennes versions d'iOS)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו למעלה על ״עריכה״ › ״הוספת וידג׳ט״ (או על ״+״ בגרסאות iOS ישנות יותר)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर “संपादित करें” › “विजेट जोड़ें” पर टैप करें (पुराने iOS वर्शन में “+” पर)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson fent a „Szerkesztés” › „Widget hozzáadása” elemre (régebbi iOS-verziókban a „+” gombra)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk “Edit” › “Tambah Widget” di bagian atas (atau “+” di versi iOS lama)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca «Modifica» › «Aggiungi widget» in alto (o «+» nelle versioni di iOS meno recenti)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上部の「編集」›「ウィジェットを追加」をタップします（古い iOS では「+」）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
