    "why_sentiment_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مؤشر الخوف والطمع لسوق العملات المشفرة بأكمله، %1$@ مقارنةً بالأمس."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Index Fear & Greed celého kryptotrhu, %1$@ oproti včerejšku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear & Greed-indeks for hele kryptomarkedet, %1$@ i forhold til i går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear & Greed Index des gesamten Kryptomarkts, %1$@ gegenüber gestern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείκτης Fear & Greed όλης της αγοράς κρυπτονομισμάτων, %1$@ σε σχέση με χθες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear & Greed index of the whole crypto market, %1$@ vs. yesterday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Índice Fear & Greed de todo el mercado cripto, %1$@ respecto a ayer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاخص ترس و طمع کل بازار رمزارز، %1$@ نسبت به دیروز."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koko kryptomarkkinan Fear & Greed -indeksi, %1$@ eiliseen verrattuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indice Fear & Greed de l'ensemble du marché crypto, %1$@ par rapport à hier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדד פחד ותאוות בצע של כל שוק הקריפטו, %1$@ לעומת אתמול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे क्रिप्टो मार्केट का डर और लालच इंडेक्स, कल की तुलना में %1$@।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A teljes kriptopiac Fear & Greed indexe, %1$@ a tegnapihoz képest."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeks Fear & Greed seluruh pasar kripto, %1$@ dibanding kemarin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indice Fear & Greed dell'intero mercato cripto, %1$@ rispetto a ieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号資産市場全体の恐怖・強欲指数、昨日比 %1$@。"
