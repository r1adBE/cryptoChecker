    "ledger_gain_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم، 7 أيام، سنة: تغيّر القيمة خلال الفترة – لا تُحسب عمليات الشراء والبيع ربحًا. منذ الشراء: القيمة الحالية ناقص التكلفة (متوسط التكلفة مع الرسوم) للعملات التي ما زلت تحتفظ بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes, 7 D, 1 R: změna hodnoty za období – nákupy a prodeje se nepočítají jako zisk. Od nákupu: aktuální hodnota minus pořizovací cena (průměrná cena vč. poplatků) mincí, které stále držíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag, 7 D, 1 Å: værdiændring i perioden – køb og salg tæller ikke som gevinst. Siden køb: aktuel værdi minus anskaffelsespris (gennemsnitspris inkl. gebyrer) for de coins, du stadig har."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute, 7 T, 1 J: Wertänderung im Zeitraum – Käufe und Verkäufe zählen nicht als Gewinn. Seit Kauf: aktueller Wert minus Einstand (Durchschnittskosten inkl. Gebühren) der noch gehaltenen Coins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σήμερα, 7 Η, 1 Ε: μεταβολή αξίας στην περίοδο – αγορές και πωλήσεις δεν μετρούν ως κέρδος. Από την αγορά: τρέχουσα αξία μείον κόστος κτήσης (μέσο κόστος με χρεώσεις) των νομισμάτων που έχεις ακόμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, 7 D, 1 Y: change in value over the period – buys and sells do not count as gain. Since purchase: current value minus cost basis (average cost incl. fees) of the coins you still hold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy, 7 D, 1 A: cambio de valor en el periodo – compras y ventas no cuentan como ganancia. Desde la compra: valor actual menos coste de adquisición (coste medio con comisiones) de las monedas que aún tienes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امروز، ۷ روز، ۱ سال: تغییر ارزش در دوره – خرید و فروش سود حساب نمی‌شود. از زمان خرید: ارزش فعلی منهای بهای تمام‌شده (میانگین هزینه با کارمزد) کوین‌هایی که هنوز داری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänään, 7 pv, 1 v: arvon muutos jaksolla – ostot ja myynnit eivät ole voittoa. Oston jälkeen: nykyarvo miinus hankintameno (keskihinta kuluineen) kolikoista, jotka sinulla yhä on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui, 7 J, 1 A : variation de valeur sur la période – achats et ventes ne comptent pas comme gain. Depuis l’achat : valeur actuelle moins coût de revient (coût moyen, frais compris) des coins encore détenus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היום, 7 י׳, שנה: שינוי הערך בתקופה – קניות ומכירות אינן נחשבות רווח. מאז הקנייה: הערך הנוכחי פחות עלות הרכישה (עלות ממוצעת כולל עמלות) של המטבעות שעדיין בידך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज, 7 दिन, 1 वर्ष: अवधि में मूल्य बदलाव – खरीद और बिक्री लाभ नहीं गिनी जातीं। खरीद से: जो कॉइन अभी तुम्हारे पास हैं उनका मौजूदा मूल्य घटा लागत (शुल्क सहित औसत लागत)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma, 7 N, 1 É: értékváltozás az időszakban – a vételek és eladások nem számítanak nyereségnek. Vétel óta: jelenlegi érték mínusz bekerülési érték (átlagár díjakkal) a még meglévő coinokra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini, 7 H, 1 T: perubahan nilai dalam periode – pembelian dan penjualan tidak dihitung sebagai untung. Sejak beli: nilai saat ini dikurangi biaya perolehan (biaya rata-rata termasuk biaya) koin yang masih kamu pegang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi, 7 G, 1 A: variazione di valore nel periodo – acquisti e vendite non contano come guadagno. Dall’acquisto: valore attuale meno costo di carico (costo medio, commissioni incluse) delle monete ancora possedute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日・7日・1年：期間中の評価額の変化です。購入と売却は利益として数えません。購入以来：まだ保有しているコインの現在価値から取得原価（手数料込みの平均取得単価）を引いた値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘·7일·1년: 기간 동안의 가치 변화 – 매수와 매도는 수익으로 치지 않습니다. 매수 이후: 아직 보유한 코인의 현재 가치에서 취득원가(수수료 포함 평균 단가)를 뺀 값입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag, 7 D, 1 Å: verdiendring i perioden – kjøp og salg regnes ikke som gevinst. Siden kjøp: nåverdi minus anskaffelseskost (snittkost inkl. gebyrer) for myntene du fortsatt har."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag, 7 D, 1 J: waardeverandering in de periode – aankopen en verkopen tellen niet als winst. Sinds aankoop: huidige waarde min kostprijs (gemiddelde kosten incl. kosten) van de munten die je nog hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś, 7 D, 1 R: zmiana wartości w okresie – zakupy i sprzedaże nie liczą się jako zysk. Od zakupu: bieżąca wartość minus koszt nabycia (średni koszt z opłatami) monet, które nadal masz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje, 7 D, 1 A: variação do valor no período – compras e vendas não contam como ganho. Desde a compra: valor atual menos custo de aquisição (custo médio com comissões) das moedas ainda detidas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje, 7 D, 1 A: variação do valor no período – compras e vendas não contam como ganho. Desde a compra: valor atual menos custo de aquisição (custo médio com taxas) das moedas que você ainda tem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azi, 7 Z, 1 A: variația valorii în perioadă – cumpărările și vânzările nu contează drept câștig. De la cumpărare: valoarea actuală minus costul de achiziție (cost mediu cu comisioane) al monedelor încă deținute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня, 7 Д, 1 Г: изменение стоимости за период – покупки и продажи не считаются прибылью. С покупки: текущая стоимость минус себестоимость (средняя цена с комиссиями) монет, которые ещё у тебя."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sot, 7 D, 1 V: ndryshimi i vlerës në periudhë – blerjet dhe shitjet nuk llogariten si fitim. Që nga blerja: vlera aktuale minus kostoja (kosto mesatare me tarifa) e monedhave që ke ende."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag, 7 D, 1 Å: värdeförändring under perioden – köp och sälj räknas inte som vinst. Sedan köp: aktuellt värde minus anskaffningsvärde (genomsnittskostnad inkl. avgifter) för mynten du fortfarande har."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ 7 วัน 1 ปี: มูลค่าที่เปลี่ยนในช่วงเวลา – การซื้อและขายไม่นับเป็นกำไร ตั้งแต่ซื้อ: มูลค่าปัจจุบันลบต้นทุน (ต้นทุนเฉลี่ยรวมค่าธรรมเนียม) ของเหรียญที่ยังถืออยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün, 7 G, 1 Y: dönem içindeki değer değişimi – alımlar ve satımlar kazanç sayılmaz. Alımdan beri: hâlâ tuttuğun coinlerin güncel değeri eksi maliyeti (ücretler dahil ortalama maliyet)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сьогодні, 7 Д, 1 Р: зміна вартості за період – купівлі й продажі не вважаються прибутком. З купівлі: поточна вартість мінус собівартість (середня ціна з комісіями) монет, які ще у тебе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay, 7 N, 1 N: thay đổi giá trị trong kỳ – mua và bán không tính là lãi. Từ khi mua: giá trị hiện tại trừ giá vốn (giá trung bình gồm phí) của các coin bạn vẫn giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天、7天、1年：期间内的价值变化——买入和卖出不算作收益。买入以来：仍持有币的当前价值减去成本（含手续费的平均成本）。"
          }
        }
      }
