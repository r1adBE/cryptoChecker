    "settings_watchlist_activity_card_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الشريحة ⚡ بجانب المجموعات: انقر عليها لعرض الأزواج التي يحدث فيها شيء الآن فقط. تُضبط التنبيهات في إشعارات السوق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí čip ⚡ u skupin: klepnutím uvidíš jen páry, u kterých se právě něco děje. Upozornění nastavíš v sekci „Tržní upozornění“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser chippen ⚡ ved grupperne: tryk for kun at se de par, hvor der sker noget lige nu. Meddelelser indstilles under Markedsmeddelelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt ⚡ neben den Gruppen: Antippen zeigt nur die Paare, bei denen gerade etwas passiert. Mitteilungen dazu stellst du unter «Markt-Mitteilungen» ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει το ⚡ δίπλα στις ομάδες: πάτα το για να δεις μόνο τα ζεύγη όπου κάτι συμβαίνει τώρα. Οι ειδοποιήσεις ρυθμίζονται στις «Ειδοποιήσεις αγοράς»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the ⚡ chip next to the groups: tap it to see only the pairs where something is happening right now. Notifications for it are set under Market alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el chip ⚡ junto a los grupos: tócalo para ver solo los pares en los que está pasando algo ahora mismo. Los avisos se ajustan en Avisos del mercado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تراشه ⚡ را کنار گروه‌ها نشان می‌دهد: با لمس آن فقط جفت‌هایی را می‌بینی که همین حالا در آن‌ها اتفاقی در جریان است. اعلان‌ها در اعلان‌های بازار تنظیم می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää ⚡-sirun ryhmien vieressä: napauta nähdäksesi vain parit, joissa tapahtuu juuri nyt jotain. Ilmoitukset asetetaan kohdassa Markkinailmoitukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la puce ⚡ à côté des groupes : touche-la pour ne voir que les paires où il se passe quelque chose en ce moment. Les alertes se règlent sous Notifications de marché."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג את השבב ⚡ ליד הקבוצות: הקישו עליו כדי לראות רק את הצמדים שבהם משהו קורה עכשיו. ההודעות מוגדרות ב״הודעות שוק״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समूहों के पास ⚡ चिप दिखाता है: टैप करो और केवल वे पेयर देखो जिनमें अभी कुछ हो रहा है। सूचनाएँ बाज़ार सूचनाएँ में सेट होती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjeleníti a ⚡ chipet a csoportok mellett: koppintva csak azokat a párokat látod, amelyeknél éppen történik valami. Az értesítéseket a Piaci értesítések alatt állíthatod be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan chip ⚡ di samping grup: ketuk untuk melihat hanya pasangan yang sedang mengalami sesuatu. Notifikasi diatur di Peringatan pasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il chip ⚡ accanto ai gruppi: toccalo per vedere solo le coppie in cui sta succedendo qualcosa. Le notifiche si impostano in Avvisi di mercato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループの横に ⚡ チップを表示します。タップすると、今まさに動きがあるペアだけを表示します。通知は「相場のお知らせ」で設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹 옆에 ⚡ 칩을 표시합니다. 누르면 지금 무언가 일어나고 있는 거래쌍만 보여 줍니다. 알림은 ‘시장 알림’에서 설정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser brikken ⚡ ved gruppene: trykk for å se bare parene der det skjer noe akkurat nå. Varsler stilles inn under Markedsvarsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de chip ⚡ bij de groepen: tik erop om alleen de paren te zien waar nu iets gebeurt. Meldingen stel je in bij Marktmeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje chip ⚡ przy grupach: dotknij go, aby zobaczyć tylko pary, w których właśnie coś się dzieje. Powiadomienia ustawisz w sekcji „Powiadomienia rynkowe”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o chip ⚡ junto aos grupos: toca para ver só os pares em que algo está a acontecer agora. Os alertas definem-se em Avisos de mercado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o chip ⚡ junto aos grupos: toque para ver só os pares em que algo está acontecendo agora. Os alertas são definidos em Alertas de mercado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează cipul ⚡ lângă grupuri: atinge-l ca să vezi doar perechile la care se întâmplă ceva chiar acum. Notificările se setează la Alerte de piață."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает чип ⚡ рядом с группами: нажми, чтобы увидеть только пары, где прямо сейчас что-то происходит. Уведомления настраиваются в разделе «Рыночные уведомления»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shfaq çipin ⚡ pranë grupeve: preke për të parë vetëm çiftet ku po ndodh diçka tani. Njoftimet caktohen te Njoftime tregu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar chippet ⚡ vid grupperna: tryck för att bara se paren där något händer just nu. Aviseringar ställs in under Marknadsaviseringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงชิป ⚡ ข้างกลุ่ม แตะเพื่อดูเฉพาะคู่เหรียญที่มีบางอย่างเกิดขึ้นตอนนี้ ตั้งค่าการแจ้งเตือนได้ที่ “การแจ้งเตือนตลาด”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupların yanında ⚡ çipini gösterir: dokunarak yalnızca şu anda bir şeyler olan çiftleri gör. Bildirimler Piyasa bildirimleri bölümünden ayarlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує чип ⚡ поруч із групами: торкнися, щоб побачити лише пари, де просто зараз щось відбувається. Сповіщення налаштовуються в розділі «Ринкові сповіщення»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị chip ⚡ cạnh các nhóm: chạm vào để chỉ xem các cặp đang có điều gì đó xảy ra. Thông báo được đặt trong Thông báo thị trường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分组旁显示 ⚡ 标签：点按即可只查看此刻正有异动的交易对。通知在“市场通知”中设置。"
          }
        }
      }
    },
