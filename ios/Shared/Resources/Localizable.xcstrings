    "settings_asset_scope_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد الأزواج التي يعرضها الاختيار والبحث عند الإضافة. تبقى الأزواج الموجودة في قائمة المتابعة دائمًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určuje, které páry ukazuje výběr a hledání při přidávání. Páry, které už jsou v seznamu, zůstávají vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestemmer, hvilke par valget og søgningen viser, når du tilføjer. Par, der allerede er på overvågningslisten, bliver altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmt, welche Paare die Auswahl und die Suche beim Hinzufügen zeigen. Gemerkte Paare bleiben immer in der Merkliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζει ποια ζεύγη δείχνουν η επιλογή και η αναζήτηση κατά την προσθήκη. Τα ζεύγη που είναι ήδη στη λίστα μένουν πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets which pairs the selection and search show when you add pairs. Pairs already in your watchlist always stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define qué pares muestran la selección y la búsqueda al añadir. Los pares que ya están en la lista se quedan siempre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعیین می‌کند انتخاب و جستجو هنگام افزودن کدام جفت‌ها را نشان دهند. جفت‌هایی که در واچ‌لیست هستند همیشه می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrää, mitä pareja valinta ja haku näyttävät lisättäessä. Seurantalistalla jo olevat parit pysyvät aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine les paires proposées par la sélection et la recherche lors de l’ajout. Les paires déjà dans la liste y restent toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע אילו צמדים יוצגו בבחירה ובחיפוש בעת הוספה. צמדים שכבר ברשימת המעקב נשארים תמיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोड़ते समय चयन और खोज कौन-से पेयर दिखाएँ, यह तय करता है। वॉचलिस्ट में पहले से मौजूद पेयर हमेशा रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meghatározza, mely párokat mutat a választó és a keresés hozzáadáskor. A figyelőlistán már szereplő párok mindig maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menentukan pasangan yang ditampilkan pilihan dan pencarian saat menambah. Pasangan yang sudah ada di daftar pantau selalu tetap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisce quali coppie mostrano la selezione e la ricerca quando aggiungi. Le coppie già nella lista restano sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアを追加するときに選択と検索で表示するペアを決めます。ウォッチリストにあるペアは常に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가할 때 선택 화면과 검색에 표시할 거래쌍을 정합니다. 관심 목록에 있는 거래쌍은 항상 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestemmer hvilke par utvalget og søket viser når du legger til. Par som allerede står på overvåkingslisten, blir alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt welke paren de keuze en de zoekfunctie tonen bij het toevoegen. Paren die al in de volglijst staan, blijven altijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określa, które pary pokazuje wybór i wyszukiwanie przy dodawaniu. Pary, które już są na liście, zostają zawsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define que pares a seleção e a pesquisa mostram ao adicionar. Os pares que já estão na lista ficam sempre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define quais pares a seleção e a busca mostram ao adicionar. Os pares que já estão na lista ficam sempre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilește ce perechi arată selecția și căutarea la adăugare. Perechile aflate deja în listă rămân mereu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяет, какие пары показывают выбор и поиск при добавлении. Пары, уже добавленные в список, остаются всегда."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përcakton cilat çifte shfaq zgjedhja dhe kërkimi kur shton. Çiftet që janë tashmë në listë mbeten gjithmonë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestämmer vilka par urvalet och sökningen visar när du lägger till. Par som redan finns i bevakningslistan ligger alltid kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดว่าการเลือกและการค้นหาจะแสดงคู่ใดเมื่อเพิ่ม คู่ที่อยู่ในรายการติดตามแล้วจะยังคงอยู่เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklerken seçimin ve aramanın hangi çiftleri göstereceğini belirler. Listede zaten olan çiftler her zaman kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначає, які пари показують вибір і пошук під час додавання. Пари, що вже є в списку, лишаються завжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyết định các cặp mà phần chọn và tìm kiếm hiển thị khi thêm. Các cặp đã có trong danh sách luôn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定添加时选择和搜索显示哪些交易对。已在自选列表中的交易对始终保留。"
          }
        }
      }
    },
