    "welcome_understand" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افهم – لماذا يتحرك السوق الآن؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopit – proč se trh právě hýbe?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstå – hvorfor bevæger markedet sig lige nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstehen – warum bewegt sich der Markt gerade?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατανόηση – γιατί κινείται η αγορά αυτή τη στιγμή;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understand – why is the market moving right now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entender – ¿por qué se mueve el mercado ahora?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بفهمید – چرا بازار همین حالا حرکت می‌کند؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrä – miksi markkina liikkuu juuri nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprendre – pourquoi le marché bouge-t-il en ce moment ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבנה – למה השוק זז עכשיו?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समझें – बाज़ार अभी क्यों चल रहा है?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megértés – miért mozog most a piac?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahami – mengapa pasar bergerak saat ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci – perché il mercato si muove adesso?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理解する – なぜいま市場が動いているのか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이해하기 – 지금 시장은 왜 움직일까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstå – hvorfor beveger markedet seg akkurat nå?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrijpen – waarom beweegt de markt nu?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrozum – dlaczego rynek właśnie się porusza?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perceber – porque é que o mercado se está a mover agora?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entender – por que o mercado está se movendo agora?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înțelege – de ce se mișcă piața acum?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понимать – почему рынок движется прямо сейчас?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupto – pse po lëviz tregu tani?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förstå – varför rör sig marknaden just nu?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข้าใจ – ทำไมตลาดถึงเคลื่อนไหวตอนนี้?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anla – piyasa şu anda neden hareket ediyor?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розуміти – чому ринок рухається просто зараз?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiểu – vì sao thị trường đang biến động?"
          }
