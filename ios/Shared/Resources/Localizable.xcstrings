        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezárt appnál az iOS dönti el, mikor ellenőriz (riasztások, widgetek), néha órák múlva. Nyitva: minden megnyitáskor."
