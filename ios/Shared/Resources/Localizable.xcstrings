    "dex_low_liquidity_alarm_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيولة هذا المجمّع أقل من 10,000 USD (أو غير متوفرة). المبالغ الصغيرة وحدها تحرّك سعره، لذا لا يمكن ضبط تنبيهات هنا. تبقى التنبيهات الحالية، لكنها لا تنطلق إلا بعد ارتفاع السيولة من جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento pool má méně než 10 000 USD likvidity (nebo údaj chybí). Kurz pohnou už malé částky, proto zde nelze nastavit alarmy. Stávající alarmy zůstávají, ale spustí se až po opětovném růstu likvidity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne pool har under 10.000 USD i likviditet (eller ingen angivelse). Små beløb kan flytte kursen, så her kan der ikke oprettes alarmer. Eksisterende alarmer bevares, men udløses først, når likviditeten stiger igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Pool hat weniger als 10’000 USD Liquidität (oder keine Angabe). Schon kleine Beträge bewegen den Kurs, darum lassen sich hier keine Alarme setzen. Bestehende Alarme bleiben, lösen aber erst wieder aus, wenn die Liquidität steigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το pool έχει ρευστότητα κάτω από 10.000 USD (ή καμία ένδειξη). Ακόμη και μικρά ποσά κινούν την τιμή, γι' αυτό εδώ δεν μπορούν να οριστούν συναγερμοί. Οι υπάρχοντες συναγερμοί παραμένουν, αλλά ενεργοποιούνται μόνο όταν αυξηθεί ξανά η ρευστότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pool has less than 10,000 USD in liquidity (or none reported). Small trades can move its price, so no alerts can be set here. Existing alerts are kept but won't fire until liquidity rises again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pool tiene menos de 10.000 USD de liquidez (o no se indica). Pequeñas cantidades bastan para mover su precio, así que aquí no se pueden crear alarmas. Las alarmas existentes se conservan, pero no saltan hasta que la liquidez vuelva a subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقدینگی این استخر کمتر از ۱۰٬۰۰۰ USD است (یا اعلام نشده). مبالغ کم هم قیمت آن را جابه‌جا می‌کنند، پس اینجا نمی‌توان هشدار گذاشت. هشدارهای موجود می‌مانند، اما تا افزایش دوباره نقدینگی فعال نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä poolissa on alle 10 000 USD likviditeettiä (tai tieto puuttuu). Pienetkin summat liikuttavat hintaa, joten tähän ei voi asettaa hälytyksiä. Nykyiset hälytykset säilyvät, mutta laukeavat vasta, kun likviditeetti taas kasvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce pool a moins de 10 000 USD de liquidité (ou aucune indication). De petits montants suffisent à faire bouger son cours, aucune alerte ne peut donc être définie ici. Les alertes existantes sont conservées, mais ne se déclenchent qu'une fois la liquidité remontée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפול הזה יש פחות מ-10,000 USD נזילות (או שאין נתון). גם סכומים קטנים מזיזים את המחיר, ולכן אי אפשר להגדיר כאן התראות. התראות קיימות נשמרות, אך יופעלו רק כשהנזילות תעלה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पूल में 10,000 USD से कम तरलता है (या कोई जानकारी नहीं)। छोटी रकम भी इसकी कीमत हिला सकती है, इसलिए यहाँ अलार्म नहीं लगाए जा सकते। मौजूदा अलार्म बने रहते हैं, लेकिन तरलता फिर से बढ़ने तक नहीं बजेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a poolnak 10 000 USD-nél kisebb a likviditása (vagy nincs adat). Már kis összegek is elmozdítják az árfolyamot, ezért itt nem állítható be riasztás. A meglévő riasztások megmaradnak, de csak akkor jeleznek, ha a likviditás ismét nő."
