        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ανταλλακτήριο δεν είναι διαθέσιμο αυτή τη στιγμή – οι τελευταίες τιμές παραμένουν ορατές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exchange not reachable right now – the last prices stay visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El exchange no está disponible ahora – los últimos precios siguen visibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرافی الان در دسترس نیست – آخرین قیمت‌ها نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pörssiin ei saada yhteyttä juuri nyt – viimeisimmät hinnat pysyvät näkyvissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plateforme injoignable pour le moment – les derniers cours restent affichés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבורסה לא זמינה כרגע – המחירים האחרונים נשארים מוצגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सचेंज अभी उपलब्ध नहीं है – पिछली कीमतें दिखती रहेंगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tőzsde most nem érhető el – az utolsó árfolyamok láthatók maradnak."
