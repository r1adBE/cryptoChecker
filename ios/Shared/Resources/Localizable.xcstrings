    "settings_accent_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لون التطبيق والأدوات وأيقونة التطبيق. قد تُزيل بعض الشاشات الرئيسية الأيقونة عند التغيير – أضفها من جديد عندئذٍ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva aplikace, widgetů a ikony aplikace. Některé domovské obrazovky při změně ikonu odstraní – pak ji přidej znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farve til appen, widgets og appikonet. Nogle startskærme fjerner ikonet ved skift – tilføj det så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe für App, Widgets und App-Symbol. Manche Startbildschirme entfernen das Symbol beim Wechsel – dann neu hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρώμα για την εφαρμογή, τα widget και το εικονίδιο της εφαρμογής. Ορισμένες αρχικές οθόνες αφαιρούν το εικονίδιο κατά την αλλαγή – τότε πρόσθεσέ το ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color for the app, widgets and app icon. Some home screens remove the icon when it changes – add it again then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de la app, los widgets y el icono de la app. Algunas pantallas de inicio quitan el icono al cambiarlo; vuelve a añadirlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ برنامه، ویجت‌ها و نماد برنامه. برخی صفحه‌های اصلی هنگام تغییر، نماد را حذف می‌کنند – در این صورت دوباره اضافه کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri sovellukselle, widgeteille ja sovelluskuvakkeelle. Jotkin aloitusnäytöt poistavat kuvakkeen vaihdon yhteydessä – lisää se silloin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur de l’app, des widgets et de l’icône de l’app. Certains écrans d’accueil retirent l’icône lors du changement : ajoute-la à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבע לאפליקציה, לווידג׳טים ולסמל האפליקציה. חלק ממסכי הבית מסירים את הסמל בעת ההחלפה – אז יש להוסיף אותו מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप, विजेट और ऐप आइकन का रंग। कुछ होम स्क्रीन बदलने पर आइकन हटा देती हैं – तब इसे फिर से जोड़ो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás, a widgetek és az alkalmazásikon színe. Egyes kezdőképernyők váltáskor eltávolítják az ikont – ilyenkor add hozzá újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna untuk aplikasi, widget, dan ikon aplikasi. Beberapa layar utama menghapus ikon saat diganti – tambahkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore dell’app, dei widget e dell’icona dell’app. Alcune schermate Home rimuovono l’icona al cambio: aggiungila di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ、ウィジェット、アプリアイコンの色。 ホーム画面によっては変更時にアイコンが消えます。その場合は追加し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱, 위젯, 앱 아이콘의 색상. 일부 홈 화면은 변경 시 아이콘을 제거합니다. 그러면 다시 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farge for appen, widgeter og appikonet. Noen startskjermer fjerner ikonet ved bytte – legg det da til på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur voor de app, widgets en het app-pictogram. Sommige startschermen verwijderen het pictogram bij het wisselen – voeg het dan opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor aplikacji, widżetów i ikony aplikacji. Niektóre ekrany główne usuwają ikonę przy zmianie – wtedy dodaj ją ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da app, dos widgets e do ícone da app. Alguns ecrãs principais removem o ícone na troca – adiciona-o de novo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor do app, dos widgets e do ícone do app. Algumas telas iniciais removem o ícone na troca – adicione-o de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culoarea aplicației, a widgeturilor și a pictogramei aplicației. Unele ecrane de pornire elimină pictograma la schimbare – adaug-o din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет приложения, виджетов и значка приложения. Некоторые рабочие столы удаляют значок при смене – тогда добавь его снова."
          }
        },
        "sq" : {
          "stringUnit" : {
