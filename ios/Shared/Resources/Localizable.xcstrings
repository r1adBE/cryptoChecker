    "explain_funding" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسوم تُدفع بين المراكز الطويلة والقصيرة. القيمة الموجبة بقوة تعني أن كثيرين يراهنون على ارتفاع الأسعار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poplatek mezi long a short pozicemi. Silně kladný znamená, že mnozí sázejí na růst cen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebyr mellem long- og short-positioner. Stærkt positiv betyder, at mange satser på stigende kurser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebühr zwischen Long- und Short-Positionen. Stark positiv heisst: viele wetten auf steigende Kurse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρέωση μεταξύ θέσεων long και short. Έντονα θετική σημαίνει ότι πολλοί ποντάρουν σε άνοδο των τιμών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fee between long and short positions. Strongly positive means many are betting on rising prices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comisión entre posiciones largas y cortas. Muy positiva significa que muchos apuestan por precios al alza."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارمزدی بین موقعیت‌های لانگ و شورت. مثبتِ زیاد یعنی بسیاری روی افزایش قیمت شرط بسته‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long- ja short-positioiden välinen maksu. Vahvasti positiivinen tarkoittaa, että moni veikkaa hintojen nousua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frais entre positions longues et courtes. Fortement positif signifie que beaucoup parient sur la hausse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עמלה בין פוזיציות לונג לשורט. ערך חיובי מאוד פירושו שרבים מהמרים על עליית מחירים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉन्ग और शॉर्ट पोज़िशन के बीच शुल्क। काफ़ी पॉज़िटिव होने का मतलब है कि कई लोग कीमतें बढ़ने पर दांव लगा रहे हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díj a long és short pozíciók között. Erősen pozitív érték: sokan emelkedő árfolyamra fogadnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya antara posisi long dan short. Sangat positif berarti banyak yang bertaruh harga naik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commissione tra posizioni long e short. Fortemente positivo significa che molti scommettono su prezzi in salita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロングとショートの間で支払われる手数料。大きくプラスなら、多くが値上がりに賭けています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "롱과 숏 포지션 사이에 오가는 수수료. 크게 양수이면 많은 사람이 가격 상승에 베팅하고 있다는 뜻입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgift mellom long- og short-posisjoner. Sterkt positiv betyr at mange satser på stigende kurser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergoeding tussen long- en shortposities. Sterk positief betekent dat velen op stijgende koersen wedden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opłata między pozycjami long i short. Mocno dodatnia oznacza, że wielu stawia na wzrost cen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa entre posições longas e curtas. Fortemente positiva significa que muitos apostam na subida dos preços."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa entre posições longas e curtas. Fortemente positiva significa que muitos apostam na subida dos preços."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxă între pozițiile long și short. Puternic pozitivă înseamnă că mulți pariază pe creșterea prețurilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плата между длинными и короткими позициями. Сильно положительная — многие ставят на рост цен."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarifë midis pozicioneve long dhe short. Fort pozitive do të thotë se shumë vënë bast për rritjen e çmimeve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgift mellan long- och short-positioner. Starkt positiv betyder att många satsar på stigande kurser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าธรรมเนียมระหว่างสถานะ long และ short ค่าบวกสูงหมายความว่าหลายคนเดิมพันว่าราคาจะขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long ve short pozisyonlar arasındaki ücret. Güçlü pozitif değer, birçok kişinin fiyatların yükselmesine bahis yaptığı anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плата між довгими та короткими позиціями. Сильно додатна — багато хто ставить на зростання цін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phí giữa vị thế long và short. Dương mạnh nghĩa là nhiều người đang đặt cược giá tăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多头与空头之间支付的费用。大幅为正表示许多人押注价格上涨。"
          }
        }
      }
    },
    "explain_open_interest" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمة جميع مراكز العقود الآجلة المفتوحة. إذا ارتفعت، فهناك أموال أكثر تراهن على الحركة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota všech otevřených futures pozic. Když roste, na pohyb sází více peněz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdien af alle åbne futures-positioner. Stiger den, satser flere penge på bevægelsen."
          }
        },
        "de" : {
          "stringUnit" : {
