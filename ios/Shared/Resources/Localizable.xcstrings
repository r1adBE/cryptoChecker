    "explorer_lists_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمّل القائمة العامة الكاملة لكل منصة، وهي نفسها للجميع. يبقى بحثك على الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načte úplný veřejný seznam každé burzy – stejný pro všechny. Tvoje hledání zůstává v zařízení."
