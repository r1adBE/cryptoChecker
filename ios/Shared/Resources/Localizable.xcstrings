    "tax_template_confirm_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجريبي، قواعد مبسّطة، تنقص معاملات المنصات الأخرى – تحقّق قبل تقديم الإقرار الضريبي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, zjednodušená pravidla, chybí transakce z jiných platforem – ověř před podáním přiznání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, forenklede regler, transaktioner fra andre platforme mangler – tjek før selvangivelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, vereinfachte Regeln, Transaktionen anderer Plattformen fehlen – vor der Steuererklärung prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, απλοποιημένοι κανόνες, λείπουν συναλλαγές άλλων πλατφορμών – έλεγξε πριν από τη δήλωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, simplified rules, transactions from other platforms are missing – check before filing your tax return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, normas simplificadas, faltan las transacciones de otras plataformas; revísalo antes de presentar la declaración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتا، قواعد ساده‌شده، تراکنش‌های پلتفرم‌های دیگر نیست – پیش از اظهارنامه بررسی کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, yksinkertaistetut säännöt, muiden alustojen tapahtumat puuttuvat – tarkista ennen veroilmoitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bêta, règles simplifiées, les transactions d’autres plateformes manquent – à vérifier avant ta déclaration d’impôts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטא, כללים מפושטים, חסרות עסקאות מפלטפורמות אחרות – בדקו לפני הגשת הדוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीटा, सरल नियम, दूसरे प्लेटफ़ॉर्म के लेनदेन शामिल नहीं – टैक्स रिटर्न से पहले जाँचो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Béta, egyszerűsített szabályok, más platformok tranzakciói hiányoznak – ellenőrizd az adóbevallás előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, aturan disederhanakan, transaksi dari platform lain tidak ada – periksa sebelum mengisi SPT."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, regole semplificate, mancano le transazioni di altre piattaforme – verifica prima della dichiarazione dei redditi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベータ版・簡略化したルール・他のプラットフォームの取引は含まれません – 確定申告の前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베타, 단순화된 규칙, 다른 플랫폼의 거래는 빠져 있습니다 – 세금 신고 전에 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, forenklede regler, transaksjoner fra andre plattformer mangler – sjekk før skattemeldingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bèta, vereenvoudigde regels, transacties van andere platforms ontbreken – controleer vóór je aangifte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, uproszczone zasady, brakuje transakcji z innych platform – sprawdź przed złożeniem zeznania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, regras simplificadas, faltam transações de outras plataformas – verifica antes de entregar a declaração."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, regras simplificadas, faltam transações de outras plataformas – confira antes de enviar a declaração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, reguli simplificate, lipsesc tranzacțiile de pe alte platforme – verifică înainte de declarația fiscală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бета, упрощённые правила, транзакций с других платформ нет – проверь перед подачей декларации."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, rregulla të thjeshtuara, mungojnë transaksionet nga platforma të tjera – kontrollo para deklaratës."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, förenklade regler, transaktioner från andra plattformar saknas – kontrollera före deklarationen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบต้า กฎแบบย่อ ไม่มีธุรกรรมจากแพลตฟอร์มอื่น – ตรวจสอบก่อนยื่นภาษี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, basitleştirilmiş kurallar, diğer platformlardaki işlemler eksik – beyannameden önce kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бета, спрощені правила, транзакцій з інших платформ немає – перевір перед поданням декларації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta, quy tắc đơn giản hóa, thiếu giao dịch từ nền tảng khác – hãy kiểm tra trước khi khai thuế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试版，规则已简化，缺少其他平台的交易——报税前请核实。"
          }
        }
      }
