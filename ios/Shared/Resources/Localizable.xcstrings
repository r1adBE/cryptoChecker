          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A negociação da última hora está em linha com as últimas 24 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranzacționarea din ultima oră este în linie cu ultimele 24 de ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объём торгов за последний час на уровне последних 24 часов."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
