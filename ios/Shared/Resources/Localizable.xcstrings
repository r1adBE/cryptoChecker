        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बंद होने पर iOS तय करता है कि कब जाँच हो (अलार्म, विजेट), कभी-कभी घंटों के अंतर पर। खुला: हर बार खोलने पर।"
