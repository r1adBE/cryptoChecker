    "market_scores_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القمة = علامات ظهرت عند قمم الدورات السابقة، القاع = علامات ظهرت عند قيعان الدورات السابقة. من 4 نقاط يهيمن جانب، ومن 7 يكون متطرفًا. لا هدف سعري ولا توقعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrchol = známky jako u dřívějších vrcholů cyklu, dno = známky jako u dřívějších den cyklu. Od 4 bodů převažuje jedna strana, od 7 je extrémní. Žádný cenový cíl a žádná prognóza."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top = tegn som ved tidligere cyklustoppe, bund = tegn som ved tidligere cyklusbunde. Fra 4 point dominerer en side, fra 7 er den ekstrem. Intet kursmål og ingen prognose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch = Anzeichen wie an früheren Zyklus-Hochs, Tief = Anzeichen wie an früheren Zyklus-Tiefs. Ab 4 Punkten überwiegt eine Seite, ab 7 gilt sie als extrem. Kein Kursziel und keine Prognose."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κορυφή = ενδείξεις όπως σε προηγούμενες κορυφές κύκλου, πυθμένας = ενδείξεις όπως σε προηγούμενους πυθμένες κύκλου. Από 4 πόντους κυριαρχεί μία πλευρά, από 7 είναι ακραία. Καμία τιμή-στόχος και καμία πρόβλεψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High = signs seen at past cycle highs, low = signs seen at past cycle lows. From 4 points one side dominates, from 7 it is extreme. No price target and no forecast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo = señales como en máximos de ciclos pasados, mínimo = señales como en mínimos de ciclos pasados. Desde 4 puntos domina un lado, desde 7 es extremo. Sin precio objetivo y sin previsión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سقف = نشانه‌هایی مانند سقف‌های چرخه‌های گذشته، کف = نشانه‌هایی مانند کف‌های چرخه‌های گذشته. از ۴ امتیاز یک طرف غالب است و از ۷ شدید. بدون قیمت هدف و بدون پیش‌بینی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huippu = merkkejä kuten aiemmissa syklihuipuissa, pohja = merkkejä kuten aiemmissa syklipohjissa. 4 pisteestä alkaen toinen puoli hallitsee, 7:stä alkaen se on äärimmäinen. Ei hintatavoitetta eikä ennustetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommet = signes comme aux sommets de cycles passés, creux = signes comme aux creux de cycles passés. À partir de 4 points un côté domine, à partir de 7 il est extrême. Ni objectif de prix ni prévision."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיא = סימנים כמו בשיאי מחזורים קודמים, שפל = סימנים כמו בשפלי מחזורים קודמים. מ-4 נקודות צד אחד שולט, מ-7 זה קיצוני. ללא יעד מחיר וללא תחזית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिखर = पिछले चक्र-शिखरों जैसे संकेत, तल = पिछले चक्र-तलों जैसे संकेत। 4 अंकों से एक पक्ष हावी होता है, 7 से यह चरम है। कोई मूल्य लक्ष्य नहीं और कोई पूर्वानुमान नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csúcs = jelek, mint a korábbi ciklustetőknél, mélypont = jelek, mint a korábbi ciklusaljaknál. 4 ponttól az egyik oldal dominál, 7-től extrém. Nincs célár és nincs előrejelzés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puncak = tanda seperti pada puncak siklus sebelumnya, dasar = tanda seperti pada dasar siklus sebelumnya. Mulai 4 poin satu sisi dominan, mulai 7 ekstrem. Tanpa target harga dan tanpa prakiraan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massimo = segnali come ai massimi dei cicli passati, minimo = segnali come ai minimi dei cicli passati. Da 4 punti prevale un lato, da 7 è estremo. Nessun obiettivo di prezzo e nessuna previsione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高値 = 過去のサイクル天井と同様のサイン、安値 = 過去のサイクル底と同様のサイン。4ポイント以上で一方が優勢、7以上で極端です。目標価格でも予測でもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고점 = 과거 사이클 고점과 같은 신호, 저점 = 과거 사이클 저점과 같은 신호. 4점부터 한쪽이 우세하고 7점부터 극단입니다. 목표가도 예측도 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp = tegn som ved tidligere syklustopper, bunn = tegn som ved tidligere syklusbunner. Fra 4 poeng dominerer én side, fra 7 er den ekstrem. Ikke noe kursmål og ingen prognose."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top = tekenen zoals bij eerdere cyclustoppen, bodem = tekenen zoals bij eerdere cyclusbodems. Vanaf 4 punten overheerst een kant, vanaf 7 is het extreem. Geen koersdoel en geen voorspelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczyt = oznaki jak na dawnych szczytach cyklu, dołek = oznaki jak na dawnych dołkach cyklu. Od 4 punktów przeważa jedna strona, od 7 jest ekstremalnie. Bez ceny docelowej i bez prognozy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico = sinais como nos picos de ciclos passados, fundo = sinais como nos fundos de ciclos passados. A partir de 4 pontos um lado domina, a partir de 7 é extremo. Sem preço-alvo e sem previsão."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico = sinais como nos picos de ciclos passados, fundo = sinais como nos fundos de ciclos passados. A partir de 4 pontos um lado domina, a partir de 7 é extremo. Sem preço-alvo e sem previsão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maxim = semne ca la maximele ciclurilor trecute, minim = semne ca la minimele ciclurilor trecute. De la 4 puncte domină o parte, de la 7 este extremă. Niciun preț țintă și nicio prognoză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вершина – признаки как на прошлых вершинах цикла, дно – признаки как на прошлых днищах цикла. От 4 баллов преобладает одна сторона, от 7 – экстремально. Не целевая цена и не прогноз."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum = shenja si në maksimumet e cikleve të kaluara, minimum = shenja si në minimumet e cikleve të kaluara. Nga 4 pikë mbizotëron një anë, nga 7 është ekstreme. Pa objektiv çmimi dhe pa parashikim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp = tecken som vid tidigare cykeltoppar, botten = tecken som vid tidigare cykelbottnar. Från 4 poäng dominerar en sida, från 7 är det extremt. Inget kursmål och ingen prognos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จุดสูงสุด = สัญญาณแบบที่เคยเห็นที่จุดสูงสุดของรอบก่อน ๆ, จุดต่ำสุด = สัญญาณแบบที่เคยเห็นที่จุดต่ำสุดของรอบก่อน ๆ ตั้งแต่ 4 คะแนนฝั่งหนึ่งครองตลาด ตั้งแต่ 7 ถือว่าสุดขั้ว ไม่ใช่ราคาเป้าหมายและไม่ใช่การคาดการณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepe = geçmiş döngü zirvelerindeki gibi işaretler, dip = geçmiş döngü diplerindeki gibi işaretler. 4 puandan itibaren bir taraf baskındır, 7'den itibaren aşırıdır. Fiyat hedefi değildir ve tahmin değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вершина – ознаки як на минулих вершинах циклу, дно – ознаки як на минулих днищах циклу. Від 4 балів переважає одна сторона, від 7 – екстремально. Не цільова ціна і не прогноз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đỉnh = dấu hiệu giống các đỉnh chu kỳ trước, đáy = dấu hiệu giống các đáy chu kỳ trước. Từ 4 điểm một bên chiếm ưu thế, từ 7 là cực độ. Không phải giá mục tiêu và không phải dự báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部 = 与以往周期顶部类似的迹象，底部 = 与以往周期底部类似的迹象。4 分起一方占优，7 分起为极端。不是目标价，也不是预测。"
          }
        }
      }
    },
    "market_scores_info_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحسب علامات القمة المحتملة الإشارات التي ظهرت عند قمم الدورات السابقة: مبالغة قوية في التقييم (MVRV)، إيرادات مرتفعة جدًا للمعدّنين (Puell)، سعر أعلى بكثير من متوسط 200 يوم أو 200 أسبوع، صعود قطعي مكافئ، وفترة 12–18 شهرًا بعد التنصيف.\n\nتحسب علامات القاع المحتمل إشارات القيعان السابقة: MVRV منخفض، إيرادات ضعيفة للمعدّنين، هبوط قوي من أعلى مستوى تاريخي، سعر قرب متوسط 200 أسبوع، تراجع معدل التجزئة، وقمة مضى عليها أكثر من عام.\n\nبتقدم 4 نقاط تكون المنطقة Bull أو Bear، ومن 7 متطرفة. إذا لم يتقدم أي جانب، يحسم اتجاه السعر. 0/10 على الجانبين يعني: لا نشوة ولا استسلام.\n\nلا هدف سعري ولا توقعات: الإشارات تصف فقط كيف بدت الدورات السابقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Známky možného vrcholu počítají signály z vrcholů minulých cyklů: silné nadhodnocení (MVRV), velmi vysoké příjmy těžařů (Puell), cena vysoko nad 200denním nebo 200týdenním průměrem, parabolický růst a období 12–18 měsíců po halvingu.\n\nZnámky možného dna počítají signály minulých den: nízké MVRV, slabé příjmy těžařů, silný pokles z historického maxima, cena u 200týdenního průměru, klesající hashrate a vrchol starší než rok.\n\nOd 4 bodů náskoku je zóna Bull nebo Bear, od 7 Extrémní. Pokud nevede žádná strana, rozhoduje cenový trend. 0/10 na obou stranách znamená: ani euforie, ani kapitulace.\n\nŽádný cenový cíl a žádná prognóza: signály jen popisují, jak vypadaly minulé cykly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn på en mulig top tæller signaler set ved tidligere cyklustoppe: kraftig overvurdering (MVRV), meget høje minerindtægter (Puell), kurs langt over 200-dages eller 200-ugers gennemsnittet, parabolsk stigning og perioden 12–18 måneder efter halveringen.\n\nTegn på en mulig bund tæller signaler fra tidligere bunde: lav MVRV, svage minerindtægter, kraftigt fald fra all-time high, kurs nær 200-ugers gennemsnittet, faldende hashrate og en top for over et år siden.\n\nFra 4 points forspring er zonen Bull eller Bear, fra 7 Ekstrem. Fører ingen side, afgør kurstrenden. 0/10 på begge sider betyder: hverken eufori eller kapitulation.\n\nIntet kursmål og ingen prognose: signalerne beskriver kun, hvordan tidligere cyklusser så ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise auf ein mögliches Hoch zählen Signale, die an früheren Zyklus-Hochs auftraten: starke Überbewertung (MVRV), sehr hohe Miner-Einnahmen (Puell), Kurs weit über dem 200-Tage- oder 200-Wochen-Schnitt, parabolischer Anstieg und das Zeitfenster 12–18 Monate nach dem Halving.\n\nHinweise auf ein mögliches Tief zählen Signale früherer Zyklus-Tiefs: tiefes MVRV, schwache Miner-Einnahmen, starker Rückgang vom Allzeithoch, Kurs nahe dem 200-Wochen-Schnitt, fallende Hashrate und ein Hoch, das über ein Jahr zurückliegt.\n\nAb 4 Punkten mit Vorsprung lautet die Zone Bull bzw. Bear, ab 7 Extrem. Führt keine Seite, entscheidet der Kurstrend. 0/10 auf beiden Seiten heisst: weder Euphorie noch Kapitulation.\n\nKein Kursziel und keine Prognose: Die Signale beschreiben nur, wie frühere Zyklen aussahen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ενδείξεις πιθανής κορυφής μετρούν σήματα που εμφανίστηκαν σε κορυφές προηγούμενων κύκλων: ισχυρή υπερτίμηση (MVRV), πολύ υψηλά έσοδα miners (Puell), τιμή πολύ πάνω από τον μέσο όρο 200 ημερών ή 200 εβδομάδων, παραβολική άνοδος και το διάστημα 12–18 μηνών μετά το halving.\n\nΟι ενδείξεις πιθανού πυθμένα μετρούν σήματα προηγούμενων πυθμένων: χαμηλό MVRV, αδύναμα έσοδα miners, μεγάλη πτώση από το ιστορικό υψηλό, τιμή κοντά στον μέσο όρο 200 εβδομάδων, πτωτικό hashrate και κορυφή πριν από πάνω από έναν χρόνο.\n\nΜε προβάδισμα 4 πόντων η ζώνη είναι Bull ή Bear, από 7 Ακραία. Αν καμία πλευρά δεν προηγείται, αποφασίζει η τάση της τιμής. 0/10 και στις δύο πλευρές σημαίνει: ούτε ευφορία ούτε συνθηκολόγηση.\n\nΚαμία τιμή-στόχος και καμία πρόβλεψη: τα σήματα περιγράφουν μόνο πώς έμοιαζαν οι προηγούμενοι κύκλοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signs of a possible high count signals seen at past cycle highs: strong overvaluation (MVRV), very high miner revenue (Puell), price far above the 200-day or 200-week average, a parabolic rise and the window 12–18 months after the halving.\n\nSigns of a possible low count signals of past cycle lows: low MVRV, weak miner revenue, a deep drop from the all-time high, price near the 200-week average, falling hashrate and a high more than a year ago.\n\nFrom 4 points with a lead the zone is Bull or Bear, from 7 Extreme. If neither side leads, the price trend decides. 0/10 on both sides means neither euphoria nor capitulation.\n\nNo price target and no forecast: the signals only describe what past cycles looked like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las señales de un posible máximo cuentan indicios vistos en máximos de ciclos pasados: fuerte sobrevaloración (MVRV), ingresos de mineros muy altos (Puell), precio muy por encima de la media de 200 días o 200 semanas, subida parabólica y la ventana de 12–18 meses tras el halving.\n\nLas señales de un posible mínimo cuentan indicios de mínimos pasados: MVRV bajo, ingresos de mineros débiles, fuerte caída desde el máximo histórico, precio cerca de la media de 200 semanas, hashrate en descenso y un máximo de hace más de un año.\n\nCon 4 puntos de ventaja la zona es Bull o Bear, con 7 Extrema. Si ningún lado lidera, decide la tendencia del precio. 0/10 en ambos lados significa: ni euforia ni capitulación.\n\nSin precio objetivo y sin previsión: las señales solo describen cómo fueron los ciclos pasados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانه‌های سقف احتمالی سیگنال‌هایی را می‌شمارد که در سقف‌های چرخه‌های گذشته دیده شده‌اند: ارزش‌گذاری بیش از حد شدید (MVRV)، درآمد بسیار بالای ماینرها (Puell)، قیمت بسیار بالاتر از میانگین ۲۰۰ روزه یا ۲۰۰ هفته‌ای، رشد سهمی و بازه ۱۲ تا ۱۸ ماه پس از هاوینگ.\n\nنشانه‌های کف احتمالی سیگنال‌های کف‌های گذشته را می‌شمارد: MVRV پایین، درآمد ضعیف ماینرها، افت شدید از بالاترین قیمت تاریخی، قیمت نزدیک میانگین ۲۰۰ هفته‌ای، کاهش هش‌ریت و سقفی که بیش از یک سال از آن گذشته است.\n\nبا برتری ۴ امتیازی منطقه Bull یا Bear است و از ۷ شدید. اگر هیچ طرفی جلو نباشد، روند قیمت تعیین می‌کند. ۰/۱۰ در هر دو طرف یعنی: نه سرخوشی و نه تسلیم.\n\nبدون قیمت هدف و بدون پیش‌بینی: سیگنال‌ها فقط توصیف می‌کنند که چرخه‌های گذشته چگونه بوده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkit mahdollisesta huipusta laskevat aiempien syklihuippujen signaaleja: voimakas yliarvostus (MVRV), hyvin korkeat louhijatulot (Puell), hinta selvästi 200 päivän tai 200 viikon keskiarvon yläpuolella, parabolinen nousu ja 12–18 kuukauden jakso halvingin jälkeen.\n\nMerkit mahdollisesta pohjasta laskevat aiempien pohjien signaaleja: matala MVRV, heikot louhijatulot, jyrkkä lasku kaikkien aikojen huipusta, hinta lähellä 200 viikon keskiarvoa, laskeva hashrate ja yli vuoden takainen huippu.\n\n4 pisteen johdolla vyöhyke on Bull tai Bear, 7:stä alkaen Äärimmäinen. Jos kumpikaan ei johda, hintatrendi ratkaisee. 0/10 molemmin puolin tarkoittaa: ei euforiaa eikä antautumista.\n\nEi hintatavoitetta eikä ennustetta: signaalit kuvaavat vain, miltä aiemmat syklit näyttivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signes d'un possible sommet comptent les signaux observés aux sommets des cycles passés : forte surévaluation (MVRV), revenus des mineurs très élevés (Puell), prix bien au-dessus de la moyenne 200 jours ou 200 semaines, hausse parabolique et la fenêtre de 12 à 18 mois après le halving.\n\nLes signes d'un possible creux comptent les signaux des creux passés : MVRV bas, faibles revenus des mineurs, forte baisse depuis le plus haut historique, prix proche de la moyenne 200 semaines, hashrate en baisse et un sommet datant de plus d'un an.\n\nÀ partir de 4 points d'avance la zone est Bull ou Bear, à partir de 7 Extrême. Si aucun côté ne mène, la tendance du prix décide. 0/10 des deux côtés signifie : ni euphorie ni capitulation.\n\nNi objectif de prix ni prévision : les signaux décrivent seulement à quoi ressemblaient les cycles passés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סימנים לשיא אפשרי סופרים אותות שנראו בשיאי מחזורים קודמים: תמחור יתר חזק (MVRV), הכנסות כורים גבוהות מאוד (Puell), מחיר הרבה מעל ממוצע 200 יום או 200 שבועות, עלייה פרבולית וחלון של 12–18 חודשים אחרי ההאלבינג.\n\nסימנים לשפל אפשרי סופרים אותות של שפלים קודמים: MVRV נמוך, הכנסות כורים חלשות, ירידה חדה מהשיא של כל הזמנים, מחיר קרוב לממוצע 200 שבועות, ירידה ב-hashrate ושיא שהיה לפני יותר משנה.\n\nביתרון של 4 נקודות האזור הוא Bull או Bear, מ-7 קיצוני. אם אף צד לא מוביל, מגמת המחיר מכריעה. 0/10 בשני הצדדים פירושו: לא אופוריה ולא כניעה.\n\nללא יעד מחיר וללא תחזית: האותות רק מתארים איך נראו מחזורים קודמים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संभावित शिखर के संकेत पिछले चक्रों के शिखरों पर दिखे संकेत गिनते हैं: भारी ओवरवैल्यूएशन (MVRV), माइनरों की बहुत ऊँची आय (Puell), कीमत 200-दिन या 200-सप्ताह औसत से बहुत ऊपर, परवलयिक उछाल और हॉल्विंग के 12–18 महीने बाद की अवधि।\n\nसंभावित तल के संकेत पिछले तलों के संकेत गिनते हैं: कम MVRV, माइनरों की कमज़ोर आय, सर्वकालिक उच्च से तेज़ गिरावट, 200-सप्ताह औसत के पास कीमत, गिरता हैशरेट और एक साल से पुराना शिखर।\n\n4 अंकों की बढ़त पर ज़ोन Bull या Bear है, 7 से चरम। यदि कोई पक्ष आगे नहीं, तो मूल्य रुझान तय करता है। दोनों ओर 0/10 का अर्थ: न उत्साह, न समर्पण।\n\nकोई मूल्य लक्ष्य नहीं और कोई पूर्वानुमान नहीं: संकेत सिर्फ़ यह बताते हैं कि पिछले चक्र कैसे दिखते थे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy lehetséges csúcs jelei a korábbi ciklustetőknél látott jeleket számolják: erős túlértékeltség (MVRV), nagyon magas bányászbevétel (Puell), az ár messze a 200 napos vagy 200 hetes átlag felett, parabolikus emelkedés és a halving utáni 12–18 hónapos időszak.\n\nEgy lehetséges mélypont jelei a korábbi mélypontok jeleit számolják: alacsony MVRV, gyenge bányászbevétel, erős esés a történelmi csúcsról, ár a 200 hetes átlag közelében, csökkenő hashrate és egy évnél régebbi csúcs.\n\n4 pont előnytől a zóna Bull vagy Bear, 7-től Extrém. Ha egyik oldal sem vezet, az ártrend dönt. Mindkét oldalon 0/10: se eufória, se kapituláció.\n\nNincs célár és nincs előrejelzés: a jelek csak azt írják le, hogyan néztek ki a korábbi ciklusok."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda kemungkinan puncak menghitung sinyal yang muncul di puncak siklus sebelumnya: overvaluasi kuat (MVRV), pendapatan penambang sangat tinggi (Puell), harga jauh di atas rata-rata 200 hari atau 200 minggu, kenaikan parabolik, dan jendela 12–18 bulan setelah halving.\n\nTanda kemungkinan dasar menghitung sinyal dasar sebelumnya: MVRV rendah, pendapatan penambang lemah, penurunan tajam dari harga tertinggi sepanjang masa, harga dekat rata-rata 200 minggu, hashrate menurun, dan puncak lebih dari setahun lalu.\n\nDengan keunggulan 4 poin zonanya Bull atau Bear, mulai 7 Ekstrem. Jika tidak ada sisi yang unggul, tren harga yang menentukan. 0/10 di kedua sisi berarti: bukan euforia, bukan kapitulasi.\n\nTanpa target harga dan tanpa prakiraan: sinyal hanya menggambarkan seperti apa siklus-siklus sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segnali di un possibile massimo contano gli indizi visti ai massimi dei cicli passati: forte sopravvalutazione (MVRV), ricavi dei miner molto alti (Puell), prezzo molto sopra la media a 200 giorni o 200 settimane, rialzo parabolico e la finestra di 12–18 mesi dopo l'halving.\n\nI segnali di un possibile minimo contano gli indizi dei minimi passati: MVRV basso, ricavi dei miner deboli, forte calo dal massimo storico, prezzo vicino alla media a 200 settimane, hashrate in calo e un massimo di oltre un anno fa.\n\nDa 4 punti di vantaggio la zona è Bull o Bear, da 7 Estrema. Se nessun lato prevale, decide il trend del prezzo. 0/10 su entrambi i lati significa: né euforia né capitolazione.\n\nNessun obiettivo di prezzo e nessuna previsione: i segnali descrivono solo come apparivano i cicli passati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高値の可能性を示すサインは、過去のサイクル天井で見られたシグナルを数えます：強い割高感（MVRV）、非常に高いマイナー収入（Puell）、200日または200週平均を大きく上回る価格、放物線的な上昇、半減期後12〜18か月の期間。\n\n安値の可能性を示すサインは、過去の底のシグナルを数えます：低い MVRV、弱いマイナー収入、史上最高値からの大幅下落、200週平均付近の価格、ハッシュレートの低下、1年以上前の高値。\n\n4ポイント以上リードするとゾーンは Bull または Bear、7以上で極端。どちらもリードしない場合は価格トレンドが決めます。両方0/10は、熱狂も投げ売りもない状態です。\n\n目標価格でも予測でもありません：シグナルは過去のサイクルがどうだったかを示すだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고점 가능성 신호는 과거 사이클 고점에서 나타난 신호를 셉니다: 강한 고평가(MVRV), 매우 높은 채굴자 수익(Puell), 200일 또는 200주 평균을 크게 웃도는 가격, 포물선형 상승, 반감기 후 12~18개월 구간.\n\n저점 가능성 신호는 과거 저점의 신호를 셉니다: 낮은 MVRV, 약한 채굴자 수익, 사상 최고가 대비 큰 하락, 200주 평균 근처의 가격, 해시레이트 하락, 1년 이상 지난 고점.\n\n4점 이상 앞서면 구간은 Bull 또는 Bear, 7점부터 극단입니다. 어느 쪽도 앞서지 않으면 가격 추세가 결정합니다. 양쪽 모두 0/10이면 과열도 항복도 없는 상태입니다.\n\n목표가도 예측도 아닙니다: 신호는 과거 사이클이 어떤 모습이었는지만 설명합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn på en mulig topp teller signaler sett ved tidligere syklustopper: kraftig overvurdering (MVRV), svært høye minerinntekter (Puell), kurs langt over 200-dagers eller 200-ukers snittet, parabolsk stigning og perioden 12–18 måneder etter halveringen.\n\nTegn på en mulig bunn teller signaler fra tidligere bunner: lav MVRV, svake minerinntekter, kraftig fall fra all-time high, kurs nær 200-ukers snittet, fallende hashrate og en topp for over ett år siden.\n\nFra 4 poengs ledelse er sonen Bull eller Bear, fra 7 Ekstrem. Leder ingen side, avgjør kurstrenden. 0/10 på begge sider betyr: verken eufori eller kapitulasjon.\n\nIkke noe kursmål og ingen prognose: signalene beskriver bare hvordan tidligere sykluser så ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekenen van een mogelijke top tellen signalen die bij eerdere cyclustoppen optraden: sterke overwaardering (MVRV), zeer hoge minerinkomsten (Puell), koers ver boven het 200-daags of 200-weeks gemiddelde, parabolische stijging en de periode 12–18 maanden na de halving.\n\nTekenen van een mogelijke bodem tellen signalen van eerdere bodems: lage MVRV, zwakke minerinkomsten, sterke daling vanaf de all-time high, koers dicht bij het 200-weeks gemiddelde, dalende hashrate en een top van meer dan een jaar geleden.\n\nVanaf 4 punten voorsprong is de zone Bull of Bear, vanaf 7 Extreem. Leidt geen kant, dan beslist de koerstrend. 0/10 aan beide kanten betekent: geen euforie en geen capitulatie.\n\nGeen koersdoel en geen voorspelling: de signalen beschrijven alleen hoe eerdere cycli eruitzagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaki możliwego szczytu liczą sygnały widoczne na szczytach dawnych cykli: silne przewartościowanie (MVRV), bardzo wysokie przychody górników (Puell), cena daleko nad średnią 200-dniową lub 200-tygodniową, wzrost paraboliczny i okno 12–18 miesięcy po halvingu.\n\nOznaki możliwego dołka liczą sygnały dawnych den: niskie MVRV, słabe przychody górników, silny spadek od szczytu wszech czasów, cena blisko średniej 200-tygodniowej, spadający hashrate i szczyt sprzed ponad roku.\n\nOd 4 punktów przewagi strefa to Bull lub Bear, od 7 Ekstremalna. Gdy żadna strona nie prowadzi, decyduje trend ceny. 0/10 po obu stronach oznacza: ani euforia, ani kapitulacja.\n\nBez ceny docelowej i bez prognozy: sygnały opisują jedynie, jak wyglądały dawne cykle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sinais de um possível pico contam indícios vistos em picos de ciclos passados: forte sobrevalorização (MVRV), receitas de mineradores muito altas (Puell), preço muito acima da média de 200 dias ou 200 semanas, subida parabólica e a janela de 12–18 meses após o halving.\n\nOs sinais de um possível fundo contam indícios de fundos passados: MVRV baixo, receitas fracas dos mineradores, forte queda desde o máximo histórico, preço perto da média de 200 semanas, hashrate em queda e um pico de há mais de um ano.\n\nCom 4 pontos de vantagem a zona é Bull ou Bear, com 7 Extrema. Se nenhum lado lidera, decide a tendência do preço. 0/10 em ambos os lados significa: nem euforia nem capitulação.\n\nSem preço-alvo e sem previsão: os sinais apenas descrevem como foram os ciclos passados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sinais de um possível pico contam indícios vistos em picos de ciclos passados: forte sobrevalorização (MVRV), receita dos mineradores muito alta (Puell), preço muito acima da média de 200 dias ou 200 semanas, alta parabólica e a janela de 12–18 meses após o halving.\n\nOs sinais de um possível fundo contam indícios de fundos passados: MVRV baixo, receita fraca dos mineradores, forte queda desde a máxima histórica, preço perto da média de 200 semanas, hashrate em queda e um pico de mais de um ano atrás.\n\nCom 4 pontos de vantagem a zona é Bull ou Bear, com 7, Extreme. Se nenhum lado lidera, a tendência do preço decide. 0/10 em ambos os lados significa: nem euforia nem capitulação.\n\nSem preço-alvo e sem previsão: os sinais apenas descrevem como foram os ciclos passados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semnele unui posibil maxim numără semnalele văzute la maximele ciclurilor trecute: supraevaluare puternică (MVRV), venituri foarte mari ale minerilor (Puell), preț mult peste media de 200 de zile sau 200 de săptămâni, creștere parabolică și fereastra de 12–18 luni după halving.\n\nSemnele unui posibil minim numără semnalele minimelor trecute: MVRV scăzut, venituri slabe ale minerilor, scădere puternică de la maximul istoric, preț aproape de media de 200 de săptămâni, hashrate în scădere și un maxim de acum peste un an.\n\nCu 4 puncte avans zona este Bull sau Bear, de la 7 Extremă. Dacă nicio parte nu conduce, decide trendul prețului. 0/10 pe ambele părți înseamnă: nici euforie, nici capitulare.\n\nNiciun preț țintă și nicio prognoză: semnalele descriu doar cum arătau ciclurile trecute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Признаки возможной вершины – это сигналы, наблюдавшиеся на вершинах прошлых циклов: сильная переоценка (MVRV), очень высокий доход майнеров (Puell), цена намного выше 200-дневной или 200-недельной средней, параболический рост и окно 12–18 месяцев после халвинга.\n\nПризнаки возможного дна – это сигналы прошлых днищ: низкий MVRV, слабый доход майнеров, сильное падение от исторического максимума, цена около 200-недельной средней, падающий хешрейт и максимум более года назад.\n\nПри перевесе от 4 баллов зона Bull или Bear, от 7 – Экстремальная. Если ни одна сторона не лидирует, решает ценовой тренд. 0/10 с обеих сторон означает: ни эйфории, ни капитуляции.\n\nНе целевая цена и не прогноз: сигналы лишь описывают, как выглядели прошлые циклы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenjat e një maksimumi të mundshëm numërojnë sinjalet e parë në majat e cikleve të kaluara: mbivlerësim i fortë (MVRV), të ardhura shumë të larta të minerëve (Puell), çmim shumë mbi mesataren 200-ditore ose 200-javore, rritje parabolike dhe dritarja 12–18 muaj pas halving-ut.\n\nShenjat e një minimumi të mundshëm numërojnë sinjalet e fundeve të kaluara: MVRV i ulët, të ardhura të dobëta të minerëve, rënie e fortë nga maksimumi historik, çmim pranë mesatares 200-javore, hashrate në rënie dhe një maksimum mbi një vit më parë.\n\nMe 4 pikë epërsi zona është Bull ose Bear, nga 7 Ekstreme. Nëse asnjë anë nuk prin, vendos trendi i çmimit. 0/10 në të dyja anët do të thotë: as euforia as kapitullim.\n\nPa objektiv çmimi dhe pa parashikim: sinjalet vetëm përshkruajnë si dukeshin ciklet e kaluara."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tecken på en möjlig topp räknar signaler från tidigare cykeltoppar: kraftig övervärdering (MVRV), mycket höga minerintäkter (Puell), kurs långt över 200-dagars- eller 200-veckorsgenomsnittet, paraboliskt uppsving och perioden 12–18 månader efter halveringen.\n\nTecken på en möjlig botten räknar signaler från tidigare bottnar: lågt MVRV, svaga minerintäkter, kraftigt fall från rekordnivån, kurs nära 200-veckorsgenomsnittet, sjunkande hashrate och en topp för över ett år sedan.\n\nFrån 4 poängs försprång är zonen Bull eller Bear, från 7 Extrem. Leder ingen sida avgör kurstrenden. 0/10 på båda sidor betyder: varken eufori eller kapitulation.\n\nInget kursmål och ingen prognos: signalerna beskriver bara hur tidigare cykler såg ut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัญญาณของจุดสูงสุดที่อาจเกิดขึ้นนับสัญญาณที่เคยเกิดที่จุดสูงสุดของรอบก่อน ๆ: มูลค่าสูงเกินจริงมาก (MVRV), รายได้นักขุดสูงมาก (Puell), ราคาสูงกว่าค่าเฉลี่ย 200 วันหรือ 200 สัปดาห์มาก, การพุ่งขึ้นแบบพาราโบลา และช่วง 12–18 เดือนหลัง halving\n\nสัญญาณของจุดต่ำสุดที่อาจเกิดขึ้นนับสัญญาณของจุดต่ำสุดในอดีต: MVRV ต่ำ, รายได้นักขุดอ่อนแอ, ราคาร่วงหนักจากจุดสูงสุดตลอดกาล, ราคาใกล้ค่าเฉลี่ย 200 สัปดาห์, hashrate ลดลง และจุดสูงสุดผ่านมานานกว่าหนึ่งปี\n\nนำ 4 คะแนนขึ้นไปโซนจะเป็น Bull หรือ Bear ตั้งแต่ 7 เป็นสุดขั้ว หากไม่มีฝั่งใดนำ แนวโน้มราคาเป็นตัวตัดสิน 0/10 ทั้งสองฝั่งหมายถึง: ไม่มีทั้งความคึกคักเกินเหตุและการยอมแพ้\n\nไม่ใช่ราคาเป้าหมายและไม่ใช่การคาดการณ์: สัญญาณเพียงอธิบายว่ารอบก่อน ๆ เป็นอย่างไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olası bir tepe işaretleri, geçmiş döngü zirvelerinde görülen sinyalleri sayar: güçlü aşırı değerleme (MVRV), çok yüksek madenci geliri (Puell), fiyatın 200 günlük veya 200 haftalık ortalamanın çok üzerinde olması, parabolik yükseliş ve halving'den sonraki 12–18 aylık dönem.\n\nOlası bir dip işaretleri, geçmiş diplerin sinyallerini sayar: düşük MVRV, zayıf madenci geliri, tüm zamanların zirvesinden sert düşüş, 200 haftalık ortalamaya yakın fiyat, düşen hashrate ve bir yıldan eski bir zirve.\n\n4 puan farkla bölge Bull veya Bear, 7'den itibaren Aşırıdır. Hiçbir taraf önde değilse fiyat trendi belirler. İki tarafta da 0/10: ne coşku ne teslimiyet.\n\nFiyat hedefi değildir ve tahmin değildir: sinyaller yalnızca geçmiş döngülerin nasıl göründüğünü anlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ознаки можливої вершини – це сигнали, що спостерігалися на вершинах минулих циклів: сильна переоцінка (MVRV), дуже високий дохід майнерів (Puell), ціна значно вище 200-денної або 200-тижневої середньої, параболічне зростання та вікно 12–18 місяців після халвінгу.\n\nОзнаки можливого дна – це сигнали минулих днищ: низький MVRV, слабкий дохід майнерів, сильне падіння від історичного максимуму, ціна біля 200-тижневої середньої, падіння хешрейту та максимум понад рік тому.\n\nЗа переваги від 4 балів зона Bull або Bear, від 7 – Екстремальна. Якщо жодна сторона не лідирує, вирішує ціновий тренд. 0/10 з обох боків означає: ні ейфорії, ні капітуляції.\n\nНе цільова ціна і не прогноз: сигнали лише описують, який вигляд мали минулі цикли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu hiệu có thể là đỉnh đếm các tín hiệu từng xuất hiện ở đỉnh các chu kỳ trước: định giá quá cao mạnh (MVRV), doanh thu thợ đào rất cao (Puell), giá cao hơn nhiều so với trung bình 200 ngày hoặc 200 tuần, tăng dạng parabol và khoảng 12–18 tháng sau halving.\n\nDấu hiệu có thể là đáy đếm các tín hiệu của các đáy trước: MVRV thấp, doanh thu thợ đào yếu, giảm mạnh từ đỉnh mọi thời đại, giá gần trung bình 200 tuần, hashrate giảm và đỉnh đã hơn một năm.\n\nDẫn trước 4 điểm thì vùng là Bull hoặc Bear, từ 7 là Cực độ. Nếu không bên nào dẫn, xu hướng giá quyết định. 0/10 cả hai bên nghĩa là: không hưng phấn, không đầu hàng.\n\nKhông phải giá mục tiêu và không phải dự báo: các tín hiệu chỉ mô tả các chu kỳ trước đã diễn ra thế nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能顶部的迹象统计以往周期顶部出现过的信号：严重高估（MVRV）、矿工收入极高（Puell）、价格远高于 200 日或 200 周均线、抛物线式上涨，以及减半后 12–18 个月的时间窗口。\n\n可能底部的迹象统计以往底部的信号：MVRV 偏低、矿工收入疲弱、较历史高点大幅下跌、价格接近 200 周均线、算力下降，以及高点已超过一年。\n\n领先 4 分时区域为 Bull 或 Bear，7 分起为极端。若双方均不领先，由价格趋势决定。两边都是 0/10 表示：既无狂热，也无投降。\n\n不是目标价，也不是预测：这些信号只描述以往周期的样子。"
          }
        }
      }
    },
