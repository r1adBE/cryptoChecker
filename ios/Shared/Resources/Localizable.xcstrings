    "portfolio_tx_withdrawal_gift_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهديته أو دفعت به؟ سجّله كـ ‹هدية› أو ‹دُفع به› – بحسب البلد يُعدّ ذلك بيعًا ضريبيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darováno nebo jím zaplaceno? Zapiš jako ‹Dar› nebo ‹Zaplaceno› – podle země je to daňově prodej."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Givet væk eller betalt med? Registrér det som ‹Gave› eller ‹Betalt med› – afhængigt af landet er det skattemæssigt et salg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschenkt oder damit bezahlt? Dann als ‹Verschenkt› bzw. ‹Damit bezahlt› erfassen – je nach Land ist das steuerlich ein Verkauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χάρισες ή πλήρωσες με αυτό; Κατάγραψέ το ως ‹Δωρεά› ή ‹Πληρωμή με αυτό› – ανάλογα με τη χώρα, φορολογικά είναι πώληση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gave it away or paid with it? Record it as “Gift” or “Paid with it” – depending on the country, that counts as a sale for tax purposes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo regalaste o pagaste con ello? Regístralo como ‹Regalo› o ‹Pagado con ello›: según el país, fiscalmente es una venta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدیه دادی یا با آن پرداخت کردی؟ آن را به‌صورت ‹هدیه› یا ‹پرداخت با آن› ثبت کن – بسته به کشور، از نظر مالیاتی فروش است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annoitko pois tai maksoitko sillä? Kirjaa se nimellä ‹Lahja› tai ‹Maksettu sillä› – maasta riippuen se on verotuksessa myynti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donné ou utilisé pour payer ? Enregistre-le comme ‹Don› ou ‹Payé avec› – selon le pays, c’est fiscalement une vente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתת במתנה או שילמת בזה? רשמו כ‹מתנה› או ‹שולם בזה› – בהתאם למדינה, לצורכי מס זו מכירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपहार में दिया या इससे भुगतान किया? इसे ‹उपहार› या ‹इससे भुगतान› के रूप में दर्ज करो – देश के अनुसार कर के लिए यह बिक्री है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elajándékoztad vagy fizettél vele? Rögzítsd ‹Ajándék› vagy ‹Fizetés vele› típusként – országtól függően ez adózási szempontból eladás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diberikan atau dipakai membayar? Catat sebagai ‹Hadiah› atau ‹Dibayar dengannya› – tergantung negara, secara pajak itu penjualan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regalato o usato per pagare? Registralo come ‹Regalo› o ‹Pagato con› – a seconda del paese, ai fini fiscali è una vendita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贈与した、または支払いに使った？ ‹贈与› または ‹支払いに使用› として記録してください – 国によっては税務上の売却です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증여했거나 결제에 썼나요? ‹증여› 또는 ‹결제에 사용›으로 기록하세요 – 국가에 따라 세법상 매도입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitt bort eller betalt med? Registrer som ‹Gave› eller ‹Betalt med› – avhengig av landet er det skattemessig et salg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weggegeven of mee betaald? Leg het vast als ‹Geschonken› of ‹Mee betaald› – afhankelijk van het land is dat fiscaal een verkoop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podarowane lub zapłacono tym? Zapisz jako ‹Darowizna› lub ‹Zapłacono› – zależnie od kraju podatkowo to sprzedaż."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofereceste ou pagaste com isto? Regista como ‹Oferta› ou ‹Pago com isto› – conforme o país, fiscalmente é uma venda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doou ou pagou com isso? Registre como ‹Doação› ou ‹Pago com isso› – dependendo do país, para fins fiscais é uma venda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dăruit sau plătit cu el? Înregistrează-l ca ‹Donație› sau ‹Plătit cu› – în funcție de țară, fiscal este o vânzare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарок или оплата? Запиши как ‹Подарок› или ‹Оплачено› – в зависимости от страны для налогов это продажа."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E dhurove apo pagove me të? Regjistroje si ‹Dhuratë› ose ‹Paguar me to› – sipas vendit, tatimisht është shitje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gett bort eller betalat med? Registrera som ‹Gåva› eller ‹Betalat med› – beroende på land är det skattemässigt en försäljning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เป็นของขวัญหรือใช้จ่ายไป? บันทึกเป็น ‹ของขวัญ› หรือ ‹ใช้จ่ายแล้ว› – ขึ้นอยู่กับประเทศ ทางภาษีถือเป็นการขาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hediye mi ettin, ödeme mi yaptın? ‹Hediye› veya ‹Ödeme yapıldı› olarak kaydet – ülkeye göre vergi açısından bu bir satıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарунок чи оплата? Запиши як ‹Подарунок› або ‹Оплачено› – залежно від країни для податків це продаж."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tặng hay dùng để thanh toán? Hãy ghi là ‹Tặng› hoặc ‹Đã thanh toán› – tùy quốc gia, về thuế đó là một lần bán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送人了或用于支付？请记为‹赠与›或‹用于支付›——视国家而定，税务上属于卖出。"
          }
        }
      }
    },
    "portfolio_tx_withdrawal_price_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري: القيمة السوقية بالـ USDT، للسجل فقط (فارغ = سعر ذلك اليوم). تخرج العملات دائمًا بتكلفة الشراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepovinné: tržní hodnota v USDT, jen pro historii (prázdné = denní kurz). Mince vždy odcházejí za pořizovací cenu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit: markedsværdi i USDT, kun til historikken (tom = dagens kurs). Coinsene går altid ud til deres anskaffelsespris."
          }
        },
