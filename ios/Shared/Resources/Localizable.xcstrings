        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모와 그룹을 포함한 목록, 경보, 즐겨찾기, 포트폴리오, 설정을 직접 보관하는 파일로 저장합니다 (예: 새 휴대폰용)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrer liste med notater og grupper, alarmer, favoritter, portefølje og innstillinger i en fil du tar vare på selv – f.eks. til ny telefon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart lijst met notities en groepen, alarmen, favorieten, portfolio en instellingen als bestand dat je zelf bewaart – bijv. voor een nieuwe telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje listę z notatkami i grupami, alarmy, ulubione, portfel i ustawienia w pliku, który przechowujesz sam – np. na nowy telefon."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda a lista com notas e grupos, alarmes, favoritos, portfólio e definições num ficheiro que guardas – p. ex. para um telemóvel novo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva a lista com notas e grupos, alarmes, favoritos, portfólio e configurações em um arquivo que você guarda – por ex. para um celular novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează lista cu note și grupuri, alarmele, favoritele, portofoliul și setările într-un fișier păstrat de tine – de ex. pentru un telefon nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет список с заметками и группами, оповещения, избранное, портфель и настройки в файл, который хранится у тебя — например, для нового телефона."
