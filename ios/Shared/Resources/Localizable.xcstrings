    "portfolio_empty_example_plain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثال: شراء %1$@ BTC في 1 مارس. يعرض التطبيق بعدها قيمته اليوم وهل أنت رابح أم خاسر – يُحفظ على هذا الجهاز فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příklad: %1$@ BTC koupeno 1. března. Aplikace pak ukáže, kolik má dnes hodnotu a zda jsi v plusu, nebo v minusu – uloženo jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksempel: %1$@ BTC købt den 1. marts. Appen viser så, hvad den er værd i dag, og om du er i plus eller minus – gemt kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: %1$@ BTC am 1. März gekauft. Die App zeigt dann, was das heute wert ist und ob du im Plus oder im Minus bist – gespeichert nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παράδειγμα: %1$@ BTC αγορασμένο την 1η Μαρτίου. Η εφαρμογή δείχνει πόσο αξίζει σήμερα και αν είσαι σε κέρδος ή ζημία – αποθηκεύεται μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example: %1$@ BTC bought on 1 March. The app then shows what it is worth today and whether you are up or down – stored only on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejemplo: %1$@ BTC comprado el 1 de marzo. La app muestra cuánto vale hoy y si ganas o pierdes – guardado solo en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثال: خرید %1$@ BTC در ۱ مارس. برنامه نشان می‌دهد امروز چقدر می‌ارزد و در سود هستی یا زیان – فقط روی همین دستگاه ذخیره می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimerkki: %1$@ BTC ostettu 1. maaliskuuta. Sovellus näyttää sitten, paljonko se on tänään arvoinen ja oletko voitolla vai tappiolla – tallennetaan vain tähän laitteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple : %1$@ BTC acheté le 1er mars. L’app montre alors sa valeur aujourd’hui et si tu es en gain ou en perte – enregistré uniquement sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דוגמה: %1$@ BTC נקנה ב-1 במרץ. האפליקציה תראה כמה זה שווה היום ואם יש רווח או הפסד – נשמר רק במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदाहरण: 1 मार्च को %1$@ BTC खरीदा। फिर ऐप दिखाता है कि आज उसकी कीमत क्या है और तुम फ़ायदे में हो या नुकसान में – सिर्फ़ इसी डिवाइस पर सेव।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Példa: %1$@ BTC vásárolva március 1-jén. Az app megmutatja, mennyit ér ma, és hogy pluszban vagy mínuszban vagy – csak ezen az eszközön tárolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contoh: %1$@ BTC dibeli pada 1 Maret. Aplikasi lalu menunjukkan nilainya hari ini dan apakah kamu untung atau rugi – hanya disimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
