          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Handel der letzten Stunde entspricht den letzten 24 Stunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συναλλαγές της τελευταίας ώρας είναι σύμφωνες με τις τελευταίες 24 ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
