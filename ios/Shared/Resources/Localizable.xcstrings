    "backup_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ القائمة مع الملاحظات والمجموعات، والتنبيهات والمفضلة والمحفظة والإعدادات في ملف تحتفظ به بنفسك – مثلًا لهاتف جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloží seznam s poznámkami a skupinami, alarmy, oblíbené, portfolio a nastavení do souboru, který si uschováte – např. pro nový telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmer liste med noter og grupper, alarmer, favoritter, portefølje og indstillinger i en fil, du selv opbevarer – fx til en ny telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Merkliste mit Notizen und Gruppen, Alarme, Favoriten, Portfolio und Einstellungen als Datei, die du selbst ablegst – z. B. für ein neues Handy."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύει λίστα με σημειώσεις και ομάδες, ειδοποιήσεις, αγαπημένα, χαρτοφυλάκιο και ρυθμίσεις σε αρχείο που κρατάτε εσείς – π.χ. για νέο κινητό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your watchlist with notes and groups, alarms, favorites, portfolio and settings as a file you keep yourself – e.g. for a new phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda lista con notas y grupos, alertas, favoritos, cartera y ajustes en un archivo que guardas tú, p. ej. para un móvil nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست همراه با یادداشت‌ها و گروه‌ها، هشدارها، علاقه‌مندی‌ها، پرتفوی و تنظیمات را در فایلی ذخیره می‌کند که خودتان نگه می‌دارید – مثلاً برای گوشی جدید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa listan muistiinpanoineen ja ryhmineen, hälytykset, suosikit, salkun ja asetukset tiedostoon, jonka säilytät itse – esim. uutta puhelinta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre liste avec notes et groupes, alertes, favoris, portefeuille et réglages dans un fichier que vous gardez – p. ex. pour un nouveau téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר רשימה עם הערות וקבוצות, התראות, מועדפים, תיק השקעות והגדרות בקובץ שאתם שומרים – למשל לטלפון חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट और समूहों सहित सूची, अलार्म, पसंदीदा, पोर्टफोलियो और सेटिंग एक फ़ाइल में सहेजता है जिसे आप रखते हैं – जैसे नए फ़ोन के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A listát jegyzetekkel és csoportokkal, a riasztásokat, kedvenceket, a portfóliót és a beállításokat egy fájlba menti, amelyet ön őriz – pl. új telefonhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan daftar beserta catatan dan grup, alarm, favorit, portofolio, dan setelan ke file yang Anda simpan sendiri – mis. untuk ponsel baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva lista con note e gruppi, avvisi, preferiti, portafoglio e impostazioni in un file che conservi tu, ad es. per un nuovo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモとグループを含むリスト、アラーム、お気に入り、ポートフォリオ、設定を自分で保管するファイルに保存します（新しい端末用など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모와 그룹을 포함한 목록, 알림, 즐겨찾기, 포트폴리오, 설정을 직접 보관하는 파일로 저장합니다 (예: 새 휴대폰용)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrer liste med notater og grupper, alarmer, favoritter, portefølje og innstillinger i en fil du tar vare på selv – f.eks. til ny telefon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart lijst met notities en groepen, alarmen, favorieten, portfolio en instellingen als bestand dat je zelf bewaart – bijv. voor een nieuwe telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje listę z notatkami i grupami, alarmy, ulubione, portfel i ustawienia w pliku, który przechowujesz sam – np. na nowy telefon."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda lista com notas e grupos, alertas, favoritos, portfólio e definições num ficheiro que guarda – p. ex. para um telemóvel novo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva a lista com notas e grupos, alertas, favoritos, portfólio e configurações em um arquivo que você guarda – por ex. para um celular novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează lista cu note și grupuri, alarmele, favoritele, portofoliul și setările într-un fișier păstrat de tine – de ex. pentru un telefon nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет список с заметками и группами, оповещения, избранное, портфель и настройки в файл, который хранится у вас — например, для нового телефона."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruan listën me shënime dhe grupe, alarmet, të preferuarat, portofolin dhe cilësimet në një skedar që e mban vetë – p.sh. për një telefon të ri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar lista med anteckningar och grupper, larm, favoriter, portfölj och inställningar i en fil du själv sparar – t.ex. för en ny telefon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกรายการ (รวมบันทึกและกลุ่ม) การแจ้งเตือน รายการโปรด พอร์ตโฟลิโอ และการตั้งค่าเป็นไฟล์ที่คุณเก็บเอง เช่น สำหรับโทรศัพท์เครื่องใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlar ve gruplarla birlikte listeyi, alarmları, favorileri, portföyü ve ayarları kendi saklayacağınız bir dosyaya kaydeder – ör. yeni telefon için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає список із нотатками та групами, сповіщення, обране, портфель і налаштування у файл, який зберігаєте ви — наприклад, для нового телефона."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu danh sách kèm ghi chú và nhóm, cảnh báo, yêu thích, danh mục và cài đặt vào tệp do bạn giữ – vd. cho điện thoại mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把列表（含备注和分组）、提醒、收藏、投资组合和设置保存为由你自己保管的文件，例如换新手机时使用。"
          }
        }
      }
    },
