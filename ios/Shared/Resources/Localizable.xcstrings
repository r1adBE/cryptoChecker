    "portfolio_tx_explain_gift" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغادر العملات رصيدك كالسحب – تصرّف بالقيمة السوقية فقط حيث تفرض الدولة الضريبة على الهدايا هكذا (UK وCA وAU)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coiny opustí držbu jako výběr – zcizení v tržní hodnotě jen tam, kde země takto daní dary (UK, CA, AU)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins forlader beholdningen som en udbetaling – afhændelse til markedsværdi kun, hvor landet beskatter gaver sådan (UK, CA, AU)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins verlassen den Bestand wie eine Auszahlung – Veräusserung zum Marktwert nur, wo das Land Schenkungen so besteuert (UK, CA, AU)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα coins φεύγουν από την κατοχή σαν ανάληψη – διάθεση σε αγοραία αξία μόνο όπου η χώρα φορολογεί έτσι τις δωρεές (UK, CA, AU)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins leave your holdings like a withdrawal – a disposal at market value only where the country taxes gifts (UK, CA, AU)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas salen de tu tenencia como un retiro; transmisión a valor de mercado solo donde el país grava así las donaciones (UK, CA, AU)"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوین‌ها مثل برداشت از دارایی خارج می‌شوند – واگذاری به ارزش بازار فقط جایی که کشور هدیه را این‌گونه مالیات می‌گیرد (UK، CA، AU)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinit poistuvat omistuksesta kuin nosto – luovutus käypään arvoon vain, jos maa verottaa lahjat näin (UK, CA, AU)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coins quittent tes avoirs comme un retrait – cession à la valeur de marché seulement là où le pays taxe les dons ainsi (UK, CA, AU)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המטבעות יוצאים מהאחזקות כמו משיכה – מימוש בשווי שוק רק היכן שהמדינה ממסה כך מתנות (UK, CA, AU)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
