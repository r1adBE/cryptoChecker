    "ios_background_refresh_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديث التطبيقات في الخلفية متوقف لهذا التطبيق. بدونه لا تُفحص التنبيهات إلا والتطبيق مفتوح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace na pozadí je pro aplikaci vypnutá. Bez ní se alarmy kontrolují jen při otevřené aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrundsopdatering er slået fra for appen. Uden den tjekkes alarmer kun, mens appen er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaktualisierung ist für die App aus. Ohne sie werden Alarme nur bei offener App geprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανανέωση στο παρασκήνιο είναι απενεργοποιημένη για την εφαρμογή. Χωρίς αυτήν, οι συναγερμοί ελέγχονται μόνο με ανοιχτή εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background App Refresh is off for this app. Without it, alerts are only checked while the app is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización en segundo plano está desactivada para la app. Sin ella, las alarmas solo se comprueban con la app abierta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌روزرسانی پس‌زمینه برای این برنامه خاموش است. بدون آن، هشدارها فقط وقتی برنامه باز است بررسی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustapäivitys on pois päältä tältä sovellukselta. Ilman sitä hälytykset tarkistetaan vain sovelluksen ollessa auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actualisation en arrière-plan est désactivée pour l’app. Sans elle, les alertes ne sont vérifiées que l’app ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רענון ברקע כבוי עבור האפליקציה. בלעדיו ההתראות נבדקות רק כשהאפליקציה פתוחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप के लिए बैकग्राउंड ऐप रिफ़्रेश बंद है। इसके बिना अलार्म सिर्फ़ ऐप खुला होने पर जाँचे जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérben frissítés ki van kapcsolva az appnál. Nélküle a riasztások csak nyitott appnál ellenőrződnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refresh Aplikasi di Latar Belakang mati untuk aplikasi ini. Tanpanya, alarm hanya diperiksa saat aplikasi terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aggiornamento in background è disattivato per l’app. Senza, gli allarmi vengono controllati solo con l’app aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのAppのバックグラウンド更新がオフです。オフのままだと、アラームはアプリを開いている間しか確認されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 백그라운드 앱 새로 고침이 꺼져 있습니다. 꺼져 있으면 경보는 앱이 열려 있을 때만 확인됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnsoppdatering er av for appen. Uten den sjekkes alarmer bare mens appen er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ververs op achtergrond staat uit voor de app. Zonder dit worden alarmen alleen gecontroleerd als de app open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odświeżanie w tle jest wyłączone dla aplikacji. Bez niego alarmy są sprawdzane tylko przy otwartej aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização em segundo plano está desativada para a app. Sem ela, os alarmes só são verificados com a app aberta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização em segundo plano está desativada para o app. Sem ela, os alarmes só são verificados com o app aberto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reîmprospătarea în fundal este oprită pentru aplicație. Fără ea, alarmele sunt verificate doar cu aplicația deschisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновое обновление для приложения выключено. Без него оповещения проверяются, только пока приложение открыто."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifreskimi në sfond është i çaktivizuar për aplikacionin. Pa të, alarmet kontrollohen vetëm kur aplikacioni është i hapur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatering i bakgrunden är av för appen. Utan den kontrolleras larm bara när appen är öppen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรีเฟรชแอปในเบื้องหลังปิดอยู่สำหรับแอปนี้ หากไม่เปิด สัญญาณเตือนจะถูกตรวจเฉพาะตอนเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
