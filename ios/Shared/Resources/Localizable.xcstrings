    "portfolio_address_overlap" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجودة أيضًا في معاملاتك: %1$@ – يُجمع الاثنان. نفس العملات؟ اختر «العرض فقط»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Také ve tvých vlastních transakcích: %1$@ – sčítá se obojí. Stejné mince? Zvol „Jen zobrazit“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også i dine egne transaktioner: %1$@ – begge lægges sammen. Samme coins? Vælg «Vis kun»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch in deinen eigenen Transaktionen: %1$@ – beides wird addiert. Dieselben Coins? Wähle «Nur anzeigen»."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και στις δικές σου συναλλαγές: %1$@ – προστίθενται και τα δύο. Ίδια νομίσματα; Επίλεξε «Μόνο προβολή»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also in your own transactions: %1$@ – both are added. Same coins? Choose “Show only”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También en tus propias transacciones: %1$@; se suman ambos. ¿Las mismas monedas? Elige «Solo mostrar»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در تراکنش‌های خودت هم هست: %1$@ – هر دو جمع می‌شوند. همان سکه‌ها؟ «فقط نمایش» را انتخاب کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myös omissa tapahtumissasi: %1$@ – molemmat lasketaan yhteen. Samat kolikot? Valitse ”Näytä vain”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi dans tes propres transactions : %1$@ – les deux sont additionnés. Mêmes coins ? Choisis « Afficher seulement »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופיע גם בעסקאות שלך: %1$@ – שניהם מתווספים. אותם מטבעות? בחרו «הצגה בלבד»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हारे अपने लेन-देन में भी: %1$@ – दोनों जोड़े जाते हैं। वही कॉइन? “सिर्फ़ दिखाओ” चुनो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saját tranzakcióidban is: %1$@ – mindkettő összeadódik. Ugyanazok a coinok? Válaszd ezt: „Csak megjelenítés”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga ada di transaksimu sendiri: %1$@ – keduanya dijumlahkan. Koin yang sama? Pilih “Hanya tampilkan”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche nelle tue transazioni: %1$@ – vengono sommati entrambi. Stesse monete? Scegli «Mostra soltanto»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の取引にもあります：%1$@ – 両方が合算されます。同じコインなら「表示のみ」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 거래에도 있습니다: %1$@ – 둘 다 합산됩니다. 같은 코인인가요? “표시만”을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også i dine egne transaksjoner: %1$@ – begge legges sammen. Samme coins? Velg «Bare vis»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook in je eigen transacties: %1$@ – beide worden opgeteld. Dezelfde munten? Kies «Alleen tonen»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Także w twoich transakcjach: %1$@ – oba są sumowane. Te same monety? Wybierz „Tylko pokaż”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também nas tuas próprias transações: %1$@ – ambos são somados. As mesmas moedas? Escolhe «Apenas mostrar»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também nas suas próprias transações: %1$@ – os dois são somados. As mesmas moedas? Escolha “Só mostrar”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Și în propriile tranzacții: %1$@ – ambele se adună. Aceleași monede? Alege „Doar afișează”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также в твоих собственных транзакциях: %1$@ – учитывается и то и другое. Те же монеты? Выбери «Только показывать»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edhe në transaksionet e tua: %1$@ – mblidhen të dyja. Të njëjtat monedha? Zgjidh «Vetëm shfaq»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finns även i dina egna transaktioner: %1$@ – båda läggs ihop. Samma mynt? Välj ”Visa bara”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีในรายการของคุณเองด้วย: %1$@ – ทั้งสองจะถูกรวมกัน เป็นเหรียญเดียวกันหรือไม่? เลือก “แสดงอย่างเดียว”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
