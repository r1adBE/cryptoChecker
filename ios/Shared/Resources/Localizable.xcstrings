        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قفل پرتفوی روشن می‌ماند – پشتیبان رمزنشده نمی‌تواند آن را خاموش کند."
          }
        },
        "fi" : {
          "stringUnit" : {
