    "portfolio_address_xpub_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكشف xpub جميع عناوين هذه المحفظة الرقمية. تُشتق على جهازك؛ ولا تُرسل إلى %1$@ إلا عناوين منفردة – 40 طلبًا على الأقل في البحث الأول ثم أقل. لا تُقبل المفاتيح الخاصة (xprv) أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xpub prozrazí všechny adresy této peněženky. Odvozují se v tvém zařízení; na %1$@ jdou jen jednotlivé adresy – při prvním hledání nejméně 40 dotazů, potom méně. Soukromé klíče (xprv) se nikdy nepřijímají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En xpub afslører alle adresser i denne wallet. De udledes på din enhed; kun enkelte adresser sendes til %1$@ – mindst 40 forespørgsler ved første søgning, senere færre. Private nøgler (xprv) accepteres aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein xpub verrät alle Adressen dieser Wallet. Sie werden auf deinem Gerät abgeleitet; an %1$@ gehen nur einzelne Adressen – bei der ersten Suche mindestens 40 Anfragen, danach weniger. Private Schlüssel (xprv) werden nie angenommen."
          }
        },
        "el" : {
          "stringUnit" : {
