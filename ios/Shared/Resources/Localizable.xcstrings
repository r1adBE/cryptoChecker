    "delivery_swipe_away_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أغلقت التطبيق بسحبه في مبدّل التطبيقات، يتوقف iOS عن الفحص في الخلفية حتى تفتحه مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když aplikaci v přepínači aplikací odsuneš pryč, iOS přestane kontrolovat na pozadí, dokud ji znovu neotevřeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du swiper appen væk i appskifteren, tjekker iOS ikke længere i baggrunden, før du åbner den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischst du die App im App-Umschalter weg, prüft iOS im Hintergrund nicht mehr, bis du sie wieder öffnest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν κλείσεις την εφαρμογή με σάρωση στην εναλλαγή εφαρμογών, το iOS σταματά τους ελέγχους στο παρασκήνιο μέχρι να την ανοίξεις ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you swipe the app away in the app switcher, iOS stops background checks until you open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cierras la app deslizándola en el selector de apps, iOS deja de comprobar en segundo plano hasta que la vuelvas a abrir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر برنامه را در تعویض‌گر برنامه‌ها با کشیدن ببند، iOS تا باز کردن دوباره آن در پس‌زمینه بررسی نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos pyyhkäiset apin pois apinvaihtajassa, iOS lopettaa taustatarkistukset, kunnes avaat sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu balaies l'app dans le sélecteur d'apps, iOS ne vérifie plus en arrière-plan jusqu'à ce que tu la rouvres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם סוגרים את האפליקציה בהחלקה במחליף האפליקציות, iOS מפסיק לבדוק ברקע עד שפותחים אותה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर तुम ऐप स्विचर में ऐप को स्वाइप करके बंद करते हो, तो iOS बैकग्राउंड में जाँचना बंद कर देता है जब तक तुम उसे दोबारा न खोलो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az appváltóban elhúzod az appot, az iOS nem ellenőriz többé a háttérben, amíg újra meg nem nyitod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kamu mengusap tutup aplikasi di pengalih aplikasi, iOS berhenti memeriksa di latar belakang sampai kamu membukanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se chiudi l'app con uno swipe nel selettore app, iOS smette di controllare in background finché non la riapri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appスイッチャーでアプリを上にスワイプして閉じると、次に開くまで iOS はバックグラウンドで確認しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 전환기에서 앱을 쓸어 넘겨 닫으면 다시 열 때까지 iOS가 백그라운드에서 확인하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sveiper bort appen i appveksleren, slutter iOS å sjekke i bakgrunnen til du åpner den igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg je de app weg in de appkiezer, dan controleert iOS niet meer op de achtergrond tot je hem weer opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zamkniesz aplikację przesunięciem w przełączniku aplikacji, iOS przestanie sprawdzać w tle, dopóki jej ponownie nie otworzysz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fechares a app a deslizá-la no seletor de apps, o iOS deixa de verificar em segundo plano até a voltares a abrir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você fechar o app deslizando no seletor de apps, o iOS para de verificar em segundo plano até você abri-lo de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă închizi aplicația glisând în comutatorul de aplicații, iOS nu mai verifică în fundal până când o deschizi din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если смахнуть приложение в переключателе приложений, iOS перестаёт проверять в фоне, пока ты снова его не откроешь."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nëse e heq aplikacionin me rrëshqitje te ndërruesi i aplikacioneve, iOS nuk kontrollon më në sfond derisa ta hapësh përsëri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du sveper bort appen i appväxlaren slutar iOS kontrollera i bakgrunden tills du öppnar den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณปัดแอปทิ้งในตัวสลับแอป iOS จะหยุดตรวจสอบเบื้องหลังจนกว่าคุณจะเปิดแอปอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı uygulama değiştiricide kaydırıp kapatırsan iOS, yeniden açana kadar arka planda kontrol etmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо змахнути застосунок у перемикачі застосунків, iOS перестає перевіряти у фоні, доки ти знову його не відкриєш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn vuốt tắt ứng dụng trong trình chuyển đổi ứng dụng, iOS sẽ ngừng kiểm tra trong nền cho đến khi bạn mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在 App 切换器中划掉应用，iOS 会停止后台检查，直到你再次打开它。"
          }
        }
      }
    },
