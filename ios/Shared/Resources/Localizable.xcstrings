    "settings_activity_sensitivity_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى سهولة اعتبار العملة غير عادية – بالتساوي لبطاقة قائمة المتابعة والإشعارات. مع «أقل» تعرض البطاقة أقوى 3 فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak snadno se mince považuje za neobvyklou – stejně pro kartu ve sledovaných i pro oznámení. Při „Méně“ karta ukazuje jen 3 nejsilnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor let en coin regnes som usædvanlig – ens for kortet i overvågningslisten og notifikationerne. Med ”Mindre” viser kortet kun de 3 stærkeste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie leicht ein Coin als auffällig gilt – für die Karte in der Merkliste und die Markt-Mitteilungen gleich. Bei «Weniger» zeigt die Karte nur die 3 stärksten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο εύκολα ένα νόμισμα θεωρείται ασυνήθιστο – ίδια για την κάρτα της λίστας παρακολούθησης και τις ειδοποιήσεις αγοράς. Με «Λιγότερα» η κάρτα δείχνει μόνο τα 3 ισχυρότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How easily a coin counts as unusual – the same for the watchlist card and market alerts. With “Less”, the card shows only the 3 strongest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con qué facilidad una moneda se considera inusual: igual para la tarjeta de la lista y las notificaciones. Con «Menos», la tarjeta muestra solo las 3 más fuertes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چقدر آسان یک کوین غیرعادی به شمار می‌آید – برای کارت واچ‌لیست و اعلان‌ها یکسان. با «کمتر» کارت فقط ۳ مورد قوی‌تر را نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka helposti kolikko katsotaan epätavalliseksi – sama seurantalistan kortille ja ilmoituksille. Asetuksella ”Vähemmän” kortti näyttää vain 3 vahvinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facilité avec laquelle une crypto est jugée inhabituelle – identique pour la carte de la liste et les notifications. Avec « Moins », la carte n’affiche que les 3 plus forts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה בקלות מטבע נחשב חריג – זהה לכרטיס ברשימת המעקב ולהודעות השוק. באפשרות ״פחות״ הכרטיס מציג רק את 3 החזקים ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई कॉइन कितनी आसानी से असामान्य माना जाए – वॉचलिस्ट कार्ड और सूचनाओं के लिए एक जैसा। “कम” पर कार्ड केवल 3 सबसे मज़बूत दिखाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen könnyen számít egy érme szokatlannak – ugyanúgy a figyelőlista kártyájára és az értesítésekre. „Kevesebb” esetén a kártya csak a 3 legerősebbet mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa mudah koin dianggap tidak biasa – sama untuk kartu daftar pantau dan notifikasi. Dengan “Lebih sedikit”, kartu hanya menampilkan 3 terkuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto facilmente una moneta è considerata insolita – uguale per la scheda della lista e le notifiche. Con «Meno» la scheda mostra solo le 3 più forti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインを異常とみなす基準 – ウォッチリストのカードと通知に共通です。「少なめ」ではカードに上位3件のみ表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코인을 이상 움직임으로 판단하는 기준 – 관심 목록 카드와 알림에 동일하게 적용됩니다. ‘적게’에서는 카드에 가장 강한 3개만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lett en mynt regnes som uvanlig – likt for kortet i overvåkingslisten og varslene. Med «Færre» viser kortet bare de 3 sterkeste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe snel een munt als ongewoon geldt – gelijk voor de kaart in de volglijst en de meldingen. Bij ‘Minder’ toont de kaart alleen de 3 sterkste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak łatwo moneta uznawana jest za nietypową – tak samo dla karty na liście obserwowanych i powiadomień. Przy „Mniej” karta pokazuje tylko 3 najsilniejsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com que facilidade uma moeda é considerada invulgar – igual para o cartão da lista e as notificações. Com «Menos», o cartão mostra apenas as 3 mais fortes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com que facilidade uma moeda é considerada incomum – igual para o card da lista e as notificações. Com “Menos”, o card mostra só as 3 mais fortes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de ușor o monedă e considerată neobișnuită – la fel pentru cardul din listă și pentru notificări. Cu „Mai puțin”, cardul arată doar cele mai puternice 3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько легко монета считается необычной – одинаково для карточки в списке и для уведомлений. При «Меньше» карточка показывает только 3 самых сильных."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa lehtë një monedhë quhet e pazakontë – njësoj për kartën e listës dhe njoftimet. Me «Më pak», karta tregon vetëm 3 më të fortat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur lätt ett mynt räknas som ovanligt – samma för kortet i bevakningslistan och aviseringarna. Med ”Färre” visar kortet bara de 3 starkaste."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกณฑ์ที่เหรียญจะถือว่าผิดปกติ – ใช้เหมือนกันทั้งการ์ดในรายการติดตามและการแจ้งเตือน เมื่อเลือก “น้อยลง” การ์ดจะแสดงเพียง 3 อันดับที่แรงที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir coinin ne kadar kolay olağandışı sayılacağı – izleme listesi kartı ve bildirimler için aynı. “Daha az” seçiliyken kart yalnızca en güçlü 3 taneyi gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки легко монета вважається незвичайною – однаково для картки в списку та для сповіщень. За «Менше» картка показує лише 3 найсильніші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức dễ để một coin bị coi là bất thường – giống nhau cho thẻ trong danh sách theo dõi và thông báo. Với “Ít hơn”, thẻ chỉ hiện 3 coin mạnh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "币种被视为异常的难易程度——自选列表卡片与通知相同。选择“较少”时，卡片只显示最强的 3 个。"
          }
        }
      }
    },
