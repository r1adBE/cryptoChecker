    "alarm_fires_now_above" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعر أعلى من %1$@ بالفعل. هل تريد الحفظ رغم ذلك؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena je už nad %1$@. Přesto uložit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursen er allerede over %1$@. Gem alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kurs liegt schon über %1$@. Trotzdem speichern?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τιμή είναι ήδη πάνω από %1$@. Αποθήκευση παρ’ όλα αυτά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The price is already above %1$@. Save anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio ya está por encima de %1$@. ¿Guardar de todos modos?"
