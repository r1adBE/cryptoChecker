    "tax_summary_orientation_block" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاسترشاد – ليست استشارة ضريبية – ليست تقديرًا ضريبيًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientační – nejde o daňové poradenství – nejde o vyměření"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejledende – ikke skatterådgivning – ikke en ansættelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientierung – keine Steuerberatung – keine Veranlagung"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενδεικτικό – όχι φορολογική συμβουλή – όχι εκκαθάριση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For guidance only – not tax advice – not an assessment"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – no es asesoramiento fiscal – no es una liquidación"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای راهنمایی – نه مشاورهٔ مالیاتی – نه تشخیص مالیات"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuntaa antava – ei veroneuvontaa – ei verotuspäätös"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À titre indicatif – pas un conseil fiscal – pas une imposition"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתמצאות – לא ייעוץ מס – לא שומה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मार्गदर्शन हेतु – टैक्स सलाह नहीं – कर निर्धारण नहीं"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tájékoztató – nem adótanácsadás – nem adómegállapítás"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientasi – bukan nasihat pajak – bukan penetapan pajak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – non è consulenza fiscale – non è un accertamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目安 – 税務アドバイスではありません – 課税決定ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고용 – 세무 조언 아님 – 과세 결정 아님"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veiledende – ikke skatteråd – ikke en skatteavregning"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatief – geen belastingadvies – geen aanslag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientacyjnie – nie porada podatkowa – nie decyzja wymiarowa"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – não é aconselhamento fiscal – não é uma liquidação"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativo – não é consultoria tributária – não é um lançamento"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientativ – nu este consultanță fiscală – nu este o impunere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ориентир – не налоговая консультация – не налоговое начисление"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientuese – jo këshillë tatimore – jo vlerësim tatimor"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vägledande – ingen skatterådgivning – inget beslut om slutlig skatt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อเป็นแนวทาง – ไม่ใช่คำแนะนำด้านภาษี – ไม่ใช่การประเมินภาษี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yol gösterici – vergi tavsiyesi değil – tarh değil"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орієнтир – не податкова консультація – не податкове нарахування"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham khảo – không phải tư vấn thuế – không phải quyết định thuế"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供参考——不构成税务建议——不是税务核定"
          }
        }
      }
    },
