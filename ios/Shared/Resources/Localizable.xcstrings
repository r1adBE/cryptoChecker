    "halving_estimate_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهالفينغ التالي حسابيًا نحو %1$@: تبقّى %2$@ كتلة بمتوسط %3$@ دقيقة لكل كتلة (فترة الصعوبة الحالية). امتداد حسابي لا وعد – زمن الكتلة يتفاوت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další halving výpočtem kolem %1$@: zbývá %2$@ bloků při průměrně %3$@ min na blok (aktuální období obtížnosti). Odhad, ne slib – doba bloku kolísá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Næste halving beregnet omkring %1$@: %2$@ blokke tilbage ved i gennemsnit %3$@ min pr. blok (nuværende sværhedsperiode). En fremskrivning, ikke et løfte – bloktiden svinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächstes Halving rechnerisch um %1$@: noch %2$@ Blöcke bei durchschnittlich %3$@ Min. je Block (laufende Schwierigkeitsperiode). Eine Fortschreibung, keine Zusage – die Blockzeit schwankt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επόμενο halving, βάσει υπολογισμού, περίπου %1$@: απομένουν %2$@ μπλοκ με μέσο όρο %3$@ λεπτά ανά μπλοκ (τρέχουσα περίοδος δυσκολίας). Προβολή, όχι υπόσχεση – ο χρόνος μπλοκ μεταβάλλεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next halving by calculation around %1$@: %2$@ blocks left at an average of %3$@ min per block (current difficulty period). A projection, not a promise – block time varies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo halving, por cálculo, hacia %1$@: quedan %2$@ bloques a %3$@ min por bloque de media (periodo de dificultad actual). Una proyección, no una promesa: el tiempo de bloque varía."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هاوینگ بعدی به‌طور محاسباتی حدود %1$@: %2$@ بلوک باقی‌مانده با میانگین %3$@ دقیقه برای هر بلوک (دورهٔ سختی فعلی). یک برون‌یابی است نه وعده – زمان بلوک نوسان دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraava puoliintuminen laskennallisesti noin %1$@: %2$@ lohkoa jäljellä keskimäärin %3$@ min lohkoa kohden (nykyinen vaikeusjakso). Ennakointi, ei lupaus – lohkoaika vaihtelee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prochain halving, par calcul, vers %1$@ : encore %2$@ blocs à %3$@ min par bloc en moyenne (période de difficulté en cours). Une projection, pas une promesse – le temps de bloc varie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההאלבינג הבא לפי חישוב סביב %1$@: נותרו %2$@ בלוקים בממוצע %3$@ דק׳ לבלוק (תקופת הקושי הנוכחית). המשכה חשבונית, לא הבטחה – זמן הבלוק משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगला हॉल्विंग गणना से लगभग %1$@: औसतन %3$@ मिनट प्रति ब्लॉक पर %2$@ ब्लॉक बाकी (मौजूदा डिफिकल्टी अवधि)। यह अनुमानित विस्तार है, वादा नहीं – ब्लॉक समय बदलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő felezés számítás szerint %1$@ körül: még %2$@ blokk, átlagosan %3$@ perc blokkonként (jelenlegi nehézségi időszak). Továbbvezetés, nem ígéret – a blokkidő ingadozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halving berikutnya menurut perhitungan sekitar %1$@: tersisa %2$@ blok dengan rata-rata %3$@ menit per blok (periode kesulitan saat ini). Proyeksi, bukan janji – waktu blok berubah-ubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossimo halving, per calcolo, intorno a %1$@: ancora %2$@ blocchi a %3$@ min per blocco in media (periodo di difficoltà in corso). Una proiezione, non una promessa – il tempo di blocco varia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の半減期は計算上 %1$@ 頃：現在の難易度期間の平均 %3$@ 分/ブロックで残り %2$@ ブロック。延長計算であり約束ではありません（ブロック時間は変動します）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 반감기는 계산상 %1$@ 무렵: 현재 난이도 기간 평균 블록당 %3$@분으로 %2$@ 블록 남음. 연장 계산일 뿐 약속이 아닙니다 – 블록 시간은 변합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste halvering beregnet rundt %1$@: %2$@ blokker igjen med i snitt %3$@ min per blokk (nåværende vanskelighetsperiode). En framskriving, ikke et løfte – blokktiden varierer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgende halving berekend rond %1$@: nog %2$@ blokken bij gemiddeld %3$@ min per blok (huidige moeilijkheidsperiode). Een doortrekking, geen belofte – de bloktijd schommelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Następny halving według obliczeń ok. %1$@: zostało %2$@ bloków przy średnio %3$@ min na blok (bieżący okres trudności). Ekstrapolacja, nie obietnica – czas bloku się zmienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo halving, por cálculo, por volta de %1$@: faltam %2$@ blocos a %3$@ min por bloco em média (período de dificuldade atual). Uma projeção, não uma promessa – o tempo de bloco varia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo halving, por cálculo, por volta de %1$@: faltam %2$@ blocos a %3$@ min por bloco em média (período de dificuldade atual). Uma projeção, não uma promessa – o tempo de bloco varia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Următorul halving, prin calcul, în jur de %1$@: mai sunt %2$@ blocuri la o medie de %3$@ min pe bloc (perioada de dificultate curentă). O proiecție, nu o promisiune – timpul de bloc variază."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующий халвинг расчётно около %1$@: осталось %2$@ блоков при среднем %3$@ мин на блок (текущий период сложности). Экстраполяция, не обещание – время блока колеблется."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halving-u i ardhshëm sipas llogaritjes rreth %1$@: edhe %2$@ blloqe me mesatarisht %3$@ min për bllok (periudha aktuale e vështirësisë). Një projeksion, jo premtim – koha e bllokut ndryshon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nästa halvering beräknad kring %1$@: %2$@ block kvar med i snitt %3$@ min per block (nuvarande svårighetsperiod). En framskrivning, inget löfte – blocktiden varierar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การฮาล์ฟวิ่งครั้งถัดไปตามการคำนวณราว %1$@: เหลือ %2$@ บล็อก เฉลี่ย %3$@ นาทีต่อบล็อก (ช่วงความยากปัจจุบัน) เป็นการคำนวณต่อเนื่อง ไม่ใช่คำสัญญา – เวลาบล็อกผันผวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sonraki halving hesaplamaya göre %1$@ civarı: blok başına ortalama %3$@ dk ile %2$@ blok kaldı (mevcut zorluk dönemi). Bir projeksiyon, söz değil – blok süresi değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наступний халвінг розрахунково близько %1$@: лишилося %2$@ блоків у середньому по %3$@ хв на блок (поточний період складності). Екстраполяція, не обіцянка – час блоку коливається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halving tiếp theo theo tính toán khoảng %1$@: còn %2$@ khối với trung bình %3$@ phút mỗi khối (giai đoạn độ khó hiện tại). Đây là ngoại suy, không phải cam kết – thời gian khối dao động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一次减半按计算约在 %1$@：按当前难度周期平均每块 %3$@ 分钟，还剩 %2$@ 个区块。这是推算，不是承诺——出块时间会波动。"
          }
        }
      }
    },
