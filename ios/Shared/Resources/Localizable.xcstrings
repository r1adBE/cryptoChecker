        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Aufschlüsselung: Diese Version hat noch keine vollständige Aktualisierung abgeschlossen. Auf Aktualisieren tippen und warten, bis der Kreis stoppt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ανάλυση ακόμα: αυτή η έκδοση δεν έχει ολοκληρώσει πλήρη ανανέωση. Πατήστε ανανέωση και περιμένετε να σταματήσει η ένδειξη φόρτωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No breakdown yet: this version has not completed a full refresh. Tap refresh and wait until the spinner stops."
