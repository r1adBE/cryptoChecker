    "settings_exact_checks_permission_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإذن مفقود – عندما يكون الجهاز في وضع السكون يفحص Android بشكل غير منتظم، أحيانًا بعد ساعات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybí oprávnění – v klidu zařízení kontroluje Android nepravidelně, někdy až po hodinách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilladelse mangler – når enheden hviler, tjekker Android uregelmæssigt, nogle gange først efter timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigung fehlt – bei ruhendem Gerät prüft Android unregelmässig, manchmal erst nach Stunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπει η άδεια – όταν η συσκευή ηρεμεί, το Android ελέγχει ακανόνιστα, μερικές φορές μετά από ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission missing – while the device rests, Android checks irregularly, sometimes only after hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el permiso: con el dispositivo en reposo, Android comprueba de forma irregular, a veces tras horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجوز نیست – وقتی دستگاه در حالت استراحت است Android نامنظم بررسی می‌کند، گاهی پس از چند ساعت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa puuttuu – laitteen levätessä Android tarkistaa epäsäännöllisesti, joskus vasta tuntien päästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation manquante – appareil en veille, Android vérifie irrégulièrement, parfois après des heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חסרה הרשאה – כשהמכשיר במנוחה, Android בודק באופן לא סדיר, לפעמים רק אחרי שעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति नहीं है – डिवाइस निष्क्रिय होने पर Android अनियमित रूप से जाँचता है, कभी-कभी घंटों बाद।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiányzó engedély – nyugvó eszközön az Android rendszertelenül ellenőriz, néha csak órák múlva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin tidak ada – saat perangkat diam, Android memeriksa tidak teratur, terkadang baru setelah berjam-jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizzazione mancante – a dispositivo inattivo Android controlla in modo irregolare, a volte solo dopo ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限がありません – 端末の休止中は Android の確認が不定期になり、数時間後になることもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 없음 – 기기가 쉬는 동안 Android는 불규칙하게 확인하며, 몇 시간 뒤에야 확인하기도 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillatelse mangler – når enheten hviler, sjekker Android uregelmessig, noen ganger først etter timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming ontbreekt – als het toestel rust, controleert Android onregelmatig, soms pas na uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak uprawnienia – gdy urządzenie odpoczywa, Android sprawdza nieregularnie, czasem dopiero po godzinach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta a permissão – com o dispositivo em repouso, o Android verifica de forma irregular, por vezes só após horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão ausente – com o aparelho em repouso, o Android verifica de forma irregular, às vezes só após horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipsește permisiunea – în repaus, Android verifică neregulat, uneori abia după ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет разрешения – пока устройство в покое, Android проверяет нерегулярно, иногда лишь через несколько часов."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mungon leja – kur pajisja pushon, Android kontrollon parregullisht, ndonjëherë vetëm pas orësh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behörighet saknas – när enheten vilar kontrollerar Android oregelbundet, ibland först efter timmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีสิทธิ์ – ขณะเครื่องพัก Android จะตรวจไม่สม่ำเสมอ บางครั้งหลายชั่วโมงต่อครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin eksik – cihaz dinlenirken Android düzensiz kontrol eder, bazen ancak saatler sonra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає дозволу – коли пристрій у спокої, Android перевіряє нерегулярно, іноді лише через кілька годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiếu quyền – lúc thiết bị nghỉ, Android kiểm tra không đều, đôi khi sau nhiều giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少权限——设备静置期间 Android 的检查不规律，有时要隔几小时。"
          }
        }
      }
    },
