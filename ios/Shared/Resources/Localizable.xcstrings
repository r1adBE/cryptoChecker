    "watchlist_sort_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا واسحب زوجًا، أو استخدم المقبض. تبقى المفضلة في الأعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž a táhni pár, nebo použij úchyt. Oblíbené zůstávají nahoře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold og træk et par, eller brug håndtaget. Favoritter bliver øverst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paar halten und ziehen oder den Griff benutzen. Favoriten bleiben oben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα και σύρε ένα ζεύγος ή χρησιμοποίησε τη λαβή. Τα αγαπημένα μένουν πάνω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold and drag a pair, or use the handle. Favorites stay at the top."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra un par, o usa el asa. Los favoritos quedan arriba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جفت را نگه دار و بکش یا از دستگیره استفاده کن. علاقه‌مندی‌ها بالا می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä paria painettuna ja vedä, tai käytä kahvaa. Suosikit pysyvät ylhäällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens et fais glisser une paire, ou utilise la poignée. Les favoris restent en haut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזיקו וגררו צמד, או השתמשו בידית. המועדפים נשארים למעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेयर को दबाकर खींचो या हैंडल का उपयोग करो। पसंदीदा ऊपर रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd lenyomva és húzd a párt, vagy használd a fogantyút. A kedvencek felül maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan dan seret pasangan, atau gunakan pegangan. Favorit tetap di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta e trascina una coppia, oppure usa la maniglia. I preferiti restano in alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアを長押ししてドラッグするか、ハンドルを使います。お気に入りは常に上に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래쌍을 길게 눌러 끌거나 핸들을 사용하세요. 즐겨찾기는 위에 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold og dra et par, eller bruk håndtaket. Favoritter blir øverst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een paar vast en sleep, of gebruik de greep. Favorieten blijven bovenaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj i przeciągnij parę albo użyj uchwytu. Ulubione zostają na górze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém premido e arrasta um par, ou usa a pega. Os favoritos ficam no topo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado e arraste um par, ou use a alça. Os favoritos ficam no topo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat și trage o pereche sau folosește mânerul. Favoritele rămân sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживай и перетащи пару или используй ручку. Избранное остаётся вверху."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbaj dhe tërhiq një çift, ose përdor dorezën. Të preferuarat mbeten lart."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll och dra ett par, eller använd handtaget. Favoriter stannar överst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างแล้วลากคู่เทรด หรือใช้ที่จับ รายการโปรดอยู่ด้านบนเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir çifti basılı tutup sürükle veya tutamacı kullan. Favoriler üstte kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуй і перетягни пару або скористайся ручкою. Обране лишається вгорі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ và kéo một cặp, hoặc dùng tay cầm. Mục yêu thích luôn ở trên cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住并拖动交易对，或使用拖动柄。收藏始终在最上方。"
          }
        }
      }
    },
