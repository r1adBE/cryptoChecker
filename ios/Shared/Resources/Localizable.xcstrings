    "ledger_partial_cost" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«منذ الشراء» يحسب فقط الجزء الذي له سعر شراء – دون %1$@ بلا سعر شراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Od nákupu“ počítá jen část s nákupní cenou – bez %1$@ bez nákupní ceny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Siden køb» tæller kun delen med købspris – uden %1$@ uden købspris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Seit Kauf» zählt nur den Teil mit Kaufpreis – ohne %1$@ ohne Kaufpreis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Από την αγορά» μετρά μόνο το μέρος με τιμή αγοράς – χωρίς %1$@ χωρίς τιμή αγοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Since purchase” counts only the part with a buy price – without %1$@ lacking a buy price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Desde la compra» cuenta solo la parte con precio de compra: sin %1$@ sin precio de compra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«از زمان خرید» فقط بخشِ دارای قیمت خرید را حساب می‌کند – بدون %1$@ بدون قیمت خرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Ostosta” laskee vain osan, jolla on ostohinta – ilman %1$@ ilman ostohintaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Depuis l'achat » ne compte que la part avec prix d’achat – sans %1$@ sans prix d’achat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«מאז הקנייה» סופר רק את החלק עם מחיר קנייה – ללא %1$@ ללא מחיר קנייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“खरीद से” सिर्फ़ खरीद भाव वाले हिस्से को गिनता है – बिना खरीद भाव वाले %1$@ के बिना।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Vétel óta” csak a vételi árral rendelkező részt számolja – %1$@ nélkül (vételi ár nélküli)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sejak beli” hanya menghitung bagian yang punya harga beli – tanpa %1$@ yang tidak punya harga beli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Dall'acquisto» conta solo la parte con prezzo d’acquisto – senza %1$@ privi di prezzo d’acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「購入以来」は購入価格のある部分だけを計算します – 購入価格のない %1$@ を除く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“매수 이후”은(는) 매수가가 있는 부분만 계산합니다 – 매수가 없는 %1$@ 제외."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Siden kjøp» teller bare delen med kjøpspris – uten %1$@ uten kjøpspris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sinds aankoop» telt alleen het deel met aankoopprijs – zonder %1$@ zonder aankoopprijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Od zakupu” liczy tylko część z ceną zakupu – bez %1$@ bez ceny zakupu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Desde a compra» conta apenas a parte com preço de compra – sem %1$@ sem preço de compra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Desde a compra” conta só a parte com preço de compra – sem %1$@ sem preço de compra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„De la cumpărare” ia în calcul doar partea cu preț de cumpărare – fără %1$@ fără preț de cumpărare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«С покупки» учитывает только часть с ценой покупки – без %1$@ без цены покупки."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Që nga blerja» llogarit vetëm pjesën me çmim blerjeje – pa %1$@ pa çmim blerjeje."
