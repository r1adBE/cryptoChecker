    "settings_indicator_alerts_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مؤشرات بيتكوين، تُفحص مرتين يوميًا. أنت تختار الحدود – لا يقيّم التطبيق القيم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazatele Bitcoinu, kontrolované dvakrát denně. Hranice si volíš sám – aplikace hodnoty nehodnotí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-nøgletal, tjekket to gange om dagen. Du vælger grænserne – appen vurderer ikke værdierne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-Kennzahlen, zweimal täglich geprüft. Die Grenzen wählst du selbst – die App bewertet die Werte nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείκτες Bitcoin, ελέγχονται δύο φορές την ημέρα. Τα όρια τα επιλέγεις εσύ – η εφαρμογή δεν αξιολογεί τις τιμές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin indicators, checked twice a day. You choose the limits – the app does not rate the values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores de Bitcoin, revisados dos veces al día. Tú eliges los límites; la app no valora los valores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاخص‌های بیت‌کوین، دو بار در روز بررسی می‌شوند. مرزها را خودت انتخاب می‌کنی – برنامه مقادیر را ارزیابی نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoinin tunnusluvut, tarkistetaan kahdesti päivässä. Rajat valitset itse – sovellus ei arvioi arvoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicateurs Bitcoin, vérifiés deux fois par jour. Tu choisis les seuils – l’app n’évalue pas les valeurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדדי ביטקוין, נבדקים פעמיים ביום. הגבולות נקבעים על ידך – האפליקציה לא מעריכה את הערכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिटकॉइन संकेतक, दिन में दो बार जाँचे जाते हैं। सीमाएँ तुम चुनते हो – ऐप मानों का मूल्यांकन नहीं करता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-mutatók, naponta kétszer ellenőrizve. A határokat te választod – az app nem értékeli az értékeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikator Bitcoin, diperiksa dua kali sehari. Kamu yang memilih batasnya – aplikasi tidak menilai nilainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatori Bitcoin, controllati due volte al giorno. Le soglie le scegli tu – l’app non valuta i valori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin の指標を1日2回確認します。しきい値はご自身で選び、アプリは値を評価しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비트코인 지표를 하루 두 번 확인합니다. 기준은 직접 고르며 앱은 값을 평가하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-nøkkeltall, sjekket to ganger om dagen. Du velger grensene – appen vurderer ikke verdiene."
