    "settings_app_badge_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعدّ إشعارات التنبيه المفتوحة. تحدد الشاشة الرئيسية ظهور رقم أو نقطة (مثل Samsung: «مع رقم»)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá otevřená upozornění na alarmy. Zda se zobrazí číslo, nebo tečka, rozhoduje domovská obrazovka (např. Samsung: „S číslem“)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller åbne alarmnotifikationer. Om der vises et tal eller en prik, bestemmer startskærmen (f.eks. Samsung: «Med tal»)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt offene Alarm-Mitteilungen. Ob eine Zahl oder ein Punkt erscheint, bestimmt der Startbildschirm (z. B. Samsung: «Mit Zahl»)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά τις ανοιχτές ειδοποιήσεις συναγερμών. Αν εμφανίζεται αριθμός ή κουκκίδα το αποφασίζει η αρχική οθόνη (π.χ. Samsung: «Με αριθμό»)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts open alert notifications. Whether a number or a dot appears is up to the home screen (e.g. Samsung: “Show with number”)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta las notificaciones de alarma abiertas. La pantalla de inicio decide si aparece un número o un punto (p. ej. Samsung: «Con número»)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌های هشدار باز را می‌شمارد. نمایش عدد یا نقطه را صفحهٔ اصلی تعیین می‌کند (مثلاً Samsung: «با عدد»)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee avoimet hälytysilmoitukset. Aloitusnäyttö päättää, näkyykö numero vai piste (esim. Samsung: ”Numerolla”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les notifications d’alerte ouvertes. Le lanceur décide s’il affiche un nombre ou un point (p. ex. Samsung : «Avec nombre»)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סופר התראות פתוחות. מסך הבית קובע אם יופיע מספר או נקודה (למשל Samsung: «עם מספר»)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुली अलार्म सूचनाएँ गिनता है। संख्या दिखे या बिंदु, यह होम स्क्रीन तय करती है (जैसे Samsung: “संख्या के साथ”)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszámolja a nyitott riasztási értesítéseket. Hogy szám vagy pont jelenik meg, azt a kezdőképernyő dönti el (pl. Samsung: „Számmal”)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung notifikasi alarm yang terbuka. Layar utama menentukan apakah muncul angka atau titik (mis. Samsung: “Dengan angka”)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta le notifiche di allarme aperte. Se appare un numero o un punto lo decide la schermata Home (ad es. Samsung: «Con numero»)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未読のアラーム通知を数えます。数字か点かはホーム画面が決めます（例：Samsung「数字で表示」）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려 있는 경보 알림 수를 셉니다. 숫자 또는 점 표시는 홈 화면이 결정합니다(예: Samsung “숫자 표시”)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teller åpne alarmvarsler. Om det vises et tall eller en prikk, bestemmer startskjermen (f.eks. Samsung: «Med tall»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt openstaande alarmmeldingen. Of er een getal of een stip verschijnt, bepaalt het startscherm (bijv. Samsung: «Met getal»)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy otwarte powiadomienia o alarmach. Czy pojawi się liczba, czy kropka, decyduje ekran główny (np. Samsung: „Z liczbą”)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta as notificações de alarme abertas. O ecrã inicial decide se aparece um número ou um ponto (p. ex. Samsung: «Com número»)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta as notificações de alarme abertas. A tela inicial decide se aparece um número ou um ponto (ex.: Samsung: “Com número”)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numără notificările de alarmă deschise. Dacă apare un număr sau un punct decide ecranul de pornire (de ex. Samsung: „Cu număr”)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает открытые уведомления о сработавших оповещениях. Будет ли число или точка, решает главный экран (напр. Samsung: «С числом»)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numëron njoftimet e hapura të alarmeve. Nëse shfaqet numër apo pikë e vendos ekrani bazë (p.sh. Samsung: «Me numër»)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknar öppna larmaviseringar. Om en siffra eller en prick visas avgör hemskärmen (t.ex. Samsung: ”Med siffra”)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับการแจ้งเตือนสัญญาณที่ยังเปิดอยู่ หน้าจอหลักเป็นตัวกำหนดว่าจะแสดงตัวเลขหรือจุด (เช่น Samsung: “แสดงตัวเลข”)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık alarm bildirimlerini sayar. Sayı mı nokta mı görüneceğine ana ekran karar verir (ör. Samsung: “Sayıyla”)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахує відкриті сповіщення про сигнали. Чи буде число, чи крапка, вирішує головний екран (напр. Samsung: «З числом»)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm các thông báo cảnh báo đang mở. Màn hình chính quyết định hiện số hay dấu chấm (vd. Samsung: “Có số”)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计未处理的提醒通知。显示数字还是圆点由主屏幕决定（例如 Samsung：“显示数字”）。"
          }
        }
      }
    },
