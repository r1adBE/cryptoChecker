    "portfolio_tx_gift_spouse_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المملكة المتحدة وكندا: بلا ربح ولا خسارة – يتولى شريكك تكلفتك. الدول الأخرى تتجاهل ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojené království a Kanada: bez zisku a bez ztráty – partner převezme tvou pořizovací cenu. Ostatní země to ignorují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storbritannien og Canada: ingen gevinst og intet tab – din partner overtager din anskaffelsessum. Andre lande ignorerer det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UK und Kanada: kein Gewinn und kein Verlust – dein Partner übernimmt deinen Einstand. Andere Länder ignorieren das."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ηνωμένο Βασίλειο και Καναδάς: χωρίς κέρδος και χωρίς ζημία – ο σύντροφός σου αναλαμβάνει το κόστος κτήσης σου. Οι άλλες χώρες το αγνοούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UK and Canada: no gain and no loss – your partner takes over your cost basis. Other countries ignore this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reino Unido y Canadá: sin ganancia ni pérdida – tu pareja asume tu coste. Los demás países lo ignoran."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بریتانیا و کانادا: بدون سود و بدون زیان – شریکت بهای تمام‌شده تو را می‌گیرد. کشورهای دیگر این را نادیده می‌گیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso-Britannia ja Kanada: ei voittoa eikä tappiota – kumppanisi saa hankintamenosi. Muut maat eivät huomioi tätä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Royaume-Uni et Canada : ni plus- ni moins-value – ton partenaire reprend ton prix de revient. Les autres pays l’ignorent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בריטניה וקנדה: ללא רווח וללא הפסד – בן/בת הזוג מקבלים את עלות הרכישה שלך. מדינות אחרות מתעלמות מכך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यूके और कनाडा: न लाभ, न हानि – तुम्हारा पार्टनर तुम्हारी लागत अपनाता है। अन्य देश इसे अनदेखा करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyesült Királyság és Kanada: nincs nyereség és veszteség – a társad átveszi a beszerzési értékedet. Más országok ezt figyelmen kívül hagyják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inggris dan Kanada: tanpa untung dan tanpa rugi – pasanganmu mengambil alih biaya perolehanmu. Negara lain mengabaikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regno Unito e Canada: né guadagno né perdita – il partner riprende il tuo costo. Gli altri paesi lo ignorano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英国とカナダ：損益なし – パートナーがあなたの取得価額を引き継ぎます。その他の国では考慮されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영국과 캐나다: 손익 없음 – 파트너가 내 취득가액을 이어받습니다. 다른 국가는 이를 고려하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storbritannia og Canada: ingen gevinst og intet tap – partneren din overtar inngangsverdien din. Andre land ignorerer dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VK en Canada: geen winst en geen verlies – je partner neemt je kostprijs over. Andere landen negeren dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wielka Brytania i Kanada: bez zysku i bez straty – partner przejmuje twój koszt nabycia. Inne kraje to pomijają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reino Unido e Canadá: sem ganho nem perda – o parceiro assume o teu custo. Os outros países ignoram isto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reino Unido e Canadá: sem ganho nem perda – o companheiro assume seu custo. Os outros países ignoram isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regatul Unit și Canada: fără câștig și fără pierdere – partenerul preia costul tău. Celelalte țări ignoră acest lucru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великобритания и Канада: без прибыли и убытка – партнёр перенимает твою стоимость приобретения. Другие страны это не учитывают."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbretëria e Bashkuar dhe Kanadaja: pa fitim dhe pa humbje – partneri merr koston tënde. Vendet e tjera e shpërfillin këtë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storbritannien och Kanada: ingen vinst och ingen förlust – din partner tar över ditt omkostnadsbelopp. Andra länder ignorerar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สหราชอาณาจักรและแคนาดา: ไม่มีกำไรและไม่มีขาดทุน – คู่ของคุณรับต้นทุนของคุณต่อ ประเทศอื่นไม่นำมาพิจารณา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleşik Krallık ve Kanada: kâr da zarar da yok – maliyetini partnerin devralır. Diğer ülkeler bunu dikkate almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Велика Британія і Канада: без прибутку й збитку – партнер переймає твою вартість придбання. Інші країни цього не враховують."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vương quốc Anh và Canada: không lãi không lỗ – bạn đời tiếp nhận giá vốn của bạn. Các nước khác bỏ qua điều này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英国和加拿大：无盈亏——你的伴侣承接你的成本。其他国家不考虑这一点。"
          }
        }
      }
    },
