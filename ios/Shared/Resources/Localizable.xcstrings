    "tax_export_at_wallet_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النمسا: متوسط متحرك لكل عملة ومحفظة رقمية (منصة) – التحويلات بين المحافظ تنقل تكلفة الشراء معها – المكافآت بتكلفة اقتناء 0 – الرصيد الجديد بدون رسوم (غير قابلة للخصم) – فوائد الإقراض بقيمتها عند الاستلام (دخل بنسبة 27.5 بالمئة)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakousko: klouzavý průměr na minci a peněženku (burzu) – převody mezi peněženkami přenášejí pořizovací cenu – odměny s pořizovací cenou 0 – nový stav bez poplatků (neodečitatelné) – úroky z lendingu v hodnotě při přijetí (příjem se sazbou 27,5 procenta)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Østrig: løbende gennemsnit pr. coin og wallet (børs) – overførsler mellem wallets tager anskaffelsesprisen med – belønninger med anskaffelsespris 0 – ny beholdning uden gebyrer (ikke fradragsberettigede) – renter fra lending til værdien ved modtagelse (indkomst til 27,5 procent)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Österreich: gleitender Durchschnitt je Coin und Wallet (Börse) – Umbuchungen nehmen den Einstand mit – Belohnungen mit Anschaffungskosten 0 – Neubestand ohne Gebühren (nicht abzugsfähig) – Zinsen aus Lending zum Wert beim Zufluss (Einkünfte zu 27,5 Prozent)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυστρία: κινητός μέσος όρος ανά νόμισμα και πορτοφόλι (ανταλλακτήριο) – οι μεταφορές μεταξύ πορτοφολιών μεταφέρουν το κόστος κτήσης – ανταμοιβές με κόστος κτήσης 0 – νέο απόθεμα χωρίς χρεώσεις (μη εκπιπτόμενες) – τόκοι από lending στην αξία κατά την παραλαβή (εισόδημα με 27,5 τοις εκατό)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Austria: moving average per coin and wallet (exchange) – transfers carry the cost along – rewards at acquisition cost 0 – holdings from 1 Mar 2021 without fees (not deductible) – lending interest at value on receipt (income at 27.5 percent)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Austria: media móvil por moneda y wallet (exchange) – las transferencias entre wallets trasladan el coste de adquisición – recompensas con coste de adquisición 0 – nuevas tenencias sin comisiones (no deducibles) – intereses de lending a su valor al recibirlos (ingreso al 27,5 por ciento)."
          }
        },
        "fa" : {
