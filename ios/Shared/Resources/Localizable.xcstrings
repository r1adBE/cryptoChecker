    "storage_recovery_restored_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتح مفتاح سابق على هذا الجهاز البيانات المُنحّاة مجددًا، فعادت. أما ما حُفظ في هذه الأثناء فبقي دون تغيير إلى جانبها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dřívější klíč tohoto zařízení odložená data znovu otevřel, takže jsou zpět. Co se mezitím uložilo, zůstalo beze změny vedle nich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere nøgle på denne enhed åbnede de lagte data til side igen, så de er tilbage. Det, der blev gemt i mellemtiden, ligger uændret ved siden af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein früherer Schlüssel dieses Geräts hat die beiseitegelegten Daten wieder geöffnet – sie sind zurück. Was inzwischen gespeichert wurde, liegt unverändert daneben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα προηγούμενο κλειδί αυτής της συσκευής άνοιξε ξανά τα δεδομένα που είχαν παραμεριστεί, οπότε επέστρεψαν. Ό,τι αποθηκεύτηκε στο μεταξύ παραμένει αμετάβλητο δίπλα τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earlier key on this device opened the set-aside data again, so it is back. Data saved in the meantime was kept unchanged next to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clave anterior de este dispositivo volvió a abrir los datos apartados, así que han vuelto. Lo guardado mientras tanto se conservó sin cambios al lado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک کلید قبلی این دستگاه داده‌های کنارگذاشته را دوباره باز کرد و آن‌ها برگشتند. آنچه در این فاصله ذخیره شد، بدون تغییر در کنارشان مانده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen aiempi avain avasi syrjään siirretyt tiedot uudelleen, joten ne ovat palanneet. Välillä tallennetut tiedot säilyivät muuttumattomina niiden vieressä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé antérieure de cet appareil a de nouveau ouvert les données mises de côté : elles sont de retour. Ce qui a été enregistré entre-temps est conservé tel quel à côté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתח קודם במכשיר הזה פתח שוב את הנתונים שהוצאו הצידה, והם חזרו. מה שנשמר בינתיים נשמר ללא שינוי לצידם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस की एक पुरानी कुंजी ने अलग रखा गया डेटा फिर से खोल दिया, इसलिए वह वापस आ गया है। इस बीच सहेजा गया डेटा बिना बदलाव के उसके पास रखा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszköz egy korábbi kulcsa ismét megnyitotta a félretett adatokat, így visszakerültek. A közben mentett adatok változatlanul mellettük maradtak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci sebelumnya di perangkat ini membuka lagi data yang disisihkan, jadi data itu kembali. Data yang disimpan sementara itu tetap utuh di sampingnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave precedente di questo dispositivo ha riaperto i dati messi da parte, che sono tornati. Quanto salvato nel frattempo è stato conservato invariato accanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の以前の鍵で、退避していたデータを再び開けたため、データが戻りました。その間に保存されたデータはそのまま横に残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 이전 키로 따로 보관했던 데이터를 다시 열 수 있어 데이터가 돌아왔습니다. 그사이 저장된 데이터는 그대로 옆에 보관됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere nøkkel på denne enheten åpnet de tilsidesatte dataene igjen, så de er tilbake. Det som ble lagret i mellomtiden, ligger uendret ved siden av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eerdere sleutel op dit apparaat opende de apart gezette gegevens weer, dus ze zijn terug. Wat in de tussentijd is opgeslagen, staat ongewijzigd ernaast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wcześniejszy klucz tego urządzenia ponownie otworzył odłożone dane, więc wróciły. To, co zapisano w międzyczasie, pozostało bez zmian obok."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave anterior deste dispositivo voltou a abrir os dados postos de parte, por isso estão de volta. O que foi guardado entretanto ficou inalterado ao lado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave anterior deste aparelho abriu de novo os dados deixados de lado, então eles voltaram. O que foi salvo nesse meio-tempo ficou inalterado ao lado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cheie anterioară a acestui dispozitiv a deschis din nou datele puse deoparte, așa că au revenit. Ce s-a salvat între timp a rămas neschimbat alături."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежний ключ этого устройства снова открыл отложенные данные, и они вернулись. Сохранённое за это время осталось без изменений рядом."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një çelës i mëparshëm i kësaj pajisjeje i hapi sërish të dhënat e lëna mënjanë, ndaj ato u kthyen. Ato që u ruajtën ndërkohë mbetën të pandryshuara pranë tyre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidigare nyckel på den här enheten öppnade de undanlagda uppgifterna igen, så de är tillbaka. Det som sparats under tiden ligger kvar oförändrat bredvid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์เดิมของอุปกรณ์นี้เปิดข้อมูลที่แยกเก็บไว้ได้อีกครั้ง ข้อมูลจึงกลับมาแล้ว ส่วนข้อมูลที่บันทึกระหว่างนั้นยังเก็บไว้ข้าง ๆ โดยไม่เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdaki önceki bir anahtar kenara ayrılan verileri yeniden açtı, böylece veriler geri geldi. Bu arada kaydedilenler değişmeden yanında duruyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередній ключ цього пристрою знову відкрив відкладені дані, тож вони повернулися. Збережене за цей час залишилося без змін поруч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khóa trước đây trên thiết bị này đã mở lại dữ liệu được để riêng, nên dữ liệu đã trở lại. Những gì lưu trong lúc đó vẫn được giữ nguyên bên cạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本设备之前的一个密钥重新打开了被搁置的数据，数据已恢复。在此期间保存的数据原样保留在旁边。"
          }
        }
      }
    },
