    "tax_template_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاسترشاد فقط: يحدد الطريقة والسنة الضريبية وملخص ورقة العمل. تبقى بطاقة المحفظة محايدة – قد تختلف الهدايا ورسوم التحويل عن ورقة العمل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen orientačně: určuje metodu / zdaňovací období a přehled pracovního podkladu. Karta Portfolio zůstává neutrální – dary a poplatky za převody se mohou od pracovního podkladu lišit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun vejledende: bestemmer metode / skatteår og oversigt i arbejdspapiret. Porteføljekortet forbliver neutralt – gaver og overførselsgebyrer kan afvige fra arbejdspapiret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Orientierung: bestimmt Methode / Steuerjahr und Übersicht der Arbeitsunterlage. Die Portfolio-Karte bleibt neutral – Schenkungen und Umbuchungsgebühren können von der Arbeitsunterlage abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο ενδεικτικά: ορίζει μέθοδο / φορολογικό έτος και σύνοψη του εγγράφου εργασίας. Η κάρτα Χαρτοφυλακίου μένει ουδέτερη – δωρεές και τέλη μεταφοράς μπορεί να διαφέρουν από το έγγραφο εργασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For guidance only: sets the method, tax year and summary of the tax worksheet. The Portfolio card stays neutral – gifts and transfer fees can differ from the worksheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo orientativo: define el método / el ejercicio fiscal y el resumen del documento de trabajo. La tarjeta de Cartera sigue siendo neutral: las donaciones y las comisiones de traspaso pueden diferir del documento de trabajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط برای راهنمایی: روش، سال مالیاتی و خلاصهٔ برگهٔ کاری را تعیین می‌کند. کارت پرتفوی بی‌طرف می‌ماند – هدیه‌ها و کارمزدهای انتقال ممکن است با برگهٔ کاری فرق داشته باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain suuntaa antava: määrittää menetelmän / verovuoden ja työpaperin koosteen. Salkku-kortti pysyy neutraalina – lahjat ja siirtokulut voivat poiketa työpaperista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À titre indicatif uniquement : définit la méthode / l’année fiscale et le récapitulatif du document de travail. La carte Portefeuille reste neutre – dons et frais de transfert peuvent différer du document de travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתמצאות בלבד: קובע שיטה / שנת מס וסיכום של מסמך העבודה. הכרטיס בתיק ההשקעות נשאר ניטרלי – מתנות ועמלות העברה עשויות להיות שונות ממסמך העבודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ मार्गदर्शन के लिए: कार्य-पत्र की पद्धति / कर वर्ष और सारांश तय करता है। पोर्टफ़ोलियो कार्ड तटस्थ रहता है – उपहार और ट्रांसफ़र शुल्क कार्य-पत्र से अलग हो सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak tájékoztató: meghatározza a módszert / az adóévet és a munkaanyag összesítőjét. A Portfólió kártya semleges marad – az ajándékok és az átvezetési díjak eltérhetnek a munkaanyagtól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya orientasi: menentukan metode / tahun pajak / dan ringkasan kertas kerja. Kartu Portofolio tetap netral – hadiah dan biaya transfer bisa berbeda dari kertas kerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo orientativo: imposta metodo / anno fiscale e riepilogo del documento di lavoro. La scheda Portafoglio resta neutra – donazioni e commissioni di trasferimento possono differire dal documento di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目安のみ：作業資料の方法・課税年度・サマリーを決めます。ポートフォリオのカードは中立のままです。贈与や振替手数料は作業資料と異なることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고용: 작업 자료의 방식 / 과세 연도 / 요약을 정합니다. 포트폴리오 카드는 중립을 유지합니다. 증여와 이체 수수료는 작업 자료와 다를 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare veiledende: bestemmer metode / skatteår og oversikt i arbeidsdokumentet. Porteføljekortet forblir nøytralt – gaver og overføringsgebyrer kan avvike fra arbeidsdokumentet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen ter oriëntatie: bepaalt methode / belastingjaar en overzicht van het werkdocument. De Portfolio-kaart blijft neutraal – schenkingen en overboekingskosten kunnen afwijken van het werkdocument."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko orientacyjnie: określa metodę / rok podatkowy i podsumowanie dokumentu roboczego. Karta Portfel pozostaje neutralna – darowizny i opłaty za przeniesienia mogą różnić się od dokumentu roboczego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas orientativo: define o método / o ano fiscal e o resumo do documento de trabalho. O cartão Portfólio mantém-se neutro – doações e taxas de transferência podem diferir do documento de trabalho."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas orientativo: define o método / o ano fiscal e o resumo do documento de trabalho. O cartão Portfólio continua neutro – doações e taxas de transferência podem diferir do documento de trabalho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar orientativ: stabilește metoda / anul fiscal și rezumatul documentului de lucru. Cardul Portofoliu rămâne neutru – donațiile și comisioanele de transfer pot diferi de documentul de lucru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только ориентир: задаёт метод / налоговый год и сводку рабочего документа. Карточка «Портфель» остаётся нейтральной – подарки и комиссии за переводы могут отличаться от рабочего документа."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetëm orientuese: përcakton metodën / vitin tatimor dhe përmbledhjen e dokumentit të punës. Karta e Portofolit mbetet neutrale – dhuratat dhe tarifat e transferimit mund të ndryshojnë nga dokumenti i punës."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast vägledande: bestämmer metod / beskattningsår och översikt i underlaget. Portföljkortet förblir neutralt – gåvor och överföringsavgifter kan skilja sig från underlaget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อเป็นแนวทางเท่านั้น: กำหนดวิธี ปีภาษี และสรุปของเอกสารประกอบงาน การ์ดพอร์ตโฟลิโอยังคงเป็นกลาง – ของขวัญและค่าธรรมเนียมการโอนอาจต่างจากเอกสารประกอบงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yol gösterici: çalışma belgesinin yöntemini / vergi yılını ve özetini belirler. Portföy kartı tarafsız kalır – hediyeler ve transfer ücretleri çalışma belgesinden farklı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише орієнтир: визначає метод / податковий рік і підсумок робочого документа. Картка «Портфель» лишається нейтральною – подарунки й комісії за перекази можуть відрізнятися від робочого документа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ để tham khảo: xác định phương pháp / năm tính thuế và phần tổng hợp của tài liệu làm việc. Thẻ Danh mục vẫn trung lập – quà tặng và phí chuyển có thể khác với tài liệu làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供参考：决定工作底稿的方法、纳税年度和汇总。投资组合卡片保持中性——赠与和转账手续费可能与工作底稿不同。"
          }
        }
      }
    },
