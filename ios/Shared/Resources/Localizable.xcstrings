        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tất cả cặp khỏi danh sách theo dõi? Các cảnh báo của chúng cũng sẽ bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
