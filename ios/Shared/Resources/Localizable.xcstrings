    "settings_address_server_public_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُستعلم عناوين بيتكوين وxpub الخاصة بك عندئذٍ من عُقد عامة: %1$@. وهي ترى هذه العناوين مع عنوان IP الخاص بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje bitcoinové adresy a xpub se pak budou dotazovat u veřejných uzlů: %1$@. Ty uvidí tyto adresy spolu s tvou IP adresou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine Bitcoin-adresser og xpub slås så op hos offentlige noder: %1$@. De ser adresserne sammen med din IP-adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bitcoin-Adressen und xpub werden dann bei öffentlichen Knoten abgefragt: %1$@. Diese sehen die Adressen zusammen mit deiner IP-Adresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διευθύνσεις Bitcoin και τα xpub σου θα ερωτώνται τότε σε δημόσιους κόμβους: %1$@. Αυτοί βλέπουν τις διευθύνσεις μαζί με τη διεύθυνση IP σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Bitcoin addresses and xpub keys will then be queried at public nodes: %1$@. They see these addresses together with your IP address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus direcciones Bitcoin y xpub se consultarán entonces en nodos públicos: %1$@. Estos ven las direcciones junto con tu dirección IP."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در این صورت آدرس‌های بیت‌کوین و xpub تو از گره‌های عمومی پرسیده می‌شوند: %1$@. آن‌ها این آدرس‌ها را همراه با آدرس IP تو می‌بینند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-osoitteesi ja xpubisi kysytään silloin julkisilta solmuilta: %1$@. Ne näkevät osoitteet yhdessä IP-osoitteesi kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes adresses Bitcoin et tes xpub seront alors interrogées auprès de nœuds publics : %1$@. Ceux-ci voient ces adresses avec ton adresse IP."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתובות הביטקוין וה-xpub שלכם ייבדקו אז בצמתים ציבוריים: %1$@. הם רואים את הכתובות יחד עם כתובת ה-IP שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तब तुम्हारे Bitcoin पते और xpub सार्वजनिक नोड्स पर पूछे जाएँगे: %1$@। वे इन पतों को तुम्हारे IP पते के साथ देखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bitcoin-címeidet és az xpubokat ekkor nyilvános csomópontoknál kérdezzük le: %1$@. Ezek a címeket az IP-címeddel együtt látják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat Bitcoin dan xpub milikmu lalu akan ditanyakan ke node publik: %1$@. Node tersebut melihat alamat ini bersama alamat IP-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi indirizzi Bitcoin e le xpub verranno allora interrogati su nodi pubblici: %1$@. Questi vedono gli indirizzi insieme al tuo indirizzo IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin アドレスと xpub は公開ノード（%1$@）に問い合わせるようになります。公開ノードにはこれらのアドレスと IP アドレスが見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그러면 비트코인 주소와 xpub을 공개 노드(%1$@)에 조회합니다. 공개 노드는 이 주소를 IP 주소와 함께 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin-adressene og xpub-ene dine spørres da hos offentlige noder: %1$@. De ser adressene sammen med IP-adressen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Bitcoin-adressen en xpubs worden dan bij openbare nodes opgevraagd: %1$@. Die zien deze adressen samen met je IP-adres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje adresy Bitcoin i xpub będą wtedy sprawdzane w publicznych węzłach: %1$@. Widzą one te adresy razem z twoim adresem IP."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus endereços Bitcoin e xpub passam a ser consultados em nós públicos: %1$@. Estes veem os endereços juntamente com o teu endereço IP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus endereços Bitcoin e xpub passarão a ser consultados em nós públicos: %1$@. Eles veem esses endereços junto com seu endereço IP."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresele tale Bitcoin și xpub vor fi atunci interogate la noduri publice: %1$@. Acestea văd adresele împreună cu adresa ta IP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда твои адреса Bitcoin и xpub будут запрашиваться у публичных узлов: %1$@. Они видят эти адреса вместе с твоим IP-адресом."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresat e tua Bitcoin dhe xpub do të pyeten atëherë te nyjet publike: %1$@. Ato i shohin adresat bashkë me adresën tënde IP."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina Bitcoin-adresser och xpub frågas då hos offentliga noder: %1$@. De ser adresserna tillsammans med din IP-adress."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากนั้นที่อยู่ Bitcoin และ xpub ของคุณจะถูกสอบถามที่โหนดสาธารณะ: %1$@ โหนดเหล่านี้จะเห็นที่อยู่พร้อมกับที่อยู่ IP ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin adreslerin ve xpub’ların bundan sonra herkese açık düğümlerde sorgulanır: %1$@. Bu düğümler adresleri IP adresinle birlikte görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоді твої адреси Bitcoin і xpub запитуватимуться в публічних вузлів: %1$@. Вони бачать ці адреси разом із твоєю IP-адресою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đó địa chỉ Bitcoin và xpub của bạn sẽ được truy vấn ở nút công khai: %1$@. Các nút này thấy các địa chỉ cùng với địa chỉ IP của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后你的比特币地址和 xpub 将向公共节点查询：%1$@。这些节点会看到这些地址以及你的 IP 地址。"
          }
        }
      }
    },
