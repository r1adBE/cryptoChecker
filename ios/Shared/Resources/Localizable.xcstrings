    "settings_rolling_futures_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: تُعلَّم العقود الآجلة ذات الاستحقاق غير الموجودة في قائمة المنصة على أنها لم تعد متداولة بدلًا من فحصها واحدًا تلو الآخر. يوفّر الوقت في كل تحديث."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto: termínované futures, které chybí v seznamu burzy, se označí jako již neobchodované, místo aby se kontrolovaly jednotlivě. Šetří čas při každém obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra: futures med udløb, der mangler på børsens liste, markeres som ”handles ikke længere” i stedet for at blive tjekket én ad gangen. Sparer tid ved hver opdatering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Laufzeit-Futures, die in der Liste der Börse fehlen, werden als «nicht mehr gehandelt» markiert statt einzeln geprüft. Spart bei jeder Aktualisierung Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό: τα futures με λήξη που λείπουν από τη λίστα του ανταλλακτηρίου επισημαίνονται ως εκτός διαπραγμάτευσης αντί να ελέγχονται ένα-ένα. Εξοικονομεί χρόνο σε κάθε ανανέωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: dated futures missing from the exchange list are marked as no longer traded instead of being checked one by one. Saves time on every refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: los futuros con vencimiento que faltan en la lista del exchange se marcan como «ya no se negocian» en lugar de comprobarse uno a uno. Ahorra tiempo en cada actualización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموش: فیوچرز سررسیددار که در فهرست صرافی نیستند به‌جای بررسی تک‌به‌تک، به‌عنوان «دیگر معامله نمی‌شود» علامت می‌خورند. در هر تازه‌سازی زمان صرفه‌جویی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois: pörssin listalta puuttuvat määräaikaiset futuurit merkitään poistuneiksi kaupankäynnistä sen sijaan, että ne tarkistettaisiin yksitellen. Nopeuttaa jokaista päivitystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les futures à échéance absents de la liste de la plateforme sont marqués comme « n'est plus négocié » au lieu d'être vérifiés un par un. Fait gagner du temps à chaque actualisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי: חוזים עתידיים מתוארכים שחסרים ברשימת הבורסה יסומנו כלא נסחרים עוד במקום להיבדק אחד־אחד. חוסך זמן בכל רענון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: एक्सचेंज की सूची में न मिलने वाले एक्सपायरी फ़्यूचर्स को एक-एक करके जाँचने के बजाय ट्रेड न होने वाले के रूप में चिह्नित किया जाता है। हर रीफ़्रेश में समय बचता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki: a tőzsde listájáról hiányzó lejáratos határidős ügyletek egyenkénti ellenőrzés helyett „már nem kereskedett” jelölést kapnak. Minden frissítésnél időt takarít meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif: futures dengan jatuh tempo yang tidak ada di daftar bursa ditandai tidak lagi diperdagangkan, alih-alih diperiksa satu per satu. Menghemat waktu setiap kali memuat ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: i futures con scadenza assenti dall'elenco dell'exchange vengono segnati come «non più negoziati» invece di essere controllati uno per uno. Fa risparmiare tempo a ogni aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ: 取引所のリストにない期日付き先物は、1件ずつ確認せずに取引終了として扱います。更新のたびに時間を節約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면: 거래소 목록에 없는 만기 선물은 하나씩 확인하지 않고 ‘거래 종료’로 표시합니다. 새로고침할 때마다 시간이 절약됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: futures med forfall som mangler i børsens liste, merkes som «handles ikke lenger» i stedet for å sjekkes én etter én. Sparer tid ved hver oppdatering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: futures met vervaldatum die niet meer in de lijst van de beurs staan, worden als niet meer verhandeld gemarkeerd in plaats van één voor één gecontroleerd. Bespaart tijd bij elke vernieuwing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wył.: kontrakty terminowe, których brak na liście giełdy, są oznaczane jako już nienotowane, zamiast być sprawdzane pojedynczo. Oszczędza to czas przy każdym odświeżeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: os futuros com vencimento ausentes da lista da exchange são marcados como «já não é negociado» em vez de serem verificados um a um. Poupa tempo em cada atualização."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: os futuros com vencimento que não estão na lista da exchange são marcados como “não é mais negociado” em vez de serem verificados um por um. Economiza tempo a cada atualização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivat: futures cu scadență care lipsesc din lista bursei sunt marcate ca netranzacționate, în loc să fie verificate pe rând. Economisește timp la fiecare actualizare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: срочные фьючерсы, которых нет в списке биржи, помечаются как неторгуемые, а не проверяются по одному. Экономит время при каждом обновлении."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joaktiv: futures me afat që mungojnë në listën e bursës shënohen si jo më të tregtuara në vend që të kontrollohen një nga një. Kursen kohë në çdo rifreskim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: terminer med förfallodag som saknas i börsens lista markeras som ”handlas inte längre” i stället för att kontrolleras en och en. Sparar tid vid varje uppdatering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด: ฟิวเจอร์สที่มีวันหมดอายุซึ่งไม่อยู่ในรายการของกระดานเทรด จะถูกทำเครื่องหมายว่าไม่มีการซื้อขายแล้ว แทนการตรวจทีละรายการ ช่วยประหยัดเวลาทุกครั้งที่รีเฟรช"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: Borsa listesinde bulunmayan vade tarihli kontratlar tek tek kontrol edilmek yerine artık işlem görmüyor olarak işaretlenir. Her yenilemede zaman kazandırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено: строкові ф'ючерси, яких немає у списку біржі, позначаються як такі, що більше не торгуються, замість перевірки кожного окремо. Заощаджує час під час кожного оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt: các futures có kỳ hạn không còn trong danh sách của sàn sẽ được đánh dấu là ngừng giao dịch thay vì kiểm tra từng cái. Tiết kiệm thời gian mỗi lần làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时：交易所列表中缺失的交割合约将被标记为已停止交易，而不是逐个检查。每次刷新都能节省时间。"
          }
        }
      }
    },
