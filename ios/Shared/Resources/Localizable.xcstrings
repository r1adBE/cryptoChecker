    "alarm_log_empty_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الإدخالات هنا عندما ينطلق تنبيه أو يُوقف – مثلًا بسبب سعر قديم أو خلال ساعات الصمت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy se tu objeví, jakmile se alarm spustí nebo bude pozdržen – třeba kvůli zastaralému kurzu nebo nočnímu klidu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her vises poster, så snart en alarm udløses eller holdes tilbage – fx på grund af en forældet kurs eller nattero."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge erscheinen hier, sobald ein Alarm auslöst oder zurückgehalten wird – etwa wegen eines veralteten Kurses oder der Nachtruhe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εγγραφές εμφανίζονται εδώ μόλις ένας συναγερμός ενεργοποιηθεί ή κρατηθεί – π.χ. λόγω παλιάς τιμής ή κατά τις ώρες ησυχίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries appear here when an alert fires or is held back – for example because the price is stale or during quiet hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas aparecen aquí cuando una alarma salta o se retiene, por ejemplo por un precio desactualizado o durante las horas de silencio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی هشداری فعال شود یا نگه داشته شود، موارد اینجا نمایش داده می‌شوند – مثلاً به‌خاطر قیمت قدیمی یا در ساعات بی‌صدا."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkinnät näkyvät tässä, kun hälytys laukeaa tai pidätetään – esimerkiksi vanhentuneen hinnan tai hiljaisten tuntien vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées apparaissent ici dès qu'une alerte se déclenche ou est retenue – par exemple à cause d'un cours obsolète ou pendant les heures calmes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשומות יופיעו כאן כשהתראה מופעלת או מעוכבת – למשל בגלל מחיר לא עדכני או בשעות דממה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई अलार्म बजता है या रोका जाता है, तब प्रविष्टियाँ यहाँ दिखती हैं – जैसे पुरानी कीमत के कारण या मौन घंटों में।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejegyzések itt jelennek meg, amint egy riasztás jelez vagy vissza lesz tartva – például elavult árfolyam miatt vagy csendes órákban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entri muncul di sini saat alarm berbunyi atau ditahan – misalnya karena harga usang atau saat jam tenang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci compaiono qui quando un allarme scatta o viene trattenuto – per esempio per un prezzo non aggiornato o durante le ore di silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームが鳴ったり保留されたりすると、ここに記録されます（例：価格が古い、おやすみ時間中など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경보가 울리거나 보류되면 여기에 기록됩니다. 예: 가격이 오래되었거나 조용한 시간인 경우."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppføringer vises her så snart en alarm utløses eller holdes tilbake – for eksempel på grunn av en utdatert kurs eller i nattro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items verschijnen hier zodra een alarm afgaat of wordt tegengehouden – bijvoorbeeld door een verouderde koers of tijdens stille uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisy pojawiają się tutaj, gdy alarm zadziała lub zostanie wstrzymany – np. z powodu nieaktualnego kursu albo w godzinach ciszy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As entradas aparecem aqui quando um alarme dispara ou é retido – por exemplo, por causa de um preço desatualizado ou durante as horas de silêncio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As entradas aparecem aqui quando um alarme dispara ou é segurado – por exemplo, por um preço desatualizado ou no horário de silêncio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intrările apar aici când o alarmă se declanșează sau este reținută – de exemplu din cauza unui preț învechit sau în orele de liniște."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи появятся здесь, когда оповещение сработает или будет задержано – например, из-за устаревшей цены или в тихие часы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regjistrimet shfaqen këtu sapo një alarm aktivizohet ose mbahet – për shembull për shkak të një çmimi të vjetruar ose gjatë orëve të heshtjes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster visas här så snart ett larm utlöses eller hålls tillbaka – till exempel på grund av en inaktuell kurs eller under tysta timmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการจะแสดงที่นี่เมื่อสัญญาณเตือนทำงานหรือถูกระงับ เช่น เพราะราคาไม่เป็นปัจจุบันหรือในช่วงเวลาเงียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir alarm çaldığında veya bekletildiğinde kayıtlar burada görünür – örneğin eski bir fiyat yüzünden ya da sessiz saatlerde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи з’являться тут, коли сигнал спрацює або буде затриманий – наприклад, через застарілу ціну чи в тихі години."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục sẽ hiện ở đây khi cảnh báo kích hoạt hoặc bị giữ lại – ví dụ do giá đã cũ hoặc trong giờ yên lặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当提醒触发或被暂缓时（例如价格过时或处于静音时段），记录会显示在这里。"
          }
        }
      }
    },
