    "portfolio_fifo_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: تستخدم المبيعات أقدم عملاتك أولًا. المتوسط = تكلفة الشراء المتبقية ÷ الكمية ذات سعر الشراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: prodeje berou nejdřív tvé nejstarší mince. Prům. = zbývající pořizovací cena ÷ množství s nákupní cenou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: salg bruger dine ældste coins først. Gns. = resterende anskaffelsespris ÷ mængde med købspris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: Verkäufe nehmen die ältesten Coins zuerst. Ø = verbleibender Einstand ÷ Menge mit Kaufpreis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: οι πωλήσεις χρησιμοποιούν πρώτα τα παλαιότερα νομίσματά σου. Μ.Ο. = υπόλοιπο κόστος κτήσης ÷ ποσότητα με τιμή αγοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: sells use your oldest coins first. Avg. = remaining cost basis ÷ amount with purchase price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: las ventas usan primero tus monedas más antiguas. Media = coste de adquisición restante ÷ cantidad con precio de compra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: فروش‌ها اول از قدیمی‌ترین سکه‌هایت کم می‌شوند. میانگین = بهای تمام‌شدهٔ باقی‌مانده ÷ مقدار دارای قیمت خرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: myynnit käyttävät ensin vanhimmat kolikkosi. Ka. = jäljellä oleva hankintahinta ÷ ostohinnallinen määrä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO : les ventes utilisent d’abord tes coins les plus anciens. Moy. = coût de revient restant ÷ quantité avec prix d’achat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: מכירות משתמשות קודם במטבעות הוותיקים שלך. ממוצע = עלות הרכישה הנותרת ÷ הכמות עם מחיר קנייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: बिक्री में पहले तुम्हारे सबसे पुराने कॉइन इस्तेमाल होते हैं। औसत = बची लागत ÷ खरीद भाव वाली मात्रा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: az eladások először a legrégebbi coinjaidat használják. Átl. = fennmaradó bekerülési érték ÷ vételi áras mennyiség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: penjualan memakai koin tertuamu lebih dulu. Rata-rata = sisa biaya perolehan ÷ jumlah dengan harga beli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: le vendite usano prima le monete più vecchie. Media = costo di carico residuo ÷ quantità con prezzo d’acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO：売却では古いコインから先に使います。平均 = 残りの取得原価 ÷ 購入価格のある数量。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: 매도 시 가장 오래된 코인부터 사용합니다. 평균 = 남은 매입 원가 ÷ 매수가가 있는 수량."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: salg bruker de eldste coinene dine først. Snitt = gjenværende inngangsverdi ÷ mengde med kjøpspris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: verkopen gebruiken eerst je oudste munten. Gem. = resterende kostprijs ÷ hoeveelheid met aankoopprijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: sprzedaż najpierw zużywa najstarsze monety. Śr. = pozostały koszt nabycia ÷ ilość z ceną zakupu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: as vendas usam primeiro as moedas mais antigas. Média = custo de aquisição restante ÷ quantidade com preço de compra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: as vendas usam primeiro suas moedas mais antigas. Média = custo de aquisição restante ÷ quantidade com preço de compra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: vânzările folosesc mai întâi cele mai vechi monede. Medie = cost de achiziție rămas ÷ cantitate cu preț de cumpărare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: при продаже сначала списываются самые старые монеты. Ср. = оставшаяся стоимость покупки ÷ количество с ценой покупки."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: shitjet përdorin së pari monedhat më të vjetra. Mesat. = kostoja e mbetur e blerjes ÷ sasia me çmim blerjeje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: försäljningar använder dina äldsta mynt först. Snitt = återstående anskaffningsvärde ÷ mängd med köppris."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: การขายจะใช้เหรียญที่เก่าที่สุดก่อน เฉลี่ย = ต้นทุนคงเหลือ ÷ จำนวนที่มีราคาซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: satışlar önce en eski coin'lerini kullanır. Ort. = kalan maliyet ÷ alış fiyatlı miktar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: під час продажу спершу списуються найстаріші монети. Сер. = залишкова вартість купівлі ÷ кількість із ціною купівлі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO: lệnh bán dùng coin cũ nhất của bạn trước. TB = giá vốn còn lại ÷ số lượng có giá mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIFO：卖出时先用最早的币。平均 = 剩余成本 ÷ 有买入价的数量。"
          }
        }
      }
    },
