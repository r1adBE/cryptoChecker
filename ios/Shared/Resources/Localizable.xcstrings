    "watchlist_favorites_empty_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مفضلة بعد. اسحب زوجًا إلى اليمين أو افتحه واضغط «المفضلة»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádné oblíbené. Přejeď pár doprava, nebo ho otevři a klepni na „Oblíbené“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen favoritter endnu. Stryg et par til højre, eller åbn det og tryk på ”Favorit”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Favoriten. Ein Paar nach rechts wischen oder das Paar öffnen und auf «Favorit» tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη αγαπημένα. Σύρε ένα ζεύγος προς τα δεξιά ή άνοιξέ το και πάτα «Αγαπημένο»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No favorites yet. Swipe a pair to the right, or open the pair and tap “Favorite”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay favoritos. Desliza un par hacia la derecha, o ábrelo y toca «Favorito»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز علاقه‌مندی‌ای نیست. یک جفت را به راست بکش یا آن را باز کن و «علاقه‌مندی» را بزن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä suosikkeja. Pyyhkäise pari oikealle tai napauta parin näkymässä ”Suosikki”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de favoris. Balaie une paire vers la droite, ou ouvre-la et touche « Favori »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין מועדפים. החליקו צמד ימינה, או פתחו אותו והקישו ״מועדף״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई पसंदीदा नहीं। किसी जोड़ी को दाईं ओर स्वाइप करो या उसे खोलकर “पसंदीदा” टैप करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincsenek kedvencek. Húzz egy párt jobbra, vagy nyisd meg, és koppints a „Kedvenc” gombra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada favorit. Geser pasangan ke kanan atau ketuk “Favorit” di halaman pasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun preferito. Scorri una coppia verso destra, oppure aprila e tocca «Preferito»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りはまだありません。ペアを右にスワイプするか、ペアを開いて「お気に入り」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 즐겨찾기가 없습니다. 페어를 오른쪽으로 밀거나 페어를 열고 ‘즐겨찾기’를 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen favoritter ennå. Sveip et par til høyre, eller åpne det og trykk på «Favoritt»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen favorieten. Veeg een paar naar rechts, of open het en tik op ‘Favoriet’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak ulubionych. Przesuń parę w prawo albo otwórz ją i dotknij „Ulubione”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há favoritos. Desliza um par para a direita, ou abre-o e toca em «Favorito»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há favoritos. Deslize um par para a direita, ou abra-o e toque em “Favorito”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă nu ai favorite. Glisează o pereche spre dreapta sau deschide-o și atinge „Favorit”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока нет избранного. Смахни пару вправо или нажми «Избранное» в карточке пары."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende pa të preferuara. Rrëshqit një çift djathtas ose hape dhe prek «I preferuar»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga favoriter än. Svep ett par åt höger eller öppna det och tryck på ”Favorit”."
