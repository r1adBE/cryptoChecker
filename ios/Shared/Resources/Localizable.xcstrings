        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay desglose: esta versión no ha completado ninguna actualización completa. Toca Actualizar y espera a que el indicador se detenga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز جزئیاتی نیست: این نسخه هنوز یک تازه‌سازی کامل انجام نداده است. روی تازه‌سازی بزنید و صبر کنید تا نشانگر چرخان متوقف شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
