        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien opera %1$@ ve todas las direcciones consultadas de esta wallet y puede vincularlas entre sí y con tu dirección IP."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کس %1$@ را اداره می‌کند، همهٔ آدرس‌های پرسیده‌شدهٔ این کیف پول را می‌بیند و می‌تواند آن‌ها را به هم و به آدرس IP تو ربط دهد."
