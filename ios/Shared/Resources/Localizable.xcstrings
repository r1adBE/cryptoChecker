    "settings_quiet_hours_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل التنبيهات بصمت بين %1$@ و %2$@: بلا صوت أو اهتزاز أو نطق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezi %1$@ a %2$@ přicházejí alarmy potichu: bez zvuku, vibrací a hlasového hlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellem %1$@ og %2$@ kommer alarmer lydløst: uden lyd, vibration eller oplæsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen %1$@ und %2$@ kommen Alarme lautlos: ohne Ton, Vibration und Sprachausgabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταξύ %1$@ και %2$@ οι ειδοποιήσεις τιμής έρχονται αθόρυβα: χωρίς ήχο, δόνηση ή εκφώνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarms arrive silently between %1$@ and %2$@: no sound, vibration or speech."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ y %2$@ las alarmas llegan en silencio: sin sonido, vibración ni voz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بین %1$@ و %2$@ هشدارها بی‌صدا می‌رسند: بدون صدا، لرزش یا گفتار."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikavälillä %1$@–%2$@ hälytykset tulevat äänettömästi: ilman ääntä, värinää tai puhetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ et %2$@, les alertes arrivent en silence : sans son, vibration ni voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בין %1$@ ל־%2$@ התראות מגיעות בשקט: בלי צליל, רטט או הקראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से %2$@ के बीच अलार्म चुपचाप आते हैं: न आवाज़, न वाइब्रेशन, न बोलकर सूचना।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ és %2$@ között a riasztások némán érkeznek: hang, rezgés és felolvasás nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antara %1$@ dan %2$@ alarm datang tanpa suara: tanpa bunyi, getar, atau ucapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra %1$@ e %2$@ gli allarmi arrivano in silenzio: niente suono, vibrazione o voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@～%2$@ はアラームが無音で届きます（音・バイブレーション・読み上げなし）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@~%2$@에는 경보가 소리 없이 도착합니다. 소리, 진동, 음성 안내가 모두 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellom %1$@ og %2$@ kommer alarmer lydløst: uten lyd, vibrering eller opplesning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tussen %1$@ en %2$@ komen alarmen geluidloos binnen: zonder geluid, trillen of spraak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Między %1$@ a %2$@ alarmy są wyciszone: bez dźwięku, wibracji i komunikatów głosowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ e %2$@, os alarmes chegam em silêncio: sem som, vibração ou voz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ e %2$@, os alarmes chegam em silêncio: sem som, vibração ou voz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Între %1$@ și %2$@ alarmele sosesc în liniște: fără sunet, vibrații sau voce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С %1$@ до %2$@ оповещения приходят беззвучно: без звука, вибрации и озвучивания."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midis %1$@ dhe %2$@ alarmet vijnë në heshtje: pa tingull, dridhje apo zë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellan %1$@ och %2$@ kommer larm ljudlöst: utan ljud, vibration eller uppläsning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่าง %1$@ ถึง %2$@ สัญญาณเตือนจะมาแบบเงียบ: ไม่มีเสียง ไม่สั่น และไม่อ่านออกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ile %2$@ arasında alarmlar sessiz gelir: ses, titreşim ve sesli okuma olmadan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З %1$@ до %2$@ сигнали надходять беззвучно: без звуку, вібрації та озвучення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ %1$@ đến %2$@, cảnh báo đến trong im lặng: không âm thanh, rung hay giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 至 %2$@ 之间，提醒将静音送达：无声音、无振动、无语音。"
          }
        }
      }
    },
