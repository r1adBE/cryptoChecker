    "about_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker مشروع مستقل من Rich1e: نظرة هادئة على الأسعار دون حساب أو إعلانات أو تتبع. للأسئلة والاقتراحات: %1$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker je nezávislý projekt od Rich1e: klidný přehled kurzů bez účtu, reklam a sledování. Dotazy a přání: %1$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker er et uafhængigt projekt af Rich1e: et roligt kursoverblik uden konto, reklamer eller sporing. Spørgsmål og ønsker: %1$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker ist ein unabhängiges Projekt von Rich1e: eine ruhige Kursübersicht ohne Konto, Werbung und Tracking. Fragen und Wünsche: %1$@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Crypto Checker είναι ένα ανεξάρτητο έργο του Rich1e: μια ήρεμη επισκόπηση τιμών χωρίς λογαριασμό, διαφημίσεις ή παρακολούθηση. Ερωτήσεις και προτάσεις: %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker is an independent project by Rich1e: a calm price overview without account, ads or tracking. Questions and wishes: %1$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker es un proyecto independiente de Rich1e: una vista tranquila de precios sin cuenta, anuncios ni rastreo. Preguntas y sugerencias: %1$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker یک پروژه مستقل از Rich1e است: نمایی آرام از قیمت‌ها بدون حساب، تبلیغات یا ردیابی. پرسش‌ها و پیشنهادها: %1$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker on Rich1en itsenäinen projekti: rauhallinen kurssinäkymä ilman tiliä, mainoksia tai seurantaa. Kysymykset ja toiveet: %1$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker est un projet indépendant de Rich1e : un aperçu calme des cours, sans compte, ni publicité, ni pistage. Questions et suggestions : %1$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker הוא פרויקט עצמאי של Rich1e: סקירת שערים רגועה בלי חשבון, פרסומות או מעקב. שאלות ובקשות: %1$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker, Rich1e का एक स्वतंत्र प्रोजेक्ट है: बिना खाते, विज्ञापन या ट्रैकिंग के भावों का शांत ओवरव्यू। सवाल और सुझाव: %1$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Crypto Checker Rich1e független projektje: nyugodt árfolyam-áttekintés fiók, reklám és követés nélkül. Kérdések és kívánságok: %1$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crypto Checker adalah proyek independen dari Rich1e: ringkasan harga yang tenang tanpa akun, iklan, atau pelacakan. Pertanyaan dan saran: %1$@"
