          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפליקציה סגורה, iOS מחליט מתי לבדוק (התראות, ווידג׳טים), לפעמים בהפרש של שעות. פתוחה: בכל פתיחה."
