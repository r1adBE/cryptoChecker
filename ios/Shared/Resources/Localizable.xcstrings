    "watchlist_clear_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة كل الأزواج من قائمة المتابعة؟ ستُحذف تنبيهاتها أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat všechny páry ze sledovaných? Odstraní se i jejich alarmy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern alle par fra overvågningslisten? Deres alarmer forsvinder også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Paare aus der Merkliste entfernen? Die Alarme der Paare werden ebenfalls gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να αφαιρεθούν όλα τα ζεύγη από τη λίστα παρακολούθησης; Θα διαγραφούν και οι συναγερμοί τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove all pairs from the watchlist? Their alerts go with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar todos los pares de la lista de seguimiento? Sus alarmas también se eliminarán."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه جفت‌ها از واچ‌لیست حذف شوند؟ هشدارهایشان نیز حذف می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko kaikki parit seurantalistalta? Myös niiden hälytykset poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer toutes les paires de la liste de suivi ? Leurs alertes seront aussi supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסיר את כל הצמדים מרשימת המעקב? גם ההתראות שלהם יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉचलिस्ट से सभी पेयर हटाओ? उनके अलार्म भी हट जाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítod az összes párt a figyelőlistáról? A riasztásaik is törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua pasangan dari daftar pantau? Alarmnya juga akan ikut terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere tutte le coppie dalla lista di osservazione? Verranno eliminati anche i loro allarmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリストからすべてのペアを削除しますか？各ペアのアラームも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 목록에서 모든 거래쌍을 삭제할까요? 해당 경보도 함께 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerne alle par fra overvåkingslisten? Alarmene deres forsvinner også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle paren uit de volglijst verwijderen? Hun alarmen worden ook verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć wszystkie pary z listy obserwowanych? Ich alarmy również zostaną usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover todos os pares da lista de acompanhamento? Os respetivos alarmes também serão removidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover todos os pares da lista de acompanhamento? Os alarmes deles também serão removidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimini toate perechile din lista de urmărire? Alarmele lor vor fi șterse și ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить все пары из списка? Их оповещения тоже будут удалены."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të hiqen të gjitha çiftet nga lista e ndjekjes? Bashkë me to hiqen edhe alarmet e tyre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort alla par från bevakningslistan? Deras larm tas också bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบคู่ทั้งหมดออกจากรายการติดตามไหม? สัญญาณเตือนของคู่เหล่านั้นจะถูกลบด้วย"
