    "about_license" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الأسعار مباشرة من المنصات؛ بلا حساب وبلا تتبّع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny přicházejí přímo z burz; žádný účet a žádné sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurserne kommer direkte fra børserne; ingen konto og ingen sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kurse kommen direkt von den Börsen, ohne Konto und ohne Tracking."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές έρχονται απευθείας από τα ανταλλακτήρια· χωρίς λογαριασμό και χωρίς παρακολούθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices come straight from the exchanges; no account and no tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los precios vienen directamente de los exchanges; sin cuenta y sin rastreo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌ها مستقیماً از صرافی‌ها می‌آیند؛ بدون حساب کاربری و بدون ردیابی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnat tulevat suoraan pörsseistä; ei tiliä eikä seurantaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prix viennent directement des plateformes ; aucun compte, aucun pistage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחירים מגיעים ישירות מהבורסות; ללא חשבון וללא מעקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमतें सीधे एक्सचेंजों से आती हैं; कोई अकाउंट नहीं और कोई ट्रैकिंग नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az árak közvetlenül a tőzsdékről érkeznek; nincs fiók és nincs követés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga langsung dari bursa; tanpa akun dan tanpa pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prezzi arrivano direttamente dagli exchange; nessun account e nessun tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格は取引所から直接取得します。アカウント不要、トラッキングなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격은 거래소에서 직접 가져오며, 계정도 추적도 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursene kommer rett fra børsene; ingen konto og ingen sporing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koersen komen rechtstreeks van de beurzen; geen account en geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny pochodzą bezpośrednio z giełd; bez konta i bez śledzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os preços vêm diretamente das exchanges; sem conta e sem rastreio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os preços vêm diretamente das exchanges; sem conta e sem rastreamento."
          }
        },
        "ro" : {
          "stringUnit" : {
