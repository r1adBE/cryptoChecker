    "settings_change_basis_hint_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد المنطقة الزمنية المختارة بداية حساب نسبة التغيّر في قائمة المتابعة وسطر النبض والزوج المفتوح والأدوات، وكذلك الأوقات المعروضة في الرسوم البيانية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolené časové pásmo určuje, odkdy se počítá procentní změna (seznam sledovaných, řádek pulzu, otevřený pár, widgety), a také časy v grafech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valgte tidszone bestemmer, hvorfra den procentvise ændring regnes (overvågningsliste, pulslinje, åbent par, widgets), og hvilke klokkeslæt graferne viser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählte Zeitzone legt fest, ab wann die Prozent-Änderung zählt (Merkliste, Puls-Zeile, geöffnetes Paar, Widgets) und in welcher Zeit die Charts beschriftet sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ζώνη ώρας που επιλέγεις ορίζει από πότε μετρά η ποσοστιαία μεταβολή (λίστα παρακολούθησης, γραμμή παλμού, ανοιχτό ζεύγος, widget) και τις ώρες στα γραφήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen time zone sets from when the percentage change counts (watchlist, pulse line, opened pair, widgets) and the times shown in the charts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zona horaria elegida fija desde cuándo cuenta la variación porcentual (lista de seguimiento, línea de pulso, par abierto, widgets) y las horas que muestran los gráficos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منطقه زمانی انتخاب‌شده تعیین می‌کند تغییر درصدی از چه زمانی حساب شود (واچ‌لیست، خط نبض، جفت بازشده، ابزارک‌ها) و ساعت‌های نمودارها در کدام منطقه نمایش داده شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittu aikavyöhyke määrää, mistä alkaen prosenttimuutos lasketaan (seurantalista, pulssirivi, parin näkymä, widgetit), ja kaavioiden kellonajat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fuseau horaire choisi fixe à partir de quand la variation en pourcentage est calculée (liste de suivi, ligne de pouls, paire ouverte, widgets) et les heures affichées dans les graphiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזור הזמן שנבחר קובע ממתי נספר השינוי באחוזים (רשימת המעקב, שורת הדופק, הצמד הפתוח, ווידג׳טים) ואת השעות שמוצגות בגרפים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना गया समय क्षेत्र तय करता है कि प्रतिशत बदलाव कब से गिना जाए (वॉचलिस्ट, पल्स लाइन, खुली जोड़ी, विजेट) और चार्ट में कौन-सा समय दिखे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A választott időzóna határozza meg, mikortól számít a százalékos változás (figyelőlista, pulzussor, a megnyitott pár, widgetek), és milyen időt mutatnak a diagramok."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona waktu yang dipilih menentukan sejak kapan perubahan persentase dihitung (daftar pantau, baris ringkasan, halaman pasangan, widget) dan waktu yang tampil di grafik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fuso orario scelto stabilisce da quando conta la variazione percentuale (lista, riga del polso, coppia aperta, widget) e gli orari mostrati nei grafici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだタイムゾーンによって、ウォッチリスト、パルス行、開いたペア、ウィジェットの変動率をいつから数えるかと、チャートに表示される時刻が決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 시간대에 따라 관심 목록, 펄스 줄, 열린 거래쌍, 위젯의 변동률을 언제부터 계산할지와 차트에 표시되는 시각이 정해집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valgte tidssonen bestemmer fra når den prosentvise endringen regnes (overvåkingsliste, pulslinje, åpnet par, widgeter), og hvilke klokkeslett grafene viser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gekozen tijdzone bepaalt vanaf wanneer de procentuele verandering telt (volglijst, pulsregel, geopend paar, widgets) en welke tijden de grafieken tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrana strefa czasowa określa, od kiedy liczy się zmiana procentowa (lista obserwowanych, linia pulsu, otwarta para, widżety), oraz godziny pokazywane na wykresach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fuso horário escolhido define a partir de quando conta a variação percentual (lista de acompanhamento, linha de pulso, par aberto, widgets) e as horas mostradas nos gráficos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fuso horário escolhido define a partir de quando a variação percentual é contada (lista de acompanhamento, linha de pulso, par aberto, widgets) e os horários mostrados nos gráficos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusul orar ales stabilește de când se calculează variația procentuală (lista de urmărire, linia de puls, perechea deschisă, widgeturi) și orele afișate în grafice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный часовой пояс определяет, с какого момента считается процентное изменение (список наблюдения, строка пульса, карточка пары, виджеты), и время на графиках."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona kohore e zgjedhur përcakton që kur llogaritet ndryshimi në përqindje (lista e ndjekjes, rreshti i pulsit, çifti i hapur, widget-et) dhe orët që shfaqin grafikët."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valda tidszonen avgör från när den procentuella förändringen räknas (bevakningslistan, pulsraden, öppnade paret, widgetarna) och vilka klockslag diagrammen visar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขตเวลาที่เลือกกำหนดว่าการเปลี่ยนแปลงเป็นเปอร์เซ็นต์เริ่มนับเมื่อใด (รายการติดตาม แถวสรุป หน้าคู่เหรียญ วิดเจ็ต) และเวลาที่แสดงบนกราฟ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen saat dilimi, yüzde değişimin ne zamandan itibaren sayılacağını (izleme listesi, nabız satırı, çift sayfası, widget’lar) ve grafiklerde gösterilen saatleri belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибраний часовий пояс визначає, з якого моменту рахується відсоткова зміна (список спостереження, рядок пульсу, картка пари, віджети), і час на графіках."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Múi giờ đã chọn quyết định thay đổi phần trăm được tính từ lúc nào (danh sách theo dõi, dòng nhịp, trang cặp, tiện ích) và giờ hiển thị trên biểu đồ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选时区决定自选列表、脉搏行、交易对页面和小部件中的百分比涨跌从何时开始计算，以及图表中显示的时间。"
          }
        }
      }
    },
    "settings_change_basis_hint_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» يقارن بالسعر قبل 24 ساعة تمامًا. «00:00» يقارن بسعر الافتتاح عند منتصف الليل في هذه المنطقة الزمنية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ porovnává s cenou přesně před 24 hodinami. „00:00“ porovnává s otevírací cenou o půlnoci v tomto časovém pásmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” sammenligner med kursen for præcis 24 timer siden. ”00:00” sammenligner med åbningskursen ved midnat i denne tidszone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» vergleicht mit dem Kurs vor genau 24 Stunden. «00:00» vergleicht mit dem Eröffnungskurs um Mitternacht in dieser Zeitzone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» συγκρίνει με την τιμή ακριβώς πριν από 24 ώρες. Το «00:00» συγκρίνει με την τιμή ανοίγματος τα μεσάνυχτα σε αυτή τη ζώνη ώρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” compares with the price exactly 24 hours ago. “00:00” compares with the opening price at midnight in that time zone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» compara con el precio de hace exactamente 24 horas. «00:00» compara con el precio de apertura a medianoche en esa zona horaria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» با قیمت دقیقاً 24 ساعت پیش مقایسه می‌کند. «00:00» با قیمت بازگشایی در نیمه‌شب همین منطقه زمانی مقایسه می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” vertaa hintaan tasan 24 tuntia sitten. ”00:00” vertaa avaushintaan keskiyöllä tällä aikavyöhykkeellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » compare avec le cours d’il y a exactement 24 heures. « 00:00 » compare avec le cours d’ouverture à minuit dans ce fuseau horaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״%1$@״ משווה למחיר לפני 24 שעות בדיוק. ״00:00״ משווה למחיר הפתיחה בחצות באזור הזמן הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ठीक 24 घंटे पहले के भाव से तुलना करता है। “00:00” इस समय क्षेत्र में आधी रात के शुरुआती भाव से तुलना करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „%1$@” a pontosan 24 órával korábbi árfolyamhoz hasonlít. A „00:00” az ebben az időzónában éjfélkor érvényes nyitóárfolyamhoz hasonlít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” membandingkan dengan harga tepat 24 jam lalu. “00:00” membandingkan dengan harga pembukaan pada tengah malam di zona waktu itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» confronta con il prezzo di esattamente 24 ore fa. «00:00» confronta con il prezzo di apertura a mezzanotte in quel fuso orario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」はちょうど24時間前の価格と比較します。「00:00」はそのタイムゾーンの午前0時の始値と比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’는 정확히 24시간 전 가격과 비교합니다. ‘00:00’은 해당 시간대 자정의 시가와 비교합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» sammenligner med kursen for nøyaktig 24 timer siden. «00:00» sammenligner med åpningskursen ved midnatt i denne tidssonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ vergelijkt met de koers van precies 24 uur geleden. ‘00:00’ vergelijkt met de openingskoers om middernacht in die tijdzone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” porównuje z ceną sprzed dokładnie 24 godzin. „00:00” porównuje z ceną otwarcia o północy w tej strefie czasowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» compara com o preço de há exatamente 24 horas. «00:00» compara com o preço de abertura à meia-noite nesse fuso horário."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” compara com o preço de exatamente 24 horas atrás. “00:00” compara com o preço de abertura à meia-noite nesse fuso horário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” compară cu prețul de acum exact 24 de ore. „00:00” compară cu prețul de deschidere de la miezul nopții în acest fus orar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» сравнивает с ценой ровно 24 часа назад. «00:00» сравнивает с ценой открытия в полночь в этом часовом поясе."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» krahason me çmimin e saktë 24 orë më parë. «00:00» krahason me çmimin e hapjes në mesnatë në këtë zonë kohore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” jämför med kursen för exakt 24 timmar sedan. ”00:00” jämför med öppningskursen vid midnatt i den tidszonen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” เทียบกับราคาเมื่อ 24 ชั่วโมงก่อนพอดี “00:00” เทียบกับราคาเปิดตอนเที่ยงคืนในเขตเวลานั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” tam 24 saat önceki fiyatla karşılaştırır. “00:00” bu saat diliminde gece yarısındaki açılış fiyatıyla karşılaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» порівнює з ціною рівно 24 години тому. «00:00» порівнює з ціною відкриття опівночі в цьому часовому поясі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” so với giá đúng 24 giờ trước. “00:00” so với giá mở cửa lúc nửa đêm theo múi giờ đó."
