        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kapalıyken iOS çoğu zaman 15 dakikadan geç kontrol eder, bazen ancak uygulamayı yeniden açtığında. Kısa sıçramalar kaçabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли застосунок закрито, iOS часто перевіряє пізніше ніж через 15 хвилин, іноді лише під час наступного відкриття. Короткі стрибки можна пропустити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đóng ứng dụng, iOS thường kiểm tra muộn hơn 15 phút, đôi khi chỉ khi bạn mở lại ứng dụng. Có thể bỏ lỡ các biến động ngắn."
