    "ios_settings_accent_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبَّق فورًا على التطبيق والأدوات والإشعارات. تتغير أيقونة التطبيق أيضًا؛ ويؤكد iOS ذلك بتنبيه قصير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí ihned pro aplikaci, widgety a oznámení. Změní se i ikona aplikace; iOS to potvrdí krátkým upozorněním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder straks for app, widgets og notifikationer. App-ikonet skifter også; iOS bekræfter det med en kort besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt sofort für App, Widgets und Benachrichtigungen. Auch das App-Icon wechselt; iOS bestätigt das mit einem kurzen Hinweis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζεται αμέσως σε εφαρμογή, widget και ειδοποιήσεις. Αλλάζει και το εικονίδιο της εφαρμογής· το iOS το επιβεβαιώνει με ένα σύντομο μήνυμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to app, widgets and notifications right away. The app icon changes too; iOS confirms that with a short notice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica de inmediato a la app, los widgets y las notificaciones. También cambia el icono de la app; iOS lo confirma con un breve aviso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلافاصله روی برنامه، ابزارک‌ها و اعلان‌ها اعمال می‌شود. نماد برنامه هم تغییر می‌کند؛ iOS این را با یک پیام کوتاه تأیید می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee sovellusta, widgetejä ja ilmoituksia heti. Myös sovelluksen kuvake vaihtuu; iOS vahvistaa sen lyhyellä ilmoituksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique immédiatement à l'app, aux widgets et aux notifications. L'icône de l'app change aussi ; iOS le confirme par un bref message."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל מיד על האפליקציה, הווידג׳טים וההתראות. גם סמל האפליקציה משתנה; iOS מאשר זאת בהודעה קצרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप, विजेट और नोटिफ़िकेशन पर तुरंत लागू होता है। ऐप आइकन भी बदलता है; iOS इसकी पुष्टि एक छोटे संदेश से करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azonnal érvényes az alkalmazásra, a widgetekre és az értesítésekre. Az alkalmazásikon is megváltozik; ezt az iOS egy rövid üzenettel jelzi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung berlaku untuk aplikasi, widget, dan notifikasi. Ikon aplikasi juga berubah; iOS mengonfirmasinya dengan pemberitahuan singkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica subito ad app, widget e notifiche. Cambia anche l'icona dell'app; iOS lo conferma con un breve avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ、ウィジェット、通知にすぐ反映されます。アプリアイコンも変わり、iOS が短いメッセージで確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱, 위젯, 알림에 바로 적용됩니다. 앱 아이콘도 바뀌며, iOS가 짧은 안내로 이를 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder umiddelbart for app, moduler og varsler. Appikonet endres også; iOS bekrefter det med en kort melding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt direct voor app, widgets en meldingen. Ook het app-icoon verandert; iOS bevestigt dat met een korte melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana od razu obejmuje aplikację, widżety i powiadomienia. Zmienia się też ikona aplikacji; iOS potwierdza to krótkim komunikatem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se de imediato à app, aos widgets e às notificações. O ícone da app também muda; o iOS confirma-o com um breve aviso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se imediatamente ao app, aos widgets e às notificações. O ícone do app também muda; o iOS confirma isso com um breve aviso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplică imediat aplicației, widgeturilor și notificărilor. Se schimbă și pictograma aplicației; iOS confirmă acest lucru printr-un scurt mesaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу применяется к приложению, виджетам и уведомлениям. Значок приложения тоже меняется; iOS подтверждает это коротким сообщением."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbatohet menjëherë për aplikacionin, widget-et dhe njoftimet. Ndryshon edhe ikona e aplikacionit; iOS e konfirmon me një njoftim të shkurtër."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller direkt för appen, widgetar och aviseringar. Appikonen byts också; iOS bekräftar det med ett kort meddelande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีผลกับแอป วิดเจ็ต และการแจ้งเตือนทันที ไอคอนแอปจะเปลี่ยนด้วย โดย iOS จะยืนยันด้วยข้อความสั้น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, widget ve bildirimlere hemen uygulanır. Uygulama simgesi de değişir; iOS bunu kısa bir uyarıyla onaylar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одразу застосовується до застосунку, віджетів і сповіщень. Значок застосунку теж зміниться; iOS підтвердить це коротким повідомленням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng ngay cho ứng dụng, widget và thông báo. Biểu tượng ứng dụng cũng thay đổi; iOS xác nhận bằng một thông báo ngắn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即应用于应用、小部件和通知。应用图标也会随之更改，iOS 会以简短提示进行确认。"
          }
        }
      }
    },
    "ios_settings_language_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
