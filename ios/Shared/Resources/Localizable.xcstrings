    "portfolio_address_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسَل العنوان العام فقط إلى %1$@ – لا مفاتيح ولا عبارات استرداد (seed) أبدًا. يراه المزوّد مع عنوان IP الخاص بك. يُفحص مرة كل 10 دقائق على الأكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ se posílá jen veřejná adresa – nikdy klíče ani seed fráze. Poskytovatel ji vidí spolu s tvou IP adresou. Kontroluje se nejvýš každých 10 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun den offentlige adresse sendes til %1$@ – aldrig nøgler eller seed-sætninger. Udbyderen ser den sammen med din IP-adresse. Tjekkes højst hvert 10. minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet wird nur die öffentliche Adresse an %1$@ – nie Schlüssel oder Seed-Wörter. Der Anbieter sieht sie zusammen mit deiner IP-Adresse. Abgefragt höchstens alle 10 Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο %1$@ στέλνεται μόνο η δημόσια διεύθυνση – ποτέ κλειδιά ή φράσεις seed. Ο πάροχος τη βλέπει μαζί με τη διεύθυνση IP σου. Έλεγχος το πολύ κάθε 10 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the public address is sent to %1$@ – never keys or seed phrases. The provider sees it together with your IP address. Checked at most every 10 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se envía la dirección pública a %1$@, nunca claves ni frases semilla. El proveedor la ve junto con tu dirección IP. Se consulta como máximo cada 10 minutos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط آدرس عمومی به %1$@ فرستاده می‌شود – هرگز کلید یا عبارت بازیابی (seed). ارائه‌دهنده آن را همراه با آدرس IP تو می‌بیند. حداکثر هر 10 دقیقه یک بار بررسی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palveluun %1$@ lähetetään vain julkinen osoite – ei koskaan avaimia tai siemenlauseita. Palveluntarjoaja näkee sen yhdessä IP-osoitteesi kanssa. Tarkistetaan enintään 10 minuutin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule l’adresse publique est envoyée à %1$@ – jamais de clés ni de seed phrase. Le fournisseur la voit avec ton adresse IP. Interrogée au plus toutes les 10 minutes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק הכתובת הציבורית נשלחת אל %1$@ – אף פעם לא מפתחות או seed phrase. הספק רואה אותה יחד עם כתובת ה-IP שלך. נבדק לכל היותר כל 10 דקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ को सिर्फ़ सार्वजनिक पता भेजा जाता है – कभी भी कुंजियाँ या seed phrase नहीं। प्रदाता इसे तुम्हारे IP पते के साथ देखता है। अधिकतम हर 10 मिनट में जाँचा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a nyilvános cím kerül elküldésre ide: %1$@ – soha kulcs vagy seed-szavak. A szolgáltató az IP-címeddel együtt látja. Legfeljebb 10 percenként lekérdezve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya alamat publik yang dikirim ke %1$@ – tidak pernah kunci atau seed phrase. Penyedia melihatnya bersama alamat IP-mu. Dicek paling sering setiap 10 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ viene inviato solo l’indirizzo pubblico – mai chiavi o seed phrase. Il fornitore lo vede insieme al tuo indirizzo IP. Controllato al massimo ogni 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ に送信するのは公開アドレスだけです。鍵やシードフレーズは決して送信しません。提供元にはあなたの IP アドレスとともに表示されます。確認は最短でも10分ごとです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에는 공개 주소만 전송되며 키나 시드 문구는 절대 전송되지 않습니다. 제공자는 이를 IP 주소와 함께 보게 됩니다. 최대 10분마다 조회합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare den offentlige adressen sendes til %1$@ – aldri nøkler eller seed-fraser. Leverandøren ser den sammen med IP-adressen din. Sjekkes høyst hvert 10. minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
