        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin Cash addresses can't be watched: there is no free public service without an API key whose terms allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones de Bitcoin Cash no se pueden vigilar: no hay ningún servicio público gratuito sin clave API cuyas condiciones lo permitan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آدرس‌های Bitcoin Cash را نمی‌توان زیر نظر گرفت: هیچ سرویس عمومی رایگانی بدون کلید API نیست که شرایطش این را مجاز کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin Cash -osoitteita ei voi seurata: ei ole ilmaista julkista palvelua ilman API-avainta, jonka ehdot sallisivat sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
