    "portfolio_csv_import_transfers_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح السحب والإيداع المطابق له من العملة نفسها تحويلًا واحدًا: يبقى سعر الشراء ومدة الاحتفاظ، ويُحتسب الفرق رسوم شبكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr a odpovídající vklad stejného coinu se spojí do jednoho převodu: nákupní cena a doba držení zůstávají, rozdíl se počítá jako síťový poplatek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En udbetaling og den matchende indbetaling af samme coin bliver én overførsel: købspris og ejertid bevares, forskellen tæller som netværksgebyr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Auszahlung und die passende Einzahlung desselben Coins werden eine Umbuchung: Kaufpreis und Haltedauer bleiben, die Differenz gilt als Netzwerkgebühr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ανάληψη και η αντίστοιχη κατάθεση του ίδιου coin γίνονται μία μεταφορά: η τιμή αγοράς και η περίοδος κατοχής διατηρούνται, η διαφορά μετρά ως προμήθεια δικτύου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A withdrawal and the matching deposit of the same coin become one transfer: purchase price and holding period carry over, the difference counts as network fee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una retirada y el depósito correspondiente de la misma moneda se convierten en una sola transferencia: el precio de compra y el periodo de tenencia se mantienen, la diferencia cuenta como comisión de red."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک برداشت و واریز متناظر همان کوین یک انتقال می‌شوند: قیمت خرید و مدت نگهداری حفظ می‌شود و تفاوت، کارمزد شبکه حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosto ja saman coinin vastaava talletus yhdistetään yhdeksi siirroksi: ostohinta ja omistusaika säilyvät, erotus lasketaan verkkomaksuksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retrait et le dépôt correspondant du même coin deviennent un seul transfert : le prix d’achat et la durée de détention sont conservés, la différence compte comme frais de réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משיכה וההפקדה התואמת של אותו מטבע הופכות להעברה אחת: מחיר הקנייה ותקופת ההחזקה נשמרים, וההפרש נחשב לעמלת רשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही कॉइन की निकासी और उससे मेल खाती जमा एक ट्रांसफ़र बन जाती हैं: ख़रीद मूल्य और होल्डिंग अवधि बनी रहती है, अंतर नेटवर्क शुल्क माना जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kifizetés és ugyanazon coin hozzá illő befizetése egyetlen átvezetés lesz: a beszerzési ár és a tartási idő megmarad, a különbözet hálózati díjnak számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penarikan dan setoran yang cocok dari koin yang sama menjadi satu transfer: harga beli dan lama kepemilikan tetap, selisihnya dihitung sebagai biaya jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prelievo e il deposito corrispondente dello stesso coin diventano un unico trasferimento: prezzo d’acquisto e periodo di detenzione restano, la differenza conta come commissione di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じコインの出庫とそれに合う入庫を1件の振替にまとめます：取得価格と保有期間は引き継がれ、差額はネットワーク手数料になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 코인의 출금과 그에 맞는 입금이 하나의 이체가 됩니다: 매수가와 보유 기간은 유지되고, 차액은 네트워크 수수료로 처리됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et uttak og det tilsvarende innskuddet av samme coin blir én overføring: kjøpspris og eiertid beholdes, differansen regnes som nettverksgebyr."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een opname en de bijbehorende storting van dezelfde coin worden één overboeking: aankoopprijs en bezitsduur blijven behouden, het verschil telt als netwerkkosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypłata i pasująca wpłata tego samego coina stają się jednym przeniesieniem: cena zakupu i okres posiadania zostają zachowane, różnica liczy się jako opłata sieciowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um levantamento e o depósito correspondente da mesma moeda tornam-se uma só transferência: o preço de compra e o período de detenção mantêm-se, a diferença conta como comissão de rede."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um saque e o depósito correspondente da mesma moeda viram uma única transferência: o preço de compra e o período de posse são mantidos, a diferença conta como taxa de rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O retragere și depunerea corespunzătoare a aceleiași monede devin un singur transfer: prețul de achiziție și perioada de deținere se păstrează, diferența contează drept comision de rețea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вывод и соответствующий ему депозит той же монеты становятся одним переводом: цена покупки и срок владения сохраняются, разница считается комиссией сети."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një tërheqje dhe depozita përkatëse e të njëjtit coin bëhen një transferim i vetëm: çmimi i blerjes dhe periudha e mbajtjes ruhen, diferenca llogaritet si tarifë rrjeti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett uttag och motsvarande insättning av samma coin blir en enda överföring: köppris och innehavstid behålls, skillnaden räknas som nätverksavgift."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การถอนและการฝากที่ตรงกันของเหรียญเดียวกันจะรวมเป็นการโอนย้ายครั้งเดียว: ราคาซื้อและระยะเวลาถือครองยังคงเดิม ส่วนต่างนับเป็นค่าธรรมเนียมเครือข่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı coin’in bir çekimi ve ona uyan yatırımı tek bir transfer olur: alış fiyatı ve elde tutma süresi korunur, aradaki fark ağ ücreti sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виведення та відповідний депозит тієї самої монети стають одним переказом: ціна купівлі й строк володіння зберігаються, різниця вважається комісією мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lần rút và lần nạp tương ứng của cùng một coin trở thành một lần chuyển: giá mua và thời gian nắm giữ được giữ nguyên, phần chênh lệch được tính là phí mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一币种的一笔提现和与之匹配的充值合并为一次转移：买入价和持有期保留，差额计为网络手续费。"
          }
        }
      }
    },
