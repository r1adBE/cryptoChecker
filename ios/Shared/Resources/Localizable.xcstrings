    "alarm_oi_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن العقود المفتوحة بالقيمة المحفوظة قبل هذا العدد من الساعات. لا ينبّه التنبيه الجديد إلا بعد أن يجمع التطبيق بيانات طوال هذه المدة؛ ويتم الفحص مرة كل 5 دقائق على الأكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnává open interest s hodnotou uloženou před tolika hodinami. Nový alarm se ozve, až aplikace nasbírá data za celé toto období; kontrola nejvýše každých 5 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner open interest med værdien fra så mange timer siden. En ny alarm giver først besked, når appen har indsamlet data så længe; der tjekkes højst hvert 5. minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht mit dem Open Interest von vor so vielen Stunden. Ein neuer Alarm meldet erst, wenn die App so lange Werte gesammelt hat; geprüft wird höchstens alle 5 Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνει το ανοιχτό ενδιαφέρον με την τιμή που αποθηκεύτηκε πριν από τόσες ώρες. Ένας νέος συναγερμός ενεργοποιείται μόνο όταν η εφαρμογή έχει συλλέξει δεδομένα για τόσο διάστημα· έλεγχος το πολύ κάθε 5 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares open interest with the value stored that many hours ago. A new alert only reports once the app has collected data for that long; checked at most every 5 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el interés abierto con el valor guardado hace esas horas. Una alarma nueva solo avisa cuando la app ha reunido datos durante ese tiempo; se comprueba como mucho cada 5 minutos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقعیت‌های باز را با مقداری که همین تعداد ساعت پیش ذخیره شده مقایسه می‌کند. هشدار جدید فقط وقتی خبر می‌دهد که برنامه به همین مدت داده جمع کرده باشد؛ بررسی حداکثر هر ۵ دقیقه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa avoimia positioita arvoon, joka tallennettiin yhtä monta tuntia sitten. Uusi hälytys ilmoittaa vasta, kun sovellus on kerännyt tietoja niin kauan; tarkistus enintään 5 minuutin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare l’intérêt ouvert avec la valeur enregistrée il y a autant d’heures. Une nouvelle alerte ne prévient qu’une fois les données collectées sur cette durée ; vérification au plus toutes les 5 minutes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משווה את ה־Open interest לערך שנשמר לפני אותו מספר שעות. התראה חדשה מודיעה רק אחרי שהאפליקציה אספה נתונים במשך הזמן הזה; הבדיקה לכל היותר כל 5 דקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओपन इंटरेस्ट की तुलना उतने ही घंटे पहले सहेजे गए मान से करता है। नया अलार्म तभी सूचना देता है जब ऐप ने इतने समय तक डेटा इकट्ठा कर लिया हो; जाँच अधिकतम हर 5 मिनट में।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nyitott pozíciókat az ennyi órával korábban mentett értékkel veti össze. Új riasztás csak akkor jelez, ha az alkalmazás ennyi ideig gyűjtött adatot; ellenőrzés legfeljebb 5 percenként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan open interest dengan nilai yang disimpan sekian jam lalu. Alarm baru hanya memberi tahu setelah aplikasi mengumpulkan data selama itu; diperiksa paling sering tiap 5 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta l’open interest con il valore salvato altrettante ore fa. Un nuovo allarme avvisa solo dopo che l’app ha raccolto dati per quel tempo; controllo al massimo ogni 5 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建玉を、同じ時間だけ前に保存した値と比べます。新しいアラームは、アプリがその期間のデータを集めてから通知します。確認は最短5分ごとです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미결제약정을 해당 시간 전에 저장한 값과 비교합니다. 새 경보는 앱이 그 기간 동안 데이터를 모은 뒤에야 알립니다. 확인은 최소 5분 간격으로 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner open interest med verdien fra så mange timer siden. En ny alarm varsler først når appen har samlet data så lenge; det sjekkes høyst hvert 5. minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkt de open interest met de waarde van zoveel uur geleden. Een nieuw alarm meldt pas iets als de app zo lang gegevens heeft verzameld; controle hoogstens elke 5 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównuje otwarte pozycje z wartością zapisaną tyle godzin temu. Nowy alarm zadziała dopiero, gdy aplikacja zbierze dane z tego okresu; sprawdzanie najwyżej co 5 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara o interesse aberto com o valor guardado há essas horas. Um alarme novo só avisa depois de a app recolher dados durante esse tempo; verificação no máximo a cada 5 minutos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara o interesse aberto com o valor salvo há essa quantidade de horas. Um alarme novo só avisa depois que o app coletar dados por esse tempo; verificação no máximo a cada 5 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compară interesul deschis cu valoarea salvată acum tot atâtea ore. O alarmă nouă anunță doar după ce aplicația a strâns date atât timp; verificare cel mult la fiecare 5 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивает открытый интерес со значением, сохранённым столько часов назад. Новое оповещение сработает, только когда приложение соберёт данные за это время; проверка не чаще раза в 5 минут."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krahason open interest me vlerën e ruajtur para po aq orësh. Një alarm i ri njofton vetëm pasi aplikacioni të ketë mbledhur të dhëna për aq kohë; kontrollohet jo më shpesh se çdo 5 minuta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför open interest med värdet från så många timmar sedan. Ett nytt larm meddelar först när appen har samlat data så länge; kontroll högst var 5:e minut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบ Open interest กับค่าที่บันทึกไว้เมื่อจำนวนชั่วโมงเท่านั้นก่อน สัญญาณเตือนใหม่จะทำงานเมื่อแอปเก็บข้อมูลได้นานพอแล้ว ตรวจสอบอย่างมากทุก 5 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık pozisyonu o kadar saat önce kaydedilen değerle karşılaştırır. Yeni alarm ancak uygulama o süre boyunca veri topladıktan sonra bildirir; en fazla 5 dakikada bir kontrol edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює відкритий інтерес зі значенням, збереженим стільки годин тому. Новий сигнал спрацює, лише коли застосунок збере дані за цей час; перевірка не частіше ніж раз на 5 хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh open interest với giá trị đã lưu cách đây đúng số giờ đó. Cảnh báo mới chỉ báo khi ứng dụng đã thu thập dữ liệu đủ lâu; kiểm tra tối đa 5 phút một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将持仓量与相应小时数之前保存的数值比较。新提醒要等应用收集了足够长时间的数据后才会通知；最多每 5 分钟检查一次。"
          }
        }
      }
    },
