    "diagnostics_share_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف نصي للدعم: الإصدار والجهاز وإعدادات التنبيهات وآخر عمليات الفحص وسجل التنبيهات – بدون المحفظة أو المبالغ أو العناوين أو الملاحظات. تراه أولًا؛ لا يُرسل شيء تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textový soubor pro podporu: verze, zařízení, nastavení alarmů, poslední kontroly a protokol alarmů – bez portfolia, částek, adres a poznámek. Nejdřív ho uvidíš; nic se neodesílá automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstfil til support: version, enhed, alarmindstillinger, seneste tjek og alarmlog – uden portefølje, beløb, adresser eller noter. Du ser den først; intet sendes automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textdatei für den Support: Version, Gerät, Alarm-Einstellungen, letzte Prüfungen und Alarm-Protokoll – ohne Portfolio, Beträge, Adressen und Notizen. Du siehst sie zuerst; gesendet wird nichts automatisch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχείο κειμένου για την υποστήριξη: έκδοση, συσκευή, ρυθμίσεις συναγερμών, τελευταίοι έλεγχοι και αρχείο συναγερμών – χωρίς χαρτοφυλάκιο, ποσά, διευθύνσεις ή σημειώσεις. Το βλέπεις πρώτα εσύ· τίποτα δεν αποστέλλεται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text file for support: version, device, alert settings, recent checks and alert log – without portfolio, amounts, addresses or notes. You see it first; nothing is sent automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivo de texto para soporte: versión, dispositivo, ajustes de alarmas, últimas comprobaciones y registro de alarmas – sin cartera, importes, direcciones ni notas. Primero lo ves tú; no se envía nada automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل متنی برای پشتیبانی: نسخه، دستگاه، تنظیمات هشدار، آخرین بررسی‌ها و گزارش هشدارها – بدون سبد دارایی، مبالغ، آدرس‌ها یا یادداشت‌ها. ابتدا خودت آن را می‌بینی؛ هیچ چیزی خودکار ارسال نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitiedosto tukea varten: versio, laite, hälytysasetukset, viimeisimmät tarkistukset ja hälytysloki – ilman salkkua, summia, osoitteita tai muistiinpanoja. Näet sen ensin; mitään ei lähetetä automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichier texte pour le support : version, appareil, réglages des alertes, dernières vérifications et journal des alertes – sans portefeuille, montants, adresses ni notes. Tu le vois d'abord ; rien n'est envoyé automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובץ טקסט לתמיכה: גרסה, מכשיר, הגדרות התראות, בדיקות אחרונות ויומן התראות – בלי תיק, סכומים, כתובות או הערות. קודם רואים אותו; שום דבר לא נשלח אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सपोर्ट के लिए टेक्स्ट फ़ाइल: वर्ज़न, डिवाइस, अलार्म सेटिंग, हाल की जाँचें और अलार्म लॉग – पोर्टफ़ोलियो, राशि, पते या नोट्स के बिना। पहले तुम इसे देखते हो; कुछ भी अपने-आप नहीं भेजा जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szövegfájl a támogatásnak: verzió, eszköz, riasztási beállítások, utolsó ellenőrzések és riasztási napló – portfólió, összegek, címek és jegyzetek nélkül. Előbb te látod; semmi sem megy el automatikusan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File teks untuk dukungan: versi, perangkat, pengaturan alarm, pemeriksaan terakhir, dan log alarm – tanpa portofolio, jumlah, alamat, atau catatan. Kamu melihatnya dulu; tidak ada yang dikirim otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di testo per il supporto: versione, dispositivo, impostazioni degli allarmi, ultimi controlli e registro allarmi – senza portafoglio, importi, indirizzi o note. Lo vedi prima tu; nulla viene inviato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポート用のテキストファイル：バージョン、端末、アラーム設定、最近の確認、アラーム履歴 – ポートフォリオ、金額、アドレス、メモは含みません。最初に内容を確認でき、自動では何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원용 텍스트 파일: 버전, 기기, 경보 설정, 최근 확인 및 경보 기록 – 포트폴리오, 금액, 주소, 메모는 포함하지 않습니다. 먼저 내용을 보여 드리며, 자동으로 전송되는 것은 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstfil for brukerstøtte: versjon, enhet, alarminnstillinger, siste sjekker og alarmlogg – uten portefølje, beløp, adresser eller notater. Du ser den først; ingenting sendes automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstbestand voor support: versie, apparaat, alarminstellingen, laatste controles en alarmlogboek – zonder portfolio, bedragen, adressen of notities. Je ziet het eerst; er wordt niets automatisch verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik tekstowy dla wsparcia: wersja, urządzenie, ustawienia alarmów, ostatnie sprawdzenia i dziennik alarmów – bez portfela, kwot, adresów i notatek. Najpierw go zobaczysz; nic nie jest wysyłane automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficheiro de texto para o suporte: versão, dispositivo, definições de alarmes, últimas verificações e registo de alarmes – sem carteira, montantes, endereços nem notas. É mostrado primeiro; nada é enviado automaticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivo de texto para o suporte: versão, aparelho, configurações de alarmes, últimas verificações e registro de alarmes – sem portfólio, valores, endereços nem notas. Você vê primeiro; nada é enviado automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișier text pentru suport: versiune, dispozitiv, setări de alarme, ultimele verificări și jurnalul alarmelor – fără portofoliu, sume, adrese sau notițe. Îl vezi mai întâi; nimic nu se trimite automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовый файл для поддержки: версия, устройство, настройки оповещений, последние проверки и журнал оповещений – без портфеля, сумм, адресов и заметок. Сначала ты его увидишь; ничего не отправляется автоматически."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedar teksti për mbështetjen: versioni, pajisja, cilësimet e alarmeve, kontrollet e fundit dhe regjistri i alarmeve – pa portofol, shuma, adresa apo shënime. E sheh fillimisht ti; asgjë nuk dërgohet automatikisht."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textfil för support: version, enhet, larminställningar, senaste kontroller och larmlogg – utan portfölj, belopp, adresser eller anteckningar. Du ser den först; inget skickas automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ข้อความสำหรับฝ่ายสนับสนุน: เวอร์ชัน อุปกรณ์ การตั้งค่าสัญญาณเตือน การตรวจสอบล่าสุด และบันทึกสัญญาณเตือน – ไม่มีพอร์ตโฟลิโอ จำนวนเงิน ที่อยู่ หรือโน้ต คุณจะเห็นก่อน ไม่มีการส่งโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destek için metin dosyası: sürüm, cihaz, alarm ayarları, son kontroller ve alarm günlüğü – portföy, tutar, adres veya not olmadan. Önce sen görürsün; hiçbir şey otomatik gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовий файл для підтримки: версія, пристрій, налаштування сигналів, останні перевірки та журнал сигналів – без портфеля, сум, адрес і нотаток. Спершу ти його побачиш; нічого не надсилається автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp văn bản cho bộ phận hỗ trợ: phiên bản, thiết bị, cài đặt cảnh báo, các lần kiểm tra gần đây và nhật ký cảnh báo – không có danh mục, số tiền, địa chỉ hay ghi chú. Bạn xem trước; không có gì được gửi tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供支持使用的文本文件：版本、设备、提醒设置、最近检查和提醒记录 – 不含投资组合、金额、地址或备注。你会先看到内容；不会自动发送任何内容。"
          }
        }
      }
    },
    "error_market_unreachable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنصة غير متاحة حاليًا – تبقى آخر الأسعار ظاهرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burza je teď nedostupná – poslední ceny zůstávají vidět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Børsen kan ikke nås lige nu – de seneste kurser bliver stående."
