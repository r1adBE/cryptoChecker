    "app_lock_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إعداد قفل شاشة على هذا الجهاز. أعِدّ قفلًا في إعدادات النظام أولًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto zařízení není nastaven zámek obrazovky. Nejprve ho nastav v nastavení systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke konfigureret skærmlås på denne enhed. Opret en i systemindstillingerne først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist keine Displaysperre eingerichtet. Richte zuerst eine in den Systemeinstellungen ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει ρυθμιστεί κλείδωμα οθόνης σε αυτή τη συσκευή. Ρύθμισε πρώτα ένα στις ρυθμίσεις συστήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No screen lock is set up on this device. Set one up in the system settings first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene bloqueo de pantalla. Configura uno primero en los ajustes del sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی این دستگاه قفل صفحه تنظیم نشده است. ابتدا یکی را در تنظیمات سیستم تنظیم کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä laitteessa ei ole näytön lukitusta. Määritä se ensin järjestelmän asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun verrouillage d'écran n'est configuré sur cet appareil. Configures-en d'abord un dans les paramètres système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא הוגדרה נעילת מסך במכשיר זה. הגדירו נעילה בהגדרות המערכת תחילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कोई स्क्रीन लॉक सेट नहीं है। पहले सिस्टम सेटिंग्स में एक सेट करो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az eszközön nincs beállítva képernyőzár. Először állíts be egyet a rendszerbeállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada kunci layar di perangkat ini. Atur dulu di pengaturan sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo non è impostato alcun blocco schermo. Impostane prima uno nelle impostazioni di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末には画面ロックが設定されていません。先にシステム設定で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 화면 잠금이 설정되어 있지 않습니다. 먼저 시스템 설정에서 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke satt opp skjermlås på denne enheten. Sett opp en i systeminnstillingene først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op dit apparaat is geen schermvergrendeling ingesteld. Stel er eerst een in via de systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu nie ustawiono blokady ekranu. Najpierw ustaw ją w ustawieniach systemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há bloqueio de ecrã configurado neste dispositivo. Configura primeiro um nas definições do sistema."
