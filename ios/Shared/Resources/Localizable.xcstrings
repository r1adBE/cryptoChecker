    "market_info_macro_what" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواعيد بيانات اقتصادية أمريكية مهمة: التضخم (CPI وPCE)، وأسعار المنتجين (PPI)، وتقرير الوظائف، وقرارات الفائدة لدى الاحتياطي الفيدرالي الأمريكي. كثيرًا ما تحرّك هذه الأرقام أسعار العملات المشفرة أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termíny důležitých ekonomických údajů z USA: inflace (CPI, PCE), ceny výrobců (PPI), zpráva o trhu práce a rozhodnutí americké centrální banky o sazbách. Taková čísla často hýbou i cenami kryptoměn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoer for vigtige amerikanske økonomiske tal: inflation (CPI, PCE), producentpriser (PPI), jobrapporten og rentebeslutninger fra den amerikanske centralbank. Den slags tal flytter ofte også kurserne på kryptovalutaer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine wichtiger US-Wirtschaftsdaten: Inflation (CPI, PCE), Erzeugerpreise (PPI), Arbeitsmarktbericht und Zinsentscheide der US-Notenbank. Solche Zahlen bewegen oft auch die Kurse von Kryptowährungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ημερομηνίες σημαντικών οικονομικών στοιχείων των ΗΠΑ: πληθωρισμός (CPI, PCE), τιμές παραγωγού (PPI), έκθεση απασχόλησης και αποφάσεις επιτοκίων της Federal Reserve. Τέτοια στοιχεία συχνά κινούν και τις τιμές των κρυπτονομισμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates of important US economic data: inflation (CPI, PCE), producer prices (PPI), the jobs report and interest rate decisions of the US Federal Reserve. Such figures often move crypto prices too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechas de datos económicos importantes de EE. UU.: inflación (CPI, PCE), precios de producción (PPI), informe de empleo y decisiones de tipos de la Reserva Federal. Estas cifras a menudo también mueven los precios de las criptomonedas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخ انتشار داده‌های مهم اقتصادی آمریکا: تورم (CPI، PCE)، قیمت تولیدکننده (PPI)، گزارش اشتغال و تصمیم‌های نرخ بهره فدرال رزرو. این ارقام اغلب قیمت رمزارزها را هم جابه‌جا می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tärkeiden Yhdysvaltain talouslukujen päivämäärät: inflaatio (CPI, PCE), tuottajahinnat (PPI), työllisyysraportti ja Yhdysvaltain keskuspankin korkopäätökset. Tällaiset luvut liikuttavat usein myös kryptovaluuttojen kursseja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates de données économiques américaines importantes : inflation (CPI, PCE), prix à la production (PPI), rapport sur l'emploi et décisions de taux de la Réserve fédérale. Ces chiffres font souvent bouger aussi les cours des cryptomonnaies."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מועדי נתונים כלכליים חשובים מארה״ב: אינפלציה (CPI,‏ PCE), מחירי יצרן (PPI), דוח התעסוקה והחלטות הריבית של הפדרל ריזרב. נתונים כאלה מזיזים לעיתים קרובות גם את מחירי המטבעות הקריפטוגרפיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महत्वपूर्ण अमेरिकी आर्थिक आँकड़ों की तारीखें: महँगाई (CPI, PCE), उत्पादक कीमतें (PPI), जॉब्स रिपोर्ट और अमेरिकी फ़ेडरल रिज़र्व के ब्याज दर फ़ैसले। ऐसे आँकड़े अक्सर क्रिप्टो की कीमतों को भी हिलाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontos amerikai gazdasági adatok időpontjai: infláció (CPI, PCE), termelői árak (PPI), munkaerőpiaci jelentés és az amerikai jegybank kamatdöntései. Az ilyen számok gyakran a kriptovaluták árfolyamát is mozgatják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal data ekonomi penting AS: inflasi (CPI, PCE), harga produsen (PPI), laporan tenaga kerja, dan keputusan suku bunga bank sentral AS. Angka-angka seperti ini sering juga menggerakkan harga kripto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date di importanti dati economici USA: inflazione (CPI, PCE), prezzi alla produzione (PPI), rapporto sull'occupazione e decisioni sui tassi della Federal Reserve. Questi dati spesso muovono anche i prezzi delle criptovalute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要な米国経済指標の発表日です。インフレ（CPI、PCE）、生産者物価（PPI）、雇用統計、米連邦準備制度理事会（FRB）の金利決定などで、こうした数字は暗号資産の価格も動かすことがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요한 미국 경제 지표의 발표 일정입니다. 물가(CPI, PCE), 생산자 물가(PPI), 고용보고서, 미국 연방준비제도의 금리 결정이 해당하며, 이런 수치는 암호화폐 가격도 자주 움직입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoer for viktige amerikanske økonomiske tall: inflasjon (CPI, PCE), produsentpriser (PPI), sysselsettingsrapporten og rentebeslutninger fra den amerikanske sentralbanken. Slike tall påvirker ofte også kursene på kryptovaluta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data van belangrijke Amerikaanse economische cijfers: inflatie (CPI, PCE), producentenprijzen (PPI), het banenrapport en rentebesluiten van de Amerikaanse centrale bank. Zulke cijfers bewegen vaak ook de koersen van cryptomunten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminy ważnych danych gospodarczych z USA: inflacja (CPI, PCE), ceny producentów (PPI), raport z rynku pracy i decyzje Rezerwy Federalnej w sprawie stóp procentowych. Takie dane często poruszają też kursy kryptowalut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datas de dados económicos importantes dos EUA: inflação (CPI, PCE), preços no produtor (PPI), relatório de emprego e decisões de juros da Reserva Federal. Estes números movem muitas vezes também os preços das criptomoedas."
