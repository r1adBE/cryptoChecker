    "ledger_fee_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالـ USDT ترفع تكلفة الشراء (البيع: تخفض العائد)، وبالعملة نفسها تقلل الكمية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V USDT zvyšuje pořizovací cenu (prodej: snižuje výnos), v minci snižuje množství."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I USDT hæver det anskaffelsesprisen (salg: sænker provenuet); i coinen mindsker det mængden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In USDT erhöht sie den Einstand (Verkauf: senkt den Erlös), im Coin verringert sie die Menge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε USDT αυξάνει το κόστος κτήσης (πώληση: μειώνει το έσοδο)· στο νόμισμα μειώνει την ποσότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In USDT it raises the cost basis (sell: lowers the proceeds); in the coin it reduces the amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En USDT aumenta el coste de adquisición (venta: reduce el importe); en la moneda reduce la cantidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به USDT، بهای تمام‌شده را بالا می‌برد (فروش: درآمد را کم می‌کند)؛ به سکه، مقدار را کم می‌کند."
          }
        },
        "fi" : {
